#!/usr/bin/env bash
#
# lua-window - the Lua window (issue 802): the canvas as a picture, with
# each new version written over the old. Until a window backend is built
# (SDL2 or LÖVE on kuvalu; see issues/completed/802-the-lua-window.md) it
# draws headless: nothing on screen, but --screenshot and --key work, and
# every screenshot is filed into development-history/ when it stops.
#
# It stops cleanly when a file named `stop` appears in
# tmp/shared-memory/lua-window/: it writes its goodbye receipt. LuaJIT
# cannot catch a signal, so this script catches Ctrl-C and TERM instead and
# drops the stop file, then waits for the window to say goodbye.
#
# Usage:
#   scripts/lua-window                  the project at its usual place
#   scripts/lua-window <dir> [OPTIONS]  the project at <dir>; OPTIONS go to
#                                       src/072-lua-window.lua (--replay
#                                       FOLDER, --screenshot SECONDS, --key
#                                       SECONDS NAME, --for SECONDS, --fast)

DIR="/mnt/mtwo/programming/ai-stuff/guide-feature"
if [ -n "${1:-}" ] && [ "${1#--}" = "$1" ]; then
    DIR="$1"
    shift
fi
STOP="${DIR}/tmp/shared-memory/lua-window"

luajit "${DIR}/src/072-lua-window.lua" --dir "${DIR}" "$@" &
WINDOW=$!

stop_cleanly() {
    mkdir -p "${STOP}"
    : > "${STOP}/stop"
}
trap stop_cleanly INT TERM

while kill -0 "${WINDOW}" 2>/dev/null; do
    wait "${WINDOW}"
    STATUS=$?
done

# every picture it took goes into development-history/, none thrown away
luajit "${DIR}/src/072-lua-window.lua" --dir "${DIR}" \
    --file-screenshots "scripts/lua-window $*"
exit "${STATUS:-0}"
