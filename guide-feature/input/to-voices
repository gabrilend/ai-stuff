# How the blitter mails each new version to the voices (src/035-to-voices.lua,
# issue 303): one living rmail message, outbox/the-canvas in the guide
# mailbox, addressed to every voice in input/blitter. Read once when the
# blitter starts. Text goes in double quotes.

# "on" mails every version; "off" mails nothing (the demos and tests run the
# blitter with it off, in throwaway projects).
send             = "on"

# The guide mailbox's folder, as input/mailboxes makes it (guide.folder).
mailbox          = "~/guide-mail"

# "on" ends the canvas with a `cuts:` section: each voice's words cut by its
# latest turn that landed, so its next turn sees what its edit destroyed
# (docs/datapath-blit.md, "Collision rules").
tell-the-voice   = "on"

# Which model server each voice uses is not set here: every version names
# each voice's endpoint, read then from the project-root endpoints file
# (docs/endpoints.md, issue 402).

# The project the voices work on: its git checkout on kuvalu, read at every
# version for the commit their clones should be at.
project-checkout = "/mnt/mtwo/programming/ai-stuff/guide-feature"
