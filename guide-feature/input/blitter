# The blitter's settings (src/016-blitter.lua). Every value it runs with is
# here; nothing has a default in code. Text goes in double quotes; numbers
# and sizes are bare.

# The canvas, columns x rows. Fixed when the blitter starts.
canvas-size    = 60x20

# How arriving voice canvases become the shared canvas: "newest" blits each
# voice's changes as they arrive; "distill" has kuvalu's distiller combine
# every voice's newest canvas into one and blits that (issue 601; its words
# in input/distill-instructions, its counts in input/distill, its endpoint
# use.distiller in the endpoints file). Read again on every arrival.
merge-mode     = "newest"

# What happens to a word a write cuts into: "blank-whole" blanks what is
# left of it (the owner's rule); "keep-fragments" leaves the letters, as a
# terminal would. Read again on every arrival.
collision-rule = "blank-whole"

# How long a mark lasts, in versions: a mark is dropped once it is more than
# this many versions old, so 0 shows a change only on the version that made
# it. Read again on every arrival.
mark-lifetime  = 12

# The project the voices work on, as the viewers' `project:` header names it
# (with the commit the project is at, read from git when the blitter starts).
project        = "guide-feature"

# The voices, in the order viewers give them colours (the `voices:` header).
voices         = "fg-sora-1 fg-sora-2 fg-sora-3"
