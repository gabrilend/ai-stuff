#!/usr/bin/env bash
#
# phase-5-demo - shows a design built from a blueprint alone. The notes
# program's blueprint (phase 4) is built by stand-in turns wave by wave into
# new code, each piece checked by running its own acceptance commands; one
# piece is built broken the first time and repaired; the finished design is
# then run to show it works. A second case shows what happens when a piece
# can never be built: everything built on it is held, the rest is built,
# and nothing is delivered.
#
# Usage: phase-5-demo [project folder]

DIR="/mnt/mtwo/programming/ai-stuff/burner-of-down-things"
if [ -d "${1:-}" ]; then
    DIR="$1"
fi

source "/mnt/mtwo/programming/ai-stuff/scripts/libs/ensure-ram-tiers"
ensure_ram_tiers "${DIR}" || exit 1

exec luajit "${DIR}/issues/completed/demos/phase-5-demo.lua" "${DIR}"
