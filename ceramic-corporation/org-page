#!/usr/bin/env bash
#
# org-page -- writes an org as one static HTML5 page anybody can open.
#
# The blocked board first, then every box with its holders and ports (every
# wire a link to the other end, every waiting port marked), then the people
# and the outside parties. No JavaScript and nothing the org's files do not
# hold. Refuses an invalid org rather than drawing something untrue.
#
# Usage:
#   ./org-page ORG_DIR > page.html
#   ./org-page /path/to/ceramic-corporation ORG_DIR > page.html

DIR="/mnt/mtwo/programming/ai-stuff/ceramic-corporation"

# -- {{{ show_help
show_help() {
    sed -n '3,12p' "$0" | sed 's/^# \{0,1\}//'
}
# }}}

if [ -f "$1/src/013-org-page.lua" ]; then
    DIR="$1"
    shift
fi

if [ "$#" -ne 1 ] || [ "$1" = "-h" ] || [ "$1" = "--help" ]; then
    show_help >&2
    exit 2
fi

exec "${LUA:-luajit}" "${DIR}/src/013-org-page.lua" "$1"
