#!/usr/bin/env bash
#
# blocked-board -- ranks what an org is waiting on by how much depends on it.
#
# One row per source of waiting (a box, or a party outside the org): how many
# ports it owes, how many boxes it would free outright by delivering, and how
# many boxes depend on it at any distance. Ranked by that reach first, so the
# top line is the delivery that unsticks the most. The numbers are defined in
# docs/004-what-blocked-means.md.
#
# Usage:
#   ./blocked-board ORG_DIR              -- every source of waiting
#   ./blocked-board ORG_DIR --ready      -- only what somebody can deliver now
#   ./blocked-board ORG_DIR --says       -- each row followed by what it is
#   ./blocked-board /path/to/ceramic-corporation ORG_DIR [--ready] [--says]
#
# LUA picks the interpreter (default luajit).

DIR="/mnt/mtwo/programming/ai-stuff/ceramic-corporation"

# -- {{{ show_help
show_help() {
    sed -n '3,18p' "$0" | sed 's/^# \{0,1\}//'
}
# }}}

if [ -f "$1/src/008-blocked-board.lua" ]; then
    DIR="$1"
    shift
fi

if [ "$#" -lt 1 ] || [ "$1" = "-h" ] || [ "$1" = "--help" ]; then
    show_help
    exit 2
fi

exec "${LUA:-luajit}" "${DIR}/src/008-blocked-board.lua" "$@"
