#!/usr/bin/env bash
#
# run-tests -- runs everything this project knows how to check, and says what
# held and what did not.
#
# For a general: a project is only as trustworthy as the things it re-checks
# without being asked. This runs all of them in one go, from anywhere, and
# ends with a single line saying whether anything broke.
#
# Tests are cheap. Make many of them, and run them during the build.
#
# usage:
#   ./run-tests            everything
#   ./run-tests --quick    skip the ones that boot emulated machines
#   ./run-tests DIR        run against a project at another path

# {{{ DIR -- the project root, hard-coded, overridable by an argument
DIR="/mnt/mtwo/programming/ai-stuff/every-software-image-able"
# }}}

QUICK=""
for word in "$@"; do
  case "$word" in
    --quick) QUICK="yes" ;;
    --*)     echo "run-tests: unknown option $word" >&2 ; exit 1 ;;
    *)       DIR="$word" ;;
  esac
done

# the RAM directories, before anything tries to write a log into them.
mkdir -p /tmp/every-software-image-able
mkdir -p /dev/shm/every-software-image-able
ln -sfn /tmp/every-software-image-able "${DIR}/tmp"
ln -sfn /dev/shm/every-software-image-able /tmp/every-software-image-able/shared-memory

PASSED=0
FAILED=0
FAILED_NAMES=""

# {{{ run_test -- one test, its name, and whether it held
run_test() {
  local name="$1"
  local script="$2"

  printf '\n=== %s ===\n' "$name"

  if luajit "${DIR}/src/${script}" --dir "${DIR}"; then
    PASSED=$((PASSED + 1))
  else
    FAILED=$((FAILED + 1))
    FAILED_NAMES="${FAILED_NAMES}  ${name}\n"
  fi
}
# }}}

printf '\n'
printf 'checking everything in %s\n' "${DIR}"

# The quick ones first, so a broken build is reported in seconds rather than
# after several minutes of booting emulated computers.
run_test "the packed model, round-tripped"   "027-test-blob.lua"
run_test "the arithmetic, against its record" "037-test-forward.lua"
run_test "the kernels, fast and slow"         "044-test-kernels.lua"
run_test "the fast arithmetic, against its twin" "104-test-fast-kernel.lua"
run_test "what a thinking machine costs"      "046-what-fits.lua"
run_test "weights at four bits, and the cost" "124-test-quantised.lua"
run_test "raising e to a power, two ways"     "048-test-exp.lua"
run_test "a whole thought, on real arithmetic" "050-test-assembly-forward.lua"
run_test "text into numbers, and back"        "039-test-tokenizer.lua"
run_test "the same words into the same numbers" "060-test-assembly-tokenizer.lua"
run_test "choosing what to say next"          "041-test-sampler.lua"
run_test "choosing the same word, twice over" "058-test-assembly-sampler.lua"
run_test "what the machine is thinking with"  "053-test-context.lua"
run_test "the loop, closed, and its stoppers" "062-test-thinking-loop.lua"
run_test "asking for something, and being answered" "065-test-the-hands.lua"
run_test "reading something too big to hold"  "067-test-the-reader.lua"
run_test "touching memory, and what it will not touch" "072-test-touch-memory.lua"
run_test "running what it wrote"              "075-test-run-what-it-wrote.lua"
run_test "keeping something, and touching what breaks" "078-test-keep-and-touch.lua"
run_test "saying how it is"                   "080-test-emit-a-status.lua"
run_test "what it wakes up holding"           "085-test-the-payload.lua"
run_test "a recipe, a board, and their bytes" "090-test-the-image.lua"
run_test "devices that die, and the confusion" "093-test-devices-that-die.lua"
run_test "the read that never answers"        "106-test-the-watchdog.lua"
run_test "watching, and cutting the power"    "096-test-watching-and-power.lua"

if [ -z "${QUICK}" ]; then
  # These boot real emulated machines on three architectures and take minutes.
  run_test "the discipline, held and broken"  "022-test-traps.lua"
  run_test "the machine's arithmetic, against the host's" "055-test-blob-report.lua"
  run_test "saying something with nothing underneath" "070-test-say.lua"
  run_test "waking up, and knowing what it woke on" "087-test-waking.lua"
  run_test "the second tongue, against the first" "100-test-kernels-aarch64.lua"
  run_test "a whole thought, in the second tongue" "110-test-forward-aarch64.lua"
  run_test "the third tongue, against the first"  "113-test-kernels-riscv64.lua"
  run_test "a whole thought, in the third tongue" "116-test-forward-riscv64.lua"
  run_test "choosing the same word, second tongue" "119-test-sampler-aarch64.lua"
  run_test "choosing the same word, third tongue"  "122-test-sampler-riscv64.lua"
  run_test "four-bit weights, on all three"       "125-test-quantised-kernels.lua"
  run_test "the same words, on all three"         "127-test-tokenizer-elsewhere.lua"
  run_test "saying something, on all three"       "129-test-say-elsewhere.lua"
else
  printf '\n=== skipped: the discipline, held and broken (--quick) ===\n'
  printf '\n=== skipped: the machine'"'"'s arithmetic, against the host'"'"'s (--quick) ===\n'
  printf '\n=== skipped: saying something with nothing underneath (--quick) ===\n'
fi

printf '\n'
printf '%s\n' "--------------------------------------------------------------"
if [ "${FAILED}" -eq 0 ]; then
  printf 'all %d test programs held\n' "${PASSED}"
else
  printf '%d of %d test programs held. These did not:\n' \
    "${PASSED}" "$((PASSED + FAILED))"
  printf "${FAILED_NAMES}"
fi
printf '\n'

mkdir -p "${DIR}/output"
printf '%d of %d test programs held\ngoodbye\n' \
  "${PASSED}" "$((PASSED + FAILED))" > "${DIR}/output/goodbye"

[ "${FAILED}" -eq 0 ]
