# The storyline shelf is a generated artifact - hundreds of symlinks rebuilt
# by scripts/build-storyline-library.sh on demand. Tracking it would smear
# regeneration churn across every commit; the tracked library/README.md
# explains how to rebuild it. (Issue 057.)
library/storyline/

# tmp is this machine's link to its RAM scratch folder, made by
# scripts/libs/ensure-ram-tiers when a test runs. It points outside the
# repository and means nothing on another machine.
/tmp
