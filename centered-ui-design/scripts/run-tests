#!/usr/bin/env bash
#
# run-tests - runs every check in the project that needs no window.
#
# In plain terms: finds each test file in src/ (names ending in .test.lua)
# and runs it with plain LuaJIT, reporting how many passed and failed. The
# drawn parts are checked by running the game with scripted clicks and a
# screenshot (see the run script's options); and last, the game itself is
# started for a moment and closed, and its goodbye note checked, so a
# drawing that fails to start (a shader that will not build) fails here.
#
# Usage:
#   scripts/run-tests              test the project at the default location
#   scripts/run-tests <dir>        test the project at <dir>

DIR="/mnt/mtwo/programming/ai-stuff/centered-ui-design"
# a first argument is the project's location
if [ -n "${1:-}" ]; then
    DIR="$1"
fi

# the C boxes are checked through the built library: build it first
"${DIR}/scripts/build-ceramics" "${DIR}" > /dev/null || exit 1

STATUS=0
for TEST_FILE in "${DIR}"/src/*.test.lua; do
    echo "== ${TEST_FILE##*/}"
    luajit "${TEST_FILE}" "${DIR}" || STATUS=1
done

# the game starts, draws for a second and closes cleanly (a fresh goodbye)
echo "== the game starts and closes"
GOODBYE="${DIR}/output/goodbye"
BEFORE=$(stat -c %Y "${GOODBYE}" 2>/dev/null || echo 0)
sleep 1
START_LOG=$(love "${DIR}/src" "${DIR}" --quit 1.0 2>&1)
AFTER=$(stat -c %Y "${GOODBYE}" 2>/dev/null || echo 0)
# a goodbye written after the start: it reached a clean ending
if [ "${AFTER}" -gt "${BEFORE}" ]; then
    echo "PASS  the game starts, draws and says goodbye"
else
    echo "FAIL  the game did not reach a clean ending:"
    echo "${START_LOG}" | head -12
    STATUS=1
fi

# the view dials, through the same key and wheel handlers a person's reach:
# S held while scrolling three notches widens the field of view by a tenth
# a notch; A held, the view distance; the run log says what they became
echo "== the view dials answer S and A with the wheel"
love "${DIR}/src" "${DIR}" --wheel-with 0.5 s 3 --wheel-with 0.7 a -2 --wheel-with 0.8 d 4 --quit 1.0 > /dev/null 2>&1
VIEW_LINE=$(grep '^view reach' "${DIR}/tmp/shared-memory/run-log")
SETTINGS="${DIR}/input/game-settings.lua"
SPAN_START=$(grep -o 'arch_span_degrees = [0-9.]*' "${SETTINGS}" | grep -o '[0-9.]*$')
REACH_START=$(grep -o 'arch_reach = [0-9.]*' "${SETTINGS}" | grep -o '[0-9.]*$')
VIEW_CHECK=$(luajit -e "
local reach, span, spacing = ('${VIEW_LINE}'):match('reach ([%d.]+) span ([%d.]+) spacing ([%d.]+)')
reach, span, spacing = tonumber(reach), tonumber(span), tonumber(spacing)
local want_span = ${SPAN_START} * 1.1 ^ 3
local want_reach = ${REACH_START} * 1.1 ^ -2
print((math.abs(span - want_span) < 0.01 and math.abs(reach - want_reach) < 0.01
    and math.abs(spacing - 1.1 ^ 4) < 0.001) and 'ok' or
    ('span ' .. span .. ' (wanted ' .. want_span .. '), reach ' .. reach .. ' (wanted ' .. want_reach .. ')'))")
if [ "${VIEW_CHECK}" = "ok" ]; then
    echo "PASS  S with the wheel widens the field of view; A brings the view nearer; D spreads the rings"
else
    echo "FAIL  the view dials: ${VIEW_CHECK} (${VIEW_LINE})"
    STATUS=1
fi
exit "${STATUS}"
