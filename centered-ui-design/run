#!/usr/bin/env bash
#
# run - starts the game.
#
# In plain terms: makes sure the project's RAM scratch folders exist (a reboot
# empties them), then opens the game window with LÖVE, telling the game where
# the project lives so it can read its settings from input/ and leave its
# goodbye note in output/.
#
# Usage:
#   ./run                          run the project at the default location
#   ./run <project-dir>            run the project at another location
#   ./run [<project-dir>] --screenshot SECONDS
#                                  run for SECONDS, save the window to
#                                  tmp/shared-memory/screenshot.png, and close;
#                                  the picture is then kept for good in
#                                  development-history/ (scripts/file-screenshot)
#                                  with notes on what changed since the last one
#
# Environment:
#   CAPTURE_NAME=words-with-dashes  the name the kept picture is filed under
#   CAPTURE_SKIP_FILING=1           do not file it here (capture-history files
#                                   it itself, with the commit it shows)

DIR="/mnt/mtwo/programming/ai-stuff/centered-ui-design"
# a first argument that is a folder is the project's location
if [ -d "${1:-}" ]; then
    DIR="$1"
    shift
fi

source /mnt/mtwo/programming/ai-stuff/scripts/libs/ensure-ram-tiers
ensure_ram_tiers "${DIR}"

# the world runs on the ceramic engine: build it first (it rebuilds only
# when a source changed); a failed build stops here, naming the step
"${DIR}/scripts/build-ceramics" "${DIR}" > /dev/null || exit 1

# a picture left by an earlier run must never be filed as this run's
rm -f "${DIR}/tmp/shared-memory/screenshot.png"
love "${DIR}/src" "${DIR}" "$@"
STATUS=$?

# every screenshot deserves a spot (the owner: "each and every single one of
# them should deserve a spot. show the things that change"): a run that took
# one files it in development-history/, unless the caller files it itself
if printf '%s\n' "$@" | grep -qx -- "--screenshot" && [ -z "${CAPTURE_SKIP_FILING:-}" ]; then
    # a run that failed before its screenshot leaves none; file-screenshot says so
    "${DIR}/scripts/file-screenshot" "${DIR}" "${CAPTURE_NAME:-screenshot}" -- "$@" || STATUS=1
fi
exit "${STATUS}"
