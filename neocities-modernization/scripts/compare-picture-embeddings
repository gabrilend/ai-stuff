#!/usr/bin/env luajit
-- compare-picture-embeddings
--
-- WHAT IT DOES (for a CEO): asks whether the embedding model understands what
-- a picture shows -- in particular a picture of words. It turns a few pictures
-- (three it draws itself, of a line of poetry, a line of C and a grocery list,
-- plus real screenshots and a drawing from the project) and a few sentences
-- into the model's numbers, then prints, for every picture, which sentences
-- it sits closest to, and how close the pictures sit to each other. If a
-- picture of a poem sits beside that poem, the model reads pictures.
-- (Issue 9-013, tested 2026-10-21.)
--
-- Usage: scripts/compare-picture-embeddings [DIR] --port N
--   DIR   project directory (default below)
--   --port the port of a llama-server started with EmbeddingGemma 2, its
--          vision projector (--mmproj) and --embeddings; the script does not
--          start one
-- Results only; changes nothing outside tmp/shared-memory/.

-- --help: print the header above and exit, before any work (libs/script-help.lua)
dofile((debug.getinfo(1, "S").source:sub(2):match("(.*/)") or "./") .. "../libs/script-help.lua").handle(arg)
local D = "/mnt/mtwo/programming/ai-stuff/neocities-modernization/"
local PORT
do
    local i = 1
    while i <= #arg do
        if arg[i] == "--port" then PORT = arg[i + 1]; i = i + 1
        elseif arg[i]:sub(1, 2) == "--" then error("compare-picture-embeddings: unknown option " .. arg[i])
        else D = arg[i]:gsub("/?$", "/") end
        i = i + 1
    end
end
if not PORT then error("compare-picture-embeddings: --port N is required") end
package.path = D .. "libs/?.lua;" .. package.path
local json = require("dkjson")
local SCR = D .. "tmp/shared-memory/compare-picture-embeddings/"
local MEDIA = D .. "input/media_attachments/files/"

-- {{{ the pictures it draws itself: known words, plain background
os.execute("mkdir -p " .. string.format("%q", SCR))
local function draw(name, font, size, lines)
    local cmd = { "magick -size 900x300 xc:white -font", font, "-pointsize", size, "-fill black" }
    for n, l in ipairs(lines) do cmd[#cmd + 1] = string.format("-annotate +30+%d %q", 50 + n * 60, l) end
    cmd[#cmd + 1] = string.format("%q", SCR .. name)
    local r = os.execute(table.concat(cmd, " "))
    if r ~= 0 and r ~= true then error("could not draw " .. name .. " (ImageMagick)") end
end
draw("poem.png", "DejaVu-Sans", 40, { "the river remembers", "every rain that fed it" })
draw("code.png", "DejaVu-Sans-Mono", 30, { "int main(void) {", "    pthread_mutex_lock(&m);", "    return 0; }" })
draw("groceries.png", "DejaVu-Sans", 40, { "grocery list:", "eggs, milk, bread, apples" })
-- }}}

local pictures = {
    { "made: poem line", SCR .. "poem.png" },
    { "made: C code", SCR .. "code.png" },
    { "made: groceries", SCR .. "groceries.png" },
    { "real: 39 lines of C (threads)", MEDIA .. "111/735/214/433/752/435/original/8e35bbbdac68b6ae.png" },
    { "real: C semaphore pseudocode", MEDIA .. "111/701/328/421/934/067/original/224b236a8660c34a.png" },
    { "real: GNU C docs page", MEDIA .. "111/713/263/757/673/971/original/d5ea4972d2c2af90.png" },
    { "real: reddit quote (Bubblegum)", MEDIA .. "111/524/493/779/229/576/original/71adebef1060c4e9.png" },
    { "art: about-face-2", D .. "input/images/my-art/about-face-2.png" },
}
local PREFIX = "task: clustering | query: "
local texts = {
    { "the poem line", "the river remembers every rain that fed it" },
    { "C mutex code", "int main(void) { pthread_mutex_lock(&m); return 0; }" },
    { "grocery list", "grocery list: eggs, milk, bread, apples" },
    { "C threads program", "a C program that starts threads and locks a mutex" },
    { "grief poem", "a poem about grief and the people we have lost" },
    { "cartoon quote", "a favourite quote from a princess in an animated cartoon" },
    { "a drawing", "a hand-drawn picture of a face" },
    { "poem paraphrase", "water keeps the memory of the storms that made it" },
    { "engine manual", "torque the cylinder head bolts in three passes" },
}

-- {{{ local function post()
local function post(body)
    local req = SCR .. "req.json"
    local f = assert(io.open(req, "w")); f:write(json.encode(body)); f:close()
    local p = io.popen(string.format("curl -s --max-time 300 -H 'Content-Type: application/json' -d @%s http://127.0.0.1:%s/v1/embeddings", req, PORT))
    local out = p:read("*a"); p:close()
    local d = json.decode(out)
    if not (d and d.data) then error("embedding request failed: " .. out:sub(1, 400)) end
    return d.data
end
-- }}}

-- {{{ local function b64()
local function b64(path)
    local p = io.popen("base64 -w0 " .. string.format("%q", path))
    local s = p:read("*a"); p:close()
    if s == "" then error("no such picture: " .. path) end
    return s
end
-- }}}

local function cos(a, b)
    local d, na, nb = 0, 0, 0
    for i = 1, #a do d = d + a[i] * b[i]; na = na + a[i] ^ 2; nb = nb + b[i] ^ 2 end
    return d / math.sqrt(na * nb)
end

local tv = {}
for i, t in ipairs(texts) do tv[i] = post({ input = { PREFIX .. t[2] } })[1].embedding end
local pv = {}
for i, p in ipairs(pictures) do
    local data = post({ input = { { content = { { type = "image_url",
        image_url = { url = "data:image/png;base64," .. b64(p[2]) } } } } } })
    pv[i] = data[1].embedding
end
print(string.format("dimensions: text %d, picture %d", #tv[1], #pv[1]))

-- picture -> text: each row ranked, closest first
print("\nEach picture's three closest texts (cosine):")
for i, p in ipairs(pictures) do
    local r = {}
    for j, t in ipairs(texts) do r[#r + 1] = { t[1], cos(pv[i], tv[j]) } end
    table.sort(r, function(a, b) return a[2] > b[2] end)
    print(string.format("  %-32s %s %.3f | %s %.3f | %s %.3f", p[1], r[1][1], r[1][2], r[2][1], r[2][2], r[3][1], r[3][2]))
end

print("\nPicture to picture (cosine):")
local head = "                                 "
for j = 1, #pictures do head = head .. string.format(" %5d", j) end
print(head)
for i, p in ipairs(pictures) do
    local row = string.format("  %d %-30s", i, p[1])
    for j = 1, #pictures do row = row .. string.format(" %5.2f", cos(pv[i], pv[j])) end
    print(row)
end
