#!/usr/bin/env bash
# validate-output -- counts the width of every line and checks every link in
# the built site.
#
# WHAT IT DOES (for a CEO): the site's poems are drawn inside fixed-width text
# frames, so one character too many on a line pushes a wall out of place, and
# a link to a page that was never written is a page-not-found for a reader.
# This reads every page of a finished build, all processors at once, and
# reports every line wider than the widest frame and every link that points
# at nothing -- grouped by cause (content-warning boxes, web addresses,
# progress bars, frames, ordinary text) so thousands of findings read as a
# handful of problems to fix.  It changes nothing.  (Issue 9-006; owner:
# "please write a character counting script and count every line".)
#
# Usage:
#   scripts/validate-output [DIR] --jobs N [--output PATH] [--max-width N] [--report PATH]
#
#   DIR          project directory (default below)
#   --jobs       how many pages-checking processes run at once (required; run.sh
#                passes its --threads value, so one number governs the whole run)
#   --output     the built site to check (default DIR/output)
#   --max-width  widest allowed line inside a poem column, in visible
#                characters (default 84, the golden frame -- the widest drawn)
#   --report     where the full report goes (default
#                DIR/tmp/shared-memory/validate-output-report.txt)
#
# Exit status: 0 when nothing is over-wide or broken, 1 otherwise.

DIR="/mnt/mtwo/programming/ai-stuff/neocities-modernization"
OUTPUT=""
MAX_WIDTH=84
REPORT=""
JOBS=""

# {{{ parse arguments
while [ $# -gt 0 ]; do
    case "$1" in
        --jobs)      JOBS="$2"; shift 2 ;;
        --output)    OUTPUT="$2"; shift 2 ;;
        --max-width) MAX_WIDTH="$2"; shift 2 ;;
        --report)    REPORT="$2"; shift 2 ;;
        --*)         echo "validate-output: unknown option $1" >&2; exit 1 ;;
        *)           DIR="$1"; shift ;;
    esac
done
[ -n "$OUTPUT" ] || OUTPUT="$DIR/output"
[ -n "$REPORT" ] || REPORT="$DIR/tmp/shared-memory/validate-output-report.txt"
# Required, not defaulted to every processor: the run's --threads is the
# operator's statement of how much of the machine this build may take, and
# this check used to ignore it.
if ! [[ "$JOBS" =~ ^[1-9][0-9]*$ ]]; then
    echo "validate-output: --jobs N is required (how many processes check pages at once), got '$JOBS'" >&2
    exit 1
fi
if ! [[ "$MAX_WIDTH" =~ ^[1-9][0-9]*$ ]]; then
    echo "validate-output: --max-width needs a whole number, got '$MAX_WIDTH'" >&2
    exit 1
fi
if [ ! -d "$OUTPUT" ]; then
    echo "validate-output: no built site at $OUTPUT" >&2
    exit 1
fi
# }}}

"$DIR/scripts/ensure-tmp-symlink" "$DIR" >/dev/null || exit 1
# Each run works in its own folder, named by its process id: two checks at
# once (the test runner runs several tests side by side, two of which run
# this) used to share one folder, and each wiped the other's findings. A
# finished run's folder stays until the next run starts, so its
# findings.tsv can be read; then it is cleared, unless that run is still
# going.
WORK_BASE="$DIR/tmp/shared-memory/validate-output"
mkdir -p "$WORK_BASE"
for old_run in "$WORK_BASE"/run-*; do
    [ -d "$old_run" ] || continue
    kill -0 "${old_run##*-}" 2>/dev/null || rm -rf "$old_run"
done
WORK="$WORK_BASE/run-$$"
mkdir -p "$WORK"
mkdir -p "$(dirname "$REPORT")"

# Absolute paths throughout: the worker resolves each link against the folder
# of the page it sits in.
OUTPUT="$(cd "$OUTPUT" && pwd)"

# {{{ scan, --jobs workers at once
# Each worker gets batches of pages and writes its findings to its own file,
# named after its process id, so parallel workers never write to the same file.
# source/archive/ is skipped: those are the saved word clouds of past builds,
# published for reference, whose words link to today's word pages -- and a word
# with no page today is expected there (owner, 2026-10-07: "let's just not
# check the archived pages"). Every other page is checked.
# find -H: the site folder output/ is a link into RAM (Issue 10-072), and find
# does not go into a starting point that is a link unless told to.
PAGE_COUNT=$(find -H "$OUTPUT" -path "$OUTPUT/source/archive" -prune -o -name '*.html' -type f -print | wc -l)
echo "Checking $PAGE_COUNT pages under $OUTPUT on $JOBS processes (max width $MAX_WIDTH; archived word clouds skipped)..."
export WORKER="$DIR/scripts/validate-output-worker.lua" FINDINGS_DIR="$WORK" MAX_WIDTH
find -H "$OUTPUT" -path "$OUTPUT/source/archive" -prune -o -name '*.html' -type f -print0 \
    | xargs -0 -r -n 200 -P "$JOBS" sh -c \
        'exec luajit "$WORKER" "$MAX_WIDTH" "$FINDINGS_DIR/part.$$.tsv" "$@"' _
SCAN_STATUS=$?
if [ "$SCAN_STATUS" -ne 0 ]; then
    echo "validate-output: a worker failed (xargs status $SCAN_STATUS); the report would be incomplete" >&2
    exit 1
fi
cat "$WORK"/part.*.tsv > "$WORK/findings.tsv" 2>/dev/null || : > "$WORK/findings.tsv"
rm -f "$WORK"/part.*.tsv   # merged; this folder is RAM
# }}}

# {{{ summarise
# A "link" row is one missing target as seen by one worker, with its count in
# column 5 (see the worker's header), so totals are sums, not row counts.
WIDE=$(awk -F'\t' '$1=="wide"' "$WORK/findings.tsv" | wc -l)
SHAPES=$(awk -F'\t' '$1=="shape"' "$WORK/findings.tsv" | wc -l)
LINKS=$(awk -F'\t' '$1=="link" { n += $5 } END { print n + 0 }' "$WORK/findings.tsv")
{
    echo "validate-output report"
    echo "  site:      $OUTPUT"
    echo "  pages:     $PAGE_COUNT"
    echo "  max width: $MAX_WIDTH visible characters"
    echo ""
    echo "Over-wide lines: $WIDE"
    awk -F'\t' '$1=="wide" { n[$5]++; if ($4 > w[$5]) w[$5] = $4 }
        END { for (c in n) printf "  %-6s %8d lines, widest %d\n", c, n[c], w[c] }' \
        "$WORK/findings.tsv" | sort
    echo ""
    echo "Frame pieces the wrong width or with a junction out of place: $SHAPES"
    awk -F'\t' '$1=="shape" { n[$5]++ } END { for (c in n) printf "  %-16s %8d lines\n", c, n[c] }' \
        "$WORK/findings.tsv" | sort
    echo ""
    echo "Broken links: $LINKS"
    awk -F'\t' '$1=="link" { n[$4] += $5 } END { for (t in n) printf "%8d  %s\n", n[t], t }' \
        "$WORK/findings.tsv" | sort -rn | head -20 | sed 's/^/  /'
    echo ""
    echo "Examples, five per cause (page:line  width  text):"
    awk -F'\t' '$1=="wide" && seen[$5]++ < 5 {
            printf "  [%s] %s:%s  %s  %s\n", $5, $2, $3, $4, $6 }' "$WORK/findings.tsv"
    awk -F'\t' '$1=="shape" && seen[$5]++ < 5 {
            printf "  [%s] %s:%s  %s\n", $5, $2, $3, $6 }' "$WORK/findings.tsv"
    awk -F'\t' '$1=="link" && seen++ < 10 {
            printf "  [link] %s:%s  -> %s  (%s times)\n", $2, $3, $4, $5 }' "$WORK/findings.tsv"
    echo ""
    echo "Every over-wide line and misshapen frame piece, and every missing link"
    echo "target with its count"
    echo "and first page, tab-separated: $WORK/findings.tsv"
} > "$REPORT"
# }}}

cat "$REPORT" | head -40
echo "(full report: $REPORT)"

if [ "$WIDE" -gt 0 ] || [ "$SHAPES" -gt 0 ] || [ "$LINKS" -gt 0 ]; then
    exit 1
fi
exit 0
