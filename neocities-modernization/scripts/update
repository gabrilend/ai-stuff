#!/bin/bash
# Content extraction script with ZIP archive support
# Automatically detects ZIP archives and extracts JSON data for poem processing pipeline
# Implements freshness checking to skip extraction when outputs are up to date

# --help: print the header above and exit, before any work (libs/script-help.sh)
source "$(dirname "$(readlink -f "$0")")/../libs/script-help.sh"
script_help "$0" "$@"

set -euo pipefail

# {{{ setup_dir_path
setup_dir_path() {
    if [ -n "$1" ]; then
        echo "$1"
    else
        echo "/mnt/mtwo/programming/ai-stuff/neocities-modernization"
    fi
}
# }}}

# {{{ is_extraction_fresh
# Check if extracted poems.json files are newer than source ZIP archives
# Returns 0 (true) if fresh, 1 (false) if extraction needed
is_extraction_fresh() {
    local dir="$1"

    # Output files to check
    local outputs=(
        "${dir}/input/fediverse/files/poems.json"
        "${dir}/input/messages/files/poems.json"
        "${dir}/input/notes/files/poems.json"
        "${dir}/input/bluesky/files/poems.json"
    )

    # Find all ZIP archives and CAR files in input directory
    local archives=()
    while IFS= read -r -d '' archive; do
        archives+=("$archive")
    done < <(find "${dir}/input" \( -name "*.zip" -o -name "*.car" \) -type f -print0 2>/dev/null)

    # If no archives found, nothing to extract
    if [ ${#archives[@]} -eq 0 ]; then
        return 0
    fi

    # Check if all output files exist
    for output in "${outputs[@]}"; do
        if [ ! -f "$output" ]; then
            return 1  # Output missing, need to extract
        fi
    done

    # Get the oldest output file modification time
    local oldest_output_mtime=999999999999
    for output in "${outputs[@]}"; do
        local mtime
        mtime=$(stat -c %Y "$output" 2>/dev/null || echo "0")
        if [ "$mtime" -lt "$oldest_output_mtime" ]; then
            oldest_output_mtime=$mtime
        fi
    done

    # Get the newest archive file modification time
    local newest_archive_mtime=0
    for archive in "${archives[@]}"; do
        local mtime
        mtime=$(stat -c %Y "$archive" 2>/dev/null || echo "0")
        if [ "$mtime" -gt "$newest_archive_mtime" ]; then
            newest_archive_mtime=$mtime
        fi
    done

    # Fresh if oldest output is newer than newest archive
    if [ "$oldest_output_mtime" -gt "$newest_archive_mtime" ]; then
        return 0  # Fresh
    else
        return 1  # Stale, need to extract
    fi
}
# }}}

# Parse command line arguments for project directory and options
FORCE_EXTRACT=false
INCLUDE_BOOSTS=false
# The project folder: --dir PATH, or the path in setup_dir_path; a stray word
# stops the script (libs/project-dir.sh, Issue 10-076). It used to be any bare
# word. What is left is this script's own flags.
source "$(dirname "$(readlink -f "$0")")/../libs/project-dir.sh"
project_dir_read "$(setup_dir_path "")" "" "$@"
set -- "${PROJECT_ARGS[@]}"
while [[ $# -gt 0 ]]; do
    case $1 in
        --force|-f)
            FORCE_EXTRACT=true
            shift
            ;;
        --include-boosts)
            INCLUDE_BOOSTS=true
            shift
            ;;
        # Issue 10-065: accept the explicit negative. run.sh no longer has
        # defaults, so it must be able to SAY "no boosts" rather than say
        # nothing and rely on this script's own INCLUDE_BOOSTS=false above.
        # Silence and refusal look identical on a command line; only one of them
        # survives someone later changing what silence means.
        --no-boosts|--exclude-boosts)
            INCLUDE_BOOSTS=false
            shift
            ;;
        *)
            echo "Unknown option: $1" >&2
            exit 1
            ;;
    esac
done

# Check if extraction is needed (freshness check)
if [ "$FORCE_EXTRACT" = false ] && is_extraction_fresh "$DIR"; then
    echo "✅ Extraction data is up to date, skipping ZIP extraction"
    echo "   (use --force to extract anyway)"
    exit 0
fi

echo "🔄 Starting content extraction with ZIP archive support..."

# NOTE: External file syncing happens in Stage 1 (update-words), not here.
# By this point, all external files (ZIPs, notes, images) should already be in input/.

# Guarantee the tmpfs-backed tmp/ symlink exists before any working directory
# is created underneath it. Issue 8-059 unified the previous split between
# temp/ and tmp/ into a single tmpfs path.
"${DIR}/scripts/ensure-tmp-symlink" --dir "${DIR}"

# Create temporary extraction directory
TEMP_EXTRACT_DIR="${DIR}/tmp/shared-memory/extract-$(date +%s)"
mkdir -p "${TEMP_EXTRACT_DIR}"

# Extract ZIP archives to temporary locations
echo "📦 Extracting ZIP archives..."
lua "${DIR}/scripts/zip-extractor.lua" --dir "${DIR}" --temp "${TEMP_EXTRACT_DIR}" || {
    echo "Error: ZIP extraction failed" >&2
    rm -rf "${TEMP_EXTRACT_DIR}"
    exit 1
}

# Check extraction summary to see what was extracted
EXTRACTION_SUMMARY="${TEMP_EXTRACT_DIR}/extraction-summary.json"
if [ ! -f "${EXTRACTION_SUMMARY}" ]; then
    echo "Error: Extraction summary not found" >&2
    rm -rf "${TEMP_EXTRACT_DIR}"
    exit 1
fi

# {{{ stop_extraction
# stop_extraction <what failed>
# One extractor failing stops the whole update. These used to print a warning
# and carry on, so a build went ahead without that source's poems -- every
# later stage (embeddings, similarity, diversity, pages: the better part of an
# hour) then ran on a corpus missing a whole source, and the site was rebuilt
# wrong before anyone read the warning. Stopping here costs seconds; the owner
# would rather fix it now than finish a doomed run (2026-10-04).
stop_extraction() {
    echo "Error: $1 failed; stopping before the rest of the build runs on incomplete input." >&2
    rm -rf "${TEMP_EXTRACT_DIR}"
    exit 1
}
# }}}

# Extract content from temporary ZIP extractions
echo "📱 Processing extracted archives..."

# Check for fediverse data
if [ -f "${TEMP_EXTRACT_DIR}/fediverse/extract/outbox.json" ]; then
    echo "📱 Extracting fediverse content..."
    # Issue 8-011: pass the boost choice either way. "No" used to be passed as
    # nothing, which only worked because the extractor quietly fell back to
    # config.lua; since Issue 10-065a a missing choice is asked for, or is an
    # error when run.sh started the build, so "no" is said out loud.
    BOOST_FLAG="--no-boosts"
    if $INCLUDE_BOOSTS; then
        BOOST_FLAG="--include-boosts"
        echo "   📤 Including fediverse boosts in extraction"
    fi
    lua "${DIR}/scripts/extract-fediverse.lua" --dir "${DIR}" --source "${TEMP_EXTRACT_DIR}/fediverse" $BOOST_FLAG || stop_extraction "fediverse extraction"
else
    echo "ℹ️  No fediverse data found in archives"
fi

# Check for messages data
if [ -f "${TEMP_EXTRACT_DIR}/messages/extract/export.json" ]; then
    echo "💬 Extracting messages content..."
    lua "${DIR}/scripts/extract-messages.lua" --dir "${DIR}" --source "${TEMP_EXTRACT_DIR}/messages" || stop_extraction "messages extraction"
else
    echo "ℹ️  No messages data found in archives"
fi

# Check for notes data
if [ -d "${TEMP_EXTRACT_DIR}/notes/extract" ] && [ "$(find "${TEMP_EXTRACT_DIR}/notes/extract" -type f | head -1)" ]; then
    echo "📝 Extracting notes content..."
    lua "${DIR}/scripts/extract-notes.lua" --dir "${DIR}" --source "${TEMP_EXTRACT_DIR}/notes" || stop_extraction "notes extraction"
else
    echo "ℹ️  No notes data found in archives"
fi

# Also process notes from main directory if not from ZIP
if [ -d "${DIR}/input/notes" ] && [ "$(find "${DIR}/input/notes" -type f -not -name '.*' | head -1)" ]; then
    echo "📝 Processing notes from main directory..."
    bash "${DIR}/scripts/run-notes" --dir "${DIR}" || stop_extraction "main notes processing"
fi

# Check for Bluesky CAR files (find newest by mtime, not specific filenames)
# This allows any repo-*.car or *.car file to be used
CAR_FILE=$(find "${DIR}/input/bluesky" -name "*.car" -type f -printf '%T@ %p\n' 2>/dev/null | sort -rn | head -1 | cut -d' ' -f2-)
if [ -n "$CAR_FILE" ]; then
    echo "🦋 Extracting Bluesky content from $(basename "$CAR_FILE")..."
    "${DIR}/scripts/extract-bluesky-data" --dir "${DIR}" --car "$CAR_FILE" --output "${DIR}/input/bluesky/files/poems.json" || stop_extraction "Bluesky extraction"
else
    echo "ℹ️  No Bluesky CAR files found in input/bluesky/"
fi

# Preserve media attachments before cleanup
echo "🖼️  Preserving media attachments..."
MEDIA_DEST="${DIR}/input/media_attachments"
if [ -d "${TEMP_EXTRACT_DIR}/fediverse/extract/media_attachments" ]; then
    mkdir -p "${MEDIA_DEST}"
    # This line used to end "2>/dev/null || true", discarding every error,
    # because two ordinary situations made cp fail: an empty folder (with
    # "/*") and a file already preserved by an earlier run (with -n, which in
    # coreutils 9 exits 1 for each file it does not replace). Discarding those
    # also discarded real failures -- a full disk, a permission problem.
    # "/." copies the contents and copies nothing, successfully, from an empty
    # folder; --update=none skips files already there and still exits 0. So
    # any failure left is a real one, and stops the update.
    cp -r --update=none "${TEMP_EXTRACT_DIR}/fediverse/extract/media_attachments/." "${MEDIA_DEST}/" || stop_extraction "preserving media attachments"
    MEDIA_COUNT=$(find "${MEDIA_DEST}" -type f \( -name "*.png" -o -name "*.jpg" -o -name "*.jpeg" -o -name "*.gif" -o -name "*.webp" \) | wc -l)
    echo "   📷 Preserved ${MEDIA_COUNT} media files to ./${MEDIA_DEST#${DIR}/}"
fi

# Cleanup temporary files
echo "✂ Cleaning up temporary extraction files..."
rm -rf "${TEMP_EXTRACT_DIR}"

echo "✅ Content extraction complete"
echo "   📄 JSON files generated from ZIP archives for HTML pipeline"

