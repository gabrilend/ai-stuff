#!/usr/bin/env luajit
-- check-table-of-contents
--
-- Checks docs/table-of-contents.md against the files it is meant to list.
--
-- In general terms: it reads every path the table of contents writes in
-- backticks (`/docs/roadmap.md`) and checks each one exists, then lists every
-- tracked file under docs/ and notes/ that the table of contents never
-- mentions. The first kind of finding is a reader following a link to
-- nothing; the second is a document nobody can find.
--
-- Why it exists: on 2026-10-04 more than half the paths in the table of
-- contents (56 of 125) named files that had moved or been deleted, mostly a
-- long per-issue listing from when issues lived in phase-N/ folders, and
-- several documents in docs/ and notes/ were not listed at all.
--
-- Usage:
--   scripts/check-table-of-contents [DIR]
--
-- Exit status: 0 everything listed exists and every doc is listed, 1 not.

-- --help: print the header above and exit, before any work (libs/script-help.lua)
dofile((debug.getinfo(1, "S").source:sub(2):match("(.*/)") or "./") .. "../libs/script-help.lua").handle(arg)
-- the project's libraries, for the logged print (libs/output.lua, Issue 10-075)
package.path = (debug.getinfo(1, "S").source:sub(2):match("(.*/)") or "./") .. "../libs/?.lua;" .. package.path

-- {{{ local DIR
local DIR = "/mnt/mtwo/programming/ai-stuff/neocities-modernization"
-- }}}

-- {{{ local listed_folders
-- Tracked files under these folders must each appear in the table of contents.
-- A folder written in the table of contents ("/docs/Some_files/") covers
-- everything inside it, for pages saved with their supporting files.
local listed_folders = { "^docs/", "^notes/" }
-- }}}

-- {{{ local function read_file
local function read_file(path)
    local f = io.open(path, "r")
    if not f then
        return nil
    end
    local content = f:read("*a")
    f:close()
    return content
end
-- }}}

-- {{{ local function exists
local function exists(path)
    local f = io.open(path, "r")
    if f then
        f:close()
        return true
    end
    return false
end
-- }}}

-- {{{ local function main
local function main()
    for _, a in ipairs(arg) do
        if not a:match("^%-") then
            DIR = a
        else
            io.stderr:write("unknown option: " .. a .. "\n")
            os.exit(2)
        end
    end

    local toc_path = DIR .. "/docs/table-of-contents.md"
    local toc = read_file(toc_path)
    if not toc then
        io.stderr:write("no table of contents at " .. toc_path .. "\n")
        os.exit(2)
    end

    -- every backticked absolute path: "/docs/x.md" -> "docs/x.md"
    local listed, findings = {}, {}
    for path in toc:gmatch("`/([^`]+)`") do
        -- a command written in backticks ("/path/tool <project> -m") is not a
        -- path; a path with spaces still ends in an extension or a slash
        local is_path = not path:find(" ") or path:match("%.%w+$") or path:match("/$")
        if is_path then
            listed[path] = true
        end
        if is_path and not exists(DIR .. "/" .. path) then
            findings[#findings + 1] = "missing   /" .. path
        end
    end

    -- every tracked doc or note the table of contents does not name, itself
    -- or through a listed folder that contains it
    local pipe = assert(io.popen(string.format("git -C %q ls-files", DIR)))
    for rel in pipe:lines() do
        local in_scope = false
        for _, pattern in ipairs(listed_folders) do
            in_scope = in_scope or rel:match(pattern) ~= nil
        end
        if in_scope and rel ~= "docs/table-of-contents.md" and not listed[rel] then
            local covered = false
            for path in pairs(listed) do
                if path:sub(-1) == "/" and rel:sub(1, #path) == path then
                    covered = true
                    break
                end
            end
            if not covered then
                findings[#findings + 1] = "unlisted  /" .. rel
            end
        end
    end
    pipe:close()

    table.sort(findings)
    for _, finding in ipairs(findings) do
        require("output").print(finding)
    end
    require("output").print(#findings .. " finding(s)")
    os.exit(#findings > 0 and 1 or 0)
end
-- }}}

main()
