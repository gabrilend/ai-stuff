#!/usr/bin/env luajit
-- check-folder-flags
--
-- WHAT IT DOES (for a CEO): every program in the project must learn where
-- the project is from one flag, --dir PATH, read by the shared reader
-- (libs/project-dir.lua, or libs/project-dir.sh for shell scripts), which
-- also stops the program on a stray word. This lists every program that
-- does not, so none slips back to the old way -- the old way turned a
-- mistyped flag's value into the project folder (Issue 10-076). It changes
-- nothing.
--
-- What counts as a program (the execute bit is not a reliable sign here):
--   scripts/*             (not .md / .info files)
--   *.sh                  at the project root
--   src/*.lua, libs/*.lua with a "#!" first line
--   src/libs tests        (*.test.lua, *-test.lua)
-- A program passes when its text names "project-dir.lua" or
-- "project-dir.sh". One that takes no project folder at all -- a library
-- that is sourced or loaded rather than run, say -- passes with a comment
-- containing "project-dir: none" and the reason; one that reads --dir and
-- refuses stray words with a parser of its own (run.sh, whose parser also
-- checks every value) passes with "project-dir: own" and the reason. Both
-- kinds are printed, so each stays visible.
--
-- Usage:
--   scripts/check-folder-flags [--dir PATH] [--list-programs]
--     --list-programs  print every program it would check, one per line, and
--                      nothing else (scripts/write-info-notes --missing uses it)
-- Exit status: 0 when every program passes, 1 otherwise.

-- --help: print the header above and exit, before any work (libs/script-help.lua)
local here = (debug.getinfo(1, "S").source:sub(2):match("(.*/)") or "./")
dofile(here .. "../libs/script-help.lua").handle(arg)
local DIR, OWN_ARGS = dofile(here .. "../libs/project-dir.lua")
    .read(arg, "/mnt/mtwo/programming/ai-stuff/neocities-modernization")
local LIST_ONLY = false
for _, a in ipairs(OWN_ARGS) do
    if a == "--list-programs" then LIST_ONLY = true
    else io.stderr:write("check-folder-flags: unknown option " .. a .. "\n"); os.exit(1) end
end

-- {{{ local function lines_of()
-- The output of a shell command, one string per line.
local function lines_of(command)
    local p = assert(io.popen(command))
    local out = {}
    for line in p:lines() do out[#out + 1] = line end
    p:close()
    return out
end
-- }}}

-- {{{ local function slurp()
local function slurp(path)
    local f = io.open(path, "rb")
    if not f then return nil end
    local s = f:read("*a")
    f:close()
    return s
end
-- }}}

-- {{{ local function programs()
-- Every program, as paths relative to DIR, sorted.
local function programs()
    local found, seen = {}, {}
    local function add(rel)
        if not seen[rel] then seen[rel] = true; found[#found + 1] = rel end
    end
    for _, rel in ipairs(lines_of(string.format(
            "cd %q && find scripts -maxdepth 1 -type f ! -name '*.md' ! -name '*.info' | sort", DIR))) do
        add(rel)
    end
    for _, rel in ipairs(lines_of(string.format("cd %q && find . -maxdepth 1 -type f -name '*.sh' -printf '%%P\\n' | sort", DIR))) do
        add(rel)
    end
    for _, rel in ipairs(lines_of(string.format(
            "cd %q && find src libs -maxdepth 1 -type f -name '*.lua' | sort", DIR))) do
        local text = slurp(DIR .. "/" .. rel) or ""
        local is_test = rel:match("%.test%.lua$") or rel:match("%-test%.lua$")
        if is_test or text:sub(1, 2) == "#!" then add(rel) end
    end
    table.sort(found)
    return found
end
-- }}}

-- {{{ main
if LIST_ONLY then
    for _, rel in ipairs(programs()) do print(rel) end
    os.exit(0)
end
local failing, exempt, own, passing = {}, {}, {}, 0
for _, rel in ipairs(programs()) do
    local text = slurp(DIR .. "/" .. rel) or ""
    -- the reader itself, and anything that names it, passes; an exemption or
    -- a parser of its own is listed with its reason
    local none_reason = text:match("project%-dir: none%s*%-*%s*([^\n]*)")
    local own_reason = text:match("project%-dir: own%s*%-*%s*([^\n]*)")
    -- a CALL to the reader, not a mention of it in a comment: the Lua reader
    -- loaded by path and its read or read_if_run called, or the shell
    -- reader's function called
    local calls_lua = text:find("project%-dir%.lua\"%)%s*%.read")
    local calls_sh = text:find("\nproject_dir_read ", 1, true) or text:find("%sproject_dir_read \"")
    if calls_lua or calls_sh then
        passing = passing + 1
    elseif own_reason then
        own[#own + 1] = rel .. "  -- " .. own_reason
    elseif none_reason then
        exempt[#exempt + 1] = rel .. "  -- " .. none_reason
    else
        failing[#failing + 1] = rel
    end
end

print(string.format("check-folder-flags: %d programs read --dir through the shared reader, %d with a parser of their own, %d exempt, %d do neither",
    passing, #own, #exempt, #failing))
if #own > 0 then
    print("read --dir and refuse stray words with their own parser:")
    for _, line in ipairs(own) do print("  " .. line) end
end
if #exempt > 0 then
    print("exempt (take no project folder):")
    for _, line in ipairs(exempt) do print("  " .. line) end
end
if #failing > 0 then
    print("not using the shared reader (libs/project-dir.lua / .sh):")
    for _, rel in ipairs(failing) do print("  " .. rel) end
end
os.exit(#failing == 0 and 0 or 1)
-- }}}
