#!/usr/bin/env luajit
-- renumber-diversity-cache
--
-- WHAT IT DOES (for a CEO): the "different" pages are built from a stored
-- list, for every poem, of the poems most unlike it. Until 2026-10-21 that
-- list was stored by position in the embeddings file (counting from 0)
-- while the pages read it as poem numbers (counting from 1), so every
-- "different" page showed the wrong poem's list, each entry one off. The
-- generator is fixed; this repairs a list made before the fix without the
-- ~50 minutes on the GPU it takes to make a new one: each position is
-- replaced by the poem number stored at that position. (Issue 8-019.)
--
-- Usage: scripts/renumber-diversity-cache [DIR] --model NAME
--   DIR     project directory (default below)
--   --model the embedding model whose cache to repair (no default)
--
-- The original is kept in RAM (tmp/shared-memory/diversity_cache.positions.json)
-- until the next logout. A cache already marked as poem numbers is left alone.
-- It must be repaired against the same embeddings file it was made from: the
-- tool checks that the counts match and that every list starts with its own
-- position, and stops otherwise.

-- {{{ arguments
local DIR = "/mnt/mtwo/programming/ai-stuff/neocities-modernization"
local MODEL
do
    local i = 1
    while i <= #arg do
        if arg[i] == "--model" then MODEL = arg[i + 1]; i = i + 1
        elseif arg[i]:sub(1, 2) == "--" then error("renumber-diversity-cache: unknown option " .. arg[i])
        else DIR = arg[i] end
        i = i + 1
    end
end
if not MODEL then error("renumber-diversity-cache: --model NAME is required (there is no default model)") end
-- }}}

package.path = DIR .. "/libs/?.lua;" .. package.path
local utils = require("utils")
local json = require("dkjson")
utils.init_assets_root({ DIR })

local cache_file = utils.embeddings_dir_disk(MODEL) .. "/diversity_cache.json"
local embeddings_file = utils.embeddings_dir(MODEL) .. "/embeddings.json"
local cache = utils.read_json_file(cache_file) or error("cannot read " .. cache_file)
if cache.metadata and cache.metadata.numbering == "poem_index" then
    print("already in poem numbers: " .. cache_file)
    os.exit(0)
end
local embeddings = utils.read_json_file(embeddings_file) or error("cannot read " .. embeddings_file)

-- {{{ position -> poem number, from the embeddings file
local numbers = {}
for i, entry in ipairs(embeddings.embeddings) do
    numbers[i - 1] = entry.poem_index or error("embedding entry " .. i .. " has no poem_index")
end
local count = #embeddings.embeddings
-- }}}

-- {{{ check the cache was made from this embeddings file
local lists = 0
for key, list in pairs(cache.sequences) do
    lists = lists + 1
    local position = tonumber(key)
    if not position or position < 0 or position >= count then
        error(string.format("key %s is not a position in the %d embeddings: not a positions cache, or a different file", key, count))
    end
    if list[1] ~= position then
        error(string.format("the list at position %d does not start with itself: not the cache this tool repairs", position))
    end
end
if lists ~= count then
    error(string.format("%d lists for %d embeddings: the cache was made from a different embeddings file", lists, count))
end
-- }}}

-- keep the original in RAM, then rewrite
local backup = DIR .. "/tmp/shared-memory/diversity_cache.positions.json"
os.execute("mkdir -p " .. string.format("%q", DIR .. "/tmp/shared-memory"))
assert(utils.write_file(backup, json.encode(cache, { indent = false })), "could not write the backup " .. backup)

local renumbered = {}
for key, list in pairs(cache.sequences) do
    local out = {}
    for i, position in ipairs(list) do
        out[i] = numbers[position] or error("position " .. tostring(position) .. " is outside the embeddings")
    end
    renumbered[tostring(numbers[tonumber(key)])] = out
end
cache.sequences = renumbered
cache.metadata = cache.metadata or {}
cache.metadata.numbering = "poem_index"
cache.metadata.renumbered_at = os.date("%Y-%m-%d %H:%M:%S")
assert(utils.write_file(cache_file, json.encode(cache, { indent = false })), "could not write " .. cache_file)
print(string.format("renumbered %d lists in %s (original kept in %s)", lists, cache_file, backup))
