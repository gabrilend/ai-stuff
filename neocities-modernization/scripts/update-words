#!/bin/bash
# Syncs words/notes/images from backup locations to project input directory
# Preserves generated poems.json files to avoid redundant extraction
#
# Issue 8-042: Added configurable image sync from config.lua
# Issue 10-014: Migrated from input-sources.json to unified config.lua
#
# The external sync-to-projects script does rm -rf input/, which would delete
# the generated files that scripts/update creates. We preserve and restore them
# so the freshness check works correctly.

set -euo pipefail

DIR="${1:-/mnt/mtwo/programming/ai-stuff/neocities-modernization}"
BACKUP_DIR="${DIR}/temp/preserved-files-$$"
CONFIG_FILE="${DIR}/config.lua"

# {{{ get_config_value
# Helper function to read values from config.lua using inline Lua
# Usage: get_config_value "image_sync.enabled"
# Returns the value as a string (true/false for booleans, strings as-is)
get_config_value() {
    local key_path="$1"
    lua -e "
        local config = dofile('${DIR}/config.lua')
        local keys = {}
        for k in string.gmatch('${key_path}', '[^.]+') do
            table.insert(keys, k)
        end
        local value = config
        for _, k in ipairs(keys) do
            if type(value) ~= 'table' then
                print('nil')
                return
            end
            value = value[k]
        end
        if value == nil then
            print('nil')
        elseif type(value) == 'boolean' then
            print(value and 'true' or 'false')
        else
            print(tostring(value))
        end
    " 2>/dev/null || echo "nil"
}
# }}}

# {{{ get_config_array_length
# Get the length of a config array
get_config_array_length() {
    local key_path="$1"
    lua -e "
        local config = dofile('${DIR}/config.lua')
        local keys = {}
        for k in string.gmatch('${key_path}', '[^.]+') do
            table.insert(keys, k)
        end
        local value = config
        for _, k in ipairs(keys) do
            if type(value) ~= 'table' then
                print('0')
                return
            end
            value = value[k]
        end
        if type(value) == 'table' then
            print(#value)
        else
            print('0')
        end
    " 2>/dev/null || echo "0"
}
# }}}

# {{{ get_config_array_item
# Get an item from a config array (1-indexed)
# Usage: get_config_array_item "image_sync.sources" 1 "name"
get_config_array_item() {
    local key_path="$1"
    local index="$2"
    local field="$3"
    lua -e "
        local config = dofile('${DIR}/config.lua')
        local keys = {}
        for k in string.gmatch('${key_path}', '[^.]+') do
            table.insert(keys, k)
        end
        local value = config
        for _, k in ipairs(keys) do
            if type(value) ~= 'table' then
                print('')
                return
            end
            value = value[k]
        end
        if type(value) == 'table' and value[${index}] then
            local item = value[${index}]['${field}']
            if item then
                print(tostring(item))
            else
                print('')
            end
        else
            print('')
        end
    " 2>/dev/null || echo ""
}
# }}}

# {{{ preserve_generated_files
# Back up generated files before sync (they get deleted by rm -rf input/)
preserve_generated_files() {
    local preserved=0
    mkdir -p "${BACKUP_DIR}"

    for subdir in fediverse messages notes; do
        local files_dir="${DIR}/input/${subdir}/files"
        if [ -d "${files_dir}" ]; then
            mkdir -p "${BACKUP_DIR}/${subdir}"
            cp -a "${files_dir}" "${BACKUP_DIR}/${subdir}/"
            preserved=$((preserved + 1))
        fi
    done

    if [ $preserved -gt 0 ]; then
        echo "   💾 Preserved ${preserved} generated file directories"
    fi
}
# }}}

# {{{ restore_generated_files
# Restore generated files after sync
restore_generated_files() {
    local restored=0

    for subdir in fediverse messages notes; do
        local backup_files="${BACKUP_DIR}/${subdir}/files"
        if [ -d "${backup_files}" ]; then
            mkdir -p "${DIR}/input/${subdir}"
            cp -a "${backup_files}" "${DIR}/input/${subdir}/"
            restored=$((restored + 1))
        fi
    done

    # Cleanup backup directory
    rm -rf "${BACKUP_DIR}"

    if [ $restored -gt 0 ]; then
        echo "   ♻️  Restored ${restored} generated file directories"
    fi
}
# }}}

# {{{ sync_images_from_config
# Issue 8-042: Sync images from configurable source directories
# Issue 10-014: Migrated from jq/JSON to inline Lua config reading
sync_images_from_config() {
    # Check if config file exists
    if [ ! -f "${CONFIG_FILE}" ]; then
        echo "   ⚠️  Config file not found: ${CONFIG_FILE}"
        return 0
    fi

    # Check if image_sync is enabled (using Lua helper)
    local enabled
    enabled=$(get_config_value "image_sync.enabled")
    if [ "${enabled}" != "true" ]; then
        echo "   📷 Image sync disabled in config"
        return 0
    fi

    # Get destination directory
    local destination
    destination=$(get_config_value "image_sync.destination")
    if [ "${destination}" == "nil" ] || [ -z "${destination}" ]; then
        destination="input/media_attachments"
    fi
    local dest_path="${DIR}/${destination}"

    # Get sync options
    local preserve_structure overwrite_existing
    preserve_structure=$(get_config_value "image_sync.preserve_structure")
    overwrite_existing=$(get_config_value "image_sync.overwrite_existing")

    # Default to true/false if not set
    if [ "${preserve_structure}" == "nil" ]; then
        preserve_structure="true"
    fi
    if [ "${overwrite_existing}" == "nil" ]; then
        overwrite_existing="false"
    fi

    # Get number of sources
    local num_sources
    num_sources=$(get_config_array_length "image_sync.sources")

    if [ "${num_sources}" -eq 0 ]; then
        echo "   📷 No image sources configured"
        return 0
    fi

    echo "   📷 Syncing images from ${num_sources} configured source(s)..."

    # Ensure destination exists
    mkdir -p "${dest_path}"

    local total_synced=0

    # Iterate over sources (1-indexed for Lua)
    for i in $(seq 1 "${num_sources}"); do
        local source_name source_path
        source_name=$(get_config_array_item "image_sync.sources" "${i}" "name")
        source_path=$(get_config_array_item "image_sync.sources" "${i}" "path")

        if [ ! -d "${source_path}" ]; then
            echo "      ⚠️  ${source_name}: source not found (${source_path})"
            continue
        fi

        # Build rsync options
        local rsync_opts="-a"
        if [ "${overwrite_existing}" != "true" ]; then
            rsync_opts="${rsync_opts} --ignore-existing"
        fi

        # Count files before sync
        local files_before
        files_before=$(find "${dest_path}" -type f 2>/dev/null | wc -l)

        # Sync files
        if [ "${preserve_structure}" == "true" ]; then
            rsync ${rsync_opts} "${source_path}/" "${dest_path}/" 2>/dev/null || true
        else
            # Flatten structure (not recommended for media_attachments)
            find "${source_path}" -type f -exec cp -n {} "${dest_path}/" \; 2>/dev/null || true
        fi

        # Count files after sync
        local files_after
        files_after=$(find "${dest_path}" -type f 2>/dev/null | wc -l)
        local files_synced=$((files_after - files_before))

        if [ ${files_synced} -gt 0 ]; then
            echo "      ✓ ${source_name}: ${files_synced} files synced"
            total_synced=$((total_synced + files_synced))
        else
            echo "      ✓ ${source_name}: up to date"
        fi
    done

    if [ ${total_synced} -gt 0 ]; then
        echo "   📷 Total: ${total_synced} new files synced to ${destination}"
    fi
}
# }}}

# {{{ main
# Preserve generated files before the destructive sync
preserve_generated_files

# Run the external sync script (does rm -rf input/)
/home/ritz/backups/words/sync-to-projects > /dev/null 2>&1

# Restore preserved files
restore_generated_files

# Issue 8-042: Sync images from configured sources
sync_images_from_config

# Remove unwanted ZIP files that get synced but aren't content archives
rm -f "${DIR}/input/images/poem-pictures/neocities-ritz-menardi.zip"
# }}}
