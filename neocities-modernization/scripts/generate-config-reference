#!/usr/bin/env luajit
-- generate-config-reference
--
-- Writes the "Section Reference" part of docs/config-reference.md from
-- config.lua itself, so the reference cannot fall behind the file it describes.
--
-- In general terms: config.lua already explains every section in the comment
-- above it and most settings in a comment beside them. This tool reads those
-- comments, loads the file the way the pipeline does to get each setting's
-- current value, and lays the two out as one heading and one table per
-- section. Only the part of the doc between the two marker lines below is
-- replaced; everything else in the doc (the hand-written how-to guide) is left
-- exactly as it is.
--
-- The hand-written reference this replaced was written once (Issue 10-019,
-- April 2026) and never updated. Six months later it described a section that
-- no longer existed (golden_poems), used an old name for another
-- (ollama_servers), listed settings nothing read, and was missing seven
-- sections entirely. A copy kept by hand has no mechanism that makes it wrong
-- loudly; a generated one is right by construction.
--
-- Usage:
--   scripts/generate-config-reference [DIR]           rewrite the doc
--   scripts/generate-config-reference [DIR] --check   exit 1 if the doc is out
--                                                     of date; change nothing
--
-- Exit status: 0 written (or up to date), 1 --check found it out of date,
-- 2 config.lua or the doc's markers are missing.

-- {{{ local DIR
local DIR = "/mnt/mtwo/programming/ai-stuff/neocities-modernization"
-- }}}

-- {{{ local markers
-- The doc's generated region sits between these two lines. Both must be
-- present; a doc without them is refused rather than overwritten whole.
local BEGIN_MARKER = "<!-- BEGIN section reference: generated by scripts/generate-config-reference; edit config.lua's comments, not this -->"
local END_MARKER = "<!-- END section reference -->"
-- }}}

-- {{{ local function read_file
local function read_file(path)
    local f = io.open(path, "r")
    if not f then
        return nil
    end
    local content = f:read("*a")
    f:close()
    return content
end
-- }}}

-- {{{ local function split_lines
local function split_lines(text)
    local lines = {}
    for line in (text .. "\n"):gmatch("([^\n]*)\n") do
        lines[#lines + 1] = line
    end
    return lines
end
-- }}}

-- {{{ local function comment_block_above
-- The run of comment lines directly above line `at` at the given indentation,
-- top to bottom, with the comment marker removed. Fold markers ("{{{", "}}}")
-- are skipped; a blank line or code ends the run. Returns a list of strings
-- (an empty string stands for a blank comment line, i.e. a paragraph break).
local function comment_block_above(lines, at, indent)
    local block = {}
    local i = at - 1
    while i >= 1 do
        local text = lines[i]:match("^" .. indent .. "%-%-%s?(.*)$")
        if not text then
            break
        end
        if not text:match("{{{") and not text:match("}}}") then
            table.insert(block, 1, text)
        end
        i = i - 1
    end
    return block
end
-- }}}

-- {{{ local function render_value
-- A setting's current value, short enough for a table cell.
local value_renderers = {
    string = function(v) return string.format("%q", v) end,
    number = function(v) return tostring(v) end,
    boolean = function(v) return tostring(v) end,
    table = function(v)
        local count, list = 0, #v > 0
        for _ in pairs(v) do
            count = count + 1
        end
        if list then
            return "list of " .. count
        end
        return "table of " .. count
    end,
}
local function render_value(v)
    local renderer = value_renderers[type(v)]
    return renderer and renderer(v) or type(v)
end
-- }}}

-- {{{ local function cell
-- Text made safe for one Markdown table cell.
local function cell(text)
    return (text:gsub("|", "\\|"):gsub("%s+$", ""))
end
-- }}}

-- {{{ local function paragraphs
-- Comment lines as Markdown: consecutive lines join into one paragraph; a
-- blank comment line, or a line that starts an indented sub-list, begins a new
-- line. Indented lines are kept as they are, since they are usually aligned
-- examples.
local function paragraphs(block)
    local out, current = {}, {}
    local function flush()
        if #current > 0 then
            out[#out + 1] = table.concat(current, " ")
            current = {}
        end
    end
    for _, line in ipairs(block) do
        if line == "" then
            flush()
            out[#out + 1] = ""
        elseif line:match("^%s") then
            flush()
            out[#out + 1] = "    " .. line
        else
            current[#current + 1] = line
        end
    end
    flush()
    return table.concat(out, "\n")
end
-- }}}

-- {{{ local function section_lines
-- Where each top-level section opens in config.lua: { [name] = line number }
-- and the names in file order. A section opens at four spaces of indentation.
local function section_lines(lines)
    local at, order = {}, {}
    for i, line in ipairs(lines) do
        local name = line:match("^    ([%a_][%w_]*)%s*=")
        if name and not at[name] then
            at[name] = i
            order[#order + 1] = name
        end
    end
    return at, order
end
-- }}}

-- {{{ local function setting_note
-- The comment for a setting inside a section: the comment beside it on its own
-- line, else the comment block directly above it. Searched between the
-- section's first line and the next section's.
local function setting_note(lines, first, last, key)
    local escaped = key:gsub("%p", "%%%0")
    for i = first + 1, last - 1 do
        local indent = lines[i]:match("^(%s+)" .. escaped .. "%s*=")
        if indent and #indent == 8 then
            local beside = lines[i]:match("%-%-%s*(.-)%s*$")
            if beside and beside ~= "" then
                return beside
            end
            local above = comment_block_above(lines, i, indent)
            return table.concat(above, " ")
        end
    end
    return ""
end
-- }}}

-- {{{ local function sorted_keys
local function sorted_keys(t)
    local keys = {}
    for k in pairs(t) do
        if type(k) == "string" then
            keys[#keys + 1] = k
        end
    end
    table.sort(keys)
    return keys
end
-- }}}

-- {{{ local function build_reference
-- The generated Markdown for every section, in config.lua's own order.
local function build_reference(config, lines)
    local at, order = section_lines(lines)
    local out = {
        "## Section Reference",
        "",
        "Generated from `config.lua`. Each section's text is the comment above it",
        "in that file; each value is what the file holds now. To change the text,",
        "edit the comment in `config.lua` and run `scripts/generate-config-reference`.",
        "To find settings that nothing reads, run `scripts/audit-config-keys`.",
        "",
    }
    for index, name in ipairs(order) do
        local value = config[name]
        local first = at[name]
        local last = order[index + 1] and at[order[index + 1]] or #lines
        out[#out + 1] = "### " .. name
        out[#out + 1] = ""
        local description = paragraphs(comment_block_above(lines, first, "    "))
        if description ~= "" then
            out[#out + 1] = description
            out[#out + 1] = ""
        end
        -- a table of named settings gets a row per setting; a list or a single
        -- value is shown whole
        local keys = type(value) == "table" and sorted_keys(value) or {}
        if #keys > 0 then
            out[#out + 1] = "| Setting | Current value | Note |"
            out[#out + 1] = "|---|---|---|"
            for _, key in ipairs(keys) do
                out[#out + 1] = string.format("| `%s` | %s | %s |", key,
                    cell(render_value(value[key])), cell(setting_note(lines, first, last, key)))
            end
        else
            out[#out + 1] = "Current value: " .. render_value(value)
        end
        out[#out + 1] = ""
    end
    return table.concat(out, "\n")
end
-- }}}

-- {{{ local function main
local function main()
    local check_only = false
    for _, a in ipairs(arg) do
        -- --check compares instead of writing; a bare word is the project dir
        if a == "--check" then
            check_only = true
        elseif not a:match("^%-") then
            DIR = a
        else
            io.stderr:write("unknown option: " .. a .. "\n")
            os.exit(2)
        end
    end

    local config_path = DIR .. "/config.lua"
    local doc_path = DIR .. "/docs/config-reference.md"
    local ok, config = pcall(dofile, config_path)
    if not ok or type(config) ~= "table" then
        io.stderr:write("could not load " .. config_path .. ": " .. tostring(config) .. "\n")
        os.exit(2)
    end
    local doc = read_file(doc_path)
    local begin_at = doc and doc:find(BEGIN_MARKER, 1, true)
    local end_at = doc and doc:find(END_MARKER, 1, true)
    if not begin_at or not end_at or end_at < begin_at then
        io.stderr:write(doc_path .. " lacks the generated-region markers:\n  "
            .. BEGIN_MARKER .. "\n  " .. END_MARKER .. "\n")
        os.exit(2)
    end

    local reference = build_reference(config, split_lines(read_file(config_path)))
    local updated = doc:sub(1, begin_at - 1) .. BEGIN_MARKER .. "\n\n"
        .. reference .. "\n" .. doc:sub(end_at)

    -- --check: report, change nothing
    if check_only then
        if updated == doc then
            print("docs/config-reference.md is up to date")
            os.exit(0)
        end
        print("docs/config-reference.md is out of date; run scripts/generate-config-reference")
        os.exit(1)
    end

    local f = assert(io.open(doc_path, "w"))
    f:write(updated)
    f:close()
    print("wrote the section reference into " .. doc_path)
end
-- }}}

main()
