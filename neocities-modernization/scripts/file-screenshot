#!/usr/bin/env luajit
-- file-screenshot
--
-- WHAT IT DOES (for a CEO): every picture the project takes of itself is
-- kept, in order, in development-history/, so the folder reads as the
-- project's history one picture at a time -- the mistakes too. This files
-- one picture: it copies it in under the next number (001-name.png,
-- 002-name.png, ...) and writes a notes file beside it (001-name.info.md)
-- saying what made it (the commit, the command or settings given), and what
-- changed since the previous picture (which source files differ, and the
-- config.lua lines before and after). Two sections are left for a person to
-- write: what the picture shows, part by part, and the story so far.
--
-- How it knows what changed: beside each picture it keeps a fingerprint of
-- the tracked source (one md5 per file of src/, libs/, scripts/ and
-- config.lua, NNN-name.fingerprint), and compares it with the previous
-- picture's. config.lua's own text is kept in the fingerprint file too, so
-- the changed settings lines can be shown.
--
-- Usage: scripts/file-screenshot [--dir PATH] --picture FILE --name NAME [--made-by TEXT]
--   --dir PATH      project folder (default below)
--   --picture FILE  the image to file (it is copied; the original is left)
--   --name NAME     a short dash-separated name: phone-390-similar-page
--   --made-by TEXT  how the picture was made (a command, the settings), quoted
--   A word with no flag in front of it stops the script (Issue 10-076). The
--   picture and name were bare words, and a third one in front was the folder.

-- --help: print the header above and exit, before any work (libs/script-help.lua)
dofile((debug.getinfo(1, "S").source:sub(2):match("(.*/)") or "./") .. "../libs/script-help.lua").handle(arg)

-- The project folder: --dir PATH, or the path below; a stray word stops the
-- script (libs/project-dir.lua, Issue 10-076).
local DIR, OWN_ARGS = dofile((debug.getinfo(1, "S").source:sub(2):match("(.*/)") or "./") .. "../libs/project-dir.lua")
    .read(arg, "/mnt/mtwo/programming/ai-stuff/neocities-modernization",
        { ["--picture"] = true, ["--name"] = true, ["--made-by"] = true })
local PICTURE, NAME, made_by = nil, nil, nil
do
    local i = 1
    while OWN_ARGS[i] do
        local a = OWN_ARGS[i]
        if a == "--made-by" then made_by = OWN_ARGS[i + 1]; i = i + 2
        elseif a == "--picture" then PICTURE = OWN_ARGS[i + 1]; i = i + 2
        elseif a == "--name" then NAME = OWN_ARGS[i + 1]; i = i + 2
        else
            io.stderr:write("file-screenshot: unknown option " .. a .. "\n")
            os.exit(1)
        end
    end
end
if not PICTURE or not NAME then
    io.stderr:write("usage: scripts/file-screenshot [--dir PATH] --picture FILE --name NAME [--made-by TEXT]\n")
    os.exit(1)
end
if not NAME:match("^[%w%-]+$") then
    io.stderr:write("file-screenshot: NAME takes letters, digits and dashes only, got '" .. NAME .. "'\n")
    os.exit(1)
end
local HISTORY = DIR .. "/development-history"

-- {{{ local function shell_quote()
local function shell_quote(s) return "'" .. tostring(s):gsub("'", "'\\''") .. "'" end
-- }}}

-- {{{ local function read_command()
local function read_command(cmd)
    local p = assert(io.popen(cmd))
    local out = p:read("*a")
    p:close()
    return out
end
-- }}}

-- {{{ local function fingerprint()
-- { [path] = md5 } for the tracked source, and config.lua's text.
local function fingerprint()
    local list = read_command(string.format("git -C %s ls-files -- src libs scripts config.lua", shell_quote(DIR)))
    local paths = {}
    for p in list:gmatch("[^\n]+") do
        if not p:match("^libs/[^/]+/") or p:match("^libs/vulkan%-compute/") then paths[#paths + 1] = p end
    end
    local sums = {}
    if #paths > 0 then
        local listfile = os.tmpname()
        local f = assert(io.open(listfile, "w"))
        for _, p in ipairs(paths) do f:write(DIR, "/", p, "\0") end
        f:close()
        local out = read_command(string.format("xargs -0 md5sum -z < %s", shell_quote(listfile)))
        os.remove(listfile)
        for hash, path in out:gmatch("(%x+)  (%Z+)%z") do sums[path:sub(#DIR + 2)] = hash end
    end
    local cf = io.open(DIR .. "/config.lua", "r")
    local config_text = cf and cf:read("*a") or ""
    if cf then cf:close() end
    return sums, config_text
end
-- }}}

-- {{{ local function write_fingerprint() / read_fingerprint()
-- The file: "md5<TAB>path" lines, a line "== config.lua ==", then config.lua.
local function write_fingerprint(path, sums, config_text)
    local f = assert(io.open(path, "w"))
    local keys = {}
    for k in pairs(sums) do keys[#keys + 1] = k end
    table.sort(keys)
    for _, k in ipairs(keys) do f:write(sums[k], "\t", k, "\n") end
    f:write("== config.lua ==\n", config_text)
    f:close()
end
local function read_fingerprint(path)
    local f = io.open(path, "r")
    if not f then return nil end
    local s = f:read("*a")
    f:close()
    local head, config_text = s:match("^(.-)== config%.lua ==\n(.*)$")
    local sums = {}
    for hash, p in (head or s):gmatch("(%x+)\t([^\n]+)") do sums[p] = hash end
    return sums, config_text or ""
end
-- }}}

-- {{{ local function config_changes()
-- Lines of config.lua that left (-) and arrived (+), by a plain line set
-- comparison (enough for "the settings lines before and after").
local function config_changes(before, after)
    local function set(text) local s, list = {}, {}; for l in (text .. "\n"):gmatch("(.-)\n") do s[l] = (s[l] or 0) + 1; list[#list + 1] = l end; return s, list end
    local bs, bl = set(before)
    local as, al = set(after)
    local out = {}
    for _, l in ipairs(bl) do if not as[l] and l:match("%S") then out[#out + 1] = "- " .. l end end
    for _, l in ipairs(al) do if not bs[l] and l:match("%S") then out[#out + 1] = "+ " .. l end end
    return out
end
-- }}}

-- the next number, and the previous picture's fingerprint
os.execute("mkdir -p " .. shell_quote(HISTORY))
local highest, previous = 0, nil
for entry in read_command("ls " .. shell_quote(HISTORY)):gmatch("[^\n]+") do
    local n, base = entry:match("^(%d%d%d)%-(.-)%.fingerprint$")
    if n and tonumber(n) > highest then highest, previous = tonumber(n), entry end
end
local number = string.format("%03d", highest + 1)
local stem = HISTORY .. "/" .. number .. "-" .. NAME
local ext = PICTURE:match("%.(%w+)$") or "png"

-- the picture
local copied = os.execute(string.format("cp %s %s", shell_quote(PICTURE), shell_quote(stem .. "." .. ext)))
if copied ~= 0 and copied ~= true then
    io.stderr:write("file-screenshot: could not copy " .. PICTURE .. "\n")
    os.exit(1)
end

-- the fingerprint, and what changed since the previous one
local sums, config_text = fingerprint()
write_fingerprint(stem .. ".fingerprint", sums, config_text)
local changed_lines = {}
if previous then
    local old, old_config = read_fingerprint(HISTORY .. "/" .. previous)
    local changed = {}
    for p, h in pairs(sums) do if old[p] ~= h then changed[#changed + 1] = (old[p] and "changed " or "new     ") .. p end end
    for p in pairs(old) do if not sums[p] then changed[#changed + 1] = "removed " .. p end end
    table.sort(changed)
    changed_lines[#changed_lines + 1] = "Since " .. previous:gsub("%.fingerprint$", "") .. ":"
    changed_lines[#changed_lines + 1] = ""
    if #changed == 0 then changed_lines[#changed_lines + 1] = "- no source file changed" end
    for _, c in ipairs(changed) do changed_lines[#changed_lines + 1] = "- " .. c end
    local cfg = config_changes(old_config, config_text)
    if #cfg > 0 then
        changed_lines[#changed_lines + 1] = ""
        changed_lines[#changed_lines + 1] = "config.lua, lines before (-) and after (+):"
        changed_lines[#changed_lines + 1] = ""
        changed_lines[#changed_lines + 1] = "```"
        for _, l in ipairs(cfg) do changed_lines[#changed_lines + 1] = l end
        changed_lines[#changed_lines + 1] = "```"
    end
else
    changed_lines[1] = "The first picture filed: nothing to compare with."
end

-- the notes
local commit = read_command(string.format("git -C %s log -1 --format='%%h %%s'", shell_quote(DIR))):gsub("%s+$", "")
local dirty = read_command(string.format("git -C %s status --short -- src libs scripts config.lua", shell_quote(DIR)))
local f = assert(io.open(stem .. ".info.md", "w"))
f:write("# ", number, "-", NAME, "\n\n")
f:write("Filed ", os.date("%Y-%m-%d %H:%M"), " by scripts/file-screenshot.\n\n")
f:write("## What made it\n\n")
f:write("- Commit: ", commit, dirty ~= "" and " (with uncommitted changes to the source)" or "", "\n")
f:write("- How: ", made_by or "(not given)", "\n")
f:write("- Picture: `", number, "-", NAME, ".", ext, "` (copied from `", PICTURE, "`)\n\n")
f:write("## What changed since the previous picture\n\n", table.concat(changed_lines, "\n"), "\n\n")
f:write("## What it shows\n\n(to be written: the picture, literally, part by part)\n\n")
f:write("## The story so far\n\n(to be written: the arc of the project up to this picture)\n")
f:close()
print(stem .. "." .. ext)
