#version 450

// Full Similarity Matrix Compute Shader
// Computes ALL cosine similarities in a single dispatch using 2D workgroups
// Output: Upper triangular matrix stored linearly
//
// Original design from Issue 9-002:
// - 2D dispatch with 16x16 workgroups
// - Each thread computes one pair (i, j) where i < j
// - Single dispatch for all ~30M pairs

layout(local_size_x = 16, local_size_y = 16) in;

layout(set = 0, binding = 0) readonly buffer Embeddings {
    float embeddings[];  // All embeddings: num_poems * embedding_dim
};

layout(set = 0, binding = 1) writeonly buffer Similarities {
    float similarities[];  // Upper triangular output: num_poems * (num_poems - 1) / 2
};

layout(push_constant) uniform Constants {
    uint num_poems;
    uint embedding_dim;
};

// Calculate linear index for triangular storage
// For pair (i, j) where i < j:
// index = i * num_poems - i * (i + 1) / 2 + (j - i - 1)
uint triangular_index(uint i, uint j, uint n) {
    return i * n - (i * (i + 1)) / 2 + (j - i - 1);
}

void main() {
    uint i = gl_GlobalInvocationID.x;
    uint j = gl_GlobalInvocationID.y;

    // Only compute upper triangle (i < j)
    if (i >= num_poems || j >= num_poems) return;
    if (i >= j) return;  // Skip diagonal and lower triangle

    // Calculate base offsets for embeddings
    uint base_i = i * embedding_dim;
    uint base_j = j * embedding_dim;

    // Compute cosine similarity
    float dot_product = 0.0;
    float norm_i = 0.0;
    float norm_j = 0.0;

    for (uint k = 0; k < embedding_dim; k++) {
        float a = embeddings[base_i + k];
        float b = embeddings[base_j + k];

        dot_product += a * b;
        norm_i += a * a;
        norm_j += b * b;
    }

    float similarity = dot_product / (sqrt(norm_i) * sqrt(norm_j));

    // Store in triangular buffer
    uint idx = triangular_index(i, j, num_poems);
    similarities[idx] = similarity;
}
