# Project-local temporary files (tmp/ is a symlink into /tmp/, see
# scripts/ensure-tmp-symlink; ignoring it keeps `git status` clean even though
# the symlink itself is a tracked-looking file from git's perspective).
tmp

# Stage wall-clock timing ring buffer (Issue 10-051). Purely a function of this
# operator's hardware and how many times they've run the pipeline -- useless to
# share, so never track it.
.stage-timings

# Build products (regenerated each run)
output/
output-backup/
assets/

# Everything under input/ is regenerable, so none of it is tracked here. It is
# repopulated by the external sync (/home/ritz/backups/words/sync-to-projects:
# notes, pictures, the message/fediverse zips) and by run.sh --sync (config.lua
# sources). The one authored exception -- the explore-page copy -- now has a
# committed canonical home in page-templates/ and is copied back into
# input/pages/ at HTML build time by scripts/sync-page-templates (Issue 11-005).
# NOTE: input/ also holds non-anonymized source archives (*.car/*.zip/outbox.json)
# that must NEVER be tracked; this blanket ignore covers them too.
input/

# Validation reports (generated during pipeline runs)
validation_reports/

# Binary cache files (GPU-generated, large)
*.bin

# Locally-installed CUDA toolkit + built llama.cpp (multi-GB, fetched by
# scripts/build-deps.sh -- regenerable build dependencies, never track)
libs/cuda/
libs/llama.cpp/

# Editor files
*.swp
*~

# OS files
.DS_Store
