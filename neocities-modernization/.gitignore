# Project-local temporary files (tmp/ is a symlink into /tmp/, see
# scripts/ensure-tmp-symlink; ignoring it keeps `git status` clean even though
# the symlink itself is a tracked-looking file from git's perspective).
tmp

# Build products (regenerated each run)
output/
output-backup/
assets/

# Extracted poem data (regenerated by extraction scripts via run.sh --extract)
input/*/files/poems.json

# Extracted media files (regenerated from ZIP archives by run-messages)
input/messages/images/

# Input content files (synced from external sources, not tracked here)
input/images/
input/notes/

# Validation reports (generated during pipeline runs)
validation_reports/

# Source archives (contain non-anonymized data - DO NOT TRACK)
input/**/*.car
input/**/*.zip
input/**/*.tar.gz
input/**/outbox.json

# Binary cache files (GPU-generated, large)
*.bin

# Editor files
*.swp
*~

# OS files
.DS_Store
