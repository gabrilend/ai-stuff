tmp

# Built cross-toolchain — rebuilt by scripts/build-deps.
libs/cross/

# Cached upstream source tarballs — re-downloaded by scripts/build-deps
# from the URLs and SHA-512 values pinned at the top of that script.
libs/sources/

# The repository's parent .gitignore matches the pattern "build" anywhere
# in the tree (a build-artifacts catch-all). That sweep catches our
# scripts/build wrapper, which IS source we want tracked. Re-include it.
!scripts/build

# Build outputs (kernel.img, goodbye.log, etc). Regenerated by make.
output/

# Reconstructed eMMC images from the sparse dump — large sparse binaries
# (up to ~29 GiB apparent). Never committed, and kept OUT of output/ so
# push-to-usb never tries to rsync one onto a FAT32 drive (4 GiB file cap).
dumps/

# eMMC factory archive (archives/). The gzipped full-device dump pulled off
# a real unit is ~5 GiB — far too large for git; the 16 MiB raw debug-log
# image is heavy too. Both stay on disk as the known-good restore image
# (with a second copy on the lab flash drive), but out of git history. The
# small per-probe logs and the manifest ARE tracked — they are the
# on-device measurement record. Ignore the big binaries, keep the evidence.
archives/*.img.gz.*
archives/*.img
