#!/usr/bin/env bash
# push-to-usb — sync project build artifacts onto the air-gap USB drive
#
# General description: this script bridges the trusted main development
# machine and the deliberately-untrusted air-gapped lab laptop. We find
# the dedicated USB drive by its hard-coded filesystem UUID, confirm
# sudo before any destructive change, mount the drive at a project-
# owned mount point at /mnt/soren-ds, copy the build's output and the
# lab-side helper onto it, flush every byte to physical storage,
# unmount, and remove the mount point. The developer pulls the drive
# and carries it to the lab laptop.
#
# Sudo credentials are confirmed at the start. If sudo cannot be
# obtained, the script aborts before touching the drive.
#
# Visible output is deliberately terse: a couple of headline lines
# (working directory, target UUID, resolved device), then two
# progress lines — one for the mount+sync stage and one for the
# unmount+cleanup stage — each ending in a green "done" or a red
# "error" followed by the actual error text on the next line. The
# detailed step-by-step record lands in the log file under tmp/.

set -euo pipefail

# {{{ configuration — paths are all relative to DIR
DIR="${1:-/mnt/mtwo/programming/ai-stuff/soren-ds}"

# The dedicated USB drive's filesystem UUID. Hard-coded because we own
# the drive and the value almost never changes. If you reformat the
# drive (or swap it for a different one), refresh this value. To find
# the new UUID, plug the drive in and either:
#
#   lsblk -o NAME,LABEL,UUID,SIZE,MOUNTPOINT
#       (lists every block device; pick the row that's the right
#        size and label)
#
# or, if you already know which /dev path the partition is at:
#
#   blkid -o value -s UUID /dev/sdXY
#
# For FAT32 the UUID is the FS's short serial number formatted
# XXXX-XXXX. For ext4 it's a longer dash-separated value. Either
# works; /dev/disk/by-uuid/$value will resolve regardless.
USB_DRIVE_UUID="E6A7-FD9E"

# Dedicated mount point. Project-owned, so we don't fight over a
# shared path like /mnt/generic. Created at start, removed at exit.
USB_MOUNT="/mnt/soren-ds"

OUTPUT_DIR="${DIR}/output"
LAB_SIDE_DIR="${DIR}/scripts/lab-side"

TMP_DIR="${DIR}/tmp"
LOG_FILE="${TMP_DIR}/push-to-usb.log"
GOODBYE_FILE="${OUTPUT_DIR}/goodbye.log"
# }}}

# {{{ colors — only emit ANSI when stderr is a real terminal
if [[ -t 2 ]]; then
    COLOR_GREEN=$'\033[32m'
    COLOR_RED=$'\033[31m'
    COLOR_RESET=$'\033[0m'
else
    COLOR_GREEN=''
    COLOR_RED=''
    COLOR_RESET=''
fi
# }}}

# {{{ audit_log() — append a structured line to the log file only (no terminal output)
audit_log() {
    local message="$1"
    local stamp
    stamp="$(date -Iseconds)"
    printf '%s [push-to-usb] %s\n' "$stamp" "$message" >> "$LOG_FILE"
}
# }}}

# {{{ say() — print to stderr without a prefix and mirror to the log file with one
say() {
    local message="$1"
    printf '%s\n' "$message" >&2
    audit_log "$message"
}
# }}}

# {{{ die() — log an error and exit non-zero
die() {
    local message="$1"
    printf '%s\n' "$message" >&2
    audit_log "ERROR: $message"
    exit 1
}
# }}}

# {{{ progress_start() — open a progress line with a step label, no newline
progress_start() {
    local label="$1"
    printf '%s...' "$label" >&2
    audit_log "STEP start: $label"
}
# }}}

# {{{ progress_continue() — extend an open progress line with another step label
progress_continue() {
    local label="$1"
    printf ' %s...' "$label" >&2
    audit_log "STEP continue: $label"
}
# }}}

# {{{ progress_done() — close an open progress line with a green "done" newline
progress_done() {
    printf ' %sdone%s\n' "$COLOR_GREEN" "$COLOR_RESET" >&2
    audit_log "STEP done"
}
# }}}

# {{{ progress_error() — close an open progress line with red "error" then print the detail
progress_error() {
    local detail="$1"
    printf ' %serror%s\n' "$COLOR_RED" "$COLOR_RESET" >&2
    printf '%s\n' "$detail" >&2
    audit_log "STEP error: $detail"
}
# }}}

# {{{ ensure_workspace() — guarantee local bookkeeping directories exist
ensure_workspace() {
    if [[ ! -L "$TMP_DIR" ]] && [[ ! -d "$TMP_DIR" ]]; then
        die "${TMP_DIR} does not exist. Project convention requires tmp/ as a RAM-backed directory."
    fi
    mkdir -p "$OUTPUT_DIR"
}
# }}}

# {{{ cleanup_on_exit() — silent trap target; unmount and remove the project mount point no matter how we exit
cleanup_on_exit() {
    if mountpoint -q "$USB_MOUNT" 2>/dev/null; then
        sync || true
        sudo umount "$USB_MOUNT" 2>/dev/null || true
    fi
    if [[ -d "$USB_MOUNT" ]]; then
        sudo rmdir "$USB_MOUNT" 2>/dev/null || true
    fi
}
# }}}

# {{{ require_sudo() — confirm super-user credentials before any destructive operation
require_sudo() {
    audit_log "Requesting sudo."
    if ! sudo -v; then
        die "sudo could not be confirmed. Aborting before any changes were made."
    fi
    audit_log "Sudo confirmed."
}
# }}}

# {{{ resolve_device() — turn the hard-coded UUID into a real /dev path
resolve_device() {
    local by_uuid="/dev/disk/by-uuid/${USB_DRIVE_UUID}"
    if [[ ! -e "$by_uuid" ]]; then
        die "no block device with UUID ${USB_DRIVE_UUID} is currently visible. Is the drive plugged in? If you reformatted the drive, update USB_DRIVE_UUID at the top of this script."
    fi
    readlink -f "$by_uuid"
}
# }}}

# {{{ check_mount_point_free() — refuse to proceed if anything else owns /mnt/soren-ds
check_mount_point_free() {
    if [[ -d "$USB_MOUNT" ]] && mountpoint -q "$USB_MOUNT" 2>/dev/null; then
        die "${USB_MOUNT} already has something mounted on it. Run 'findmnt ${USB_MOUNT}' to investigate."
    fi
}
# }}}

# {{{ release_existing_mount() — if the device is auto-mounted somewhere else, unmount it silently
release_existing_mount() {
    local device="$1"
    local existing
    existing="$(findmnt -no TARGET --source "$device" 2>/dev/null || true)"
    if [[ -n "$existing" ]]; then
        audit_log "Drive is currently mounted at ${existing}. Unmounting before remounting at ${USB_MOUNT}."
        sudo umount "$existing"
    fi
}
# }}}

# {{{ do_mount_and_sync() — single progress line covering mkdir + mount + rsync of both source trees
# FAT32 doesn't support Unix ownership or permission bits, so we use
# rsync's -rt (recursive, preserve mtimes) rather than the usual -a
# (which expands to flags that try to chown and chmod on the target
# and fail loudly on a FAT-family filesystem).
do_mount_and_sync() {
    local device="$1"
    local err
    progress_start "mounting"
    if ! err="$(sudo mkdir -p "$USB_MOUNT" 2>&1)"; then
        progress_error "$err"
        exit 1
    fi
    if ! err="$(sudo mount "$device" "$USB_MOUNT" 2>&1)"; then
        progress_error "$err"
        exit 1
    fi
    progress_continue "syncing"
    if ! err="$(sudo rsync -rt --delete "${OUTPUT_DIR}/" "${USB_MOUNT}/output/" 2>&1)"; then
        progress_error "$err"
        exit 1
    fi
    if [[ -d "$LAB_SIDE_DIR" ]]; then
        if ! err="$(sudo rsync -rt --delete "${LAB_SIDE_DIR}/" "${USB_MOUNT}/scripts/" 2>&1)"; then
            progress_error "$err"
            exit 1
        fi
    fi
    progress_done
}
# }}}

# {{{ do_cleanup() — single progress line covering sync, umount, and mount-point removal
do_cleanup() {
    local err
    progress_start "cleaning up"
    sync
    if ! err="$(sudo umount "$USB_MOUNT" 2>&1)"; then
        progress_error "$err"
        exit 1
    fi
    if ! err="$(sudo rmdir "$USB_MOUNT" 2>&1)"; then
        progress_error "$err"
        exit 1
    fi
    progress_done
}
# }}}

# {{{ write_goodbye() — append the conventional last-thing-a-program-does line
write_goodbye() {
    local stamp
    stamp="$(date -Iseconds)"
    printf '%s push-to-usb: goodbye\n' "$stamp" >> "$GOODBYE_FILE"
}
# }}}

# {{{ main() — orchestration
main() {
    ensure_workspace
    trap cleanup_on_exit EXIT
    require_sudo
    say "DIR=${DIR}"
    say "target UUID: ${USB_DRIVE_UUID}"
    local device
    device="$(resolve_device)"
    say "device: ${device}"
    check_mount_point_free
    release_existing_mount "$device"
    do_mount_and_sync "$device"
    do_cleanup
    write_goodbye
    printf '\nUnplug the drive, put it in the lab laptop, and run: scripts/flash-sd\n' >&2
}
# }}}

main
