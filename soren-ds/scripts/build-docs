local SCRIPT = [[
// The sidebar filter: typing narrows the list to matching page names,
// opening every section that still has a match.
function filterNav(q) {
  q = q.toLowerCase();
  document.querySelectorAll('nav details').forEach(function (d) {
    var any = false;
    d.querySelectorAll('a').forEach(function (a) {
      var hit = !q || a.textContent.toLowerCase().indexOf(q) >= 0;
      a.style.display = hit ? '' : 'none';
      any = any || hit;
    });
    d.style.display = any ? '' : 'none';
    if (q && any) d.open = true;
  });
}
// Keep the sidebar scrolled to the page you are on.
window.addEventListener('load', function () {
  var here = document.querySelector('nav a.here');
  if (here) here.scrollIntoView({ block: 'center' });
});
]]
-- }}}

-- {{{ local function sidebar
local function sidebar(current)
    local out = { '<nav><div class="brand">SOREN DS</div><div class="sub">documentation &amp; measurements</div>',
                  '<input placeholder="filter pages…" oninput="filterNav(this.value)">' }
    local function link(out_name, text, class)
        local c = (out_name == current.out) and "here" or ""
        if class then c = c .. " " .. class end
        return '<a class="' .. c .. '" href="' .. out_name .. '">' .. escape(text) .. "</a>"
    end
    out[#out + 1] = '<details open><summary>Start here</summary>' .. link("index.html", "Overview") ..
        link("metrics.html", "Measurements") .. link(EXPLAINED, "What the numbers mean") .. "</details>"
    local section = nil
    for _, page in ipairs(pages) do
        if page.section ~= section then
            if section then out[#out + 1] = "</details>" end
            section = page.section
            local open = current.section == section and " open" or ""
            out[#out + 1] = "<details" .. open .. "><summary>" .. escape(section) .. "</summary>"
        end
        local text = page.title
        if page.issue then text = page.title end
        local class = page.issue and (page.done and "done" or "open") or nil
        out[#out + 1] = link(page.out, text, class)
    end
    if section then out[#out + 1] = "</details>" end
    out[#out + 1] = "</nav>"
    return table.concat(out, "\n")
end
-- }}}

-- {{{ local function shell
local function shell(page, title, body)
    local index = 0
    for i, p in ipairs(pages) do if p == page then index = i end end
    local prev = pages[index - 1]
    local next = pages[index + 1]
    local pager = '<div class="pager"><span>' ..
        (prev and ('← <a href="' .. prev.out .. '">' .. escape(prev.title) .. "</a>") or "") .. "</span><span>" ..
        (next and ('<a href="' .. next.out .. '">' .. escape(next.title) .. "</a> →") or "") .. "</span></div>"
    return "<!doctype html>\n<html lang=\"en\"><head><meta charset=\"utf-8\">" ..
        "<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">" ..
        "<title>" .. escape(title) .. " — Soren DS</title><link rel=\"stylesheet\" href=\"style.css\">" ..
        "<script src=\"site.js\"></script></head><body><div class=\"wrap\">" ..
        sidebar(page) .. "<main>" .. body .. (index > 0 and pager or "") .. "</main></div></body></html>\n"
end
-- }}}

-- {{{ the pages from Markdown
os.execute("mkdir -p '" .. OUT .. "'")
write_file(OUT .. "/style.css", STYLE)
write_file(OUT .. "/site.js", SCRIPT)

for _, page in ipairs(pages) do
    local text = read_file(page.src) or ""
    local body
    if page.plain then
        body = "<h1>" .. escape(page.title) .. "</h1><pre class=\"code\">" .. escape(text) .. "</pre>"
    else
        body = markdown(text, page)
    end
    -- An issue page says where it stands, and where its file lives.
    if page.issue then
        local status = page.done and '<span class="status done">completed</span>' or '<span class="status open">open</span>'
        body = body:gsub("(</h1>)", status .. "%1", 1)
    end
    local rel = page.src:sub(#DIR + 2)
    body = body .. '<p class="filter-note">source: <code>' .. escape(rel) .. "</code></p>"
    write_file(OUT .. "/" .. page.out, shell(page, page.title, body))
end
-- }}}

-- {{{ the measurements page
-- {{{ local function card
local function card(key)
    local m = metrics[key]
    local class = ""
    if m.unit == "bool" then class = m.value ~= 0 and " good" or " bad" end
    if key:match("%.failed$") and m.value and m.value > 0 then class = " bad" end
    return '<a class="card' .. class .. '" id="m-' .. slug(key) .. '" href="' .. EXPLAINED .. "#" .. m.anchor ..
        '" title="what this number means"><div class="k">' .. escape(key) .. '</div><div><span class="v">' ..
        format_value(m) .. '</span><span class="u">' .. escape(m.unit ~= "bool" and m.unit or "") .. "</span></div>" ..
        '<div class="d">' .. escape(m.description) .. "</div></a>"
end
-- }}}

-- {{{ local function bars
-- A small bar chart, drawn with HTML so it scales with the text.
local function bars(rows, max, class)
    local out = {}
    for _, r in ipairs(rows) do
        local width = max > 0 and math.max(0, math.min(100, 100 * r.value / max)) or 0
        out[#out + 1] = '<div class="bar-row"><a class="label" href="' .. (r.href or "#") .. '">' .. escape(r.label) ..
            '</a><div class="track"><div class="fill ' .. (r.class or class or "") .. '" style="width:' ..
            string.format("%.1f", width) .. '%"></div></div><div class="num">' .. escape(r.text) .. "</div></div>"
    end
    return table.concat(out, "\n")
end
-- }}}

-- {{{ local function value
local function value(key)
    return metrics[key] and metrics[key].value
end
-- }}}

local groups = {}
local group_order = {}
for _, key in ipairs(metric_order) do
    local g = key:match("^([^.]+)")
    if not groups[g] then groups[g] = {}; group_order[#group_order + 1] = g end
    table.insert(groups[g], key)
end
local group_titles = {
    stripes = "Memory each core owns", ring = "The task ring", workers = "Workers", ports = "Ports",
    stations = "The station table", scrap = "The scrapyard", claim = "The claim", endurance = "The endurance run",
    kinds = "Choosing an exit", written_down = "A program written down", tests = "Tests",
}

local body = {}
body[#body + 1] = "<h1>Measurements</h1>"
body[#body + 1] = "<p>Every number here was written by a test or demo program as it ran on the laptop twin, and " ..
    "gathered when these pages were built. <strong>Click any number</strong> to go to the paragraph that explains " ..
    "what it is, how it is measured, and what a healthy value looks like. To refresh them, run " ..
    "<code>scripts/build-docs --measure</code>.</p>"

-- Tests at a glance.
do
    local rows, total_pass, total_fail = {}, 0, 0
    for _, key in ipairs(groups.tests or {}) do
        local name = key:match("^tests%.(.-)%.passed$")
        if name then
            local passed = value(key) or 0
            local failed = value("tests." .. name .. ".failed") or 0
            total_pass, total_fail = total_pass + passed, total_fail + failed
            local info = by_source[name .. ".c"]
            rows[#rows + 1] = { label = name, value = passed, text = passed .. " / " .. (passed + failed),
                                class = failed > 0 and "bad" or "good", href = info and info.out or "#" }
        end
    end
    if #rows > 0 then
        local max = 0
        for _, r in ipairs(rows) do if r.value > max then max = r.value end end
        body[#body + 1] = '<div class="widget"><h3><a href="' .. EXPLAINED .. '#tests-results">Tests</a>: ' ..
            total_pass .. " checks passed, " .. total_fail .. " failed</h3>" .. bars(rows, max) ..
            '<p class="note">Each name opens the test\'s own page, which says what it checks.</p></div>'
    end
end

-- Scaling: one core against four.
do
    local one, four = value("endurance.1core.runs_per_s"), value("endurance.4core.runs_per_s")
    if one and four then
        body[#body + 1] = '<div class="widget"><h3><a href="' .. EXPLAINED .. '#endurance-speedup">Four cores against one</a></h3>' ..
            bars({ { label = "1 core", value = one, text = format_value(metrics["endurance.1core.runs_per_s"]) .. " runs/s", href = "#m-endurance-1core-runs-per-s" },
                   { label = "4 cores", value = four, text = format_value(metrics["endurance.4core.runs_per_s"]) .. " runs/s", href = "#m-endurance-4core-runs-per-s" },
                   { label = "perfect 4 cores", value = one * 4, text = format_value({ value = one * 4 }) .. " runs/s", class = "amber" } },
                 one * 4) ..
            '<p class="note">Engine-bound work (boxes that do almost nothing). The gap between the second and third bar ' ..
            "is the single shared task ring's lock — issue 204's open question, measured.</p></div>"
    end
end

-- The coarseness calculator, driven by the measured engine cost.
do
    local pass_ns = value("endurance.4core.pass_run_ns") or value("endurance.1core.pass_run_ns")
    local round_ns = value("endurance.4core.round_ns") or value("endurance.1core.round_ns")
    if pass_ns and round_ns then
        body[#body + 1] = string.format([[
<div class="widget"><h3><a href="%s#endurance-coarseness">How coarse should a box be?</a></h3>
<p>Measured: one run costs <b>%.0f ns</b> of core time in the engine; one round of real work costs <b>%.2f ns</b>.
Slide to choose how much work a box does per run, and see what share of the core's time goes to the engine.</p>
<p><input type="range" min="0" max="4" step="0.01" value="2" id="coarse" oninput="coarseness()">
 <span id="coarse-rounds"></span> rounds per run</p>
<div class="bar-row"><span class="label">engine's share</span><div class="track"><div class="fill amber" id="coarse-engine"></div></div><span class="num" id="coarse-engine-n"></span></div>
<div class="bar-row"><span class="label">work's share</span><div class="track"><div class="fill good" id="coarse-work"></div></div><span class="num" id="coarse-work-n"></span></div>
<p class="note">The break-even point, where the engine and the work cost the same, is <b>%.0f rounds</b>: the
design rule issue 215 was built to produce.</p></div>
<script>
function coarseness() {
  var rounds = Math.round(Math.pow(10, document.getElementById('coarse').value));
  var engine = %.3f, work = rounds * %.5f;
  var share = engine / (engine + work);
  document.getElementById('coarse-rounds').textContent = rounds;
  document.getElementById('coarse-engine').style.width = (100 * share) + '%%';
  document.getElementById('coarse-work').style.width = (100 * (1 - share)) + '%%';
  document.getElementById('coarse-engine-n').textContent = (100 * share).toFixed(1) + '%%';
  document.getElementById('coarse-work-n').textContent = (100 * (1 - share)).toFixed(1) + '%%';
}
window.addEventListener('load', coarseness);
</script>]], EXPLAINED, pass_ns, round_ns, pass_ns / round_ns, pass_ns, round_ns)
    end
end

-- Pictures the demos drew, if they are there.
do
    local shots = { { "demos/phase-2/four-cores.png", "phase 2 — the endurance run, four cores" },
                    { "demos/phase-3/written-down.png", "phase 3 — a program written down" } }
    local found = {}
    for _, s in ipairs(shots) do
        local from = DIR .. "/tmp/shared-memory/" .. s[1]
        local f = io.open(from, "rb")
        if f then
            local data = f:read("*a")
            f:close()
            local name = "shot-" .. slug(s[1]) .. ".png"
            local w = io.open(OUT .. "/" .. name, "wb")
            w:write(data)
            w:close()
            found[#found + 1] = '<figure><img class="shot" src="' .. name .. '" alt="' .. escape(s[2]) ..
                '"><figcaption class="note">' .. escape(s[2]) .. " (the twin's two screens, as the demo drew them)</figcaption></figure>"
        end
    end
    if #found > 0 then
        body[#body + 1] = '<div class="widget"><h3>What the demos drew</h3>' .. table.concat(found, "\n") .. "</div>"
    end
end

-- Every number, by group.
body[#body + 1] = '<div class="widget"><input placeholder="filter numbers…" oninput="filterCards(this.value)" ' ..
    'style="width:100%;background:#121217;border:1px solid #3a3a48;color:#e8e6e3;padding:6px 9px;border-radius:4px">' ..
    "<script>function filterCards(q){q=q.toLowerCase();document.querySelectorAll('.card').forEach(function(c){" ..
    "c.style.display=c.textContent.toLowerCase().indexOf(q)>=0?'':'none';});}</script></div>"
for _, g in ipairs(group_order) do
    body[#body + 1] = '<h2 id="group-' .. slug(g) .. '">' .. escape(group_titles[g] or g) .. "</h2><div class=\"cards\">"
    for _, key in ipairs(groups[g]) do body[#body + 1] = card(key) end
    body[#body + 1] = "</div>"
end
local metrics_page = { out = "metrics.html", section = "Start here", title = "Measurements" }
write_file(OUT .. "/metrics.html", shell(metrics_page, "Measurements", table.concat(body, "\n")))
-- }}}

-- {{{ the overview page
do
    local body = { "<h1>Soren DS</h1>" }
    local vision = read_file(DIR .. "/notes/vision/000-vision.md") or ""
    body[#body + 1] = "<p>A handheld operating system for the Anbernic RG DS. Its vision, in its own words:</p>"
    body[#body + 1] = "<blockquote>" .. escape(vision:sub(1, 600)):gsub("\n", "<br>") .. "…</blockquote>"
    body[#body + 1] = '<p>Read <a href="' .. (by_source["000-vision.md"] and by_source["000-vision.md"].out or "#") ..
        '">the whole vision</a>, then <a href="doc-001-architecture-overview.html">the architecture</a> and ' ..
        '<a href="doc-002-roadmap.html">the roadmap</a>.</p>'
    body[#body + 1] = "<h2>Where each phase stands</h2><div class=\"table-wrap\"><table><tr><th>phase</th><th>issues done</th><th>open</th><th></th></tr>"
    for _, ph in ipairs(phase_numbers) do
        local done, open = 0, 0
        for _, i in ipairs(phases[ph].issues or {}) do
            if i.done then done = done + 1 else open = open + 1 end
        end
        local total = done + open
        local width = total > 0 and math.floor(100 * done / total) or 0
        body[#body + 1] = '<tr><td><a href="progress-phase-' .. ph .. '.html">phase ' .. ph .. "</a></td><td>" .. done ..
            "</td><td>" .. open .. '</td><td style="width:260px"><div class="bar-row"><div class="track"><div class="fill good" style="width:' ..
            width .. '%"></div></div></div></td></tr>'
    end
    body[#body + 1] = "</table></div>"
    body[#body + 1] = '<p>Every number on <a href="metrics.html">the measurements page</a> links to ' ..
        'the paragraph explaining it. Open issues are marked <span style="color:var(--amber)">○</span> in the ' ..
        'sidebar, completed ones <span style="color:var(--good)">●</span>.</p>'
    local index_page = { out = "index.html", section = "Start here", title = "Overview" }
    write_file(OUT .. "/index.html", shell(index_page, "Overview", table.concat(body, "\n")))
end
-- }}}

print(string.format("build-docs: %d pages, %d measurements, written to %s", #pages + 2, #metric_order, OUT))
if #unresolved > 0 then
    print("build-docs: " .. #unresolved .. " document links could not be resolved:")
