#!/usr/bin/env luajit
--
-- build-docs — the documentation and the measurements, as one linked site.
--
-- General description: reads every Markdown document in the project — the
-- design documents in docs/, the notes, every issue open and completed,
-- every phase's progress file, and the .info.md reference beside every
-- source file — and writes them as HTML pages into docs/HTML/, each with
-- the same look and a table of contents down the left that reaches every
-- other page. Issue numbers, document links and source file names become
-- links wherever they appear.
--
-- It also reads the measurements the tests and demo programs wrote while
-- they ran (tmp/shared-memory/metrics/*.tsv) and builds a dashboard of
-- them: every number is a link to the paragraph in docs/027 that explains
-- it, and that paragraph lists the numbers that point at it, so the two
-- can be walked either way. A few charts and calculators on the dashboard
-- are driven by the measured numbers themselves.
--
-- Gathering and showing are kept apart: this tool never measures
-- anything; it only shows what was measured. With --measure it first runs
-- the tests and demos (which do the measuring) and then builds.
--
-- Usage: scripts/build-docs [project-dir] [--measure]

local DIR = "/mnt/mtwo/programming/ai-stuff/soren-ds"
local MEASURE = false
for _, a in ipairs({ ... }) do
    if a == "--measure" then MEASURE = true else DIR = a end
end
local OUT = DIR .. "/docs/HTML"
local METRICS_DIR = DIR .. "/tmp/shared-memory/metrics"
local EXPLAINED = "doc-027-metrics-explained.html"

-- {{{ local function run
-- Run a command, showing its output; answers true if it succeeded.
local function run(command)
    local ok = os.execute(command)
    return ok == true or ok == 0
end
-- }}}

if MEASURE then
    print("build-docs: measuring first — every test, then the demos")
    if not run("'" .. DIR .. "/scripts/test-twin' '" .. DIR .. "'") then
        io.stderr:write("build-docs: the tests failed; the pages are built anyway, and show the failures\n")
    end
    for phase = 2, 20 do
        local demo = DIR .. "/issues/completed/demos/phase-" .. phase .. "/run.sh"
        local f = io.open(demo, "r")
        if f then
            f:close()
            print("build-docs: running the phase " .. phase .. " demo")
            run("DISPLAY= WAYLAND_DISPLAY= '" .. demo .. "' '" .. DIR .. "' > '" .. DIR ..
                "/tmp/shared-memory/demo-" .. phase .. ".log' 2>&1")
        end
    end
end

-- {{{ file helpers
-- {{{ local function read_file
local function read_file(path)
    local f = io.open(path, "r")
    if not f then return nil end
    local text = f:read("*a")
    f:close()
    return text
end
-- }}}

-- {{{ local function write_file
local function write_file(path, text)
    local f = io.open(path, "w")
    if not f then
        io.stderr:write("build-docs: cannot write " .. path .. "\n")
        os.exit(1)
    end
    f:write(text)
    f:close()
end
-- }}}

-- {{{ local function list
-- The names in one directory matching a pattern, sorted. `ls` is a
-- read-only use of the shell.
local function list(path, pattern)
    local names = {}
    local p = io.popen("ls -1 '" .. path .. "' 2>/dev/null")
    for name in p:lines() do
        if not pattern or name:match(pattern) then names[#names + 1] = name end
    end
    p:close()
    table.sort(names)
    return names
end
-- }}}
-- }}}

-- {{{ the pages
local pages = {}          -- in sidebar order
local by_out = {}
local by_source = {}      -- a file's base name -> page
local by_issue = {}       -- "204", "201a" -> page

-- {{{ local function title_of
local function title_of(text, fallback)
    local t = text and text:match("^%s*#%s+([^\n]+)")
    return t or fallback
end
-- }}}

-- {{{ local function add_page
local function add_page(section, src, out, title, extra)
    local page = { section = section, src = src, out = out, title = title }
    if extra then for k, v in pairs(extra) do page[k] = v end end
    pages[#pages + 1] = page
    by_out[out] = page
    local base = src and src:match("([^/]+)$")
    if base then by_source[base] = page end
    return page
end
-- }}}

-- {{{ local function slug
local function slug(s)
    return (s:lower():gsub("[^%w]+", "-"):gsub("^-+", ""):gsub("-+$", ""))
end
-- }}}

-- Documents, in their reading order.
for _, name in ipairs(list(DIR .. "/docs", "%.md$")) do
    local path = DIR .. "/docs/" .. name
    local text = read_file(path)
    add_page("Documents", path, "doc-" .. name:gsub("%.md$", "") .. ".html", title_of(text, name))
end

-- Notes: every markdown file under notes/, grouped by its folder.
do
    local p = io.popen("cd '" .. DIR .. "/notes' 2>/dev/null && find . -type f \\( -name '*.md' -o -name '*' \\) -not -name '.*' | sort")
    for rel in p:lines() do
        rel = rel:gsub("^%./", "")
        local path = DIR .. "/notes/" .. rel
        local text = read_file(path)
        if text and not rel:match("%.png$") and not rel:match("%.jpg$") then
            add_page("Notes", path, "note-" .. slug(rel) .. ".html", title_of(text, rel), { plain = not rel:match("%.md$") })
        end
    end
    p:close()
end

-- Issues, by phase: the progress file first, then every issue open or done.
local phases = {}
local function phase_of(number)
    local digits = number:match("^(%d+)")
    if not digits then return nil end
    if #digits >= 4 then return tonumber(digits:sub(1, 2)) end
    return tonumber(digits:sub(1, 1))
end
for _, folder in ipairs({ "", "completed/", "superseded/" }) do
    for _, name in ipairs(list(DIR .. "/issues/" .. folder, "%.md$")) do
        local number = name:match("^(%d+%a?)%-")
        local progress = name:match("^phase%-(%d+)%-progress%.md$")
        local path = DIR .. "/issues/" .. folder .. name
        local text = read_file(path)
        if progress then
            local ph = tonumber(progress)
            phases[ph] = phases[ph] or {}
            phases[ph].progress = { path = path, text = text }
        elseif number and folder ~= "superseded/" then
            local ph = phase_of(number)
            phases[ph] = phases[ph] or {}
            local list_ = phases[ph].issues or {}
            phases[ph].issues = list_
            list_[#list_ + 1] = { number = number, path = path, text = text, done = folder == "completed/", name = name }
        end
    end
end
local phase_numbers = {}
for ph in pairs(phases) do phase_numbers[#phase_numbers + 1] = ph end
table.sort(phase_numbers)
for _, ph in ipairs(phase_numbers) do
    local section = "Phase " .. ph
    if phases[ph].progress then
        add_page(section, phases[ph].progress.path, "progress-phase-" .. ph .. ".html",
                 title_of(phases[ph].progress.text, "Phase " .. ph .. " progress"), { progress = ph })
    end
    local issues = phases[ph].issues or {}
    table.sort(issues, function(a, b)
        local na, nb = tonumber(a.number:match("%d+")), tonumber(b.number:match("%d+"))
        if na ~= nb then return na < nb end
        return a.number < b.number
    end)
    for _, issue in ipairs(issues) do
        local page = add_page(section, issue.path, "issue-" .. issue.number .. ".html",
                              title_of(issue.text, issue.name), { issue = issue.number, done = issue.done })
        by_issue[issue.number] = page
    end
end

-- The source reference: every .info.md, grouped by folder.
for _, folder in ipairs({ "src/engine", "src/boxes", "src/system", "src/device", "twin", "twin/tools", "twin/tests", "twin/programs" }) do
    for _, name in ipairs(list(DIR .. "/" .. folder, "%.info%.md$")) do
        local path = DIR .. "/" .. folder .. "/" .. name
        local source = name:gsub("%.info%.md$", "")
        local page = add_page("Source: " .. folder, path, "info-" .. slug(folder .. "/" .. source) .. ".html",
                              folder .. "/" .. source, { source = source })
        by_source[source] = page
    end
end
-- }}}

-- {{{ the measurements
local metrics = {}        -- name -> { value, unit, anchor, description, file }
local metric_order = {}
local by_anchor = {}      -- anchor -> list of metric names

-- {{{ local function load_metrics
local function load_metrics()
    for _, name in ipairs(list(METRICS_DIR, "%.tsv$")) do
        local text = read_file(METRICS_DIR .. "/" .. name) or ""
        for line in text:gmatch("[^\n]+") do
            local key, value, unit, anchor, description = line:match("^([^\t]+)\t([^\t]*)\t([^\t]*)\t([^\t]*)\t(.*)$")
            if key then
                if not metrics[key] then metric_order[#metric_order + 1] = key end
                metrics[key] = { value = tonumber(value), unit = unit, anchor = anchor, description = description,
                                 file = name:gsub("%.tsv$", "") }
            end
        end
    end
    table.sort(metric_order)
    for _, key in ipairs(metric_order) do
        local a = metrics[key].anchor
        by_anchor[a] = by_anchor[a] or {}
        table.insert(by_anchor[a], key)
    end
end
-- }}}
load_metrics()
if #metric_order == 0 then
    io.stderr:write("build-docs: no measurements in " .. METRICS_DIR .. " — run with --measure (or scripts/test-twin) first\n")
    os.exit(1)
end

-- Derived numbers, each computed from two measured ones and saying so.
-- {{{ local function derive
local function derive(key, a, b, unit, anchor, description, how)
    local x, y = metrics[a], metrics[b]
    if x and y and x.value and y.value and y.value ~= 0 then
        metrics[key] = { value = how(x.value, y.value), unit = unit, anchor = anchor, description = description,
                         file = "derived", from = { a, b } }
        metric_order[#metric_order + 1] = key
        by_anchor[anchor] = by_anchor[anchor] or {}
        table.insert(by_anchor[anchor], key)
    end
end
-- }}}
derive("endurance.speedup_four_over_one", "endurance.4core.runs_per_s", "endurance.1core.runs_per_s", "x",
       "endurance-speedup", "four-core runs per second divided by one-core runs per second",
       function(a, b) return a / b end)

-- {{{ local function format_value
local function format_value(m)
    local v = m.value
    if not v then return "?" end
    if m.unit == "bool" then return v ~= 0 and "yes" or "NO" end
    if v == math.floor(v) and math.abs(v) < 1e12 then
        local s = tostring(math.floor(v))
        return s:reverse():gsub("(%d%d%d)", "%1,"):reverse():gsub("^,", ""):gsub("^%-,", "-")
    end
    if math.abs(v) >= 100 then return string.format("%.0f", v) end
    if math.abs(v) >= 1 then return string.format("%.2f", v) end
    return string.format("%.3f", v)
end
-- }}}
-- }}}

-- {{{ turning Markdown into HTML
-- {{{ local function escape
local function escape(s)
    return (s:gsub("&", "&amp;"):gsub("<", "&lt;"):gsub(">", "&gt;"):gsub('"', "&quot;"))
end
-- }}}

-- {{{ local function highlight
-- Enough highlighting for code to read as code: comments, strings,
-- keywords. C and Lua keywords both, since the project writes both.
local KEYWORDS = {}
for w in ([[if else for while return switch case break continue typedef struct enum static const extern
    sizeof void int char long short unsigned signed uint8_t uint16_t uint32_t uint64_t int8_t int16_t int32_t
    int64_t size_t local function end then do elseif nil true false station comparator iterator random
    weighted spread in out include]]):gmatch("%S+") do KEYWORDS[w] = true end

local function highlight(escaped)
    local saved = {}
    local function save(class, text)
        saved[#saved + 1] = '<span class="' .. class .. '">' .. text .. "</span>"
        return "\1" .. #saved .. "\1"
    end
    escaped = escaped:gsub("(/%*.-%*/)", function(c) return save("cm", c) end)
    escaped = escaped:gsub("(//[^\n]*)", function(c) return save("cm", c) end)
    escaped = escaped:gsub("(%-%-[^\n]*)", function(c) return save("cm", c) end)
    escaped = escaped:gsub("(#[^\n]*)", function(c)
        if c:match("^#include") or c:match("^#define") or c:match("^#if") then return c end
        return save("cm", c)
    end)
    escaped = escaped:gsub("(&quot;.-&quot;)", function(s) return save("st", s) end)
    escaped = escaped:gsub("([%a_][%w_]*)", function(w)
        if KEYWORDS[w] then return '<span class="kw">' .. w .. "</span>" end
        return w
    end)
    return (escaped:gsub("\1(%d+)\1", function(i) return saved[tonumber(i)] end))
end
-- }}}

local unresolved = {}

-- {{{ local function issue_link
local function issue_link(number)
    local page = by_issue[number]
    if page then
        return '<a class="issue' .. (page.done and " done" or "") .. '" href="' .. page.out .. '" title="' ..
               escape(page.title) .. '">' .. number .. "</a>"
    end
    return number
end
-- }}}

-- {{{ local function linkify
-- Issue numbers after the word "issue(s)", in runs like "201, 202 and
-- 203"; a table cell that is only an issue number; a bold issue number;
-- Markdown links to other documents; and source file names written as
-- code. Unresolvable document links are collected and reported.
local function linkify(html, page)
    -- After "issue" or "issues", a run of numbers joined by commas,
    -- "and", "or" or "through" — every number in the run is linked.
    html = html:gsub("([Ii]ssues?)(%s+)(%d%d%d%d?%a?)", function(word, space, first)
        return word .. space .. "\2" .. first .. "\3"
    end)
    for _ = 1, 8 do
        html = html:gsub("(\3)(,?%s+[ao][nr]d?%s+)(%d%d%d%d?%a?)", "%1%2\2%3\3")
        html = html:gsub("(\3)(,%s+)(%d%d%d%d?%a?)", "%1%2\2%3\3")
        html = html:gsub("(\3)(%s+through%s+)(%d%d%d%d?%a?)", "%1%2\2%3\3")
    end
    html = html:gsub("\2(%d%d%d%d?%a?)\3", function(n) return issue_link(n) end)
    html = html:gsub("<td>(%d%d%d%d?%a?)</td>", function(n)
        if by_issue[n] then return "<td>" .. issue_link(n) .. "</td>" end
        return "<td>" .. n .. "</td>"
    end)
    html = html:gsub("<strong>(%d%d%d%d?%a?)</strong>", function(n)
        if by_issue[n] then return "<strong>" .. issue_link(n) .. "</strong>" end
        return "<strong>" .. n .. "</strong>"
    end)
    html = html:gsub("%[([^%]]+)%]%(([^%)]+)%)", function(text, target)
        if target:match("^https?://") then
            return '<a href="' .. target .. '">' .. text .. "</a>"
        end
        local base = target:match("([^/#]+)") and target:match("([^/]+)$") or target
        local anchor = base:match("#(.*)$")
        base = base:gsub("#.*$", "")
        local found = by_source[base]
        if found then
            return '<a href="' .. found.out .. (anchor and ("#" .. anchor) or "") .. '">' .. text .. "</a>"
        end
        unresolved[#unresolved + 1] = (page.src or page.out) .. " -> " .. target
        return text
    end)
    html = html:gsub("<code>([^<]-)</code>", function(code)
        local base = code:match("([^/]+)$")
        local found = base and by_source[base]
        if found and found ~= page then
            return '<a class="src" href="' .. found.out .. '"><code>' .. code .. "</code></a>"
        end
        return "<code>" .. code .. "</code>"
    end)
    return html
end
-- }}}

-- {{{ local function markdown
local function markdown(text, page)
    local out = {}
    local in_code, in_table, list_kind = false, false, nil
    local paragraph, item, quote = {}, {}, {}
    local header_row = false

    local function inline(s)
        s = escape(s)
        local saved = {}
        s = s:gsub("`([^`]+)`", function(code)
            saved[#saved + 1] = "<code>" .. code .. "</code>"
            return "\1" .. #saved .. "\1"
        end)
        s = s:gsub("%*%*(.-)%*%*", "<strong>%1</strong>")
        s = s:gsub("%*([%w][^%*\n]-)%*", "<em>%1</em>")
        return (s:gsub("\1(%d+)\1", function(i) return saved[tonumber(i)] end))
    end
    local function flush_paragraph()
        if #paragraph > 0 then
            out[#out + 1] = "<p>" .. inline(table.concat(paragraph, "\n")) .. "</p>"
            paragraph = {}
        end
    end
    local function flush_item()
        if #item > 0 then
            out[#out + 1] = "<li>" .. inline(table.concat(item, "\n")) .. "</li>"
            item = {}
        end
    end
    local function close_list()
        if list_kind then
            flush_item()
            out[#out + 1] = "</" .. list_kind .. ">"
            list_kind = nil
        end
    end
    local function close_quote()
        if #quote > 0 then
            out[#out + 1] = "<blockquote>" .. inline(table.concat(quote, "\n")) .. "</blockquote>"
            quote = {}
        end
    end
    local function close_table()
        if in_table then out[#out + 1] = "</table></div>"; in_table = false end
    end
    local function close_all()
        flush_paragraph(); close_quote(); close_list(); close_table()
    end

    for line in (text .. "\n"):gmatch("([^\n]*)\n") do
        if in_code then
            if line:match("^%s*```") then
                out[#out + 1] = "</pre>"
                in_code = false
            else
                out[#out + 1] = highlight(escape(line))
            end
        elseif line:match("^%s*```") then
            close_all()
            out[#out + 1] = '<pre class="code">'
            in_code = true
        elseif line:match("^#+%s") then
            close_all()
            local hashes, title = line:match("^(#+)%s*(.-)%s*$")
            local anchor = title:match("{#([%w%-_]+)}%s*$")
            title = title:gsub("%s*{#[%w%-_]+}%s*$", "")
            anchor = anchor or slug(title)
            local level = math.min(#hashes, 4)
            local measured = ""
            if anchor and by_anchor[anchor] and page.out == EXPLAINED then
                local cells = {}
                for _, key in ipairs(by_anchor[anchor]) do
                    local m = metrics[key]
                    cells[#cells + 1] = '<a class="metric-chip" href="metrics.html#m-' .. slug(key) .. '">' ..
                        escape(key) .. " = <b>" .. format_value(m) .. "</b> " .. escape(m.unit ~= "bool" and m.unit or "") .. "</a>"
                end
                measured = '<div class="measured">measured: ' .. table.concat(cells, " ") .. "</div>"
            end
            out[#out + 1] = ('<h%d id="%s"><a class="self" href="#%s">§</a> %s</h%d>%s'):format(
                level, anchor, anchor, inline(title), level, measured)
        elseif line:match("^%s*|") then
            flush_paragraph(); close_quote(); close_list()
            if line:match("^%s*|[%s%-:|]*$") then
                header_row = false
            else
                if not in_table then
                    out[#out + 1] = '<div class="table-wrap"><table>'
                    in_table = true
                    header_row = true
                end
                local cells = {}
                local body = line:match("^%s*|(.*)$"):gsub("|%s*$", "")
                for cell in (body .. "|"):gmatch("([^|]*)|") do
                    local tag = header_row and "th" or "td"
                    cells[#cells + 1] = "<" .. tag .. ">" .. inline(cell:match("^%s*(.-)%s*$")) .. "</" .. tag .. ">"
                end
                out[#out + 1] = "<tr>" .. table.concat(cells) .. "</tr>"
                header_row = false
            end
        elseif line:match("^%s*[-*]%s+") or line:match("^%s*%d+%.%s+") then
            flush_paragraph(); close_quote(); close_table()
            local kind = line:match("^%s*%d+%.") and "ol" or "ul"
            if list_kind ~= kind then
                close_list()
                out[#out + 1] = "<" .. kind .. ">"
                list_kind = kind
            end
            flush_item()
            item[1] = line:gsub("^%s*[-*]%s+", ""):gsub("^%s*%d+%.%s+", "")
        elseif list_kind and #item > 0 and line:match("^%s+%S") then
            item[#item + 1] = line:match("^%s*(.-)%s*$")
        elseif line:match("^%s*$") then
            close_all()
        elseif line:match("^>%s?") then
            flush_paragraph(); close_list(); close_table()
            quote[#quote + 1] = (line:gsub("^>%s?", ""))
        else
            paragraph[#paragraph + 1] = line
        end
    end
    close_all()
    if in_code then out[#out + 1] = "</pre>" end
    return linkify(table.concat(out, "\n"), page)
end
-- }}}
-- }}}

