#!/usr/bin/env bash
# flash-sd — write the assembled bootable SoreOS SD image onto a microSD card on the lab laptop
#
# General description: runs on the air-gapped lab laptop from the USB
# drive we carried over from the main machine. We find the bootable
# SD image the main machine's build-bootable-sd assembled and pushed
# into the drive's output directory, confirm sudo before any
# destructive change, ask the developer to insert the microSD card,
# identify it as the new block device that appears, refuse to
# proceed if it isn't a removable device, require a typed YES
# confirmation, dd the image, sync, and eject.
#
# Sudo is confirmed at the start. If sudo cannot be obtained, the
# script aborts before prompting for the SD card — cancelling at the
# password prompt leaves every device exactly as it was.

set -euo pipefail

# {{{ configuration — paths are all relative to DIR (the USB drive root)
SCRIPT_PATH="$(readlink -f "$0")"
SCRIPT_DIR="$(dirname "$SCRIPT_PATH")"
DIR="${1:-$(dirname "$SCRIPT_DIR")}"

OUTPUT_DIR="${DIR}/output"
LOG_FILE="/tmp/flash-sd.log"
GOODBYE_FILE="${OUTPUT_DIR}/goodbye.log"
# }}}

# {{{ log() — structured line to stderr and the log file
log() {
    local message="$1"
    local stamp
    stamp="$(date -Iseconds)"
    printf '[flash-sd] %s\n' "$message" >&2
    printf '%s [flash-sd] %s\n' "$stamp" "$message" >> "$LOG_FILE"
}
# }}}

# {{{ die() — log an error and exit non-zero
die() {
    local message="$1"
    log "ERROR: $message"
    exit 1
}
# }}}

# {{{ require_sudo() — confirm super-user credentials before any destructive operation
require_sudo() {
    log "Requesting sudo. No destructive change happens until this succeeds."
    if ! sudo -v; then
        die "sudo could not be confirmed. Aborting before any changes were made."
    fi
    log "Sudo confirmed."
}
# }}}

# {{{ find_image() — locate the bootable SD image in the drive's output/
# Looks for bootable-sd.img specifically rather than "any .img file",
# because the build produces two images that share that extension —
# kernel.img (the raw kernel) and bootable-sd.img (the assembled
# bootable image). Only the second one is flashable to an SD card and
# meaningful to the BootROM; the kernel image alone has no
# partition table and no boot chain in front of it, and writing it
# straight to a card would produce a card the device cannot boot
# from.
find_image() {
    if [[ ! -d "$OUTPUT_DIR" ]]; then
        die "no output directory at ${OUTPUT_DIR}. The image gets here one of two ways: push-to-usb on the main machine writing to the air-gap drive, or build-and-flash pulling it over the network. Neither appears to have run."
    fi
    local img="${OUTPUT_DIR}/bootable-sd.img"
    if [[ ! -f "$img" ]]; then
        die "no bootable-sd.img in ${OUTPUT_DIR}. Either run scripts/build-bootable-sd on the main machine then push-to-usb, or run build-and-flash from here to do the whole round trip over the network."
    fi
    printf '%s' "$img"
}
# }}}

# {{{ snapshot_disks() — list current whole-disk block devices, one name per line
snapshot_disks() {
    lsblk -dn -o NAME | sort
}
# }}}

# {{{ wait_for_sd_card() — diff before/after block devices around an SD insertion
wait_for_sd_card() {
    log "Snapshotting current block devices..."
    local before
    before="$(snapshot_disks)"
    printf '\nInsert the microSD card now (in a USB reader, or in a built-in slot).\nPress ENTER when inserted.\n' >&2
    read -r _
    sleep 2
    log "Snapshotting block devices after insertion..."
    local after
    after="$(snapshot_disks)"
    local before_file
    before_file="$(mktemp)"
    local after_file
    after_file="$(mktemp)"
    printf '%s\n' "$before" > "$before_file"
    printf '%s\n' "$after" > "$after_file"
    local new_names
    new_names="$(comm -13 "$before_file" "$after_file")"
    rm -f "$before_file" "$after_file"
    local count=0
    local n
    for n in $new_names; do
        count=$((count + 1))
    done
    if [[ $count -eq 0 ]]; then
        die "no new block device detected. If the laptop's built-in slot doesn't enumerate a new device, pass the device path explicitly as a second argument."
    fi
    if [[ $count -gt 1 ]]; then
        log "Multiple new devices appeared:"
        for n in $new_names; do
            log "  - /dev/$n"
        done
        die "please insert only the SD card reader."
    fi
    local single
    for n in $new_names; do
        single="$n"
    done
    printf '/dev/%s' "$single"
}
# }}}

# {{{ verify_removable() — refuse to flash anything that isn't a removable device or a built-in SD slot
# The kernel's RM (removable) flag describes the slot, not the
# medium. USB-attached SD card readers report RM=1 because the
# whole reader is hot-pluggable; laptops with a built-in SD
# slot report RM=0 because the slot itself is fixed even
# though the card in it is removable. To accept both shapes
# of "an SD card is the target" without also accepting the
# laptop's internal SSD, we widen the check to also pass
# devices whose transport is MMC. Internal SSDs use SATA or
# NVMe transport, so they still fail this check. The typed
# YES confirmation with size and model shown is the final
# guard against operator error after this gate clears.
verify_removable() {
    local device="$1"
    local removable transport
    removable="$(lsblk -dn -o RM "$device")"
    removable="${removable//[[:space:]]/}"
    transport="$(lsblk -dn -o TRAN "$device")"
    transport="${transport//[[:space:]]/}"
    if [[ "$removable" != "1" ]] && [[ "$transport" != "mmc" ]]; then
        die "${device} is neither marked removable nor on the MMC transport (RM=${removable}, TRAN=${transport}). Refusing to flash."
    fi
}
# }}}

# {{{ confirm_with_user() — show source and destination, require typed YES
confirm_with_user() {
    local device="$1"
    local image="$2"
    local size
    size="$(lsblk -dn -o SIZE "$device")"
    local model
    model="$(lsblk -dn -o MODEL "$device" 2>/dev/null || true)"
    printf '\n' >&2
    printf 'About to flash:\n' >&2
    printf '  Source:  %s\n' "$image" >&2
    printf '  Target:  %s  (size: %s, model: %s)\n' "$device" "$size" "$model" >&2
    printf '\n' >&2
    printf 'ALL DATA ON %s WILL BE OVERWRITTEN.\n' "$device" >&2
    printf '\n' >&2
    local answer
    read -r -p "Type 'YES' (in capitals) to proceed: " answer
    if [[ "$answer" != "YES" ]]; then
        die "user declined; nothing was written."
    fi
}
# }}}

# {{{ unmount_partitions() — unmount any auto-mounted partitions of the target
unmount_partitions() {
    local device="$1"
    local part
    local mp
    for part in $(lsblk -ln -o NAME "$device" | tail -n +2); do
        local part_path="/dev/${part}"
        mp="$(findmnt -no TARGET "$part_path" 2>/dev/null || true)"
        if [[ -n "$mp" ]]; then
            log "Unmounting ${part_path} from ${mp}..."
            sudo umount "$part_path"
        fi
    done
}
# }}}

# {{{ flash_image() — dd the image onto the target with progress and fsync
flash_image() {
    local image="$1"
    local device="$2"
    log "Flashing ${image} to ${device}..."
    sudo dd if="$image" of="$device" bs=4M status=progress conv=fsync
    log "Flushing physical storage..."
    sync
}
# }}}

# {{{ eject_device() — close out the device cleanly so the kernel forgets it
eject_device() {
    local device="$1"
    log "Ejecting ${device}..."
    if ! sudo eject "$device" 2>/dev/null; then
        log "eject command failed or unavailable; sync was successful so the device is safe to remove."
    fi
}
# }}}

# {{{ write_goodbye() — append the conventional last-thing-a-program-does line
write_goodbye() {
    local stamp
    stamp="$(date -Iseconds)"
    if [[ -d "$OUTPUT_DIR" ]] && [[ -w "$OUTPUT_DIR" ]]; then
        printf '%s flash-sd: goodbye\n' "$stamp" >> "$GOODBYE_FILE" 2>/dev/null || true
    fi
}
# }}}

# {{{ ensure_lab_output_dir() — create the lab-output/ directory on the USB drive root
# The companion dump-from-sd script writes its dumps into a
# lab-output/ directory on the USB drive — separate from output/
# because the main machine's push-to-usb runs `rsync --delete`
# against output/ and would wipe whatever the lab side left there.
# The USB drive's root is typically root-owned (or owned by whoever
# auto-mounted it), so the mkdir needs sudo. Once the directory
# exists, the dump files dd writes into it inherit the filesystem's
# permission model — FAT32 USB drives don't support Unix ownership
# at all, so an explicit chown after creation returns "operation
# not permitted" even with sudo. We skip the chown and rely on the
# default umask giving the dd-created files world-readable mode,
# which is enough for the developer to read them either way.
ensure_lab_output_dir() {
    local lab_output_dir="${DIR}/lab-output"
    if [[ ! -d "$lab_output_dir" ]]; then
        log "Creating ${lab_output_dir} on the USB drive (needs sudo)."
        sudo mkdir -p "$lab_output_dir"
    fi
}
# }}}

# {{{ main() — orchestration
main() {
    log "DIR=${DIR}"
    local image
    image="$(find_image)"
    log "Using image: ${image}"
    require_sudo
    ensure_lab_output_dir
    local sd_device
    if [[ $# -ge 2 ]]; then
        sd_device="$2"
        log "Using explicit device override: ${sd_device}"
    else
        sd_device="$(wait_for_sd_card)"
        log "Detected SD device: ${sd_device}"
    fi
    verify_removable "$sd_device"
    confirm_with_user "$sd_device" "$image"
    unmount_partitions "$sd_device"
    flash_image "$image" "$sd_device"
    eject_device "$sd_device"
    write_goodbye
    printf '\n' >&2
    printf 'Pull the SD card and plug it into the device.\n' >&2
}
# }}}

main "$@"
