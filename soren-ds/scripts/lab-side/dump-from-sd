#!/usr/bin/env bash
# dump-from-sd — pull the kernel's debug log and partial eMMC backup
# off the microSD card on the lab laptop
#
# General description: runs on the air-gapped lab laptop from the USB
# drive we carried over from the main machine. We confirm sudo, ask
# the developer to insert the microSD card from the device, identify
# it as the new block device that appears, refuse to proceed if it
# isn't a removable device or on the MMC transport, dd two regions
# off the card — the kernel's SD-backed debug log at LBA 0x4000000
# (per the 110g-debug-log convention in src/017-debug-log.c) and the
# eMMC boot-chain backup region at LBA 0x200000 (the emmc-backup
# probe's backup_boot target in src/019-probe-engine.c, 16 MiB) — drop both as
# timestamped files into a lab-output/ directory on the USB drive,
# and print the readable text from the debug log plus whatever
# partition layout the backup shows for the developer to read on
# the spot.
#
# Sudo is confirmed before either dump runs. If sudo can't be
# obtained the script exits before any block-device access — the
# device, the SD card, and the laptop are all left exactly as
# they were.
#
# The script is read-only against the SD card. Neither the FAT
# partition (which the device's bootloader reads from) nor either of
# the two regions the kernel writes to is modified; the only way the
# card can change as a result of running this script is if the
# laptop's automounter mounts and remounts a partition, which we
# can't prevent but also doesn't damage anything.
#
# Lab-side outputs land in $DIR/lab-output/ rather than $DIR/output/.
# The main machine's push-to-usb script runs `rsync -rt --delete`
# between its own output/ and the drive's output/, so anything the
# lab side writes into output/ would be wiped on the next push.
# lab-output/ is outside that sync and survives the round trip back
# to the main machine.

set -euo pipefail

# {{{ configuration — paths relative to DIR (the USB drive root)
SCRIPT_PATH="$(readlink -f "$0")"
SCRIPT_DIR="$(dirname "$SCRIPT_PATH")"
DIR="${1:-$(dirname "$SCRIPT_DIR")}"

LAB_OUTPUT_DIR="${DIR}/lab-output"
LOG_FILE="/tmp/dump-from-sd.log"
GOODBYE_FILE="${DIR}/output/goodbye.log"

# Regions on the microSD card the kernel writes to. These constants
# need to stay in sync with the kernel's own copies — the debug-log
# LBA lives in src/017-debug-log.c as LOG_SD_REGION_START, and the
# eMMC backup LBA + sector count is the second and third argument to
# emmc_backup_to_sd in src/002-main.c. If either changes in the
# kernel, this script needs the same change.
DEBUG_LOG_LBA=4194304             # 0x400000 — 2 GB into the SD card.
                                  # Earlier value was 0x4000000 (32 GB), an
                                  # off-by-an-extra-zero typo of the
                                  # author's intended 0x400000. Stays in
                                  # sync with the kernel's
                                  # LOG_SD_REGION_START.
DEBUG_LOG_SECTORS=32768           # 16 MiB — well above the ring buffer's actual size

BACKUP_LBA=2097152                # 0x200000 — ~1 GB into the SD card
BACKUP_SECTORS=32768              # 16 MiB — matches the emmc-backup probe's boot-chain
                                  # copy: emmc_backup_to_sd(0, 0x200000, 32768) grabs eMMC
                                  # LBA 0..32767 (GPT + uboot + trust, the Rockchip boot
                                  # chain). Was 409600 (200 MiB) when the gate blindly
                                  # copied the front of the card; trimmed once the layout
                                  # was known. Keep in sync with the probe's sector count.

# The sparse eMMC dump (src/012-emmc.c emmc_dump_to_sd) packs only its
# non-zero chunks onto the card from DUMP_DEST_LBA and logs how many sectors
# it packed ("[dump] complete ... packed=<sectors>"). We read exactly that
# many sectors back and split them into <4 GiB pieces so the whole ~7 GiB
# survives a FAT32 USB drive (whose files can't exceed 4 GiB); reconstruct-
# emmc reassembles the pieces and replays the MAP into a full image. Keep
# DUMP_DEST_LBA in sync with the kernel's copy.
DUMP_DEST_LBA=8388608             # 0x800000 — ~4 GB into the SD card
SPLIT_SIZE=3G                     # each packed piece stays under FAT32's 4 GiB cap
# }}}

# {{{ log() — single timestamped line to stderr and to the log file
log() {
    local message="$1"
    local stamp
    stamp="$(date -Iseconds)"
    printf '[dump-from-sd] %s\n' "$message" >&2
    printf '%s [dump-from-sd] %s\n' "$stamp" "$message" >> "$LOG_FILE"
}
# }}}

# {{{ die() — log an error and exit non-zero
die() {
    local message="$1"
    log "ERROR: $message"
    exit 1
}
# }}}

# {{{ require_sudo() — confirm super-user credentials before any reads
# (reads are non-destructive, but raw block-device access needs sudo)
require_sudo() {
    log "Requesting sudo. No file is touched on the SD card; we only read raw sectors."
    if ! sudo -v; then
        die "sudo could not be confirmed. Aborting before touching anything."
    fi
    log "Sudo confirmed."
}
# }}}

# {{{ snapshot_disks() — list current whole-disk block devices, one name per line
snapshot_disks() {
    lsblk -dn -o NAME | sort
}
# }}}

# {{{ wait_for_sd_card() — diff before/after block devices around an SD insertion
# Same shape as flash-sd's detection logic so the developer's
# experience between the two scripts is identical.
wait_for_sd_card() {
    log "Snapshotting current block devices..."
    local before
    before="$(snapshot_disks)"
    printf '\nInsert the microSD card now (in a USB reader, or in a built-in slot).\nPress ENTER when inserted.\n' >&2
    read -r _
    sleep 2
    log "Snapshotting block devices after insertion..."
    local after
    after="$(snapshot_disks)"
    local before_file
    before_file="$(mktemp)"
    local after_file
    after_file="$(mktemp)"
    printf '%s\n' "$before" > "$before_file"
    printf '%s\n' "$after" > "$after_file"
    local new_names
    new_names="$(comm -13 "$before_file" "$after_file")"
    rm -f "$before_file" "$after_file"
    local count=0
    local n
    for n in $new_names; do
        count=$((count + 1))
    done
    if [[ $count -eq 0 ]]; then
        die "no new block device detected. If the laptop's built-in slot doesn't enumerate a new device, pass the device path explicitly as a second argument."
    fi
    if [[ $count -gt 1 ]]; then
        log "Multiple new devices appeared:"
        for n in $new_names; do
            log "  - /dev/$n"
        done
        die "please insert only the SD card reader."
    fi
    local single
    for n in $new_names; do
        single="$n"
    done
    printf '/dev/%s' "$single"
}
# }}}

# {{{ verify_removable() — refuse to read from anything that isn't a removable device or a built-in SD slot
# Same widening as flash-sd's check: built-in SD slots report RM=0
# because the slot itself is fixed even though the card is removable,
# so we accept either RM=1 or TRAN=mmc.
verify_removable() {
    local device="$1"
    local removable transport
    removable="$(lsblk -dn -o RM "$device")"
    removable="${removable//[[:space:]]/}"
    transport="$(lsblk -dn -o TRAN "$device")"
    transport="${transport//[[:space:]]/}"
    if [[ "$removable" != "1" ]] && [[ "$transport" != "mmc" ]]; then
        die "${device} is neither marked removable nor on the MMC transport (RM=${removable}, TRAN=${transport}). Refusing to read."
    fi
}
# }}}

# {{{ unmount_partitions() — unmount any auto-mounted partitions of the target
# Raw block reads are happier without the kernel's pagecache layered
# on top of them. Same logic as flash-sd uses before its dd.
unmount_partitions() {
    local device="$1"
    local part
    local mp
    for part in $(lsblk -ln -o NAME "$device" | tail -n +2); do
        local part_path="/dev/${part}"
        mp="$(findmnt -no TARGET "$part_path" 2>/dev/null || true)"
        if [[ -n "$mp" ]]; then
            log "Unmounting ${part_path} from ${mp}..."
            sudo umount "$part_path"
        fi
    done
}
# }}}

# {{{ dump_region() — read N sectors from the device starting at LBA, output to file
# Wraps dd with a single log line. The output file ends up owned by
# whoever the filesystem reports for the directory (root, the auto-
# mount user, or unspecified on FAT32); per the default umask the
# file mode is world-readable, which is enough for the developer
# to inspect either way. We don't try to chown the file because
# FAT32 and many auto-mounted USB filesystems reject ownership
# changes with "operation not permitted" even from sudo.
dump_region() {
    local device="$1"
    local lba="$2"
    local sectors="$3"
    local output="$4"
    local label="$5"

    log "Dumping ${label} region (LBA ${lba}, ${sectors} sectors → ${output})"
    sudo dd if="$device" of="$output" bs=512 skip="$lba" count="$sectors" status=progress
    log "${label} dump complete: $(du -h "$output" | cut -f1) at ${output}"
}
# }}}

# {{{ inspect_debug_log() — print readable text from the debug log file
# The kernel writes plain ASCII through debug_write; strings -n 4
# pulls every printable run of four or more characters out, which is
# enough to make the bring-up narration visible without any other
# tooling. Capped at the first hundred lines because the ring buffer
# can hold thousands.
inspect_debug_log() {
    local file="$1"
    printf '\n=== Debug log contents (this boot, ghost-free) ===\n' >&2
    # Invoked through `bash` rather than gated on the exec bit: this script runs
    # off the FAT32 USB drive, where rsync -rt doesn't carry the executable
    # permission across, so `-x "$viewer"` would be false even when it's present.
    local viewer="${SCRIPT_DIR}/view-log"
    if [[ -f "$viewer" ]]; then
        # view-log finds the kernel's end-of-log marker, shows only this boot's
        # log (dropping ghost bytes left in the never-wiped region by earlier,
        # longer boots), and cleans NUL/CR so the lines don't overlay. Far more
        # honest than the old raw `strings` dump, which showed prior boots'
        # leftovers as if they were this run's (issue 110g). Merged stdout+stderr
        # (2>&1) so the marker note rides along; capped so a pre-marker image
        # doesn't flood the terminal. Read-only, same as the rest of this script.
        bash "$viewer" "$file" 2>&1 | head -200 >&2 || true
    else
        printf 'view-log not found beside this script; falling back to a raw strings dump — it may show ghosts from earlier boots.\n' >&2
        strings -n 4 "$file" | head -100 >&2 || true
    fi
    printf '=== end of debug log ===\n\n' >&2
}
# }}}

# {{{ split_probe_logs() — one file per probe from the run-all sweep
# The kernel's run-all sweep brackets each probe's output with banner
# lines:  "===== PROBE <name> [(writes)] ====="  …  "===== END <name>".
# We carve the readable log into lab-output/probe-<name>-<stamp>.log so
# a tech reads each probe's result on its own, instead of scrolling one
# long combined log. A probe whose START banner has no matching END is
# the one that hung — its file still holds everything it managed to log.
split_probe_logs() {
    local file="$1" stamp="$2" count
    # awk does the redirect that creates each probe-<name>-<stamp>.log, so
    # it must run as root: LAB_OUTPUT_DIR was made with `sudo mkdir` and on
    # the (root-mounted) USB drive only root can create files there. Run
    # WITHOUT sudo and awk dies with "cannot redirect ... Permission
    # denied" on the very first probe — matching the dd dumps above, which
    # are already sudo'd for the same reason. `strings` stays unprivileged
    # (the log .img is world-readable); only the file-writing awk is sudo.
    count="$(strings -n 1 "$file" | sudo awk -v dir="$LAB_OUTPUT_DIR" -v stamp="$stamp" '
        /===== PROBE / { name=$4; cur=dir "/probe-" name "-" stamp ".log";
                         print "----- probe: " name " -----" > cur; active=1; n++; next }
        /===== END /   { active=0; next }
        active         { print >> cur }
        END            { print n+0 }
    ')"
    if [[ "${count:-0}" -gt 0 ]]; then
        log "Split the sweep into ${count} per-probe logs: ${LAB_OUTPUT_DIR}/probe-*-${stamp}.log"
    fi
}
# }}}

# {{{ pull_full_dump() — copy the eMMC dump off the SD, gzipped + split for FAT32
# The full linear dump writes the whole eMMC to the SD from DUMP_DEST_LBA and
# logs "[dump] complete ... packed=<sectors>" (packed = the whole card) into
# its per-probe log. Here we read exactly that many sectors off the card
# (fast, 4 MiB reads, byte-precise skip/count), pipe them through gzip — the
# ~22 GiB of zeros collapse to almost nothing, so a 29 GiB card fits a small
# FAT32 drive — and split the gzip stream into numbered <4 GiB pieces. The
# dev side reassembles with `cat pieces | gunzip`. Skipped quietly if there
# is no finished dump log, so runs that didn't dump aren't affected.
pull_full_dump() {
    local device="$1" stamp="$2"
    local dumplog="${LAB_OUTPUT_DIR}/probe-emmc-dump-${stamp}.log"
    if [[ ! -f "$dumplog" ]]; then
        log "No dump log for this run; skipping eMMC pull."
        return 0
    fi
    # `|| true` inside the $(): a dump that didn't finish has no summary line,
    # so grep finds nothing and the pipeline "fails". Without the guard that
    # failed assignment trips `set -e` and kills the whole script (this is a
    # plain call, errexit is active) instead of the graceful skip below. That
    # case is real — a cancelled or powered-off dump.
    local packed_hex
    packed_hex="$(grep -a 'complete total=' "$dumplog" | sed -E 's/.*packed=(0x[0-9A-Fa-f]+).*/\1/' | head -1 || true)"
    if [[ -z "$packed_hex" ]]; then
        log "Dump log has no 'packed=' summary (dump may not have finished); skipping eMMC pull."
        return 0
    fi
    local sectors=$(( packed_hex ))
    if (( sectors == 0 )); then
        log "Dump wrote 0 sectors; nothing to pull."
        return 0
    fi
    local prefix="${LAB_OUTPUT_DIR}/emmc-${stamp}.img.gz."
    local mib=$(( sectors * 512 / 1024 / 1024 ))
    log "Pulling ${sectors} sectors (~${mib} MiB raw) from LBA ${DUMP_DEST_LBA}, gzip + split into ${SPLIT_SIZE} pieces → ${prefix}NN"
    # Three-stage pipe: sudo dd reads the raw card; gzip (unprivileged)
    # collapses the zeros; sudo split writes the root-owned USB drive. The
    # cached sudo credential covers both privileged ends. skip_bytes/
    # count_bytes let bs be a fast 4 MiB while skip/count stay byte-exact.
    sudo dd if="$device" bs=4M iflag=skip_bytes,count_bytes \
        skip="$(( DUMP_DEST_LBA * 512 ))" count="$(( sectors * 512 ))" status=progress \
        | gzip | sudo split -b "$SPLIT_SIZE" -d - "$prefix"
    log "Compressed pieces written:"
    ls -la "${prefix}"* >&2 || true
}
# }}}

# {{{ inspect_backup() — print the partition layout of the eMMC backup file
# `file` identifies the format if it's recognizable (DOS/MBR, GPT,
# etc.); `gdisk -l` walks the GPT if present and prints the partition
# table. Both tools tolerate the file being only a partial dump as
# long as the GPT header at sector 1 is present.
inspect_backup() {
    local file="$1"
    printf '\n=== eMMC boot-chain backup: format and partition layout ===\n' >&2
    file "$file" >&2
    printf '\n' >&2
    if command -v gdisk >/dev/null 2>&1; then
        sudo gdisk -l "$file" >&2 2>&1 || true
    else
        printf 'gdisk not installed; falling back to fdisk.\n' >&2
        sudo fdisk -l "$file" >&2 2>&1 || true
    fi
    printf '=== end of partition layout ===\n\n' >&2
}
# }}}

# {{{ eject_device() — close out the device cleanly so the kernel forgets it
eject_device() {
    local device="$1"
    log "Ejecting ${device}..."
    if ! sudo eject "$device" 2>/dev/null; then
        log "eject command failed or unavailable; reads were non-destructive so the card is safe to remove."
    fi
}
# }}}

# {{{ write_goodbye() — append the conventional last-thing-a-program-does line
write_goodbye() {
    local stamp
    stamp="$(date -Iseconds)"
    local goodbye_dir
    goodbye_dir="$(dirname "$GOODBYE_FILE")"
    if [[ -d "$goodbye_dir" ]] && [[ -w "$goodbye_dir" ]]; then
        printf '%s dump-from-sd: goodbye\n' "$stamp" >> "$GOODBYE_FILE" || true
    fi
}
# }}}

# {{{ flush_outputs() — force the extracted logs and dumps out to the USB drive
# This script writes all its output (the log/backup images, the per-probe
# split logs, the gzip dump pieces) into lab-output/ on the ALREADY-mounted
# USB drive, and it only ever ejects the SD card — it never unmounts the USB
# drive. So unlike push-to-usb (where the umount flushes on its way out),
# nothing here guarantees those writes reached the physical drive rather than
# sitting in the page cache. A plain sync flushes every mounted filesystem's
# dirty pages; once it returns, the files are safe on the drive and the
# developer can pull it and carry it back to the main machine.
flush_outputs() {
    log "Flushing extracted files to the USB drive..."
    sync
}
# }}}

# {{{ main() — orchestration
main() {
    log "DIR=${DIR}"
    require_sudo

    # The flash-sd script creates lab-output/ on the USB drive root
    # the first time it runs (it has sudo for the SD-card flash).
    # If for some reason flash-sd hasn't run on this drive — fresh
    # USB drive, or the developer is running dump-from-sd without
    # having flashed first — fall back to creating the directory
    # here with sudo. The directory's ownership follows whatever
    # the USB drive's filesystem reports (which on FAT32 isn't
    # Unix ownership at all); the dd output files inherit the
    # default umask and end up world-readable, which is enough.
    if [[ ! -d "$LAB_OUTPUT_DIR" ]]; then
        log "Creating ${LAB_OUTPUT_DIR} (needs sudo because the USB drive's root is root-owned)."
        sudo mkdir -p "$LAB_OUTPUT_DIR"
    fi

    local sd_device
    if [[ $# -ge 2 ]]; then
        sd_device="$2"
        log "Using explicit device override: ${sd_device}"
    else
        sd_device="$(wait_for_sd_card)"
        log "Detected SD device: ${sd_device}"
    fi

    verify_removable "$sd_device"
    unmount_partitions "$sd_device"

    local stamp
    stamp="$(date +%Y%m%d-%H%M%S)"
    local log_file="${LAB_OUTPUT_DIR}/debug-log-${stamp}.img"
    local backup_file="${LAB_OUTPUT_DIR}/emmc-backup-${stamp}.img"

    dump_region "$sd_device" "$DEBUG_LOG_LBA"  "$DEBUG_LOG_SECTORS" "$log_file"    "debug log"
    dump_region "$sd_device" "$BACKUP_LBA"     "$BACKUP_SECTORS"    "$backup_file" "eMMC boot-chain backup"

    inspect_debug_log "$log_file"
    split_probe_logs  "$log_file" "$stamp"
    pull_full_dump  "$sd_device" "$stamp"
    inspect_backup    "$backup_file"

    eject_device "$sd_device"
    write_goodbye
    flush_outputs

    printf '\nFiles saved (carry the USB drive back to the main machine to analyze further):\n' >&2
    printf '  %s\n' "$log_file" >&2
    printf '  %s\n' "$backup_file" >&2
    local piece
    for piece in "${LAB_OUTPUT_DIR}/emmc-${stamp}.img.gz."*; do
        [[ -e "$piece" ]] || continue
        printf '  %s\n' "$piece" >&2
    done
    if [[ -e "${LAB_OUTPUT_DIR}/emmc-${stamp}.img.gz.00" ]]; then
        printf '\nOn the main machine (somewhere with room; NOT the FAT32 drive):\n' >&2
        printf '  cat %s/emmc-%s.img.gz.* > emmc-%s.img.gz      # the gzip archive (~a few GB)\n' \
            "$LAB_OUTPUT_DIR" "$stamp" "$stamp" >&2
        printf '  gunzip -k emmc-%s.img.gz                       # -> emmc-%s.img (29 GiB) to examine\n' \
            "$stamp" "$stamp" >&2
    fi
}
# }}}

main "$@"
