#!/bin/bash

set -euo pipefail

# Ctrl+C handling: when lua is blocked inside an os.execute(curl), curl
# absorbs the SIGINT (exits 130) and lua resumes the next iteration —
# silently swallowing the interrupt. This trap makes bash itself exit
# 130 the moment the signal arrives, regardless of what the child is
# doing, so the EXIT trap below fires immediately and kills the servers.
trap 'echo ""; echo "🛑 Interrupted by user; exiting."; exit 130' INT

DIR="/home/ritz/programming/ai-stuff/words-pdf"

# Issue 027: --natural-themes disables the frequency-weighted theme
# picker (Tier 1/2/3) so the operator can compare evenly-distributed
# theme selection against raw-similarity selection.
# Issue 030 Phase 4: --no-rebuild skips the auto-rebuild stale check so
# the operator can iterate on the renderer (or anything else that
# touches themes/generators.lua mtime) without paying for a fresh
# themes-rebuild every PDF run.
# Both flags are pulled out of the positional-arg list here so the mode
# dispatch below ($1 = "pdf"|"web"|... ; $2 = ordering) does not see
# them as values.
NATURAL_THEMES_FLAG=""
NO_REBUILD=0
FILTERED_ARGS=()
for arg in "$@"; do
    if [ "$arg" = "--natural-themes" ]; then
        NATURAL_THEMES_FLAG="--natural-themes"
    elif [ "$arg" = "--no-rebuild" ]; then
        NO_REBUILD=1
    else
        FILTERED_ARGS+=("$arg")
    fi
done
set -- "${FILTERED_ARGS[@]}"

cd "${DIR}"
# tmp/ is a symlink into /tmp/words-pdf (tmpfs); the target gets wiped on
# reboot, so re-establish it before any mkdir tries to dereference it.
"${DIR}/scripts/ensure-tmp-symlink" "${DIR}"
mkdir -p output/compile-ai output/compile tmp/embeddings tmp/logs

# Tee all output (stdout + stderr) of this script through to a log file
# under tmp/logs, while still showing it on the terminal. Each run gets a
# fresh timestamped log file so previous runs aren't clobbered. The log
# file lives in tmp/ (RAM-backed via /tmp/words-pdf/) so it doesn't
# accumulate on disk; reboot wipes it along with the other ephemeral state.
# Determine a mode tag so each mode's log lands in a separately-named
# file. Easier to grep tmp/logs/ later when you want "the most recent
# themes-rebuild" vs "the most recent PDF run." The case-arg matches
# the mode dispatch below; keep them in sync if either changes.
case "${1:-}" in
    themes-rebuild)             LOG_MODE_TAG="themes-rebuild" ;;
    -I|interactive)             LOG_MODE_TAG="pdf-interactive" ;;
    web)                        LOG_MODE_TAG="web" ;;
    web-chatbot)                LOG_MODE_TAG="web-chatbot" ;;
    web-old)                    LOG_MODE_TAG="web-old" ;;
    *)                          LOG_MODE_TAG="pdf" ;;
esac
LOG_FILE="${DIR}/tmp/logs/${LOG_MODE_TAG}-$(date +%Y%m%d-%H%M%S).log"
# Issue 026: libs/progress-ui.lua needs LOG_FILE in its environment so it
# can mirror the per-page redraw region into the same log this script
# tees to. Without the export the lua process sees a nil env var and
# init() errors out.
export LOG_FILE
exec > >(tee "$LOG_FILE") 2>&1
echo "📜 Logging to $LOG_FILE"

# Backup Claude conversation transcripts
echo "Backing up Claude conversation transcripts..."
if command -v python3 &> /dev/null && [ -f /home/ritz/programming/ai-stuff/scripts/backup-conversations ]; then
    source /home/ritz/programming/ai-stuff/scripts/backup-conversations
    write-transcripts-to-project-directory "${DIR}" 2>/dev/null || echo "  (No new transcripts to backup)"
else
    echo "  (Transcript backup unavailable - missing python3 or backup-conversations script)"
fi

# Check if WebAssembly module needs building
if [ ! -f "${DIR}/src/spacebar-handler.wasm" ]; then
    echo "Building WebAssembly module for web interface..."
    "${DIR}/build-wasm.sh" "${DIR}"
fi

export \
   LD_LIBRARY_PATH=${DIR}/libs/cuda/lib64:${DIR}/libs/libharu-RELEASE_2_3_0/build/src:$LD_LIBRARY_PATH

# Issue 025: the project's AI paths talk to project-local llama-server
# instances (one for embeddings, one for chat) instead of an external
# Ollama install. Launch them in the background; the trap below kills
# whatever this script started, regardless of whether the lua pipeline
# below succeeds, fails, or gets Ctrl+C'd.
#
# An already-running server (e.g. one the operator started in another
# terminal via ./scripts/start-llamacpp-server.sh) is left alone — the
# start script only writes a pid file for servers IT actually launched,
# so the cleanup below only kills those.
"${DIR}/scripts/start-llamacpp-server.sh" --background "${DIR}"

# {{{ stop_llamacpp_servers()
# Kill any llama-server we started, identified by PID files the start
# script wrote. `kill -0` confirms the PID is still our process before
# we send SIGTERM, since /run could be interrupted between the start
# script writing the file and the server actually launching (unlikely,
# but defensive). Files are removed unconditionally — a stale pid file
# is worse than no file at all for future runs.
stop_llamacpp_servers() {
    local label pid pid_file waited
    for label in embed chat; do
        pid_file="${DIR}/tmp/llamacpp-${label}.pid"
        if [ ! -f "${pid_file}" ]; then
            continue
        fi
        pid=$(cat "${pid_file}" 2>/dev/null || true)
        if [ -n "${pid}" ] && kill -0 "${pid}" 2>/dev/null; then
            echo "🛑 Stopping ${label} server (PID ${pid})"
            kill "${pid}" 2>/dev/null || true
            # SIGTERM lets llama-server flush and unmap the model cleanly,
            # but it returns immediately — the GPU's VRAM is not actually
            # freed until the process has exited. Wait for that so the next
            # run (or the operator's next GPU command) doesn't collide with
            # a server still tearing down. If it ignores SIGTERM for 10s
            # (wedged in a CUDA call, say), escalate to SIGKILL rather than
            # leak a process holding the card hostage. Each branch is a
            # condition or `|| true` so the EXIT trap never aborts mid-cleanup
            # under `set -e` and always reaches the other server.
            waited=0
            while kill -0 "${pid}" 2>/dev/null && [ "${waited}" -lt 10 ]; do
                sleep 1
                waited=$((waited + 1))
            done
            if kill -0 "${pid}" 2>/dev/null; then
                echo "   ⚠ ${label} server ignored SIGTERM after ${waited}s; sending SIGKILL"
                kill -9 "${pid}" 2>/dev/null || true
            else
                echo "   ✓ ${label} server stopped (after ${waited}s)"
            fi
        fi
        rm -f "${pid_file}"
    done
}
# }}}
trap stop_llamacpp_servers EXIT

# input/compiled.txt is the user's source of truth. The embedding server's
# JSON parser hard-rejects ill-formed UTF-8 and goes silly on whole-block
# binary blobs (one block in this corpus is/was an embedded PDF), so we
# pre-clean the file into a transient copy under tmp/ on every run. The
# cleaner is idempotent — running it twice produces the same bytes — and
# the original input/compiled.txt is never touched.
"${DIR}/scripts/clean-compiled-input.sh" "${DIR}"
INPUT_FILE="${DIR}/tmp/compiled-cleaned.txt"

# {{{ Interactive poem ordering selection function
show_poem_ordering_menu() {
    echo "========================================"
    echo "WORDS-PDF - POEM ORDERING SELECTION"
    echo "========================================"
    echo ""
    echo "📝 Available poem ordering methods:"
    echo "   [1] Normal - Original poem order (default)"
    echo "   [2] Reverse - Sophisticated reverse ordering with cross-compilation validation"
    echo "   [3] Both - Generate both versions with different output names"
    echo ""
    echo "🎯 Select ordering method:"
    echo "   • Index selection: 1, 2, 3"
    echo "   • Vim-style: 'i' to confirm selection"
    echo -n "   Choice: "
    
    read selected_choice
    
    # Validate selection
    case "$selected_choice" in
        1|"normal")
            echo "✅ Selected: Normal poem ordering"
            POEM_ORDERING="normal"
            ;;
        2|"reverse") 
            echo "✅ Selected: Reverse ordering with cross-compilation validation"
            POEM_ORDERING="reverse"
            ;;
        3|"both")
            echo "✅ Selected: Both versions (dual output)"
            POEM_ORDERING="both"
            ;;
        "i")
            echo "📋 Please first select 1, 2, or 3, then use 'i' to confirm"
            show_poem_ordering_menu
            return
            ;;
        *)
            echo "❌ Invalid selection: $selected_choice"
            echo "   Valid options: 1 (normal), 2 (reverse), 3 (both)"
            echo ""
            show_poem_ordering_menu
            return
            ;;
    esac
    
    echo ""
    echo "🔧 Configuration:"
    echo "   Poem Ordering: $POEM_ORDERING"
    echo "   Input File: ${DIR}/input/compiled.txt" 
    echo ""
}
# }}}

# {{{ ensure_themes_fresh_or_rebuild
# Issue 029 introduced this check; Issue 030 Phase 4 upgrades it from
# hard-error to auto-rebuild. PDF generation depends on
# themes/derived-taxonomy.lua (compile-pdf-ai.lua loads it for cluster
# centroids, generator mappings, and parameter axes). Stale means
# either the input corpus or the generator registry has been modified
# since the taxonomy was built — in both cases the taxonomy needs to
# be regenerated to stay consistent.
#
# Auto-rebuild runs themes-v2/run.sh in-line before PDF generation.
# Cost: a few seconds (cache-warm) to ~3 min (LLM naming) depending on
# what changed and how much of the cache is fresh.
#
# --no-rebuild skips the rebuild even when stale and just warns. Useful
# during iterative renderer work where themes/generators.lua advances
# mtime on every save but the operator knows the taxonomy is still
# usable for their experiment.
ensure_themes_fresh_or_rebuild() {
    local TAXONOMY="${DIR}/themes/derived-taxonomy.lua"
    local CORPUS="${DIR}/input/compiled.txt"
    local GENERATORS="${DIR}/themes/generators.lua"

    local STALE_REASON=""
    if [ ! -f "${TAXONOMY}" ]; then
        STALE_REASON="missing"
    elif [ "${TAXONOMY}" -ot "${CORPUS}" ]; then
        STALE_REASON="older than corpus (${CORPUS})"
    elif [ "${TAXONOMY}" -ot "${GENERATORS}" ]; then
        STALE_REASON="older than generators registry (${GENERATORS})"
    fi

    if [ -z "${STALE_REASON}" ]; then
        return 0  # fresh; nothing to do
    fi

    if [ "${NO_REBUILD}" -eq 1 ]; then
        echo "⚠ Theme taxonomy is stale (${STALE_REASON}) but --no-rebuild is set; proceeding with current taxonomy"
        if [ ! -f "${TAXONOMY}" ]; then
            echo "❌ ...but the taxonomy file does not exist, so we cannot proceed at all."
            echo "   Run './run themes-rebuild' once first, then './run --no-rebuild' for subsequent iteration."
            exit 1
        fi
        return 0
    fi

    echo ""
    echo "════════════════════════════════════════════════════════════════"
    echo "▶ Auto-rebuilding themes (taxonomy is ${STALE_REASON})"
    echo "  themes-v2/run.sh output follows. Pass --no-rebuild to skip."
    echo "════════════════════════════════════════════════════════════════"
    "${DIR}/themes-v2/run.sh" "${DIR}"
    echo "════════════════════════════════════════════════════════════════"
    echo "▶ Auto-rebuild complete; resuming PDF generation"
    echo "════════════════════════════════════════════════════════════════"
    echo ""
}
# }}}

# Check if user wants to run web server, theme rebuild, or PDF generation
if [ "${1:-}" = "themes-rebuild" ]; then
    # Theme discovery pipeline (issue 029). Bypasses the PDF generator
    # entirely; outputs themes/derived-taxonomy.lua.
    echo "🧠 Rebuilding theme taxonomy via themes-v2/run.sh"
    "${DIR}/themes-v2/run.sh" "${DIR}"
    echo ""
    echo "✅ Theme taxonomy rebuilt: ${DIR}/themes/derived-taxonomy.lua"
    echo "   Now run './run' to generate the PDF using the new themes."
elif [ "${1:-pdf}" = "-I" ] || [ "${1:-}" = "interactive" ]; then
    ensure_themes_fresh_or_rebuild
    # Interactive mode for poem ordering selection
    show_poem_ordering_menu
    
    # Generate PDF(s) based on selection
    if [ "$POEM_ORDERING" = "both" ]; then
        echo "📄 Generating normal ordering PDF..."
        lua5.2 ./compile-pdf-ai.lua "${DIR}" "${INPUT_FILE}" "normal" $NATURAL_THEMES_FLAG
        mv output/compile-ai/output.pdf output/compile-ai/output-normal.pdf

        echo "📄 Generating reverse ordering PDF..."
        lua5.2 ./compile-pdf-ai.lua "${DIR}" "${INPUT_FILE}" "reverse" $NATURAL_THEMES_FLAG
        mv output/compile-ai/output.pdf output/compile-ai/output-reverse.pdf

        echo "✅ Generated both versions:"
        echo "   📘 output/compile-ai/output-normal.pdf"
        echo "   📗 output/compile-ai/output-reverse.pdf"
    else
        echo "📄 Generating PDF with $POEM_ORDERING ordering..."
        lua5.2 ./compile-pdf-ai.lua "${DIR}" "${INPUT_FILE}" "$POEM_ORDERING" $NATURAL_THEMES_FLAG

        if [ "$POEM_ORDERING" = "reverse" ]; then
            mv output/compile-ai/output.pdf output/compile-ai/output-reverse.pdf
            echo "✅ Generated: 📗 output/compile-ai/output-reverse.pdf"
        else
            echo "✅ Generated: 📘 output/compile-ai/output.pdf"
        fi
    fi
    
elif [ "${1:-pdf}" = "web" ]; then
    CHAR_LIMIT=${2:-80}  # Second argument is character limit (default 80)
    echo "Starting simple continuous chat server (${CHAR_LIMIT} char limit)..."
    luajit "${DIR}/src/web-server.lua" "${CHAR_LIMIT}"
elif [ "${1:-}" = "web-chatbot" ]; then
    CHAR_LIMIT=${2:-80}  # Second argument is character limit (default 80)
    echo "Starting conversational chatbot server with WebAssembly security (${CHAR_LIMIT} char limit)..."
    luajit "${DIR}/src/chatbot-server.lua" "${CHAR_LIMIT}"
elif [ "${1:-}" = "web-old" ]; then
    echo "Starting old web server..."
    luajit "${DIR}/src/web-server-old.lua"
else
    ensure_themes_fresh_or_rebuild
    # Default PDF generation with optional ordering parameter
    ORDERING=${2:-"normal"}
    echo "Generating PDF with $ORDERING ordering..."
    lua5.2 ./compile-pdf-ai.lua "${DIR}" "${INPUT_FILE}" "$ORDERING" $NATURAL_THEMES_FLAG

    if [ "$ORDERING" = "reverse" ]; then
        mv output/compile-ai/output.pdf output/compile-ai/output-reverse.pdf
        echo "✅ Generated: 📗 output/compile-ai/output-reverse.pdf"
    else
        echo "✅ Generated: 📘 output/compile-ai/output.pdf"
    fi
fi

