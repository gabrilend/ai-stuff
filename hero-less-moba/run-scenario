#!/usr/bin/env bash
#
# run-scenario -- load a described world, hold it at the gate, and look at it.
#
# **This is now a shim.** A scenario is a test whose ground is the whole map, and it is
# read, arranged, run and reported by the same bench that reads a scene. See
# scripts/run-a-test.
#
# It stays because the documents say "./run-scenario <name>" in a good many places.
#
# Usage:
#   ./run-scenario                  -- list every test
#   ./run-scenario <name>           -- open it in the window, held
#   ./run-scenario <name> report    -- run it with no window and print the numbers
#   ./run-scenario /path/to/prj <name>

DIR="/mnt/mtwo/programming/ai-stuff/hero-less-moba"

if [ -d "$1/issues" ] && [ -d "$1/src" ]; then
    DIR="$1"
    shift
fi

NAME="$1"
MODE="$2"

if [ -z "${NAME}" ]; then
    exec "${DIR}/scripts/run-a-test" "${DIR}"
fi

# The old script's `step`, `go` and `until` modes are gone rather than forwarded. How
# long a test runs is now a field in the test, so that two people running the same test
# run the same test; naming a different number on the command line made every reported
# figure depend on what somebody typed.
if [ "${MODE}" = "report" ]; then
    exec "${DIR}/scripts/run-a-test" "${DIR}" "${NAME}" report
fi

exec "${DIR}/scripts/run-a-test" "${DIR}" "${NAME}"
