#!/usr/bin/env bash
#
# run-many-matches -- play the game a great many times with nobody watching, and
# print the table you read in the morning.
#
# This is the other half of the reason the simulation and the viewer are separate
# programs. A window shows one match at one speed; this shows a thousand, and every
# question in the open-questions page marked "awaiting evidence" is waiting on it.
# Those are not decisions nobody has made -- they are measurements nobody has taken.
#
# Each match runs from a different seed with the measuring bot behind both sides. What
# comes out is deliberately made of the numbers a balance question is asked in: who
# won, how long it took, how far each lane got, how much of the chest was ever placed,
# and how much income was thrown away because a wallet was full.
#
# Usage:
#   ./run-many-matches              -- 50 matches
#   ./run-many-matches 1000         -- a thousand
#   ./run-many-matches 1000 60000   -- and a longer tick limit each
#   ./run-many-matches /path/to/prj 1000

DIR="/mnt/mtwo/programming/ai-stuff/hero-less-moba"

if [ -d "$1/issues" ] && [ -d "$1/src" ]; then
    DIR="$1"
    shift
fi

COUNT="${1:-50}"
LIMIT="${2:-60000}"

# How many at once. One match is a single-threaded walk over flat arrays and will not
# go faster; a thousand matches are a thousand independent walks and should not be
# done one at a time.
#
# The first version of this ran them in sequence and took thirty seconds a match,
# which puts ten thousand matches at three and a half days. The whole point of the
# thing is that you read the table in the morning.
WORKERS="${3:-$(nproc 2>/dev/null || echo 4)}"

mkdir -p "/dev/shm/hero-less-moba"
LOG="/dev/shm/hero-less-moba/many-matches.csv"

echo "Playing ${COUNT} matches, up to ${LIMIT} ticks each, ${WORKERS} at a time."
echo "Per-match rows go to ${LOG}"
echo

# Each worker takes every Nth seed, so a short run still spreads across the range
# rather than giving one worker all the low seeds.
PARTS="/dev/shm/hero-less-moba/parts"
rm -rf "${PARTS}"
mkdir -p "${PARTS}"

STARTED="$(date +%s)"
for WORKER in $(seq 0 $((WORKERS - 1))); do
    luajit -e "
    local root = '${DIR}'
    local tick_module = loadfile(root .. '/src/042-the-tick.lua')()
    local out = io.open('${PARTS}/${WORKER}', 'w')
    for match = 1, ${COUNT} do
      if match % ${WORKERS} == ${WORKER} then
        local modules = tick_module.load_cast(root)
        local parameters = modules.match_parameters.load()
        parameters = setmetatable({seed = parameters.seed + match}, {__index = parameters})
        local world = tick_module.assemble(modules, parameters)
        local surges, challenges = 0, 0
        while world.tick < ${LIMIT} do
          if not tick_module.advance(world) then break end
          for _, e in ipairs(world.event) do
            if e.name == 'surge_began' then surges = surges + 1 end
            if e.name == 'challenge_began' then challenges = challenges + 1 end
          end
        end
        local drawn, placed, wasted, heroes = {}, {}, {}, {}
        for team = 1, 2 do
          drawn[team] = world.team[team].draws_taken
          local _, in_lanes, in_stone = world.chest.total_held(world, team)
          placed[team] = in_lanes + in_stone
          wasted[team], heroes[team] = 0, 0
          for _, number in ipairs(world.team_players[team]) do
            local player = world.player[number]
            for colour = 1, world.colour_count do
              wasted[team] = wasted[team] + player.points_wasted[colour]
            end
            heroes[team] = heroes[team] + player.heroes_bought
          end
        end
        local towers = {0, 0}
        for _, s in ipairs(world.structure) do
          if s.alive == 1 and s.kind ~= 3 then towers[s.team] = towers[s.team] + 1 end
        end
        out:write(string.format('%d,%d,%d,%d,%d,%d,%d,%d,%d,%d,%d,%d,%d,%d,%d\n',
          parameters.seed, world.winner, world.tick,
          drawn[1], drawn[2], placed[1], placed[2], wasted[1], wasted[2],
          heroes[1], heroes[2], towers[1], towers[2], surges, challenges))
        out:flush()
      end
    end
    out:close()
    " &
done
wait
ELAPSED=$(( $(date +%s) - STARTED ))

echo 'seed,winner,ticks,drawn_1,drawn_2,placed_1,placed_2,wasted_1,wasted_2,heroes_1,heroes_2,towers_1,towers_2,surges,challenges' > "${LOG}"
cat "${PARTS}"/* >> "${LOG}"

python3 - "${LOG}" "${ELAPSED}" <<'SUMMARY'
import csv, sys

rows = list(csv.DictReader(open(sys.argv[1])))
elapsed = int(sys.argv[2])
count = len(rows)
if count == 0:
    print("no matches completed")
    raise SystemExit(1)

def total(field):
    return sum(int(r[field]) for r in rows)

wins = {0: 0, 1: 0, 2: 0, 3: 0}
for r in rows:
    wins[int(r["winner"])] += 1

decided = [r for r in rows if int(r["winner"]) in (1, 2)]

print(f"{count} matches in {elapsed}s -- {count / max(1, elapsed):.1f} a second")
print()
for team, label in ((1, "team 1 won"), (2, "team 2 won")):
    print(f"  {label:<16}{wins[team]:5d}  ({100 * wins[team] / count:.0f}%)")
print(f"  {'drawn':<16}{wins[3]:5d}  ({100 * wins[3] / count:.0f}%)")
print(f"  {'never finished':<16}{wins[0]:5d}  ({100 * wins[0] / count:.0f}%)")
print()
if decided:
    ticks = sum(int(r["ticks"]) for r in decided) / len(decided)
    print(f"  a decided match lasts {ticks / 30 / 60:.1f} minutes on average")
drawn = total("drawn_1") + total("drawn_2")
placed = total("placed_1") + total("placed_2")
heroes = total("heroes_1") + total("heroes_2")
wasted = total("wasted_1") + total("wasted_2")
print(f"  {drawn / count:.0f} upgrades drawn per match, {100 * placed / max(1, drawn):.0f}% of them ever placed")
print(f"  {heroes / count:.0f} heroes bought per match")
print(f"  {wasted / count:.0f} points of income thrown away per match -- a full wallet loses it")
print(f"  {(total('surges')) / count:.1f} surges and {(total('challenges')) / count:.1f} challenges per match")
print()
print("Two numbers to read first. A side winning far more than half is an asymmetry")
print("nobody put there. And a large share of upgrades never placed means the chest is")
print("filling faster than anybody can empty it.")
SUMMARY
