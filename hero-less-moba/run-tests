#!/usr/bin/env bash
#
# run-tests -- everything this project checks about itself, in one command.
#
# Two halves, and they are genuinely different kinds of check.
#
# The written half: this project had documents and issue files long before it had
# a line of code, and they reference each other constantly. The documentation
# validator is the compiler for them -- it finds broken links, malformed issues,
# roadmap drift, and questions that were answered without the issues citing them
# being updated.
#
# The running half: the properties the simulation refuses to break. Determinism,
# the camera's anchor, the map's symmetry, and the premise itself -- that putting
# upgrades in a lane moves a frontline.
#
# Both halves exit non-zero on failure, so this can be wired into a build.
#
# Usage:
#   ./run-tests                  -- everything
#   ./run-tests docs             -- only the written half
#   ./run-tests code             -- only the running half
#   ./run-tests /path/to/project -- elsewhere

DIR="/mnt/mtwo/programming/ai-stuff/hero-less-moba"

# **The tests pin their own seed, and do not read the one in input/.**
#
# That file may say `random`, which is what it should say for anybody looking at the
# game: every match, scene and screenshot coming out of one seed means everybody has
# only ever watched one match, and a rule that is broken in general looks fine because
# the one arrangement everybody saw happened not to hit it.
#
# A test suite wants the opposite. Half of what is asserted here is *that the same
# inputs produce the same match* -- the rules stamp, the replay keyframes, the
# divergence bound -- and a suite whose seed moved under it would fail those for the
# one reason that is not a bug. So the seed is named here, out loud, and overriding it
# is how you ask "does this hold for a different match" rather than something that
# happens by accident.
#
#   HLM_SEED=99 ./run-tests    -- the same suite, a different match
export HLM_SEED="${HLM_SEED:-20260826}"

# A leading argument is taken as a project root only when it actually looks like
# one. Testing for "is a directory" alone is not enough: this script's own modes
# are words like "docs" and "code", and a directory of that name in the working
# directory would silently be mistaken for a checkout.
if [ -d "$1/issues" ] && [ -d "$1/src" ]; then
    DIR="$1"
    shift
fi

WHICH="${1:-all}"
FAILED=0

if [ "${WHICH}" = "all" ] || [ "${WHICH}" = "docs" ]; then
    echo "== the written half =="
    "${DIR}/validate-documentation" "${DIR}"
    if [ "$?" -ne 0 ]; then
        FAILED=1
    fi
    echo
fi

if [ "${WHICH}" = "all" ] || [ "${WHICH}" = "code" ]; then
    echo "== the running half =="
    luajit "${DIR}/tests/051-the-invariants.lua"
    if [ "$?" -ne 0 ]; then
        FAILED=1
    fi

    # The formation on a bare field, separately, because a failure here should point
    # at the formation rather than at whatever else happened to be running.
    echo
    luajit "${DIR}/tests/060-the-formation-sandbox.lua"
    if [ "$?" -ne 0 ]; then
        FAILED=1
    fi
fi

exit "${FAILED}"
