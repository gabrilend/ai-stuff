#!/usr/bin/env bash
#
# run-arena -- open one rule on a small square of ground, and watch it.
#
# **This is now a shim.** There is one kind of test in this project and one front door
# over all of them, at scripts/run-a-test. A scene on a short straight road and a
# scenario on the whole map differ by one field in the file rather than by which script
# you remember, so keeping two scripts meant keeping two sets of arguments for one thing.
#
# It stays because a great deal of documentation says "./run-arena <scene>", and a
# reference that used to work and now silently does nothing is worse than a reference
# that works.
#
# Usage:
#   ./run-arena                     -- list every test
#   ./run-arena <scene>             -- open it in the window, held
#   ./run-arena <scene> headless    -- run it with no window and print the numbers
#   ./run-arena /path/to/prj <scene>

DIR="/mnt/mtwo/programming/ai-stuff/hero-less-moba"

if [ -d "$1/issues" ] && [ -d "$1/src" ]; then
    DIR="$1"
    shift
fi

SCENE="$1"
MODE="${2:-window}"

if [ -z "${SCENE}" ]; then
    exec "${DIR}/scripts/run-a-test" "${DIR}"
fi

# This script's "headless" is the front door's "report". Everything else means the window,
# which both scripts now default to.
if [ "${MODE}" = "headless" ]; then
    exec "${DIR}/scripts/run-a-test" "${DIR}" "${SCENE}" report
fi

exec "${DIR}/scripts/run-a-test" "${DIR}" "${SCENE}"
