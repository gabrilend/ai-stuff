#!/usr/bin/env bash
#
# run-a-test -- the one front door to everything this project checks about itself.
#
# Before this existed there were three ways to run a test and three sets of arguments to
# remember: one script for a scene on a small square of ground, another for a scenario on
# the whole map, and a third that ran two Lua suites and the documentation validator.
# Nothing listed them together, so "what does this project actually check" had no answer
# short of reading four directories.
#
# There is now one kind of test. A test is a table that names things -- which mechanics
# it demonstrates, which ground it stands on, which machinery to hang, how to arrange the
# bodies, which part of the tick to run, what to measure and what to claim -- and every
# one of those names is looked up in the engine. **A test contains no behavior of its
# own**, which is what stops a test quietly becoming an instrument that measures itself.
#
# Usage:
#   ./scripts/run-a-test                    -- list every test
#   ./scripts/run-a-test <name>             -- open it in a window, held
#   ./scripts/run-a-test <name> report      -- run it with no window and print the numbers
#   ./scripts/run-a-test all                -- run every test, and fail if any claim fails
#   ./scripts/run-a-test /path/to/prj ...   -- against a checkout somewhere else
#
# **Some tests are performed by a person**, because a third of what this project is made
# of is not a mechanic a world can be measured for: the headless runner and the terminal
# viewer are tools, the proving ground is the ground the other tests stand on, and the
# whole drawing phase is a window that has to be looked at.
#
# One of those names a command and one question per mechanic it covers. Running it prints
# what to look for, runs the command, waits, and then asks -- y for yes, n for no, x for
# could not reproduce, r to run it again. Answers append to by-hand/what-was-seen.md, and
# `all` reads that back and prints whatever was not a yes before listing the tests nobody
# has looked at yet. `all` does not run them: a build cannot look at anything.
#
# **The window is the default and the report is the mode you ask for.** It was the other
# way round for about an hour and that was wrong: the numbers are a summary of something,
# and the something is the thing you came to look at. A test that reports front, back and
# depth has told you a column crossed a road; it has not told you how, and how is nearly
# always the question. `all` still reports rather than opening fifteen windows.

DIR="/mnt/mtwo/programming/ai-stuff/hero-less-moba"

# A leading argument is taken as a project root only when it looks like one. Testing for
# "is a directory" alone is not enough: this script's own modes are words, and a
# directory of that name in the working directory would be mistaken for a checkout.
if [ -d "$1/issues" ] && [ -d "$1/src" ]; then
    DIR="$1"
    shift
fi

NAME="$1"
MODE="${2:-watch}"

# **The tests pin their own seed and do not read the one in input/.**
#
# That file may say `random`, which is what it should say for anybody looking at the
# game: every match and scene coming out of one seed means everybody has only ever
# watched one match, and a rule broken in general looks fine because the one arrangement
# everybody saw happened not to hit it.
#
# A test wants the opposite. A claim that holds on Tuesday and fails on Wednesday
# because the seed moved underneath it is a claim nobody can act on -- and this was not
# hypothetical: the first runs of the crossing scene reported bodies stepping off the
# road on one seed and staying on it on the next.
#
#   HLM_SEED=99 ./scripts/run-a-test <name>   -- the same test, a different world
export HLM_SEED="${HLM_SEED:-20260826}"

# The RAM tiers, recreated rather than assumed -- /tmp and /dev/shm do not survive a
# reboot and the symlinks in the repository would otherwise dangle.
mkdir -p "/tmp/hero-less-moba/tmp"
mkdir -p "/dev/shm/hero-less-moba"
if [ ! -e "/tmp/hero-less-moba/shared-memory" ]; then
    ln -sfn "/dev/shm/hero-less-moba" "/tmp/hero-less-moba/shared-memory"
fi

# Everything below is a call into the bench. The logic of listing, running, measuring and
# judging lives in Lua beside the simulation it is measuring, for the same reason a test
# may not define behavior: a shell script that computed a number about the world would be
# one more place holding an opinion about what the world is doing.

if [ -z "${NAME}" ]; then
    luajit -e "
    local bench = loadfile('${DIR}/src/071-the-bench.lua')()
    print('')
    print('Tests:')
    print('')
    for _, entry in ipairs(bench.list('${DIR}')) do
      local test = bench.read('${DIR}', entry.name)
      print(string.format('  %-28s %-6s covers %s',
                          entry.name, entry.ground, table.concat(test.covers, ', ')))
      print(string.format('  %-28s %s', '', test.name))
      print('')
    end
    "
    exit 0
fi

if [ "${NAME}" = "all" ]; then
    luajit -e "
    local bench = loadfile('${DIR}/src/071-the-bench.lua')()
    local failed = 0
    local by_hand = {}
    for _, entry in ipairs(bench.list('${DIR}')) do
      local test = bench.read('${DIR}', entry.name)
      if bench.ground[test.ground].by_hand then
        -- Skipped rather than failed. A test somebody performs cannot be run by a build,
        -- and treating it as a failure would make the build red for a reason nobody can
        -- fix at a keyboard. It is listed at the end instead, which is the whole point:
        -- the build's job here is to remember to ask.
        by_hand[#by_hand + 1] = entry.name
      else
        local report = bench.run('${DIR}', entry.name)
        print(bench.tell(report))
        if not report.held then failed = failed + 1 end
      end
    end
    -- **What a person said last time, before what nobody has looked at yet.** A build
    -- that only ever listed the tests needing a person would be a build that forgot every
    -- answer the moment it was given, and the point of writing them down is that the next
    -- person to open this project starts from what the last one saw.
    local left = bench.outstanding('${DIR}')
    if #left > 0 then
      print('')
      print('Answered by somebody, and not with a yes:')
      for _, row in ipairs(left) do
        print(string.format('    %-6s %-10s %s', row.mechanic, row.verdict,
                            (row.note ~= '' and row.note) or row.test))
      end
    end
    if #by_hand > 0 then
      print('')
      print(#by_hand .. ' test(s) need a person. Run each of these and answer what it asks:')
      for _, name in ipairs(by_hand) do
        print('    ./scripts/run-a-test ' .. name)
      end
    end
    if failed > 0 then
      print('')
      print(failed .. ' test(s) made a claim that did not hold.')
      os.exit(1)
    end
    "
    exit "$?"
fi

# **A test whose instrument is somebody's eyes.**
#
# It names a command and one question per mechanic it covers. This runs the command,
# waits for it to finish, and then asks -- in that order, because a question asked before
# the thing has been seen is a question answered from memory of the last time.
#
# Four verdicts, and the third is the one that earns its place:
#
#   y   it does that
#   n   it does something else
#   x   could not reproduce -- the run never got into the state the question is about
#   r   run it again
#
# **`x` is a finding about the simulation, not about the person.** A question nobody can
# answer because the situation never arose means the thing that was supposed to produce
# that situation does not, and that is a build fault sitting where a test failure would be
# if a bench could reach it. It is written down as loudly as a `no`.
BY_HAND="$(luajit -e "
local bench = loadfile('${DIR}/src/071-the-bench.lua')()
local test = bench.read('${DIR}', '${NAME}')
io.write(bench.ground[test.ground].by_hand and 'yes' or 'no')
")"

if [ "${BY_HAND}" = "yes" ]; then
    RECORD="${DIR}/by-hand/what-was-seen.md"
    SCRATCH="/tmp/hero-less-moba/tmp/by-hand-${NAME}"

    # The questions pulled out once, one per line, mechanic and question separated by a
    # tab -- so the loop below reads them rather than calling back into Lua per question.
    luajit -e "
    local bench = loadfile('${DIR}/src/071-the-bench.lua')()
    local test = bench.read('${DIR}', '${NAME}')
    for _, row in ipairs(test.ask) do
      io.write(row[1], '\t', row[2], '\n')
    end
    " > "${SCRATCH}"

    RUN="$(luajit -e "
    local bench = loadfile('${DIR}/src/071-the-bench.lua')()
    io.write(bench.read('${DIR}', '${NAME}').run)
    ")"

    luajit -e "
    local bench = loadfile('${DIR}/src/071-the-bench.lua')()
    print(table.concat(bench.script(bench.read('${DIR}', '${NAME}')), '\n'))
    "

    # The header, written once ever. Everything after it is one row per answer, which is
    # what makes the file readable by a person and greppable by whoever picks it up.
    if [ ! -f "${RECORD}" ]; then
        {
            printf '# What Was Seen\n\n'
            printf 'Answers from the tests a person performs. Append-only.\n\n'
            printf 'A verdict of `not built` means the run never got into the state the\n'
            printf 'question is about -- a fault in the simulation, sitting where a test\n'
            printf 'failure would be if a bench could reach it. Those are the rows to pick\n'
            printf 'up first.\n\n'
            printf '| when | test | mechanic | verdict | what was said |\n'
            printf '| --- | --- | --- | --- | --- |\n'
        } > "${RECORD}"
    fi

    # The command is run from the project root, because a test names its front doors the
    # way the documents do -- ./run-prototype -- and those are written relative to it.
    printf '\n  Running: %s\n\n' "${RUN}"
    env -C "${DIR}" sh -c "${RUN}"

    WHEN="$(date -u '+%Y-%m-%d %H:%M')"
    NOT_BUILT=0

    # **The questions are read on their own descriptor**, because the prompts inside this
    # loop have to read from the terminal. Fed through plain standard input, the file of
    # questions *is* standard input, and the first answer somebody types is never seen --
    # the read that asks for it takes the next question instead and calls it an answer.
    while IFS="$(printf '\t')" read -r MECHANIC QUESTION <&3; do
        VERDICT=""
        while [ -z "${VERDICT}" ]; do
            printf '\n  [%s] %s\n' "${MECHANIC}" "${QUESTION}"
            printf '  y yes   n no   x could not reproduce   r run it again  > '
            # **A closed input ends the questioning rather than looping on it.** Without
            # this, anything that is not a person at a keyboard -- a pipe, a build, a
            # terminal that went away -- spins here forever printing the same prompt,
            # because a read that reaches the end of its input succeeds at reading
            # nothing and the nothing is not one of the four letters.
            if ! read -r REPLY; then
                printf '\n  Nobody there. Stopping, and writing down what was answered.\n'
                break 2
            fi
            case "${REPLY}" in
                y|Y) VERDICT="yes" ;;
                n|N) VERDICT="no" ;;
                x|X) VERDICT="not built" ; NOT_BUILT=$((NOT_BUILT + 1)) ;;
                r|R) printf '\n  Running: %s\n\n' "${RUN}"
                     env -C "${DIR}" sh -c "${RUN}" ;;
                *)   printf '  y, n, x or r.\n' ;;
            esac
        done

        # Asked only when the answer is not a plain yes. A note on every yes is a prompt
        # people learn to hit return through, and then the notes that matter are lost
        # among the ones that are not.
        NOTE=""
        if [ "${VERDICT}" != "yes" ]; then
            printf '  What did you see instead? '
            read -r NOTE
        fi

        printf '| %s | %s | %s | %s | %s |\n' \
            "${WHEN}" "${NAME}" "${MECHANIC}" "${VERDICT}" "${NOTE}" >> "${RECORD}"
    done 3< "${SCRATCH}"

    rm -f "${SCRATCH}"

    printf '\n  Written to %s\n' "${RECORD}"
    if [ "${NOT_BUILT}" -gt 0 ]; then
        printf '  %s of those could not be reproduced. That is the simulation, not you.\n' \
            "${NOT_BUILT}"
    fi
    exit 0
fi

if [ "${MODE}" = "watch" ]; then
    if ! command -v love > /dev/null; then
        echo "LOVE is not installed, and the window needs it."
        echo "The same test runs with no window at all:"
        echo "    ${DIR}/scripts/run-a-test ${NAME} report"
        exit 1
    fi

    echo "Opening ${NAME}, held."
    echo
    echo "  P              start it, and hold it again"
    echo "  1 / 2 / 3      speed"
    echo "  R              back to the beginning"
    echo "  ESC            close"
    echo
    echo "  Bodies ringed in red are ones whose step was moved out of somebody."
    echo "  The yellow body is a stray, drawn with the room it keeps around itself."
    echo

    HLM_START="test:${NAME}" love "${DIR}"
    exit "$?"
fi

luajit -e "
local bench = loadfile('${DIR}/src/071-the-bench.lua')()
local report = bench.run('${DIR}', '${NAME}')
print(bench.tell(report))
if not report.held then os.exit(1) end
"
