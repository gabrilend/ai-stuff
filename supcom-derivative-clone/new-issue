## Still open

Nothing beyond the questions in the table.
MD

    # The row goes after the last issue row of the progress table. The table is
    # the only thing in that file that starts with "| " followed by a digit, so
    # the last such line is the anchor; a file with no rows yet anchors on the
    # header's separator line instead.
    local row="| ${number} | ${title} | not started |"
    local anchor
    anchor="$(grep -n '^| [0-9]' "${progress}" | tail -1 | cut -d: -f1)"
    if [ -z "${anchor}" ]; then
        anchor="$(grep -n '^| --- | --- | --- |' "${progress}" | head -1 | cut -d: -f1)"
    fi
    if [ -z "${anchor}" ]; then
        echo "The progress file ${progress} has no issue table; refusing to guess where the row goes."
        rm -f "${target}"
        return 1
    fi

    mkdir -p "/tmp/supcom-derivative-clone"
    local scratch
    scratch="$(mktemp "/tmp/supcom-derivative-clone/new-issue.XXXXXX")"
    head -n "${anchor}" "${progress}" > "${scratch}"
    printf '%s\n' "${row}" >> "${scratch}"
    tail -n +"$((anchor + 1))" "${progress}" >> "${scratch}"
    mv "${scratch}" "${progress}"

    echo "${target}"
}
# }}}

# --- the list mode ---------------------------------------------------------------

if [ "$1" = "--from-list" ]; then
    LIST="$2"
    if [ ! -f "${LIST}" ]; then
        echo "No list at ${LIST}."
        exit 1
    fi

    declare -a ORDER=()
    declare -A TITLE_OF=()
    declare -A BLOCKED_BY_OF=()
    declare -A READS_OF=()
    declare -A QUESTIONS_OF=()
    declare -A BLOCKS_OF=()

    # First pass: read every line, so that the inverse of blocked-by can be built
    # over the whole list before a single file exists.
    while IFS= read -r line; do
        case "${line}" in
            ''|'#'*) continue ;;
        esac
        IFS='|' read -r f_number f_title f_blocked f_reads f_questions <<< "${line}"
        f_number="$(trim "${f_number}")"
        f_title="$(trim "${f_title}")"
        f_blocked="$(trim "${f_blocked}")"
        f_reads="$(trim "${f_reads}")"
        f_questions="$(trim "${f_questions}")"
        if [ -z "${f_number}" ] || [ -z "${f_title}" ]; then
            echo "new-issue: cannot read '${line}' as 'number | title | blocked-by | reads | questions'."
            exit 1
        fi
        ORDER+=("${f_number}")
        TITLE_OF["${f_number}"]="${f_title}"
        BLOCKED_BY_OF["${f_number}"]="${f_blocked}"
        READS_OF["${f_number}"]="${f_reads}"
        QUESTIONS_OF["${f_number}"]="${f_questions}"
    done < "${LIST}"

    for number in "${ORDER[@]}"; do
        blocked="${BLOCKED_BY_OF[${number}]}"
        if [ "${blocked}" = "-" ] || [ -z "${blocked}" ]; then
            continue
        fi
        for upstream in ${blocked//,/ }; do
            if [ -z "${TITLE_OF[${upstream}]}" ]; then
                echo "new-issue: ${number} is blocked by ${upstream}, which is not in the list."
                exit 1
            fi
            if [ -z "${BLOCKS_OF[${upstream}]}" ]; then
                BLOCKS_OF["${upstream}"]="${number}"
            else
                BLOCKS_OF["${upstream}"]="${BLOCKS_OF[${upstream}]}, ${number}"
            fi
        done
    done

    # Second pass: write them, in list order.
    for number in "${ORDER[@]}"; do
        claim_one "${number}" "${TITLE_OF[${number}]}" "${BLOCKED_BY_OF[${number}]}" \
                  "${BLOCKS_OF[${number}]}" "${READS_OF[${number}]}" "${QUESTIONS_OF[${number}]}" || exit 1
    done
    echo "${#ORDER[@]} issues written. Add each to the roadmap table as well."
    exit 0
fi

# --- the single-issue mode --------------------------------------------------------

NUMBER="$1"
TITLE="$2"
shift 2

BLOCKED_BY="-"
BLOCKS="-"
READS="-"
QUESTIONS="-"

while [ "$#" -gt 0 ]; do
    case "$1" in
        --blocked-by) BLOCKED_BY="$2" ; shift 2 ;;
        --blocks)     BLOCKS="$2"     ; shift 2 ;;
        --reads)      READS="$2"      ; shift 2 ;;
        --questions)  QUESTIONS="$2"  ; shift 2 ;;
        *)
            echo "new-issue: unknown option '$1'"
            echo "Options are --blocked-by, --blocks, --reads, --questions."
            exit 1
            ;;
    esac
done

if [ -z "${NUMBER}" ] || [ -z "${TITLE}" ]; then
    echo "Usage: ./new-issue <number> \"<title>\" [--blocked-by ...] [--blocks ...] [--reads ...] [--questions ...]"
    echo "   or: ./new-issue --from-list <file>"
    exit 1
fi

claim_one "${NUMBER}" "${TITLE}" "${BLOCKED_BY}" "${BLOCKS}" "${READS}" "${QUESTIONS}" || exit 1
echo "Row added to the phase tracker. Add the issue to the roadmap table as well."
