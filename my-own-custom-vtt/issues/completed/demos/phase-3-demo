#!/usr/bin/env bash
#
# phase-3-demo -- shows what phase three built.
#
# Phase three claims the world moves the same way twice, on any number of
# threads, and that a turn can therefore be taken back.
#
# The first half is a measurement: one scripted session run at four thread
# counts, compared by world hash at every beat rather than only at the end.
#
# The second half spends it -- a turn taken back and replayed identically, then
# taken back and ruled differently.
#
# The last part shows what the phase does NOT solve. Undoing the world is a
# block copy; undoing what somebody saw is impossible, and the map closing over
# a room they can still describe is put on screen rather than described.
#
# Usage:
#   ./phase-3-demo                 -- build and run
#   ./phase-3-demo /path/to/prj    -- the same, from a checkout somewhere else
#
# Normally reached through ./run-phase-demo 1 in the project root.

set -e

# The project root. Hard-coded so the script works from any directory, and
# overridable as the first argument so a checkout elsewhere still works.
DIR="/mnt/mtwo/programming/ai-stuff/my-own-custom-vtt"

if [ -d "$1" ]; then
    DIR="$1"
    shift
fi

PROJECT_NAME="my-own-custom-vtt"
EXEC_TIER="/tmp/${PROJECT_NAME}/tmp"
DEMO="${EXEC_TIER}/055-demo-phase-3"

if [ ! -x "${DIR}/build" ]; then
    echo "No build script at ${DIR}/build."
    echo "Either the project root is wrong, or the project has not been initialised."
    exit 1
fi

# Built from source every time rather than trusting whatever is lying around in
# the RAM tier, because a demo that runs a stale binary is a demo that lies.
echo "Building..."
"${DIR}/build" "${DIR}" --no-test > /dev/null

if [ ! -x "${DEMO}" ]; then
    echo "The build did not produce ${DEMO}."
    exit 1
fi

exec "${DEMO}"
