#!/usr/bin/env bash
#
# phase-6-demo -- shows what phase six built.
#
# Phase six claims that "player", "commander", "the tavern" and "GM" are four
# positions on one dial rather than four systems. So this sits all four down
# together and prints the same table for each of them.
#
# It also shows the gauntlet refusing across seats, a body changing hands at a
# doorway, a seat being handed over, and what each position costs to look out
# of. No browser -- the claim is about permission, and a browser proves nothing
# about permission.
#
# Usage:
#   ./phase-6-demo                 -- build and run
#   ./phase-6-demo /path/to/prj    -- the same, from a checkout somewhere else
#
# Normally reached through ./run-phase-demo 1 in the project root.

set -e

# The project root. Hard-coded so the script works from any directory, and
# overridable as the first argument so a checkout elsewhere still works.
DIR="/mnt/mtwo/programming/ai-stuff/my-own-custom-vtt"

if [ -d "$1" ]; then
    DIR="$1"
    shift
fi

PROJECT_NAME="my-own-custom-vtt"
EXEC_TIER="/tmp/${PROJECT_NAME}/tmp"
DEMO="${EXEC_TIER}/072-demo-phase-6"

if [ ! -x "${DIR}/build" ]; then
    echo "No build script at ${DIR}/build."
    echo "Either the project root is wrong, or the project has not been initialised."
    exit 1
fi

# Built from source every time rather than trusting whatever is lying around in
# the RAM tier, because a demo that runs a stale binary is a demo that lies.
echo "Building..."
"${DIR}/build" "${DIR}" --no-test > /dev/null

if [ ! -x "${DEMO}" ]; then
    echo "The build did not produce ${DEMO}."
    exit 1
fi

exec "${DEMO}"
