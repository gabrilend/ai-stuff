#!/usr/bin/env bash
#
# phase-1-demo -- shows what phase one built.
#
# Phase one claims a world can be described, held, checked, and round-tripped.
# This builds the project from a clean checkout and runs the program that
# demonstrates each of those, reporting the numbers behind them as it goes.
#
# It also breaks a world four different ways on purpose, so the component that
# matters most in the phase is visible: a validator that names the field and
# refuses rather than repairing.
#
# Usage:
#   ./phase-1-demo                 -- build and run
#   ./phase-1-demo /path/to/prj    -- the same, from a checkout somewhere else
#
# Normally reached through ./run-phase-demo 1 in the project root.

set -e

# The project root. Hard-coded so the script works from any directory, and
# overridable as the first argument so a checkout elsewhere still works.
DIR="/mnt/mtwo/programming/ai-stuff/my-own-custom-vtt"

if [ -d "$1" ]; then
    DIR="$1"
    shift
fi

PROJECT_NAME="my-own-custom-vtt"
EXEC_TIER="/tmp/${PROJECT_NAME}/tmp"
DEMO="${EXEC_TIER}/039-demo-phase-1"

if [ ! -x "${DIR}/build" ]; then
    echo "No build script at ${DIR}/build."
    echo "Either the project root is wrong, or the project has not been initialised."
    exit 1
fi

# Built from source every time rather than trusting whatever is lying around in
# the RAM tier, because a demo that runs a stale binary is a demo that lies.
echo "Building..."
"${DIR}/build" "${DIR}" --no-test > /dev/null

if [ ! -x "${DEMO}" ]; then
    echo "The build did not produce ${DEMO}."
    exit 1
fi

exec "${DEMO}"
