#!/usr/bin/env bash
#
# phase-7-the-delve -- the mode that was added after the vision was written.
#
#   "humans and dinosaurs trying to solve Dungeons and Dragons monsters ...
#    stone golems, vine monsters, and wooden machine automatons (not steam
#    powered, but with fire powers like 'ignite' and not like 'fireball')"
#
# "Solve" was meant loosely: the monsters are enemies with health and the party
# fights them. What is left of the cycle is a table of nine numbers -- fire ruins
# a plant and does nothing to stone -- and a party of two kinds, neither of which
# is an answer to all three.

DIR="/mnt/mtwo/programming/ai-stuff/jurassic-maze"
if [ -d "$1" ]; then DIR="$1"; shift; fi

SHOTS="/dev/shm/jurassic-maze/demo"
mkdir -p "${SHOTS}"

echo "=============================================================="
echo " PHASE 7 -- THE DELVE"
echo "=============================================================="
echo ""
echo "--- what hurts what -----------------------------------------------"
echo ""
luajit -e "
local root = '${DIR}'
local C = dofile(root .. '/assets/035-creature-table.lua')

print(string.format('  %-12s %8s %8s %8s   %s', '', 'blade', 'fire', 'blunt', ''))
for _, name in ipairs({'golem', 'vine', 'automaton'}) do
  local _, kind = C.by_name(name)
  local made_of = ({golem = 'stone', vine = 'a plant', automaton = 'wood'})[name]
  print(string.format('  %-12s %8.2f %8.2f %8.2f   %s', name,
        kind.resist.blade, kind.resist.fire, kind.resist.blunt, made_of))
end
print('')
print(string.format('  %-12s %-10s', 'and carried:', ''))
for _, name in ipairs({'human', 'dino'}) do
  local _, kind = C.by_name(name)
  print(string.format('  %-12s %-10s reach %d, %.1f damage', name, kind.weapon,
        kind.reach, kind.damage))
end
print('')
print('  Fire ruins a plant and does nothing at all to stone. Weight ends a')
print('  wooden machine and is the only thing that tells against a golem.')
print('  A human carries fire and a dinosaur carries weight, and neither one')
print('  alone is an answer to all three -- which is what makes a party a party,')
print('  written as a table rather than as a rule.')
"
echo ""

echo "--- a minute in the dungeon --------------------------------------"
echo ""
luajit -e "
local root = '${DIR}'
local Params = dofile(root .. '/src/028-maze-parameters.lua')
local Tick   = dofile(root .. '/src/039-the-tick.lua')

local world = Tick.new_world(root, Params.with{seed = 12}, 'delve')
local before = 0
for i = 0, world.store.cells - 1 do
  if world.store.walkable[i] then before = before + 1 end
end

local t0 = os.clock()
for _ = 1, 3600 do Tick.tick(world) end
local c = world.counters

local after = 0
for i = 0, world.store.cells - 1 do
  if world.store.walkable[i] then after = after + 1 end
end

print(string.format('  %d bodies, sixty seconds in %.1f s real', world.bodies.live, os.clock() - t0))
print('')
for _, pair in ipairs({
    {'duels',        'fights'},
    {'blows_landed', 'blows landed'},
    {'blows_parried','blows turned aside'},
    {'deaths',       'deaths'},
    {'entangled',    'delvers held by vines'},
    {'ignitions',    'things set alight'},
    {'ignited_spreading', '  of which caught from something else'},
    {'vines_lit',    '  of which were vines'},
    {'burnt_out',    'fires that ran out of fuel'},
    {'mounted',      'humans that climbed a dinosaur'},
    {'stone_broken', 'blocks of wall a golem walked through'}}) do
  print(string.format('  %-40s %6d', pair[2], c[pair[1]] or 0))
end
print('')
print(string.format('  the maze opened up: %d floor cells became %d', before, after))
print(string.format('  and the stone version counter, written in phase one and'))
print(string.format('  never bumped by anything until now, reads %d.', world.store.version))
"
echo ""

echo "--- the automaton solves itself ----------------------------------"
echo ""
echo "  Nothing in the code arranges this. It falls out of fire spreading"
echo "  to flammable neighbours and a wooden machine being one of them."
echo "  The test asserts it happens and there is no code path called self."
echo ""
"${DIR}/run-tests" 066 2>&1 | sed 's/^/  /'
echo ""

echo "--- what the fighting actually is --------------------------------"
echo ""
echo "  The same duel machinery two fencers use, generalised beyond fencers."
echo "  The same record with two bodies in it, the same buffered damage, the"
echo "  same four endings, the same verdict the camera reads. That is why"
echo "  this mode took an afternoon rather than a phase."
echo ""
echo "  The one thing that had to change: each side uses its own numbers."
echo "  A duel between two fencers is symmetric and it did not matter. A"
echo "  human with a torch against a stone golem is not, and reading both"
echo "  sides' stats off whichever body happened to be stored first would"
echo "  decide the fight by array order."
echo ""

echo "--- and what it looks like ---------------------------------------"
echo ""
echo "  Each shot opens a window, lets it settle, saves a frame and leaves."
echo "  Guarded by a timeout: a window that loses focus can be throttled by"
echo "  the compositor to the point where it never reaches the frame it was"
echo "  told to capture, and a demo that hangs is a demo nobody runs twice."
echo ""
echo "  writing ${SHOTS}/phase-7-delve.png"
timeout 45 love "${DIR}" --seed 12 --scene delve --after 8 --zoom 1.3 --at 64 64 \
     --screenshot "${SHOTS}/phase-7-delve.png" >/dev/null 2>&1
echo ""
echo "  Orange is something on fire -- quite possibly the machine that"
echo "  started it. Run it live with:  ./run-maze --scene delve"
echo ""
