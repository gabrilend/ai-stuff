#!/usr/bin/env bash
#
# phase-2-the-eye -- the same maze, looked at three ways, one of which has no
# pixels in it at all.
#
# The point of phase two is not that the maze can be seen. It is that it can be
# *measured* -- a simulation observed only by a person watching it has no tests,
# because "did that look right" is not an assertion.

DIR="/mnt/mtwo/programming/ai-stuff/jurassic-maze"
if [ -d "$1" ]; then DIR="$1"; shift; fi

SHOTS="/dev/shm/jurassic-maze/demo"
mkdir -p "${SHOTS}"

echo "=============================================================="
echo " PHASE 2 -- THE EYE"
echo "=============================================================="
echo ""
echo "--- one: with a window -------------------------------------------"
echo ""
echo "  The stone is baked into two static meshes at load and never rebuilt."
echo "  Panning and zooming a hundred thousand polygons costs two numbers."
echo ""
luajit -e "
local root = '${DIR}'
local Params   = dofile(root .. '/src/028-maze-parameters.lua')
local Streams  = dofile(root .. '/src/029-random-streams.lua')
local Carve    = dofile(root .. '/src/031-carving.lua')
local Renderer = dofile(root .. '/src/042-the-renderer.lua')
local Stone    = dofile(root .. '/src/030-the-stone.lua')

local p = Params.check(Params.with{seed = 7})
local store = Carve.generate(root, p, Streams.make_set(7))

local t0 = os.clock()
local faces = Renderer.count_faces(Stone, store)
local sweep = os.clock() - t0

local blocks = 0
for i = 0, store.cells - 1 do blocks = blocks + store.height[i] + 1 end

print(string.format('  blocks of stone in the maze   %d', blocks))
print(string.format('  faces the renderer draws      %d   (%.1f%% of them)',
      faces, 100 * faces / blocks))
print(string.format('  the whole sweep takes         %.0f ms', sweep * 1000))
print('')
print('  Two thirds of every block faces away from a fixed camera and is')
print('  never considered. Most of the rest is buried. A face is only')
print('  emitted where two neighbouring columns disagree.')
"
echo ""
echo "  writing ${SHOTS}/phase-2-window.png"
timeout 45 love "${DIR}" --seed 7 --scene empty --zoom 0.9 --at 64 64 \
     --screenshot "${SHOTS}/phase-2-window.png" >/dev/null 2>&1
echo ""

echo "--- two: in a terminal, one layer at a time ----------------------"
echo ""
echo "  For when a number says something is wrong and you need to see"
echo "  where, over ssh, with no graphics."
echo ""
luajit -e "
local root = '${DIR}'
local Params  = dofile(root .. '/src/028-maze-parameters.lua')
local Streams = dofile(root .. '/src/029-random-streams.lua')
local Carve   = dofile(root .. '/src/031-carving.lua')
local Stone   = dofile(root .. '/src/030-the-stone.lua')
local Term    = dofile(root .. '/src/046-the-terminal-viewer.lua')
local bit     = require('bit')

local p = Params.check(Params.with{seed = 7})
local store = Carve.generate(root, p, Streams.make_set(7))

-- Pick the layers worth showing rather than guessing at them. A slice chosen by
-- hand lands in solid rock as often as not, and a demo that shows a rectangle of
-- hash marks demonstrates nothing.
local score = {}
for l = 0, p.layers - 1 do score[l] = 0 end
for i = 0, store.cells - 1 do
  if store.walkable[i] then
    local l = store.height[i]
    score[l] = score[l] + 1
  end
end

local order = {}
for l = 0, p.layers - 1 do if score[l] > 200 then order[#order + 1] = l end end
table.sort(order, function(a, b) return score[a] > score[b] end)

-- The densest window, not the centroid. A terrace is a ring around the mound, so
-- its centroid sits in the hole in the middle of it, where there is no floor at
-- that height at all -- which is how the first version of this demo came to
-- print two rectangles of solid rock.
local W, H = 66, 16
for k = 1, math.min(2, #order) do
  local l = order[k]
  local best, mx, my = -1, 0, 0
  for wy = 0, store.depth - H, 4 do
    for wx = 0, store.width - W, 4 do
      local n = 0
      for y = wy, wy + H - 1, 2 do
        for x = wx, wx + W - 1, 2 do
          local i = x + y * store.width
          if store.walkable[i] and store.height[i] == l then n = n + 1 end
        end
      end
      if n > best then best, mx, my = n, wx, wy end
    end
  end

  print(string.format('  layer %d -- %d cells of floor stand at this height:',
        l, score[l]))
  print('')
  local rows = Term.slice(Stone, store, l, mx, my, 66, 16)
  for _, row in ipairs(rows) do print('    ' .. row) end
  print('')
end
print('    #  buried stone     -  somewhere to stand')
print('    .  under an arch    (blank)  air')
print('')
print('  The dashes are one terrace of the maze, seen flat. The hashes')
print('  around them are the walls of that terrace, which are two layers')
print('  taller and so are still solid at this height.')
"
echo ""

echo "--- three: with nobody watching at all ---------------------------"
echo ""
echo "  No window, no engine, bare luajit. Half of what this is for is"
echo "  that it would fail to load if a simulation file had quietly grown"
echo "  a dependency on the window."
echo ""
"${DIR}/run-maze" --headless --seed 7 --scene balls --ticks 900 | sed 's/^/  /'
echo ""
