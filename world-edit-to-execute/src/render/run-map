#!/bin/bash
# WC3 map viewer (Issue 517e): build the scene viewer and show a map,
# its ground, doodads and script-placed units drawn with the geometry kit.
#
# Usage: src/render/run-map [MAP] [PROJECT_ROOT]
#
# MAP defaults to the project's assets/DAoW-5.4b-PUBLIC-TEST.w3x.
#
# The project root defaults to two folders above this script, so it runs
# from any checkout. raylib is looked for in RAYLIB_PATH (its src/ folder,
# holding raylib.h and libraylib.a), else the owner's usual place.

DIR="${2:-$(cd "$(dirname "$0")/../.." && pwd)}"
MAP="${1:-${DIR}/assets/DAoW-5.4b-PUBLIC-TEST.w3x}"
MAP="$(cd "$(dirname "${MAP}")" && pwd)/$(basename "${MAP}")"
RAYLIB_PATH="${RAYLIB_PATH:-/home/ritz/programming/c/libs/raylib/src}"
PROJECT_PATH="${DIR}/src/render"
BIN="$(mktemp -d)/scene_viewer"

LUAJIT_CFLAGS=$(pkg-config --cflags luajit 2>/dev/null || echo "-I/usr/include/luajit-2.1")
LUAJIT_LIBS=$(pkg-config --libs luajit 2>/dev/null || echo "-lluajit-5.1")

cd "${PROJECT_PATH}" || exit 1
if ! gcc -Wall -Wextra -O2 -o "${BIN}" \
        scene_viewer.c geometry.c landscape.c bridge.c slots.c terrain.c input.c ui.c \
        -I"${RAYLIB_PATH}" ${LUAJIT_CFLAGS} \
        -L"${RAYLIB_PATH}" -lraylib ${LUAJIT_LIBS} \
        -lGL -lm -lpthread -ldl -lrt -lX11; then
    echo "=== Compilation failed ==="
    exit 1
fi

"${BIN}" "${DIR}" src/demo/wc3map/main.lua "${MAP}"
status=$?
rm -rf "$(dirname "${BIN}")"
exit ${status}
