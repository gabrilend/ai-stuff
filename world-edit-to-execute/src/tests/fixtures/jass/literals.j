// JASS Literals Test Fixture
// Tests all literal types

// Integer - decimal
0
1
123
999999

// Integer - hex 0x prefix
0x1F
0XFF
0xABCDEF

// Integer - hex $ prefix
$FF
$DEADBEEF

// Integer - octal (leading zero)
017
0777

// Real - standard
1.5
123.456
0.0

// Real - leading dot
.5
.123

// Real - trailing dot
1.
123.

// Strings
"hello"
""
"with spaces"
"with\nnewline"
"with\ttab"
"with\\backslash"
"with\"quote"

// Rawcodes
'hfoo'
'AHbz'
'A000'
