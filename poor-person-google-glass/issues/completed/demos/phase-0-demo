#!/usr/bin/env bash
#
# phase-0-demo - phase 0, Tools: the CAD viewer, shown on the crown.
#
# In plain terms: makes the rough crown model by formula and writes it in all
# four file kinds the viewer reads (glTF, OBJ, text STL, binary STL); prints
# a table comparing them (size on disk, parts kept, triangles, read time, how
# far any corner moved on the round trip); then opens each in the viewer,
# spinning, for a few seconds and photographs it. Then the describing tool:
# four objects described only in words (a drum, a lamp, the crown, glasses) become
# models, each photographed in its annotated view; a description with
# mistakes in it shows how they are refused. Then the light pipe from
# inside: twelve stations photographed, and the table of which parts each
# station shows. Finally the light pipe opens for you to walk through (n for
# the next station) until you close the window.
#
# Usage:
#   phase-0-demo                 the project at the default location
#   phase-0-demo <project-dir>   another copy of the project

DIR="/mnt/mtwo/programming/ai-stuff/poor-person-google-glass"
if [ -d "${1:-}" ]; then
    DIR="$1"
    shift
fi

source /mnt/mtwo/programming/ai-stuff/scripts/libs/ensure-ram-tiers
ensure_ram_tiers "${DIR}" || exit 1

echo "== the crown sketch, written in every format =="
"${DIR}/scripts/make-test-shapes" "${DIR}" || exit 1
echo ""
echo "== read back and compared =="
luajit "${DIR}/issues/completed/demos/phase-0-compare.lua" "${DIR}" || exit 1
echo ""
echo "== each file in the viewer: spinning, edges on half way, photographed =="
SHAPES="${DIR}/tmp/shared-memory/shapes"
for NAME in crown-sketch.gltf crown-sketch.obj crown-sketch-text.stl crown-sketch-binary.stl; do
    "${DIR}/view-cad" "${DIR}" "${SHAPES}/${NAME}" \
        --drag 0.1 40 15 --key 0.2 space --key 1.5 w --screenshot 3 2>&1 | grep -v ALSOFT
    FRAMES=$(awk '/^frames/ { print $2 }' "${DIR}/output/goodbye")
    BLACK=$(awk '/^black/ { print $2 }' "${DIR}/output/goodbye")
    echo "   ${NAME}: ${FRAMES} frames drawn, black share ${BLACK}"
done
echo ""
echo "== described in words, not measured =="
for NAME in drum lamp crown glasses; do
    echo "-- input/descriptions/${NAME}.txt"
    grep -v '^#' "${DIR}/input/descriptions/${NAME}.txt"
    "${DIR}/describe" "${DIR}" "${DIR}/input/descriptions/${NAME}.txt" --view \
        --drag 0.1 60 20 --screenshot 0.5 --views annotated 2>&1 | grep -v -e ALSOFT -e 'screenshot saved'
    echo ""
done
echo "-- a description with three mistakes in it:"
MISTAKES="${DIR}/tmp/shared-memory/mistakes.txt"
printf 'The drum is a cylinder.\nThe lid is a disc. The lid is slightly widr than the drum.\nThe lid sits on top of the drun.\nThe knob is purpel.\n' > "${MISTAKES}"
cat "${MISTAKES}"
"${DIR}/describe" "${DIR}" "${MISTAKES}"
echo ""
echo "== the light pipe, from inside =="
"${DIR}/scripts/make-light-pipe" "${DIR}" || exit 1
"${DIR}/view-cad" "${DIR}" "${DIR}/output/models/light-pipe.gltf" --stations --views lit --screenshot 0.3 2>&1 \
    | grep -v -e ALSOFT -e 'screenshot saved' -e 'coverage written'
cat "${DIR}/tmp/shared-memory/coverage-light-pipe.gltf.txt"
grep -e '^unseen' "${DIR}/output/goodbye"
echo ""
echo "== your turn: inside the light pipe. n next station, o outside, left drag turns, wheel zooms, v views, Esc closes =="
"${DIR}/view-cad" "${DIR}" "${DIR}/output/models/light-pipe.gltf" 2>&1 | grep -v ALSOFT
echo "photographs are in ${DIR}/tmp/shared-memory/screenshot-*.png"
