#!/usr/bin/env bash
#
# run-tests - runs every test the project has.
#
# In plain terms: makes sure the RAM scratch folders exist, then runs the
# window-free tests (the shape record, the CAD formats, the camera, the
# settings) with LuaJIT, and, when a display is available, opens the viewer
# for a few seconds on a test shape, scripted, and checks it said goodbye
# and left a screenshot.
#
# Usage:
#   scripts/run-tests                 the project at the default location
#   scripts/run-tests <project-dir>   another copy of the project

DIR="/mnt/mtwo/programming/ai-stuff/poor-person-google-glass"
if [ -d "${1:-}" ]; then
    DIR="$1"
    shift
fi

source /mnt/mtwo/programming/ai-stuff/scripts/libs/ensure-ram-tiers
ensure_ram_tiers "${DIR}" || exit 1

luajit "${DIR}/src/011-the-tests.test.lua" "${DIR}" || exit 1

# the viewer, driven without a person: needs a screen to draw on
if [ -z "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ]; then
    echo "SKIPPED the window test: no display to open a window on"
    exit 0
fi
"${DIR}/scripts/make-test-shapes" "${DIR}" > /dev/null || exit 1
SHAPE="${DIR}/tmp/shared-memory/shapes/crown-sketch.gltf"
SCREENSHOT="${DIR}/tmp/shared-memory/screenshot-crown-sketch.gltf.png"
rm -f "${SCREENSHOT}"
BEFORE=$(date +%s)
"${DIR}/view-cad" "${DIR}" "${SHAPE}" --key 0.2 w --drag 0.4 60 20 --screenshot 1.0 || exit 1
GOODBYE="${DIR}/output/goodbye"
WRITTEN=$(stat -c %Y "${GOODBYE}")
if [ "${WRITTEN}" -lt "${BEFORE}" ]; then
    echo "FAIL  the viewer did not say goodbye (output/goodbye is older than the run)"
    exit 1
fi
if [ ! -s "${SCREENSHOT}" ]; then
    echo "FAIL  the viewer left no screenshot at ${SCREENSHOT}"
    exit 1
fi
# a capture that read back black (as multisampling once caused) is a
# failure even though a file was saved: the receipt counts black pixels
BLACK=$(awk '/^black/ { print $2 }' "${GOODBYE}")
if [ -z "${BLACK}" ] || awk -v share="${BLACK}" 'BEGIN { exit !(share > 0.001) }'; then
    echo "FAIL  the screenshot is ${BLACK:-of unknown} share pure black; the capture did not read the window"
    exit 1
fi
TRIANGLES=$(grep '^triangles' "${GOODBYE}")
echo "pass  the viewer opened the crown, said goodbye (${TRIANGLES}), and left a screenshot"
