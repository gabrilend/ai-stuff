#!/usr/bin/env bash
#
# run-tests - runs every test the project has.
#
# In plain terms: makes sure the RAM scratch folders exist, then runs the
# window-free tests (the shape record, the CAD formats, the camera, the
# settings; the describing language) with LuaJIT, and, when a display is
# available, opens the viewer for a moment on a test shape, scripted, and
# checks it said goodbye and saved one whole picture per view.
#
# Usage:
#   scripts/run-tests                 the project at the default location
#   scripts/run-tests <project-dir>   another copy of the project

DIR="/mnt/mtwo/programming/ai-stuff/poor-person-google-glass"
if [ -d "${1:-}" ]; then
    DIR="$1"
    shift
fi

source /mnt/mtwo/programming/ai-stuff/scripts/libs/ensure-ram-tiers
ensure_ram_tiers "${DIR}" || exit 1

luajit "${DIR}/src/011-the-tests.test.lua" "${DIR}" || exit 1
luajit "${DIR}/src/017-the-word-tests.test.lua" "${DIR}" || exit 1

# the viewer, driven without a person: needs a screen to draw on
if [ -z "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ]; then
    echo "SKIPPED the window test: no display to open a window on"
    exit 0
fi
"${DIR}/scripts/make-test-shapes" "${DIR}" > /dev/null || exit 1
SHAPE="${DIR}/tmp/shared-memory/shapes/crown-sketch.gltf"
rm -f "${DIR}"/tmp/shared-memory/screenshot-crown-sketch.gltf-*.png
BEFORE=$(date +%s)
"${DIR}/view-cad" "${DIR}" "${SHAPE}" --drag 0.2 60 20 --screenshot 0.5 > /dev/null || exit 1
GOODBYE="${DIR}/output/goodbye"
WRITTEN=$(stat -c %Y "${GOODBYE}")
if [ "${WRITTEN}" -lt "${BEFORE}" ]; then
    echo "FAIL  the viewer did not say goodbye (output/goodbye is older than the run)"
    exit 1
fi
# one picture per view, each saved, none with pure-black pixels (a picture
# that was not drawn reads back black; the viewer never draws pure black)
PICTURES=$(grep -c '^picture ' "${GOODBYE}")
if [ "${PICTURES}" -ne 6 ]; then
    echo "FAIL  the viewer saved ${PICTURES} pictures, not one per view (6)"
    exit 1
fi
while read -r VIEW SHARE FILE; do
    if [ ! -s "${FILE}" ]; then
        echo "FAIL  the ${VIEW} picture is missing: ${FILE}"
        exit 1
    fi
    if awk -v share="${SHARE}" 'BEGIN { exit !(share > 0) }'; then
        echo "FAIL  the ${VIEW} picture is ${SHARE} pure black: it was not drawn"
        exit 1
    fi
done < <(awk '/^picture / { print $2, $4, $5 }' "${GOODBYE}")
TRIANGLES=$(grep '^triangles' "${GOODBYE}")
echo "pass  the viewer opened the crown, said goodbye (${TRIANGLES}), and saved six whole pictures"

# the light pipe from inside: every part must be seen from some station
# (coverage, measured from the parts view's pixels; issues 008 and 105)
"${DIR}/scripts/make-light-pipe" "${DIR}" > /dev/null || exit 1
"${DIR}/view-cad" "${DIR}" "${DIR}/output/models/light-pipe.gltf" --stations --views lit --screenshot 0.3 > /dev/null || exit 1
UNSEEN=$(awk '/^unseen/ { print $2 }' "${GOODBYE}")
if [ "${UNSEEN}" != "0" ]; then
    echo "FAIL  the light pipe's stations leave parts unseen: $(grep '^unseen' "${GOODBYE}")"
    exit 1
fi
STATIONS=$(grep -c '^  station' "${GOODBYE}")
echo "pass  the light pipe from ${STATIONS} stations inside: every part seen at least once"
