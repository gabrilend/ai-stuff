#!/usr/bin/env luajit
--
-- refuse-directory-change
--
-- A gate that sits in front of every shell command Claude Code tries to run and
-- refuses the ones that would move the working directory somewhere else.
--
-- The reason it exists: the working directory belongs to the person at the
-- terminal, not to the assistant. When a command walks off to another folder,
-- every later command in the session inherits that move, and the prompt, the
-- status line, and the person's own sense of where they are all quietly
-- disagree with reality. Nearly every real need for it has a flag instead --
-- git takes -C, make takes -C, tar takes -C, and most other tools accept a
-- full path -- so refusing the move costs almost nothing and removes a whole
-- class of surprise.
--
-- The refusal can be lifted one time, by the person and only by the person, by
-- creating the permission token named below. The gate spends the token on the
-- next directory change and deletes it, so a permission granted once is not a
-- permission granted forever.
--
-- Asking for confirmation instead was tried first and does not work: under the
-- "auto" permission mode the confirmation is resolved without ever reaching a
-- human, which would leave this gate looking present while doing nothing. A
-- refusal is honoured; a request is not. Hence a refusal plus a token.
--
-- HOW IT READS A COMMAND
--
-- Through the shared shell-word reader (libs/shell-command-scan.lua), which
-- splits the line the way a shell does. So the gate sees the real command word
-- behind `if ...; then cd x; fi`, `builtin cd`, `command cd`, `FOO=1 cd`,
-- `\cd`, `"cd"`, `eval "cd x"`, `bash -c 'cd x'`, and `cd>/dev/null x`, and it
-- does not see `cd` inside a quoted string or a heredoc written to a file. The
-- regular expression it used before missed the first list and refused the
-- second.
--
-- A `cd` inside a child shell -- `(cd x && make)`, `$(cd x && pwd)`,
-- `bash -c 'cd x'` -- cannot move the session's directory, and is refused
-- anyway. Partly habit: a command that reaches for cd in a subshell reaches for
-- it bare the next time. And partly because the difference is not cheap to
-- prove from text: `( cd x ); make` and `cd x; make` differ by two characters.
-- `git -C` and `make -C` do the same job and leave nothing to judge.
--
-- OBSERVED ON CLAUDE CODE 2.1.280: the harness appears to drop a leading
-- `cd <the current directory> &&` from a command before PreToolUse hooks see
-- it, so that no-op shape passes live even though this script refuses it when
-- fed the text directly (and the test suite checks exactly that). It is not in
-- the changelog. To tell a stripped no-op from a broken gate, try the change
-- inside a subshell -- `(cd /tmp && pwd)` -- which the harness leaves alone and
-- this gate refuses.
--
-- WHAT THIS IS NOT
--
-- This is not a security boundary and must never be mistaken for one. The
-- assistant it constrains can read and write this file, can delete the hook
-- entry that installs it, and can create the token itself. Any of those defeats
-- it completely, and none of them is difficult. `source ./script` and a script
-- piped into a shell are not read at all.
--
-- What it buys is not prevention. It is that the ways around it are all things
-- a person would see: a token being touched, this script being edited, settings
-- being rewritten. An honour system with a witness, not a lock.
--
-- Reads the pending command as JSON on standard input. Says nothing when the
-- command is fine; prints a refusal when it is not; prints a visible warning
-- (and lets the command run) when it cannot read its input.
--
-- Usage: refuse-directory-change [token-path] [scripts-directory]

local TOKEN = arg[1] or "/tmp/claude-allow-cwd-change"
local DIR = arg[2] or "/home/ritz/programming/ai-stuff/scripts"
local GATE_NAME = "refuse-directory-change"

package.path = DIR .. "/libs/?.lua;" .. package.path
local gate = require("hook-gate")
local scan = require("shell-command-scan")

-- The command words that move the working directory.
local MOVES_DIRECTORY = { cd = true, pushd = true, popd = true }

-- {{{ local function find_directory_change()
-- The first command on the line whose real command word moves the directory,
-- or nil. Wrappers and assignments in front of it are stepped past by the
-- reader, so `builtin cd` and `FOO=1 cd` are cd.
local function find_directory_change(command_text)
    for _, command in ipairs(scan.all_commands(command_text)) do
        local words = scan.effective_words(command)
        -- a command with no command word (only assignments) moves nothing;
        -- one whose word moves the directory is the answer
        if words and MOVES_DIRECTORY[words[1]] then
            return table.concat(words, " ")
        end
    end
    return nil
end
-- }}}

-- {{{ local function main()
local function main()
    local input, json = gate.read_input(GATE_NAME, DIR)
    local command_text = gate.pending_command(GATE_NAME, input)

    local offending = find_directory_change(command_text)
    -- nothing on the line moves the directory: almost every command ends here
    if not offending then os.exit(0) end

    gate.refuse_unless_token(json, TOKEN,
        "This command changes the working directory (" .. offending .. "), which belongs to the user and does not move unless they specifically ask for it. Do the work from where you are: git -C <dir>, make -C <dir>, tar -C <dir>, or absolute paths. A heredoc needs no directory change either -- git -C <dir> commit -F - reads from stdin perfectly well. If the user genuinely wants the directory moved this once, ask them to type: ! touch " .. TOKEN)
end
-- }}}

main()
