#!/usr/bin/env bash
# rederive-transcripts - Rebuild already-written LLM transcripts from their
# session logs, so that improvements to the exporter reach the archive and not
# only the next conversation.
#
# In short: the exporter turns a Claude session log into a readable markdown
# transcript, and every project keeps its transcripts in an llm-transcripts/
# folder. When the exporter learns to do something better, the transcripts
# already on disk keep whatever they were written with. This walks every
# project that has such a folder, works out which ones still have their source
# session log, and re-runs the exporter over those. A transcript whose log has
# been deleted cannot be rebuilt by anything, and is reported as frozen rather
# than touched.
#
# It reports and changes nothing unless asked to write, because the rebuild
# overwrites the only copy of what it replaces. See
# issues/024-backfill-existing-transcript-corpus.md.
#
# Usage:
#   rederive-transcripts                 report what would change, write nothing
#   rederive-transcripts --write         actually re-run the exporter
#   rederive-transcripts --only <path>   restrict to projects under one path
#   DIR=/some/where rederive-transcripts  override where the scripts live

set -euo pipefail

# -- {{{ Paths and settings
# Hard-coded default root, overridable by environment, so the script runs from
# any directory (house convention). Everything else is derived from it.
DIR="${DIR:-/home/ritz/programming/ai-stuff/scripts}"
EXPORTER="${DIR}/backup-conversations"
CLAUDE_SESSIONS_ROOT="${CLAUDE_SESSIONS_ROOT:-$HOME/.claude/projects}"

# Where projects live. A project is anything holding an llm-transcripts folder.
SEARCH_ROOTS=(/mnt/mtwo /mnt/cmdo /mnt/kaun)
SEARCH_DEPTH=6

# Conversation ids of every session log still on disk, filled once at start.
declare -A SURVIVING_LOGS=()

WRITE=false
ONLY=""
# }}}

# -- {{{ parse_arguments()
parse_arguments() {
   while [ $# -gt 0 ]; do
      case "$1" in
         --write) WRITE=true ;;
         --only)  shift ; ONLY="${1:-}" ;;
         --help|-h)
            sed -n '2,22p' "$0"
            exit 0
            ;;
         *)
            echo "unknown argument: $1" >&2
            exit 1
            ;;
      esac
      shift
   done
}
# }}}

# -- {{{ session_log_dir_for(project_path)
# The exporter finds a project's session logs by flattening the project's
# absolute path into a single directory name: leading slash dropped, every
# remaining slash turned into a dash. This must match the exporter exactly; if
# the two ever disagree, this script reports a project as frozen that the
# exporter would happily rebuild.
session_log_dir_for() {
   local project="$1"
   local flattened
   flattened=$(echo "$project" | sed 's|^/||')
   flattened=$(echo "$flattened" | tr '/' '-')
   echo "${CLAUDE_SESSIONS_ROOT}/-${flattened}"
}
# }}}

# -- {{{ find_projects()
# Every directory that holds an llm-transcripts folder, de-duplicated. Searched
# from the real mount points rather than through the home directory, because
# the home directory reaches the same projects through symlinks and would list
# each one twice.
#
# find reports failure if it could not read some subdirectory, which is normal
# when sweeping whole mount points and must not abort the run, so its status is
# discarded deliberately rather than by accident.
find_projects() {
   local root
   for root in "${SEARCH_ROOTS[@]}"; do
      [ -d "$root" ] || continue
      find "$root" -maxdepth "$SEARCH_DEPTH" -type d -name llm-transcripts || true
   done
   return 0
}
# }}}

# -- {{{ is_excluded(project_path)
# Some directories holding transcripts are not places to write them.
#
#   - a git worktree is a second checkout of a repository that already appears
#     elsewhere in this list, so rebuilding through one writes the same project
#     twice and puts the result on whatever branch that worktree has out
#   - a backup is a copy taken to preserve what a file used to be; rewriting it
#     destroys the only thing it was for
#
# Both are recognised by a path segment rather than by inspecting the
# directory, because the cost of a wrong guess is asymmetric: skipping a real
# project loses nothing that a later run cannot do, and writing into a backup
# cannot be undone.
is_excluded() {
   local project="$1"
   case "$project" in
      # Each name is matched both as an interior component and as the last one.
      # The project path has had "/llm-transcripts" stripped off it, so a
      # backup folder holding transcripts directly ends at "backups" and the
      # interior form alone silently lets it through - which it did, until a
      # count that disagreed with a second implementation exposed it.
      */ai-worktrees/*|*/ai-worktrees) return 0 ;;
      */backups/*|*/backups)           return 0 ;;
      */.git/*|*/.git)                 return 0 ;;
      *)                return 1 ;;
   esac
}
# }}}

# -- {{{ load_surviving_log_ids()
# Every session log still on disk, keyed by its conversation id. Searched
# recursively, because a subagent's log now sits a level down inside a folder
# named after the session that spawned it rather than beside it.
#
# This is what makes an honest count possible. Asking only whether a project
# has a log DIRECTORY answers a coarser question, and answers it wrong in both
# directions: a project with a directory can still hold transcripts whose own
# conversation log was deleted years ago, and a directory of derived outputs
# can be counted as transcripts when none of it came from a session at all.
load_surviving_log_ids() {
   local path id
   while read -r path; do
      id="${path##*/}"
      id="${id%.jsonl}"
      [ -n "$id" ] && SURVIVING_LOGS["$id"]=1
   done < <(find "$CLAUDE_SESSIONS_ROOT" -name '*.jsonl' -type f)
}
# }}}

# -- {{{ classify_transcript(file)
# What a transcript's first line says it came from decides its fate. The header
# "# Conversation Summary: <id>" is the file's stable identity - the filename is
# only a projection of the dates inside it - so the id is read from the header
# and never from the name.
#
# Prints one of: repairable, frozen, headerless.
classify_transcript() {
   local file="$1"
   local first id
   first=$(head -1 "$file")
   id=$(echo "$first" | sed -n 's/^# Conversation Summary:[[:space:]]*\([^[:space:]]*\).*/\1/p')
   if [ -z "$id" ]; then
      echo headerless                    # a derived output or a hand-written
      return 0                           # note; outside this system entirely
   fi
   if [ -n "${SURVIVING_LOGS[$id]:-}" ]; then
      echo repairable
   else
      echo frozen
   fi
}
# }}}

# -- {{{ main()
main() {
   parse_arguments "$@"

   if [ ! -x "$EXPORTER" ]; then
      echo "Error: exporter not found or not executable: $EXPORTER" >&2
      exit 1
   fi

   load_surviving_log_ids

   local found projects
   found=$(find_projects)
   projects=$(echo "$found" | sed 's|/llm-transcripts$||' | sort -u)

   local runnable=() barren=()
   local repairable=0 frozen=0 headerless=0
   local project log_dir file verdict here_repairable

   while read -r project; do
      [ -n "$project" ] || continue
      is_excluded "$project" && continue
      if [ -n "$ONLY" ]; then
         case "$project" in
            "$ONLY"|"$ONLY"/*) : ;;
            *) continue ;;
         esac
      fi

      here_repairable=0
      while read -r file; do
         [ -n "$file" ] || continue
         verdict=$(classify_transcript "$file")
         case "$verdict" in
            repairable) repairable=$((repairable + 1))
                        here_repairable=$((here_repairable + 1)) ;;
            frozen)     frozen=$((frozen + 1)) ;;
            headerless) headerless=$((headerless + 1)) ;;
         esac
      done < <(find "$project/llm-transcripts" -maxdepth 1 -name '*.md' -type f)

      # Whether the exporter can do anything here is a separate question from
      # how many of this project's transcripts are repairable: the exporter
      # rebuilds from the logs it finds, so a project with logs is worth
      # visiting even if some of its transcripts are past saving.
      log_dir=$(session_log_dir_for "$project")
      if [ -d "$log_dir" ]; then
         runnable+=("$project")
      else
         barren+=("$project")
      fi
   done <<< "$projects"

   local total=$((repairable + frozen + headerless))
   echo "Session logs on disk:                                  ${#SURVIVING_LOGS[@]}"
   echo ""
   echo "Transcripts whose conversation log survives:            ${repairable}"
   echo "Transcripts whose conversation log is gone, frozen:     ${frozen}"
   echo "Files with no conversation-id header (not transcripts): ${headerless}"
   echo "Total markdown files in llm-transcripts folders:        ${total}"
   echo ""
   echo "Projects the exporter can be run on:                    ${#runnable[@]}"
   echo "Projects with no session logs at all:                   ${#barren[@]}"
   echo ""

   if [ "$WRITE" != "true" ]; then
      echo "Projects the exporter can be run on:"
      for project in "${runnable[@]}"; do
         echo "  $project"
      done
      echo ""
      echo "Projects with no session logs at all:"
      for project in "${barren[@]}"; do
         echo "  $project"
      done
      echo ""
      echo "Nothing written. Re-run with --write to rebuild what can be rebuilt."
      return 0
   fi

   local rebuilt=0
   for project in "${runnable[@]}"; do
      echo "=== $project"
      "$EXPORTER" "$project" || echo "  (exporter reported a problem; continuing)"
      rebuilt=$((rebuilt + 1))
   done

   echo ""
   echo "Visited ${rebuilt} project(s). ${frozen} transcript(s) have no surviving log and were left alone."
}
# }}}

main "$@"
