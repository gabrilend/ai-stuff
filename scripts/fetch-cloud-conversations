#!/bin/bash
#
# fetch-cloud-conversations
#
# Brings conversations that ran in the cloud (Claude Duet threads, claude.ai/code
# sessions, anything started away from this computer) home, so the transcript
# toolchain can file them like any other conversation (issue 051).
#
# A cloud session never writes to ~/.claude/projects on this computer, so
# backup-conversations has never seen one. But the cloud keeps each session's
# log in exactly the shape Claude Code writes locally - one JSON object per
# line - and hands it back to anyone signed in as the session's owner. Claude
# Code's own "teleport" (resuming a cloud session here) reads it the same way.
#
# This script:
#
#   1. asks the cloud which sessions this account has (newest first);
#   2. passes over the Remote Control sessions among them: those ran in
#      Claude Code on this computer, so their logs are already here;
#   3. downloads each other session's log, and the logs of the helper agents
#      (subagents) it started, page by page, into a sessions store of its
#      own (~/.claude/cloud-projects by default, never ~/.claude/projects, so
#      Claude Code's own store is never touched);
#   4. hands every session that changed to backup-conversations, which writes
#      its transcript, and one per helper, into the project's llm-transcripts/
#      folder as usual.
#
# A session whose log comes back empty is named and fails the run.
#
# A log that has not changed since the last run is left alone and not
# re-exported, so running this often costs one listing and one page per
# session.
#
# Sign-in: it reuses the sign-in Claude Code already keeps on this computer
# (~/.claude/.credentials.json and the organisation in ~/.claude.json). It
# never prints the token, never puts it on a command line where `ps` would
# show it, and never writes it anywhere but a RAM-backed scratch file that is
# removed when the run ends. When the sign-in has expired, it says so and
# stops: start `claude` once (it refreshes the sign-in) and run this again.
#
# Usage:
#   fetch-cloud-conversations                  fetch every session, export the
#                                              ones that changed
#   fetch-cloud-conversations --list           list the sessions, fetch nothing
#   fetch-cloud-conversations --session <id>   fetch and export one session
#   fetch-cloud-conversations --fetch-only     fetch, but do not export
#   fetch-cloud-conversations --limit <n>      look at only the newest n sessions
#
# Which project a session belongs to: a cloud session has no folder on this
# computer, so it is filed under one project, CLOUD_TRANSCRIPT_PROJECT
# (default: your home folder, whose transcripts go to ~/ai/llm-transcripts
# like any other conversation started there). A session whose repository is
# named in config/cloud-session-projects is filed under that project instead:
#
#   # repository-name   project folder on this computer
#   ai-stuff            /mnt/mtwo/programming/ai-stuff
#   r-mail              /mnt/mtwo/programming/r-mail
#
# Environment seams (for tests and relocated checkouts):
#   SCRIPTS_DIR               where this toolchain lives
#   CLOUD_SESSIONS_ROOT       where fetched logs are kept
#                             (default: ~/.claude/cloud-projects)
#   CLOUD_TRANSCRIPT_PROJECT  the project unmapped sessions are filed under
#                             (default: $HOME)
#   CLOUD_SESSION_PROJECTS    the repository-to-project map
#                             (default: $SCRIPTS_DIR/config/cloud-session-projects)
#   CLAUDE_CLOUD_API          the API's address (default: https://api.anthropic.com)
#   CLAUDE_CREDENTIALS_FILE   Claude Code's sign-in (default: ~/.claude/.credentials.json)
#   CLAUDE_ACCOUNT_FILE       Claude Code's account file (default: ~/.claude.json)
#   CLOUD_HTTP_GET            a program run as `<it> <url> <header-file> <body-out>`
#                             that prints the HTTP status; replaces curl in tests

set -euo pipefail
# Command substitutions stop on error too, or a failure inside $(...) would
# be skipped over silently (issue 025).
shopt -s inherit_errexit

SCRIPTS_DIR="${SCRIPTS_DIR:-/mnt/mtwo/programming/ai-stuff/scripts}"
SCRATCH_PROJECT_NAME="ai-stuff-scripts"

# The cloud's session API is a beta; this is the version Claude Code itself
# sends when it lists cloud sessions.
SESSIONS_BETA="ccr-byoc-2025-07-29"

# -- {{{ die
function die() {
   echo "fetch-cloud-conversations: $*" >&2
   exit 1
}
# }}}

# -- {{{ prepare_scratch
# A RAM-backed folder for this run only: the header file with the token, and
# each page as it arrives. Removed on exit, whatever happens.
function prepare_scratch() {
   local ram_tier="/dev/shm/${SCRATCH_PROJECT_NAME}"
   [ -d /dev/shm ] || ram_tier="${TMPDIR:-/tmp}/${SCRATCH_PROJECT_NAME}"
   mkdir -p "$ram_tier"
   RUN_DIR=$(mktemp -d "$ram_tier/fetch-cloud.XXXXXX")
   chmod 700 "$RUN_DIR"
   trap 'rm -rf "$RUN_DIR"' EXIT
}
# }}}

# -- {{{ read_sign_in
# Write the request headers, token included, to a file only this user can
# read. curl reads headers from a file with -H @file, so the token never
# appears in a process listing.
function read_sign_in() {
   local credentials="${CLAUDE_CREDENTIALS_FILE:-$HOME/.claude/.credentials.json}"
   local account="${CLAUDE_ACCOUNT_FILE:-$HOME/.claude.json}"
   [ -f "$credentials" ] || die "no Claude Code sign-in at $credentials; start \`claude\` and sign in first"
   [ -f "$account" ] || die "no Claude Code account file at $account; start \`claude\` and sign in first"

   local token org expires
   token=$(jq -er '.claudeAiOauth.accessToken | strings' "$credentials" 2>/dev/null) \
      || die "the sign-in in $credentials has no access token; start \`claude\` and sign in again"
   org=$(jq -er '.oauthAccount.organizationUuid | strings' "$account" 2>/dev/null) \
      || die "no organisation in $account; start \`claude\` and sign in again"

   # Claude Code records when the token runs out, in milliseconds. Saying so
   # up front beats a 401 on the first page.
   expires=$(jq -r '.claudeAiOauth.expiresAt // empty' "$credentials")
   if [ -n "$expires" ] && [ "$expires" -lt "$(( $(date +%s) * 1000 ))" ]; then
      die "the Claude Code sign-in has expired; start \`claude\` once to refresh it, then run this again"
   fi

   HEADERS="$RUN_DIR/headers"
   ( umask 077
     printf 'Authorization: Bearer %s\n' "$token"
     printf 'anthropic-version: 2023-06-01\n'
     printf 'anthropic-beta: %s\n' "$SESSIONS_BETA"
     printf 'x-organization-uuid: %s\n' "$org"
     printf 'Content-Type: application/json\n' ) > "$HEADERS"
}
# }}}

# -- {{{ http_get
# GET a URL into a file and print the status. Everything that talks to the
# network goes through here, so a test can stand in for the cloud.
function http_get() {
   local url="$1" out="$2"
   if [ -n "${CLOUD_HTTP_GET:-}" ]; then
      "$CLOUD_HTTP_GET" "$url" "$HEADERS" "$out"
      return
   fi
   curl -sS --max-time 30 -H @"$HEADERS" -o "$out" -w '%{http_code}' "$url" \
      || printf '000'
}
# }}}

# -- {{{ get_json
# GET a URL that must answer 200 with JSON. Any other answer is an error
# that names what went wrong, never a quietly empty result (issue 025).
function get_json() {
   local url="$1" out="$2" what="$3"
   local status
   status=$(http_get "$url" "$out")
   case "$status" in
      200) jq -e . "$out" >/dev/null 2>&1 || die "$what: the answer was not JSON" ;;
      401) die "$what: the sign-in was refused (401); start \`claude\` once to refresh it, then run this again" ;;
      403) die "$what: access denied (403); this computer may need to be a trusted device for this session" ;;
      404) return 4 ;;
      000) die "$what: could not reach $CLAUDE_CLOUD_API" ;;
      *)   die "$what: the cloud answered $status" ;;
   esac
}
# }}}

# -- {{{ list_sessions
# Every session this account can see, newest first, one JSON object per line
# with the fields the rest of the script uses. Pages are followed by the last
# id of the page before, until the cloud says there are no more.
#
# "kind" is the session's environment_kind: "anthropic_cloud" for a session
# that ran on Anthropic's machines (its log exists only in the cloud),
# "bridge" for a Remote Control session (it ran in Claude Code on this
# computer, and the cloud only relayed it to the app; see main).
#
# The pages are gathered in a file and cut to the limit afterwards. Cutting
# them while they were still being written (`... | head`) closed the pipe on
# a writer with up to 95 rows to go, and pipefail turned that SIGPIPE into a
# silent exit 141 on every `--limit` smaller than a page.
function list_sessions() {
   local limit="${1:-0}" after="" page="$RUN_DIR/sessions-page" seen=0
   local all="$RUN_DIR/sessions-all"
   : > "$all"
   while :; do
      local url="$CLAUDE_CLOUD_API/v1/sessions?limit=100"
      [ -n "$after" ] && url="$url&after_id=$after"
      get_json "$url" "$page" "listing sessions" || die "listing sessions: not found (404)"
      jq -c '.data[] | {id, title: (.title // ""), created_at, updated_at,
             kind: (.environment_kind // ""),
             repos: [(.session_context.sources // [])[] | (.url // "") | sub("\\.git$"; "") | split("/") | last]}' "$page" >> "$all"
      seen=$(( seen + $(jq '.data | length' "$page") ))
      [ "$limit" -gt 0 ] && [ "$seen" -ge "$limit" ] && break
      [ "$(jq -r '.has_more // false' "$page")" = "true" ] || break
      after=$(jq -r '.last_id // empty' "$page")
      [ -n "$after" ] || break
   done
   # A limit keeps the first n rows; no limit keeps them all.
   if [ "$limit" -gt 0 ]; then
      head -n "$limit" "$all"
   else
      cat "$all"
   fi
}
# }}}

# -- {{{ code_session_id
# The log lives under the session's "code" id: the same id with cse_ in place
# of session_. Claude Code makes the same swap.
function code_session_id() {
   case "$1" in
      session_*) printf 'cse_%s\n' "${1#session_}" ;;
      *)         printf '%s\n' "$1" ;;
   esac
}
# }}}

# -- {{{ fetch_log
# Write one session's whole log to $2, one line per event, oldest first.
# The paged feed is read from its first event; a session the feed does not
# know falls back to the older one-shot feed.
function fetch_log() {
   local session_id="$1" out="$2"
   local page="$RUN_DIR/log-page" cursor="" pages=0
   local feed="$CLAUDE_CLOUD_API/v1/code/sessions/$(code_session_id "$session_id")/teleport-events"
   : > "$out"
   while :; do
      local url="$feed?limit=1000"
      if [ -n "$cursor" ]; then
         url="$url&cursor=$cursor"
      else
         url="$url&from_first_event=true"
      fi
      if ! get_json "$url" "$page" "session $session_id"; then
         [ "$pages" -eq 0 ] || die "session $session_id: vanished part way through (404)"
         fetch_log_one_shot "$session_id" "$out"
         return
      fi
      jq -c '.data[] | .payload | select(. != null)' "$page" >> "$out"
      pages=$((pages + 1))
      cursor=$(jq -r '.next_cursor // empty' "$page")
      [ -n "$cursor" ] || break
      # A feed that never stops is a bug somewhere; better to say so.
      [ "$pages" -lt 1000 ] || die "session $session_id: more than 1000 pages, giving up"
   done
}
# }}}

# -- {{{ fetch_log_one_shot
function fetch_log_one_shot() {
   local session_id="$1" out="$2" page="$RUN_DIR/log-page"
   get_json "$CLAUDE_CLOUD_API/v1/session_ingress/session/$session_id" "$page" "session $session_id" \
      || die "session $session_id: the cloud has no log for it (404)"
   jq -c '.loglines[]' "$page" > "$out"
}
# }}}

# -- {{{ fetch_helpers
# Write each helper agent's (subagent's) log of a session into $2 as
# agent-<id>.jsonl, the name and folder Claude Code gives them locally, so
# backup-conversations finds them beside the parent and exports each one as
# its own transcript linked from the parent's.
#
# The helpers come from the same paged feed as the main log, asked with
# subagents=true. Asked that way the feed returns only helper rows, never
# main-conversation rows (seen 2026-11-05: 160 rows, two helpers, none of the
# parent's 2057), and each row names its helper in session_agent_id. The
# rows of all helpers arrive together; they are split by that id, keeping
# each helper's rows in the order they came, oldest first.
#
# A session the paged feed does not know (404 on the first page) is one
# whose main log came from the one-shot feed, which has no helper rows to
# offer; that is said on stderr and the session goes on without helpers.
function fetch_helpers() {
   local session_id="$1" out_dir="$2"
   local page="$RUN_DIR/helper-page" rows="$RUN_DIR/helper-rows" cursor="" pages=0
   local feed="$CLAUDE_CLOUD_API/v1/code/sessions/$(code_session_id "$session_id")/teleport-events"
   mkdir -p "$out_dir"
   : > "$rows"
   while :; do
      local url="$feed?limit=1000&subagents=true"
      if [ -n "$cursor" ]; then
         url="$url&cursor=$cursor"
      else
         url="$url&from_first_event=true"
      fi
      if ! get_json "$url" "$page" "session $session_id helpers"; then
         [ "$pages" -eq 0 ] || die "session $session_id: helper feed vanished part way through (404)"
         echo "fetch-cloud-conversations: session $session_id: the cloud has no helper feed for it; its helpers, if any, are not fetched" >&2
         return
      fi
      # A row's payload is compact JSON, so it holds no raw tab: the first
      # tab on the line always ends the helper id.
      jq -r '.data[] | select(.payload != null and .session_agent_id != null)
             | "\(.session_agent_id)\t\(.payload | tojson)"' "$page" >> "$rows"
      pages=$((pages + 1))
      cursor=$(jq -r '.next_cursor // empty' "$page")
      [ -n "$cursor" ] || break
      [ "$pages" -lt 1000 ] || die "session $session_id: more than 1000 pages of helpers, giving up"
   done
   # The helper id becomes part of a file name, so anything but letters,
   # digits, dash and underscore stops the run rather than writing elsewhere.
   awk -v dir="$out_dir" '{
      tab = index($0, "\t")
      id = substr($0, 1, tab - 1)
      if (id !~ /^[A-Za-z0-9_-]+$/) { print id; exit 1 }
      print substr($0, tab + 1) > (dir "/agent-" id ".jsonl")
   }' "$rows" > "$RUN_DIR/bad-helper-id" \
      || die "session $session_id: a helper id is not a plain name: $(cat "$RUN_DIR/bad-helper-id")"
}
# }}}

# -- {{{ describe_helpers
# Write agent-<id>.meta.json beside each helper log in $2, as Claude Code
# writes it locally: backup-conversations names a helper's transcript by the
# "description" in that file and refuses a helper without one.
#
# The cloud's helper rows carry no description. The parent's log does: the
# launch holds it, and the launch's result names the helper it started
# (toolUseResult.agentId), tied to the launch by the tool call's id. Two
# kinds of launch start a helper:
#   - an Agent (once Task) call: its description and agent type, as given;
#   - a Skill call that runs the skill in a fork: Claude Code describes
#     that helper as "/<skill> <args>" (seen 2026-11-05 in a local
#     agent-*.meta.json: "/code-review 324 medium"), named after the skill.
#
# A helper whose launch is not in the parent's log gets a file without a
# description, and the export then stops and says which helper it was. That
# happens when the launch came before a compaction: the cloud's log of a
# session starts at its latest compaction (seen 2026-11-05).
function describe_helpers() {
   local main_log="$1" helper_dir="$2" helper id
   local launches="$RUN_DIR/helper-launches"
   jq -sc '
      ([.[] | select(.type == "assistant") | .message.content[]?
            | select(.type == "tool_use")
            | if .name == "Agent" or .name == "Task" then
                 {key: .id, value: {description: .input.description, agentType: .input.subagent_type}}
              elif .name == "Skill" then
                 {key: .id, value: {description: ("/" + .input.skill + (if (.input.args // "") != "" then " " + .input.args else "" end)),
                                    name: .input.skill}}
              else empty end]
       | from_entries) as $launch
      | [.[] | select(.toolUseResult.agentId? != null) as $row
             | $row.message.content[]? | select(.type == "tool_result")
             | {key: $row.toolUseResult.agentId, value: ($launch[.tool_use_id] // {})}]
      | from_entries' "$main_log" > "$launches"
   for helper in "$helper_dir"/agent-*.jsonl; do
      [ -f "$helper" ] || continue
      id=$(basename "$helper" .jsonl)
      id="${id#agent-}"
      jq -c --arg id "$id" '(.[$id] // {}) | with_entries(select(.value != null))' "$launches" \
         > "${helper%.jsonl}.meta.json"
   done
}
# }}}

# -- {{{ project_for
# The project folder a session is filed under: the first of its repositories
# that the map names, or the default.
function project_for() {
   local session_json="$1" repo dir
   if [ -f "$CLOUD_SESSION_PROJECTS" ]; then
      for repo in $(printf '%s' "$session_json" | jq -r '.repos[]'); do
         dir=$(awk -v r="$repo" '$1 !~ /^#/ && $1 == r { $1 = ""; sub(/^ +/, ""); print; exit }' "$CLOUD_SESSION_PROJECTS")
         if [ -n "$dir" ]; then
            printf '%s\n' "${dir/#\~/$HOME}"
            return
         fi
      done
   fi
   printf '%s\n' "$CLOUD_TRANSCRIPT_PROJECT"
}
# }}}

# -- {{{ session_folder_for
# The same folder naming Claude Code and backup-conversations use, so
# backup-conversations finds the log with its sessions root pointed here.
function session_folder_for() {
   printf '%s/%s\n' "$CLOUD_SESSIONS_ROOT" "$(printf '%s' "$1" | sed 's/[^A-Za-z0-9]/-/g')"
}
# }}}

# -- {{{ same_helpers
# True when two helper folders hold the same files with the same contents.
# A folder that does not exist counts as an empty one, so a session that
# never had helpers is unchanged by a fetch that found none.
function same_helpers() {
   local old="$1" new="$2"
   [ -d "$old" ] || old="$RUN_DIR/no-helpers"
   mkdir -p "$RUN_DIR/no-helpers"
   diff -rq "$old" "$new" >/dev/null
}
# }}}

# -- {{{ bring_home
# Fetch one session and its helpers; keep them only if something changed;
# export them if asked to. Prints "new", "changed", "unchanged" or "empty".
#
# The session's log is kept at <folder>/<id>.jsonl and its helpers at
# <folder>/<id>/subagents/agent-<helper>.jsonl, the layout Claude Code uses
# locally, so backup-conversations reads both with one --session.
#
# A log with no events at all is "empty": nothing is kept or exported, and
# main names the session and fails the run. It used to be kept as an empty
# file and passed over in silence (seen on 2026-11-05 for 22 sessions, every
# one of them a Remote Control session, which are no longer fetched).
function bring_home() {
   local session_json="$1"
   local session_id project folder log helpers fresh fresh_helpers
   session_id=$(printf '%s' "$session_json" | jq -r '.id')
   project=$(project_for "$session_json")
   folder=$(session_folder_for "$project")
   log="$folder/$session_id.jsonl"
   helpers="$folder/$session_id/subagents"
   fresh="$RUN_DIR/fresh.jsonl"
   fresh_helpers="$RUN_DIR/fresh-subagents"
   rm -rf "$fresh_helpers"

   fetch_log "$session_id" "$fresh"
   if [ ! -s "$fresh" ]; then
      echo empty
      return
   fi
   fetch_helpers "$session_id" "$fresh_helpers"
   describe_helpers "$fresh" "$fresh_helpers"

   # new: never kept before. unchanged: log and helpers match what is kept,
   # so nothing is written or exported. changed: either one differs.
   local state
   if [ ! -f "$log" ]; then
      state=new
   elif cmp -s "$fresh" "$log" && same_helpers "$helpers" "$fresh_helpers"; then
      echo unchanged
      return
   else
      state=changed
   fi
   mkdir -p "$folder"
   # Rename into place, so a reader never sees half a log. The helpers'
   # folder is replaced whole, so a helper the cloud no longer lists does
   # not linger beside the ones it does.
   rm -rf "$helpers"
   if [ -n "$(ls -A "$fresh_helpers")" ]; then
      mkdir -p "$folder/$session_id"
      mv "$fresh_helpers" "$helpers"
   fi
   mv "$fresh" "$log.part"
   mv "$log.part" "$log"

   if [ "$EXPORT" = yes ]; then
      CLAUDE_SESSIONS_ROOT="$CLOUD_SESSIONS_ROOT" \
         "$SCRIPTS_DIR/backup-conversations" --session "$session_id" "$project" >&2 \
         || die "session $session_id: fetched, but backup-conversations could not export it"
   fi
   echo "$state"
}
# }}}

# -- {{{ main
function main() {
   CLAUDE_CLOUD_API="${CLAUDE_CLOUD_API:-https://api.anthropic.com}"
   CLOUD_SESSIONS_ROOT="${CLOUD_SESSIONS_ROOT:-$HOME/.claude/cloud-projects}"
   CLOUD_TRANSCRIPT_PROJECT="${CLOUD_TRANSCRIPT_PROJECT:-$HOME}"
   CLOUD_SESSION_PROJECTS="${CLOUD_SESSION_PROJECTS:-$SCRIPTS_DIR/config/cloud-session-projects}"

   local mode=all one_session="" limit=0
   EXPORT=yes
   while [ $# -gt 0 ]; do
      case "$1" in
         --list)       mode=list ;;
         --session)    mode=one; one_session="${2:?--session needs a session id}"; shift ;;
         --fetch-only) EXPORT=no ;;
         --limit)      limit="${2:?--limit needs a number}"; shift ;;
         -h|--help)    sed -n '2,/^set -euo/p' "$0" | sed '$d' | sed 's/^# \{0,1\}//'; return ;;
         *)            die "unknown argument: $1 (try --help)" ;;
      esac
      shift
   done
   [[ "$limit" =~ ^[0-9]+$ ]] || die "--limit needs a whole number"

   # Missing tools are errors, named plainly (issue 025).
   local tool
   for tool in jq awk cmp; do
      command -v "$tool" >/dev/null || die "required tool '$tool' is not installed"
   done
   [ -n "${CLOUD_HTTP_GET:-}" ] || command -v curl >/dev/null || die "required tool 'curl' is not installed"

   prepare_scratch
   read_sign_in

   local sessions="$RUN_DIR/sessions"
   list_sessions "$limit" > "$sessions"

   # The listing names each session's kind in words: "cloud" for one that
   # ran on Anthropic's machines, "remote-control" for one that ran here.
   if [ "$mode" = list ]; then
      jq -r '[.updated_at // .created_at, .id,
              ({"anthropic_cloud": "cloud", "bridge": "remote-control"}[.kind] // .kind),
              .title] | @tsv' "$sessions"
      return
   fi

   if [ "$mode" = one ]; then
      local wanted
      wanted=$(jq -c --arg id "$one_session" 'select(.id == $id)' "$sessions" | head -n 1)
      [ -n "$wanted" ] || wanted=$(jq -nc --arg id "$one_session" '{id: $id, repos: []}')
      printf '%s\n' "$wanted" > "$sessions"
   fi

   # A Remote Control session ("bridge") ran in Claude Code on this
   # computer; the cloud only relayed it to the app. Its log is already in
   # ~/.claude/projects under the folder it ran in, and backup-conversations
   # files it there. So it is not fetched: fetching it would file a second
   # transcript of the same conversation under the default project. Checked
   # 2026-11-05: every one of the 22,508 events in the 25 Remote Control
   # copies the cloud held was also in a local log; the other 22 copies were
   # empty. A Remote Control session cannot outlive its computer (it runs
   # there), so the cloud copy has nothing the local log lacks.
   local new=0 changed=0 unchanged=0 remote=0 line state kind sid
   local empty_ids=""
   while IFS= read -r line; do
      [ -n "$line" ] || continue
      kind=$(printf '%s' "$line" | jq -r '.kind // ""')
      if [ "$kind" = bridge ]; then
         remote=$((remote + 1))
         continue
      fi
      state=$(bring_home "$line") || exit 1
      case "$state" in
         new)       new=$((new + 1)) ;;
         changed)   changed=$((changed + 1)) ;;
         unchanged) unchanged=$((unchanged + 1)) ;;
         empty)     sid=$(printf '%s' "$line" | jq -r '.id')
                    empty_ids="$empty_ids $sid" ;;
      esac
   done < "$sessions"
   local empty_count
   empty_count=$(printf '%s' "$empty_ids" | wc -w)
   echo "Cloud sessions: $new new, $changed changed, $unchanged unchanged, $empty_count empty -> $CLOUD_SESSIONS_ROOT"
   echo "Remote Control sessions: $remote left to this computer's own logs (not fetched)"
   # An empty log from a session that ran in the cloud means the feed
   # answered with nothing where a conversation should be: an error, named,
   # never a quiet zero (issue 025).
   if [ "$empty_count" -gt 0 ]; then
      for sid in $empty_ids; do
         echo "fetch-cloud-conversations: session $sid: the cloud answered with an empty log; nothing was kept" >&2
      done
      exit 1
   fi
}
# }}}

main "$@"
