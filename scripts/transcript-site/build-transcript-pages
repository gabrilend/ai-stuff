#!/bin/bash
#
# build-transcript-pages
#
# Turns a project's saved conversations into web pages you can read in a
# browser: one page per conversation, with the person and the assistant on
# opposite sides of the page and a small film beside each message when the
# project asks for films, plus a table of contents that tells the project's
# story as its list of commits, oldest first, each with a button that opens
# the conversation at the moment the commit was made.
#
# By default the pages go in the project's llm-transcripts/HTML/ folder,
# beside the transcripts they are made from. A project that wants anything
# different -- another history, another folder, its own colours, films --
# says so in a settings file (see README.md in this folder).
#
# Usage:
#   build-transcript-pages [project-dir] [--settings <file>] [--dir <scripts-dir>]
#
#   project-dir   the project to build (default: the current folder)
#   --settings    a settings file (default: the project's own
#                 transcript-site.settings.lua, or none)
#   --dir         where the ai-stuff scripts live (default below)

set -euo pipefail

DIR="/home/ritz/programming/ai-stuff/scripts"

# -- {{{ parse_arguments
function parse_arguments() {
   PROJECT=""
   SETTINGS=""
   while [ $# -gt 0 ]; do
      case "$1" in
         --settings) SETTINGS="${2:?--settings needs a file}"; shift ;;
         --dir)      DIR="${2:?--dir needs a folder}"; shift ;;
         -h|--help)  sed -n '2,/^set -euo/p' "$0" | sed '$d' | sed 's/^# \{0,1\}//'; exit 0 ;;
         -*)         echo "build-transcript-pages: unknown option $1" >&2; exit 1 ;;
         *)          PROJECT="$1" ;;
      esac
      shift
   done
   PROJECT="${PROJECT:-$(pwd)}"
   SITE="$DIR/transcript-site"
}
# }}}

# -- {{{ main
function main() {
   parse_arguments "$@"

   # The table of contents is built from git history; a project that is not
   # in a repository has no history to tell, which is an error rather than a
   # page quietly listing files in some other order.
   if ! git -C "$PROJECT" rev-parse --git-dir > /dev/null; then
      echo "build-transcript-pages: $PROJECT is not in a git repository, so there is no history for the table of contents" >&2
      return 1
   fi

   PROJECT=$(realpath "$PROJECT")
   # Two paths: a settings file named here, or the builder looks for the
   # project's own (and uses the defaults when there is none).
   if [ -n "$SETTINGS" ]; then
      luajit "$SITE/build-site.lua" "$PROJECT" "$(realpath "$SETTINGS")"
   else
      luajit "$SITE/build-site.lua" "$PROJECT"
   fi
}
# }}}

main "$@"
