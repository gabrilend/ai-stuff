#!/usr/bin/env luajit
-- find-archived-exceptions
--
-- Writes archived-exceptions.lua: the fixed list of old transcripts the page
-- reader accepts even though they lack a line the exporter writes today.
--
-- In general terms: the exporter's header settled in 2026 (a "Generated on"
-- line in every transcript). Transcripts written before that, whose original
-- session logs have since been deleted, can never be rewritten into today's
-- shape. The owner decided (issue 035) that these are a known, closed set to
-- be listed rather than a reason to make the reader looser. This tool finds
-- them by reading every transcript on the machine under today's rules with no
-- exceptions, and lists a transcript only when BOTH are true:
--
--   the only thing wrong is the missing "Generated on" line, and
--   its session log is gone, so rebuilding it is impossible.
--
-- Anything else the reader refuses is printed as a problem and the run fails,
-- because that is either a transcript that can still be rebuilt (run
-- rederive-transcripts) or a format the reader does not know yet.
--
-- Usage: find-archived-exceptions [scripts-dir]

-- {{{ paths
local DIR = arg[1] or "/home/ritz/programming/ai-stuff/scripts"
local SITE = DIR .. "/transcript-site"
local SESSIONS = (os.getenv("CLAUDE_SESSIONS_ROOT") or (os.getenv("HOME") .. "/.claude/projects"))
-- The same places rederive-transcripts searches, to the same depth, with the
-- same folders left out (a worktree is a second checkout of a project listed
-- elsewhere; a backup is a copy kept to preserve what it was).
local SEARCH_ROOTS = { "/mnt/mtwo", "/mnt/cmdo", "/mnt/kaun" }
local SEARCH_DEPTH = 9
-- }}}

local reader = dofile(SITE .. "/transcript-reader.lua")
reader.use_archived_list({})

-- {{{ local function lines_of()
-- Runs a read-only command and returns its output lines. find's complaints
-- about unreadable system folders go to the terminal, where they belong.
local function lines_of(command)
  local pipe = assert(io.popen(command, "r"))
  local out = {}
  for line in pipe:lines() do
    out[#out + 1] = line
  end
  pipe:close()
  return out
end
-- }}}

-- {{{ local function excluded()
local function excluded(path)
  return path:find("/ai%-worktrees/") or path:find("/backups/") or path:find("/%.git/")
end
-- }}}

-- Every session log still on disk, by conversation id (string -> true).
local surviving = {}
for _, path in ipairs(lines_of("find '" .. SESSIONS .. "' -name '*.jsonl' -type f")) do
  surviving[path:match("([^/]+)%.jsonl$")] = true
end

local listed, problems, read_ok, not_transcripts = {}, {}, 0, 0
for _, root in ipairs(SEARCH_ROOTS) do
  local command = string.format(
    "find '%s' -maxdepth %d -path '*/llm-transcripts/*.md' -type f", root, SEARCH_DEPTH)
  for _, path in ipairs(lines_of(command)) do
    -- Only a file directly inside llm-transcripts/ is a transcript; its
    -- HTML/ pages and anything nested are not.
    if not excluded(path) and path:match("/llm%-transcripts/[^/]+%.md$") then
      local f = io.open(path, "r")
      local text = f and f:read("*a") or ""
      if f then f:close() end
      local id = text:match("^# Conversation Summary: ([^\n]+)")
      -- Three outcomes: not a transcript at all (no header - a word cloud, a
      -- note), which the rulebook leaves alone; read cleanly; or refused.
      if not id then
        not_transcripts = not_transcripts + 1
      else
        local ok, complaint = pcall(reader.read, text)
        if ok then
          read_ok = read_ok + 1
        elseif tostring(complaint):find("no generated%-on line") and not surviving[id] then
          listed[id] = path
        else
          problems[#problems + 1] = path .. "\n    " .. tostring(complaint)
            .. (surviving[id] and "\n    (its session log survives: rebuild it instead)" or "")
        end
      end
    end
  end
end

local ids = {}
for id in pairs(listed) do ids[#ids + 1] = id end
table.sort(ids)

local out = {
  "-- archived-exceptions.lua",
  "-- GENERATED by find-archived-exceptions; do not edit by hand.",
  "--",
  "-- Transcripts written before the exporter's header settled, whose session",
  "-- logs are gone, so they can never be rebuilt. The reader accepts these",
  "-- (by session id) without a \"Generated on\" line. Each is followed by where",
  "-- it was found when this list was made.",
  "return {",
}
for _, id in ipairs(ids) do
  out[#out + 1] = string.format("  [%q] = true, -- %s", id, listed[id])
end
out[#out + 1] = "}"
local file = assert(io.open(SITE .. "/archived-exceptions.lua", "w"))
file:write(table.concat(out, "\n") .. "\n")
file:close()

print(string.format("read under today's rules:   %d", read_ok))
print(string.format("archived exceptions listed: %d", #ids))
print(string.format("not transcripts (skipped):  %d", not_transcripts))
print(string.format("problems:                   %d", #problems))
for _, problem in ipairs(problems) do
  print("  " .. problem)
end
print("Wrote " .. SITE .. "/archived-exceptions.lua")
os.exit(#problems == 0 and 0 or 1)
