#!/bin/bash
#
# build-pages-before-push
#
# Brings the conversation web pages of every project in a repository up to
# date, just before that repository is pushed. It is what a repository's git
# "pre-push" hook runs (install-pages-hook puts it there).
#
# In general terms: each project keeps its saved conversations in an
# llm-transcripts/ folder and readable pages of them in llm-transcripts/HTML/.
# The pages are rebuildable output and are not committed; this keeps them
# current on the machine at the natural moment a piece of work is shipped.
# Every project is handed to the page builder, several at once (one per
# processor core), and the builder itself draws again only the pages whose
# transcript, or whose display code, changed since they were last drawn; the
# rest are left as they are. So a push in a repository of forty projects
# spends its time on the handful of pages that moved.
#
# A folder git has never committed is skipped and named: none of it is in
# the push, and its pages have no history to tell. A project whose pages
# cannot be built stops the push, with the builder's own words: the pages
# would otherwise go quietly stale. `git push --no-verify` skips every
# pre-push check, this one included.
#
# Usage: build-pages-before-push [repository] [--dir <scripts-dir>] [--jobs <n>]
#
#   repository   the repository (default: the one the current folder is in)
#   --dir        where the ai-stuff scripts live (default below)
#   --jobs       how many projects are built at once (default: the number
#                of processor cores)

set -euo pipefail

DIR="/home/ritz/programming/ai-stuff/scripts"

# -- {{{ parse_arguments
function parse_arguments() {
   REPO=""
   JOBS=$(nproc)
   while [ $# -gt 0 ]; do
      case "$1" in
         --dir)  DIR="${2:?--dir needs a folder}"; shift ;;
         --jobs) JOBS="${2:?--jobs needs a number}"; shift ;;
         -h|--help) sed -n '2,/^set -euo/p' "$0" | sed '$d' | sed 's/^# \{0,1\}//'; exit 0 ;;
         *) REPO="$1" ;;
      esac
      shift
   done
   REPO=$(git -C "${REPO:-$(pwd)}" rev-parse --show-toplevel)
}
# }}}

# -- {{{ projects_in
# Every folder in the repository (the top and up to three levels down) that
# holds an llm-transcripts/ folder with at least one transcript in it. The
# pages' own HTML/ folder never qualifies, having no transcripts.
function projects_in() {
   local folder
   while IFS= read -r folder; do
      if grep -l -s -m1 '^# Conversation Summary: ' "$folder"/*.md > /dev/null; then
         dirname "$folder"
      fi
   done < <(find "$REPO" -maxdepth 4 -type d -name llm-transcripts -not -path '*/.git/*')
}
# }}}

# -- {{{ build_one
# Builds one project's pages into its own log in the run's RAM folder, and
# leaves beside it a status file holding the builder's exit status. Run on
# its own process by xargs, so it reads only its arguments and the exported
# DIR; no two runs touch the same files.
function build_one() {
   local project="$1" logs="$2"
   local name
   name=$(printf '%s' "$project" | md5sum | cut -c1-12)
   printf '%s\n' "$project" > "$logs/$name.project"
   # Two paths: the builder succeeds (status 0) or fails (its status), and
   # either way its words are kept in the log for the summary.
   if "$DIR/transcript-site/build-transcript-pages" "$project" --dir "$DIR" > "$logs/$name.log" 2>&1; then
      echo 0 > "$logs/$name.status"
   else
      echo $? > "$logs/$name.status"
   fi
}
# }}}
export -f build_one
export DIR

# -- {{{ main
function main() {
   parse_arguments "$@"

   # The run's logs live in RAM and go when it ends; a failure's words are
   # printed before then.
   # LOGS is the script's, not the function's: the trap runs after main has
   # returned, when a local name is gone.
   LOGS=$(mktemp -d /dev/shm/build-pages-before-push.XXXXXX)
   trap 'rm -rf "$LOGS"' EXIT
   local logs="$LOGS"

   local project skipped=0
   local -a to_build=()
   while IFS= read -r project; do
      # Two paths: git has a commit touching the folder (built), or it has
      # none (skipped, and said so).
      if [ -n "$(git -C "$REPO" log -1 --format=%H -- "$project")" ]; then
         to_build+=("$project")
      else
         echo "transcript pages: skipping $project: git has never committed it, so it is not in this push"
         skipped=$((skipped + 1))
      fi
   done < <(projects_in)

   if [ "${#to_build[@]}" -gt 0 ]; then
      printf '%s\n' "${to_build[@]}" \
         | xargs -d '\n' -P "$JOBS" -I{} bash -c 'build_one "$1" "$2"' _ {} "$logs"
   fi

   local status_file name drawn current page_counts
   local projects=0 failed=0 pages_drawn=0 pages_current=0
   for status_file in "$logs"/*.status; do
      [ -e "$status_file" ] || continue
      name=$(basename "$status_file" .status)
      project=$(cat "$logs/$name.project")
      projects=$((projects + 1))
      # Two paths: a build that failed (its words printed, the push stopped)
      # or one that succeeded (its page counts added up).
      if [ "$(cat "$status_file")" != "0" ]; then
         echo "transcript pages: FAILED for $project:" >&2
         grep -v '^Reading ' "$logs/$name.log" | sed 's/^/    /' >&2
         failed=$((failed + 1))
      else
         page_counts=$(sed -n 's/^  pages drawn *\([0-9]*\), \([0-9]*\) already current$/\1 \2/p' "$logs/$name.log")
         if [ -z "$page_counts" ]; then
            echo "transcript pages: the builder said nothing about its pages for $project" >&2
            failed=$((failed + 1))
            continue
         fi
         read -r drawn current <<< "$page_counts"
         if [ "$drawn" -gt 0 ]; then
            echo "transcript pages: $project: $drawn page(s) drawn"
         fi
         pages_drawn=$((pages_drawn + drawn))
         pages_current=$((pages_current + current))
      fi
   done
   echo "transcript pages: $projects projects, $pages_drawn pages drawn, $pages_current already current, $skipped skipped, $failed failed"
   [ "$failed" -eq 0 ]
}
# }}}

main "$@"
