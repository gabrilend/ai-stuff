#!/usr/bin/env luajit
-- make-default-palette
--
-- Writes default-palette.lua: the colours every project's transcript pages
-- wear unless that project passes its own. They are double-diaper-dungeon's
-- colours, because those pages are the look the owner chose for all of them
-- (issue 035), and this copies them out of that game's balance table rather
-- than having anyone retype seven colours by hand.
--
-- Run it again after the game's colours are tuned, and the pages follow.
--
-- Usage: make-default-palette [scripts-dir] [balance-table]

-- {{{ paths
local DIR = arg[1] or "/home/ritz/programming/ai-stuff/scripts"
local BALANCE = arg[2] or "/home/ritz/games/tq/ai-stuff/double-diaper-dungeon/assets/023-balance-table.lua"
local SITE = DIR .. "/transcript-site"
-- }}}

local palette = dofile(SITE .. "/site-palette.lua")

-- The balance table is a Lua file returning a table; the colours are in its
-- `palette` field. A missing file or field is an error, not an empty palette:
-- a page with no colours renders text black on black and looks blank.
local chunk, complaint = loadfile(BALANCE)
if not chunk then
  io.stderr:write("make-default-palette: cannot read " .. BALANCE .. ": " .. tostring(complaint) .. "\n")
  os.exit(1)
end
local balance = chunk()
if type(balance) ~= "table" or type(balance.palette) ~= "table" then
  io.stderr:write("make-default-palette: " .. BALANCE .. " has no palette in it\n")
  os.exit(1)
end

local lines = {
  "-- default-palette.lua",
  "-- GENERATED by make-default-palette from",
  "-- " .. BALANCE,
  "-- Do not edit by hand; tune the game's colours and run the generator again.",
  "--",
  "-- The same shape as that balance table: palette maps a colour name to",
  "-- { value = { red, green, blue } }, each channel a number from 0 to 1.",
  "return {",
  "  palette = {",
}
for _, wanted in ipairs(palette.WANTED) do
  local entry = balance.palette[wanted.from]
  if not entry or type(entry.value) ~= "table" then
    io.stderr:write("make-default-palette: the balance table has no colour called " .. wanted.from .. "\n")
    os.exit(1)
  end
  lines[#lines + 1] = string.format("    %-12s = { value = { %.2f, %.2f, %.2f } },",
    wanted.from, entry.value[1], entry.value[2], entry.value[3])
end
lines[#lines + 1] = "  },"
lines[#lines + 1] = "}"

local out = assert(io.open(SITE .. "/default-palette.lua", "w"))
out:write(table.concat(lines, "\n") .. "\n")
out:close()
print("Wrote " .. SITE .. "/default-palette.lua")
