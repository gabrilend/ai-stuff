#!/usr/bin/env luajit
--
-- refuse-relative-commit-ref
--
-- A gate that sits in front of every shell command Claude Code tries to run and
-- refuses any history-changing git command that names its target commit by
-- counting backwards -- HEAD~1, HEAD^, @~2, main~3, HEAD@{1} -- instead of by
-- the commit's own hash.
--
-- The reason it exists: HEAD~1 is not a name, it is a sum. Nothing about it is
-- checked. It means "one step back from wherever HEAD is standing at the instant
-- this runs", and HEAD moves -- another session commits, an earlier command on
-- the same line commits, a rebase lands, a merge fast-forwards. When that
-- happens the sum does not fail. It quietly resolves to a different commit, and
-- `reset --hard` does not ask twice.
--
-- A hash is the opposite kind of reference. It is checked rather than computed:
-- either that object is there and is the one that was read out of the log a
-- moment ago, or git refuses the command. The failure mode of a wrong hash is an
-- error message. The failure mode of a wrong count is a lost afternoon.
--
-- Reading the log first and pasting the hash also puts a person's eyes on the
-- commit about to be destroyed, which is most of the value of the pause.
--
-- WHAT IS REFUSED
--
--   git reset --hard HEAD~1            a count, evaluated at run time
--   git reset --hard 'HEAD@{1}'        quoting does not change what it is
--   git revert HEAD^                   the same, one parent back
--   git rebase -i HEAD~5
--   git rebase --onto main~3 topic
--   git cherry-pick abc123~2
--   git commit --fixup=HEAD~1
--   git branch -f main HEAD~2
--   git reset --hard HEAD@{1}          the reflog is a count too
--   git reset --hard ORIG_HEAD         "wherever HEAD was before the last move"
--   git reset --hard :/fix             "the newest commit whose message says fix"
--   git reset --hard $(git rev-parse HEAD~1)
--                                      a count computed one step removed
--   git checkout HEAD~1 -- src/main.c  overwrites the file from an ancestor
--   git restore --source=HEAD~2 src/   the same, wearing another name
--   git checkout -   /  git switch -   "the branch before this one", a count
--   R=HEAD~1; git reset --hard $R      a count carried in a variable set on the line
--   git stash drop stash@{1}           the stash list is shared between sessions
--   git update-ref refs/heads/main HEAD~1
--   git worktree add /tmp/w HEAD~1
--   git notes add -m x HEAD~1
--   git push --force origin HEAD~1:main
--                                      a count aimed at other people's clones
--
-- WHAT IS ALLOWED
--
--   git reset --hard 4f2a1c9           a name; checked, not computed
--   git reset --hard HEAD              no count; "throw away my edits"
--   git commit --amend                 no revision named at all
--   git commit -m "handle ^C, drop ~/.cache"
--                                      a message is prose, not a revision
--   git checkout -- backup.txt~        after --, every word is a path
--   git log -3 HEAD~5                  reading is not modifying
--   git log HEAD~5 && git reset --hard 4f2a1c9
--                                      each command on a line is judged alone
--   git show HEAD^{commit}             peeling names the same commit
--   git push --force-with-lease origin main
--                                      forced, but nothing is counted
--   git push origin HEAD~1:main        not forced; git refuses it by itself
--
-- The gated subcommands move history, or overwrite work from wherever a count
-- lands: revert reset rebase cherry-pick commit branch tag replace
-- filter-branch checkout switch restore update-ref notes merge, `stash` when it
-- drops, pops, applies or branches, `worktree add`, and `push` when a force
-- flag (or a `+refspec`) rides along. The reading commands -- log, show, diff,
-- blame, rev-parse -- are left alone entirely, because counting backwards to
-- look at something is how the hash gets found in the first place.
--
-- A branch or tag name is accepted. It is mutable state like HEAD is, so this
-- is a line drawn rather than a principle carried to its end -- but `main` was
-- asked for by name rather than by distance.
--
-- HOW IT READS A COMMAND
--
-- Through the shared shell-word reader (libs/shell-command-scan.lua). The words
-- it judges are the words git will receive, with quotes already removed -- so
-- 'HEAD~1' is caught, while the values of message options (-m, -F, --author)
-- and every word after `--` are skipped, being prose and paths. Heredoc bodies
-- are never judged, since a commit message fed through -F - is prose too. The
-- earlier version removed quoted spans from the text instead, which hid a
-- quoted revision and, after `git -C "/a path"`, let -C swallow the subcommand.
--
-- WHAT THIS IS NOT
--
-- Not a security boundary. The assistant it constrains can edit this file or
-- remove the hook that installs it. What it buys is that the careless form is
-- not available by habit, and that every way around is something a person
-- would see in the transcript. An honour system with a witness, not a lock.
--
-- The refusal can be lifted one time by creating the permission token below.
--
-- Usage: refuse-relative-commit-ref [token-path] [scripts-directory]

local TOKEN = arg[1] or "/tmp/claude-allow-relative-commit-ref"
local DIR = arg[2] or "/home/ritz/programming/ai-stuff/scripts"
local GATE_NAME = "refuse-relative-commit-ref"

package.path = DIR .. "/libs/?.lua;" .. package.path
local gate = require("hook-gate")
local scan = require("shell-command-scan")

-- {{{ local function counts_backwards()
-- Whether one word reaches a commit by counting rather than by naming it:
--   ~ or ~N with ref characters before it       HEAD~  HEAD~3  main~2
--   ^ or ^N with ref characters before it       HEAD^  HEAD^2
--   @{...}                                      HEAD@{1}  @{-1}  stash@{2}
--   ORIG_HEAD                                   where HEAD was before a move
--   :/text                                      newest commit matching text
-- A tilde with nothing before it is a home directory (~/notes), and ^ followed
-- by { is peeling (HEAD^{commit}), which takes no step.
local function counts_backwards(word)
    if word:find("@{", 1, true) then return true end
    if word:find("ORIG_HEAD", 1, true) then return true end
    if word:sub(1, 2) == ":/" then return true end
    local pos = 1
    while true do
        local s = word:find("[~^]", pos)
        if not s then return false end
        local before = word:sub(s - 1, s - 1)
        if s > 1 and before:match("[%w_}@]") then
            local c = word:sub(s, s)
            local after_digits = word:match("^%d*", s + 1)
            local nxt = word:sub(s + 1 + #after_digits, s + 1 + #after_digits)
            if c == "~" then
                -- HEAD~ HEAD~3 HEAD~3:main, but not a~b/c-shaped path text
                if nxt == "" or not nxt:match("[/%w]") then return true end
            else
                -- HEAD^ HEAD^2, but not HEAD^{commit}
                if #after_digits > 0 then return true end
                if nxt == "" or not nxt:match("[{%w_]") then return true end
            end
        end
        pos = s + 1
    end
end
-- }}}

-- {{{ local function has_force()
-- A push is gated only when it is forced: a flag, or a refspec starting with +.
local FORCE_FLAGS = { ["-f"] = true, ["--force"] = true, ["--force-if-includes"] = true }
local function has_force(args)
    for _, a in ipairs(args) do
        if FORCE_FLAGS[a] or a:match("^%-%-force%-with%-lease") or a:sub(1, 1) == "+" then
            return true
        end
    end
    return false
end
-- }}}

-- The gated subcommands. For each: which option values are prose to be
-- skipped, whether a lone "-" means "the previous branch", and, for the ones
-- only sometimes gated, the test that decides.
local MESSAGE_OPTIONS = {
    ["-m"] = true, ["--message"] = true, ["-F"] = true, ["--file"] = true,
    ["-t"] = true, ["--template"] = true, ["--author"] = true, ["--date"] = true,
    ["--trailer"] = true, ["--cleanup"] = true,
}
local NO_SKIPS = {}
local GATED = {
    revert = { skip = { ["-m"] = true, ["--mainline"] = true }, dash_is_count = true },
    reset = { skip = NO_SKIPS, dash_is_count = true },
    rebase = { skip = { ["-x"] = true, ["--exec"] = true }, dash_is_count = true },
    ["cherry-pick"] = { skip = { ["-m"] = true, ["--mainline"] = true }, dash_is_count = true },
    merge = { skip = MESSAGE_OPTIONS, dash_is_count = true },
    commit = { skip = MESSAGE_OPTIONS },
    branch = { skip = NO_SKIPS },
    tag = { skip = MESSAGE_OPTIONS },
    replace = { skip = NO_SKIPS },
    ["filter-branch"] = { skip = NO_SKIPS },
    checkout = { skip = NO_SKIPS, dash_is_count = true },
    switch = { skip = NO_SKIPS, dash_is_count = true },
    restore = { skip = NO_SKIPS },
    ["update-ref"] = { skip = { ["-m"] = true } },
    notes = { skip = MESSAGE_OPTIONS },
    stash = {
        skip = { ["-m"] = true, ["--message"] = true },
        applies = function(args)
            local actions = { drop = true, pop = true, apply = true, branch = true, store = true }
            return actions[args[1] or ""] == true
        end,
    },
    worktree = {
        skip = { ["-b"] = true, ["-B"] = true, ["--reason"] = true },
        applies = function(args) return args[1] == "add" end,
    },
    push = { skip = { ["-o"] = true, ["--push-option"] = true, ["--repo"] = true }, applies = has_force },
}

-- {{{ local function offending_word()
-- The first word of a gated git command that counts backwards, or nil.
-- `values` holds the variables the same line set, so `R=HEAD~1; git reset
-- --hard $R` is judged on what $R will hold.
local function offending_word(invocation, values)
    local rule = GATED[invocation.subcommand]
    -- not a subcommand this gate cares about: reading, pushing unforced, ...
    if not rule then return nil end
    if rule.applies and not rule.applies(invocation.args) then return nil end

    local args = {}
    for k, a in ipairs(invocation.args) do args[k] = scan.expand_known(a, values) end
    local i = 1
    while args[i] do
        local w = args[i]
        if w == "--" then
            -- everything after -- is a path; editor backups end in ~ harmlessly
            return nil
        elseif w == "-" then
            -- a lone dash: "the previous branch" to the commands that take a
            -- revision (git reads it as @{-1}), and "standard input" elsewhere
            if rule.dash_is_count then return w end
            i = i + 1
        elseif w:sub(1, 2) == "--" and w:find("=", 1, true) then
            -- --option=value: judge the value unless the option carries prose
            local option, value = w:match("^([^=]+)=(.*)$")
            if not rule.skip[option] and counts_backwards(value) then return w end
            i = i + 1
        elseif w:sub(1, 1) == "-" then
            -- a flag; a prose option also takes the next word with it
            i = i + (rule.skip[w] and 2 or 1)
        else
            if counts_backwards(w) then return w end
            i = i + 1
        end
    end
    return nil
end
-- }}}

-- {{{ local function main()
local function main()
    local input, json = gate.read_input(GATE_NAME, DIR)
    local command_text = gate.pending_command(GATE_NAME, input)

    local offending = nil
    local commands = scan.all_commands(command_text)
    local values = scan.assignments(commands)
    for _, command in ipairs(commands) do
        local invocation = scan.git_invocation(scan.effective_words(command))
        -- only git commands are judged; each one on its own
        if invocation then
            offending = offending_word(invocation, values)
            if offending then break end
        end
    end
    -- nothing on the line counts backwards into history: most commands end here
    if not offending then os.exit(0) end

    gate.refuse_unless_token(json, TOKEN,
        "This command reaches for the commit by counting backwards (" .. offending .. ") instead of naming it. The count is worked out when the command runs, against wherever HEAD is standing at that moment -- so if the history moved since the log was last read, the count still succeeds, it just lands on a different commit, and nothing reports an error. Read the hash first (git log --oneline -5, or git stash list) and pass that instead: git reset --hard 4f2a1c9. A hash is checked rather than calculated, so a wrong one fails loudly instead of quietly destroying the wrong thing. If the user genuinely wants the relative form this once, ask them to type: ! touch " .. TOKEN)
end
-- }}}

main()
