#!/usr/bin/env luajit
--
-- stage-own-changes
--
-- A preview: prints what commit-own-changes would commit in one repository --
-- this Claude Code session's own change blocks, the files it would take whole,
-- the changed transcripts of the commit's projects, and every block it would
-- leave out and why -- and changes nothing at all.
--
-- It used to stage those lines into the repository's shared staging area for a
-- plain `git commit`. On 2026-09-22 that sharing let another session's commit
-- carry 55 of this session's staged files (issue 032a), so committing now goes
-- through commit-own-changes, which builds each commit on a private staging
-- list and never uses the shared one. The name is kept so that the old habit
-- gets a useful answer instead of an error.
--
-- How it works: it seeds a private staging list in RAM from the branch tip,
-- judges the working tree against it with the same library commit-own-changes
-- uses (own-changes-patch.lua), prints the verdicts, and deletes the list.
--
-- The session is read from CLAUDE_CODE_SESSION_ID, which Claude Code sets for
-- every shell command it runs.
--
-- Usage: stage-own-changes [repository-directory] [--project <dir>]
--                          [--scripts-dir <dir>]
--   repository-directory defaults to the ai-stuff monorepo below.
--   --project <dir> the session's project folder (default: the current one,
--                   where Claude Code keeps the session).
-- Hooks are not run: a preview must not have their effects.

local DIR = "/mnt/mtwo/programming/ai-stuff"
local SCRIPTS_DIR = "/home/ritz/programming/ai-stuff/scripts"
local PROJECT_DIR = "."
do
    local i = 1
    while arg[i] do
        -- two options; a bare word is the repository
        if arg[i] == "--scripts-dir" then
            SCRIPTS_DIR = arg[i + 1]
            i = i + 2
        elseif arg[i] == "--project" then
            PROJECT_DIR = arg[i + 1]
            i = i + 2
        else
            DIR = arg[i]
            i = i + 1
        end
    end
end

package.path = SCRIPTS_DIR .. "/libs/?.lua;" .. package.path
local ledger = require("own-lines-ledger")
local patch = require("own-changes-patch")

-- {{{ local function fail()
local function fail(message)
    io.stderr:write("stage-own-changes: ", message, "\n")
    os.exit(1)
end
-- }}}

-- {{{ local function git()
local function git(top, args, env)
    local argv = { "git", "-C", top }
    for _, a in ipairs(args) do argv[#argv + 1] = a end
    local out, ok, err = patch.run_quiet(argv, env)
    if not ok then fail("git " .. table.concat(args, " ") .. " failed:\n" .. err .. out) end
    return out
end
-- }}}

-- {{{ local function main()
local function main()
    local session_id = os.getenv("CLAUDE_CODE_SESSION_ID")
    if not session_id or session_id == "" then
        fail("CLAUDE_CODE_SESSION_ID is not set; this only works inside a Claude Code session")
    end
    local top = git(DIR, { "rev-parse", "--show-toplevel" }):gsub("%s+$", "")
    -- the branch tip, or git's empty tree when the branch has no commit yet
    local tip_out, has_tip = patch.run_quiet({ "git", "-C", top, "rev-parse", "-q", "--verify", "HEAD^{commit}" })
    local tip = has_tip and tip_out:gsub("%s+$", "")
        or git(top, { "hash-object", "-t", "tree", "/dev/null" }):gsub("%s+$", "")
    local claims = ledger.load(session_id)
    local rels = patch.ledger_files(claims, top)

    local work = ledger.session_dir(session_id)
    os.execute("mkdir -p -m 700 '" .. work:gsub("'", "'\\''") .. "'")
    local index_path = work .. "/preview-index-" .. tostring(os.time()) .. "-" .. tostring(math.random(1e9))
    local env = { GIT_INDEX_FILE = index_path }
    git(top, { "read-tree", tip }, env)
    local result, reason = patch.collect(top, claims, rels, env)
    os.remove(index_path)
    if not result then fail(reason) end

    local sessions_root = os.getenv("CLAUDE_SESSIONS_ROOT") or (os.getenv("HOME") .. "/.claude/projects")
    local carried = {}
    for _, rel in ipairs(result.taken) do carried[#carried + 1] = rel end
    for _, rel in ipairs(result.whole) do carried[#carried + 1] = rel end
    local projects, perr = patch.transcript_projects(top, PROJECT_DIR, carried)
    if not projects then fail(perr) end
    local transcripts, terr = patch.changed_transcripts(top, tip, patch.own_ids(session_id, sessions_root), projects)
    if not transcripts then fail(terr) end
    for _, t in ipairs(transcripts) do result.report[#result.report + 1] = patch.transcript_report_line(t) end

    io.write("stage-own-changes (preview; nothing is staged) in ", top, " for session ", session_id, "\n")
    io.write("commit-own-changes ", top, " -F - would commit:\n")
    if #result.report == 0 then result.report[1] = "  nothing: the ledger's files match the branch tip" end
    io.write(table.concat(result.report, "\n"), "\n")
    if #result.mixed > 0 then
        io.write("and would stop, because this session and someone else changed the same place at ", table.concat(result.mixed, ", "),
            " (commit the rest with --leave-mixed)\n")
    end
end
-- }}}

main()
