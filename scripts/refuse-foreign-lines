#!/usr/bin/env luajit
--
-- refuse-foreign-lines
--
-- A gate in front of every `git commit` Claude Code tries to run. It refuses a
-- plain `git commit` that would record anything, and points at
-- commit-own-changes, which commits exactly this session's own lines on a
-- private staging list.
--
-- The reason it exists: in a repository where several sessions and people work
-- at once, the staging area (.git/index) belongs to the repository, not to
-- whoever is typing, and `git commit` records whatever is in it. The first
-- gate insisted every commit name its paths, which took files whole from disk,
-- other people's lines included. The second checked the staged lines against
-- this session's edit ledger before the commit ran -- and on 2026-09-22 a
-- session whose gate had just found the list clean committed 55 files that
-- another session staged while its command line was still running (issue
-- 032a). A check made before a command runs cannot vouch for a list anyone can
-- write in the meantime. So commits no longer use the shared list at all:
-- commit-own-changes builds each one privately, and this gate turns the plain
-- `git commit` away.
--
-- WHAT IS REFUSED
--
--   any git commit that records something, however it is spelled -- with -a,
--   with paths, --amend, or the plain index -- behind NAME=value, env,
--   command, a full path to git, git's global options (-C "/a path", -c x=y,
--   -P, --git-dir=...), or inside bash -c or eval
--
-- WHAT IS ALLOWED
--
--   commit-own-changes <repo> -F -      the route for every commit
--   git commit --dry-run, git commit -h nothing is recorded
--   anything that is not a commit
--
-- Amending is refused with the rest: commits here are small and the history is
-- append-only, so a correction is a new commit.
--
-- WHAT THIS IS NOT
--
-- Not a security boundary. The session can run git plumbing, or ask for the
-- token. What it buys is that the easy path is the safe one, and that the ways
-- around it are on the record in the transcript.
--
-- The refusal can be lifted one time by creating the permission token below.
--
-- Usage: refuse-foreign-lines [token-path] [scripts-directory]

local TOKEN = arg[1] or "/tmp/claude-allow-foreign-commit"
local DIR = arg[2] or "/home/ritz/programming/ai-stuff/scripts"
local GATE_NAME = "refuse-foreign-lines"

package.path = DIR .. "/libs/?.lua;" .. package.path
local gate = require("hook-gate")
local scan = require("shell-command-scan")

-- {{{ commit option tables
-- Short options whose value is the rest of the cluster or the next word.
local SHORT_WITH_VALUE = { m = true, F = true, C = true, c = true, t = true }
-- Long options whose value may be the next word.
local LONG_WITH_VALUE = {
    ["--message"] = true, ["--file"] = true, ["--reuse-message"] = true,
    ["--reedit-message"] = true, ["--author"] = true, ["--date"] = true,
    ["--template"] = true, ["--fixup"] = true, ["--squash"] = true,
    ["--trailer"] = true, ["--cleanup"] = true, ["--pathspec-from-file"] = true,
}
-- Short letters that change what a commit takes, and the flag each sets.
local SHORT_FLAGS = { a = "all", i = "include", o = "only", h = "help" }
-- Long options that change what a commit takes.
local LONG_FLAGS = {
    ["--all"] = "all", ["--include"] = "include", ["--only"] = "only",
    ["--amend"] = "amend", ["--dry-run"] = "dry_run", ["--help"] = "help",
    ["--pathspec-from-file"] = "pathspec_file",
}
-- }}}

-- {{{ local function read_commit_args()
-- Reads a commit's arguments into { flags = {name = true}, paths = {...} }.
local function read_commit_args(args)
    local flags, paths = {}, {}
    local i = 1
    while args[i] do
        local w = args[i]
        if w == "--" then
            -- everything after -- is a path
            for j = i + 1, #args do paths[#paths + 1] = args[j] end
            break
        elseif w:sub(1, 2) == "--" then
            local name = w:match("^([^=]+)")
            if LONG_FLAGS[name] then flags[LONG_FLAGS[name]] = true end
            -- a long option without =value takes the next word when it needs one
            i = i + ((LONG_WITH_VALUE[name] and not w:find("=", 1, true)) and 2 or 1)
        elseif w:sub(1, 1) == "-" and #w > 1 then
            -- a short cluster: letters until one that takes a value
            local j = 2
            local takes_next = false
            while j <= #w do
                local letter = w:sub(j, j)
                if SHORT_FLAGS[letter] then flags[SHORT_FLAGS[letter]] = true end
                if SHORT_WITH_VALUE[letter] then
                    takes_next = (j == #w)
                    break
                end
                j = j + 1
            end
            i = i + (takes_next and 2 or 1)
        else
            -- a bare word is a pathspec
            paths[#paths + 1] = w
            i = i + 1
        end
    end
    return { flags = flags, paths = paths }
end
-- }}}

-- {{{ local function what_it_would_do()
-- Nil for a commit that records nothing (help, dry run); otherwise a short
-- description of what this spelling of the commit would take.
local function what_it_would_do(commit)
    local parsed = read_commit_args(commit.args)
    local f = parsed.flags
    -- asking for help or a dry run records nothing
    if f.help or f.dry_run then return nil end
    if f.all then return "it uses -a/--all, which takes every tracked file's changes straight from disk -- including lines other sessions or people have not committed yet" end
    if f.include or f.pathspec_file or #parsed.paths > 0 then
        return "it names paths, which makes git take those files whole from disk -- any other session's lines in them come along"
    end
    if f.amend then return "it amends the last commit; commits here are append-only, so a correction is a new commit" end
    return "it records the shared staging area, which any other session can write to between this check and the commit"
end
-- }}}

-- {{{ local function main()
local function main()
    local input, json = gate.read_input(GATE_NAME, DIR)
    local command_text = gate.pending_command(GATE_NAME, input)

    local problem = nil
    for _, command in ipairs(scan.all_commands(command_text)) do
        local invocation = scan.git_invocation(scan.effective_words(command))
        -- only a git commit that records something is this gate's business
        if invocation and invocation.subcommand == "commit" then
            problem = problem or what_it_would_do(invocation)
        end
    end
    if not problem then os.exit(0) end

    gate.refuse_unless_token(json, TOKEN,
        "Plain git commit is not used here: " .. problem .. ". Commit with commit-own-changes <repo> -F - (message on standard input), which builds the commit from this session's own lines on a private staging list and never touches the shared one; run stage-own-changes <repo> first to preview what it would take."
        .. " If the user genuinely wants this git commit as it stands, ask them to type: ! touch " .. TOKEN)
end
-- }}}

main()
