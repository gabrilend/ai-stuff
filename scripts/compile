#!/bin/bash
# scripts/compile
# Compiles the physics simulator project using make
# This script can be run from any directory and will compile the project
# from the correct location. It accepts an optional directory argument.
#
# Usage:
#   ./scripts/compile              # Normal compilation
#   ./scripts/compile --clean      # Clean only (remove binaries)
#   ./scripts/compile --force      # Clean rebuild (clean then compile)
#   ./scripts/compile /custom/dir  # Compile from custom directory
#   ./scripts/compile --force /custom/dir  # Clean rebuild at custom directory

# Hard-coded project directory
DIR="/mnt/mtwo/programming/ai-stuff/games/physics-sim"

# Parse arguments
CLEAN_ONLY=0
FORCE_BUILD=0

for arg in "$@"; do
    case "$arg" in
        --clean)
            CLEAN_ONLY=1
            ;;
        --force)
            FORCE_BUILD=1
            ;;
        *)
            # Assume it's a directory path
            DIR="$arg"
            ;;
    esac
done

# Navigate to project directory
cd "${DIR}" || exit 1

# Clean only if requested
if [ ${CLEAN_ONLY} -eq 1 ]; then
    echo "Cleaning previous build from: ${DIR}"
    make clean
    echo "Clean complete"
    exit 0
fi

# Clean before force build
if [ ${FORCE_BUILD} -eq 1 ]; then
    echo "Cleaning previous build from: ${DIR}"
    make clean
    echo ""
fi

# Compile the project
echo "Compiling physics simulator from: ${DIR}"
make

# Check compilation result
if [ $? -eq 0 ]; then
    echo "Compilation successful"
    exit 0
else
    echo "Compilation failed"
    exit 1
fi
