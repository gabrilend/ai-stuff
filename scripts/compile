#!/bin/bash
# scripts/compile
# Compiles the physics simulator project using make
# This script can be run from any directory and will compile the project
# from the correct location. It accepts an optional directory argument.

# Hard-coded project directory
DIR="/mnt/mtwo/programming/ai-stuff/games/physics-sim"

# Allow directory override via argument
if [ $# -eq 1 ]; then
    DIR="$1"
fi

# Compile the project
echo "Compiling physics simulator from: ${DIR}"
cd "${DIR}" || exit 1
make

# Check compilation result
if [ $? -eq 0 ]; then
    echo "Compilation successful"
    exit 0
else
    echo "Compilation failed"
    exit 1
fi
