#!/bin/bash
# scripts/compile
# Compiles the physics simulator project using make
# This script can be run from any directory and will compile the project
# from the correct location. It accepts an optional directory argument.
#
# Usage:
#   ./scripts/compile              # Compile both game and editor (default)
#   ./scripts/compile --game       # Compile game only
#   ./scripts/compile --editor     # Compile editor only
#   ./scripts/compile --clean      # Clean only (remove binaries)
#   ./scripts/compile --force      # Clean rebuild (clean then compile)
#   ./scripts/compile /custom/dir  # Compile from custom directory
#   ./scripts/compile --force --game /custom/dir  # Clean rebuild game at custom dir

# Hard-coded project directory
DIR="/mnt/mtwo/programming/ai-stuff/games/physics-sim"

# Parse arguments
CLEAN_ONLY=0
FORCE_BUILD=0
BUILD_TARGET="all"  # Default: build both game and editor

for arg in "$@"; do
    case "$arg" in
        --clean)
            CLEAN_ONLY=1
            ;;
        --force)
            FORCE_BUILD=1
            ;;
        --game)
            BUILD_TARGET="game"
            ;;
        --editor)
            BUILD_TARGET="editor"
            ;;
        *)
            # Assume it's a directory path
            DIR="$arg"
            ;;
    esac
done

# Navigate to project directory
cd "${DIR}" || exit 1

# Clean only if requested
if [ ${CLEAN_ONLY} -eq 1 ]; then
    echo "Cleaning previous build from: ${DIR}"
    make clean
    echo "Clean complete"
    exit 0
fi

# Clean before force build
if [ ${FORCE_BUILD} -eq 1 ]; then
    echo "Cleaning previous build from: ${DIR}"
    make clean
    echo ""
fi

# Compile the project
case "${BUILD_TARGET}" in
    game)
        echo "Compiling game from: ${DIR}"
        make game
        ;;
    editor)
        echo "Compiling editor from: ${DIR}"
        make editor
        ;;
    all)
        echo "Compiling game and editor from: ${DIR}"
        make all
        ;;
esac

# Check compilation result
if [ $? -eq 0 ]; then
    echo "Compilation successful"
    exit 0
else
    echo "Compilation failed"
    exit 1
fi
