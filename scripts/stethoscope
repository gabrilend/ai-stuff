#!/usr/bin/env luajit
-- stethoscope
--
-- Lets one Claude Code session ask another one a question, through a mailbox
-- in RAM, without either of them having to be watched by a person.
--
-- How it works, in general terms: every listener has a name and a folder. A
-- question is a file dropped into that folder's inbox; an answer is a file
-- dropped into its replies, under the same id. A listener holds still and
-- checks its inbox twice a second -- like a doctor with a stethoscope, hearing
-- nothing until there is a heartbeat -- and stops the moment a question
-- arrives, so the session that ran it wakes up, reads it, and answers. Any
-- number of listeners can exist at once, each under its own name.
--
-- WHY A LISTENER NEEDS A PERMIT
--
--   Listening costs money. A session that is woken by a question spends a turn
--   on it, and a session that listens by habit spends turns all day. So the
--   listen command refuses to start unless the PERSON has written a permit for
--   that name, by typing `! stethoscope permit NAME` into the listening
--   session themselves. A session must never write a permit on its own. The
--   permit lasts until `stethoscope stop NAME`.
--
--   An ask to a name with no permit is refused rather than queued: a question
--   left in an inbox nobody is allowed to read would wait forever and look
--   like it was sent.
--
-- WHY FILES APPEAR WHOLE
--
--   Every message is written under a temporary name and then renamed into
--   place. A rename is atomic on one filesystem, so a listener checking the
--   folder sees either no message or a complete one, never half of one.
--
-- WHY TIMING OUT IS AN ERROR
--
--   A wait that runs out of patience exits with status 2 and says so. It is
--   never reported as an answer, because "nothing arrived" and "the answer was
--   empty" are different facts.
--
-- Usage:
--   stethoscope [--dir DIR] permit NAME          the person allows NAME to listen
--   stethoscope [--dir DIR] listen NAME [--patience SECONDS]
--   stethoscope [--dir DIR] ask NAME [--patience SECONDS]   < question
--   stethoscope [--dir DIR] send NAME                       < question  (no wait)
--   stethoscope [--dir DIR] await NAME ID [--patience SECONDS]
--   stethoscope [--dir DIR] reply NAME ID                   < answer
--   stethoscope [--dir DIR] stop NAME            withdraw the permit
--   stethoscope [--dir DIR] who                  who may listen, and what waits
--
-- Exit status: 0 done, 1 refused or misused, 2 waited and nothing arrived.

-- The mailbox root. RAM-backed, because these messages are ephemeral and
-- should be gone after a reboot. --dir overrides it.
local DIR = "/dev/shm/claude-stethoscope"

local POLL_SECONDS = 0.5       -- how often a waiting side looks at its folder
local DEFAULT_PATIENCE = 3600  -- seconds a wait lasts before giving up

-- {{{ local function fail()
local function fail(message)
  io.stderr:write("stethoscope: ", message, "\n")
  os.exit(1)
end
-- }}}

-- {{{ local function shell_quote()
local function shell_quote(text)
  return "'" .. tostring(text):gsub("'", "'\\''") .. "'"
end
-- }}}

-- {{{ local function exists()
local function exists(path)
  local handle = io.open(path, "r")
  if handle then handle:close() return true end
  return false
end
-- }}}

-- {{{ local function make_folder()
local function make_folder(path)
  local ok = os.execute("mkdir -p " .. shell_quote(path))
  -- LuaJIT returns 0 on success, Lua 5.2-style runtimes return true.
  if ok ~= 0 and ok ~= true then fail("could not create " .. path) end
end
-- }}}

-- {{{ local function list_folder()
-- Names in a folder, sorted, skipping the temporary names writes use.
local function list_folder(path)
  local names = {}
  if not exists(path) then return names end
  local pipe = io.popen("ls -1 " .. shell_quote(path))
  for name in pipe:lines() do
    if not name:match("^%.") then names[#names + 1] = name end
  end
  pipe:close()
  table.sort(names)
  return names
end
-- }}}

-- {{{ local function write_whole()
-- Written under a hidden temporary name, then renamed into place, so a reader
-- never sees a partial file.
local function write_whole(folder, name, text)
  make_folder(folder)
  local temporary = folder .. "/." .. name .. ".writing"
  local handle = io.open(temporary, "w")
  if not handle then fail("could not write " .. temporary) end
  handle:write(text)
  handle:close()
  local ok, problem = os.rename(temporary, folder .. "/" .. name)
  if not ok then fail("could not place " .. name .. ": " .. tostring(problem)) end
end
-- }}}

-- {{{ local function read_whole()
local function read_whole(path)
  local handle = io.open(path, "r")
  if not handle then fail("could not read " .. path) end
  local text = handle:read("*a")
  handle:close()
  return text
end
-- }}}

-- {{{ local function nap()
local function nap()
  os.execute("sleep " .. POLL_SECONDS)
end
-- }}}

-- {{{ local function check_name()
-- A name becomes a folder, so it may not climb out of the mailbox.
local function check_name(name)
  if not name or not name:match("^[%w][%w%-_]*$") then
    fail("a listener's name is letters, digits, dashes and underscores; got '" ..
         tostring(name) .. "'")
  end
  return name
end
-- }}}

-- {{{ local function fresh_id()
-- Sorts by arrival: seconds since the epoch, then this process's id so two
-- asks in the same second do not collide.
local function fresh_id()
  local pipe = io.popen("echo $PPID")
  local pid = pipe:read("*l") or "0"
  pipe:close()
  return string.format("%d-%s-%04d", os.time(), pid, math.random(0, 9999))
end
-- }}}

-- {{{ local function wait_for()
-- Calls `look` until it returns something or patience runs out.
local function wait_for(look, patience, what)
  local waited = 0
  while true do
    local found = look()
    if found then return found end
    if waited >= patience then
      io.stderr:write("stethoscope: waited ", patience, " seconds for ", what,
                      " and nothing arrived\n")
      os.exit(2)
    end
    nap()
    waited = waited + POLL_SECONDS
  end
end
-- }}}

-- {{{ local function read_stdin()
local function read_stdin(what)
  local text = io.read("*a")
  if not text or text:match("^%s*$") then fail(what .. " was empty; nothing sent") end
  return text
end
-- }}}

-- {{{ local function patience_from()
local function patience_from(args, start)
  for index = start, #args do
    if args[index] == "--patience" then
      local seconds = tonumber(args[index + 1])
      if not seconds or seconds <= 0 then fail("--patience takes a number of seconds") end
      return seconds
    end
  end
  return DEFAULT_PATIENCE
end
-- }}}

-- Each command, by name. A table rather than a chain of comparisons, so adding
-- a command is adding a row.
local COMMANDS = {}

-- {{{ COMMANDS.permit()
-- Run by the person, never by a session on its own initiative.
function COMMANDS.permit(args)
  local name = check_name(args[1])
  write_whole(DIR .. "/" .. name, "permit",
              "permitted " .. os.date("%Y-%m-%d %H:%M:%S") .. "\n")
  print("'" .. name .. "' may listen until `stethoscope stop " .. name .. "`")
end
-- }}}

-- {{{ COMMANDS.stop()
function COMMANDS.stop(args)
  local name = check_name(args[1])
  local permit = DIR .. "/" .. name .. "/permit"
  if not exists(permit) then fail("'" .. name .. "' had no permit") end
  os.remove(permit)
  print("'" .. name .. "' may no longer listen")
end
-- }}}

-- {{{ COMMANDS.listen()
-- Waits for the oldest unheard question, prints it, files it as heard, exits.
-- One question per run, so the session wakes once per question and decides
-- for itself whether to listen again.
function COMMANDS.listen(args)
  local name = check_name(args[1])
  local home = DIR .. "/" .. name
  if not exists(home .. "/permit") then
    fail("'" .. name .. "' has no permit to listen. Only the person can give one, " ..
         "by typing:  ! stethoscope permit " .. name)
  end
  local patience = patience_from(args, 2)
  local id = wait_for(function()
    -- The permit is checked on every look, so `stop` ends a listen in progress.
    if not exists(home .. "/permit") then
      fail("the permit for '" .. name .. "' was withdrawn while listening")
    end
    return list_folder(home .. "/inbox")[1]
  end, patience, "a question for '" .. name .. "'")
  local text = read_whole(home .. "/inbox/" .. id)
  make_folder(home .. "/heard")
  os.rename(home .. "/inbox/" .. id, home .. "/heard/" .. id)
  io.write("question ", id, " for ", name, ":\n", text)
  if not text:match("\n$") then io.write("\n") end
  io.write("\nanswer it with:  stethoscope reply ", name, " ", id, "  < answer\n")
end
-- }}}

-- {{{ COMMANDS.send()
-- Drops a question in and prints its id without waiting.
function COMMANDS.send(args)
  local name = check_name(args[1])
  local home = DIR .. "/" .. name
  if not exists(home .. "/permit") then
    fail("nobody is permitted to listen as '" .. name .. "', so the question was " ..
         "not sent. Ask the person to start a listener there first.")
  end
  local text = read_stdin("the question")
  local id = fresh_id()
  write_whole(home .. "/inbox", id, text)
  print(id)
  return id
end
-- }}}

-- {{{ COMMANDS.await()
function COMMANDS.await(args)
  local name = check_name(args[1])
  local id = args[2]
  if not id or not id:match("^[%w%-]+$") then fail("await needs the question's id") end
  local reply = DIR .. "/" .. name .. "/replies/" .. id
  wait_for(function() return exists(reply) and reply end,
           patience_from(args, 3), "an answer to " .. id)
  io.write(read_whole(reply))
end
-- }}}

-- {{{ COMMANDS.ask()
-- send, then await.
function COMMANDS.ask(args)
  local id = COMMANDS.send({ args[1] })
  io.stdout:flush()
  -- await reads its patience from the third argument on, so the name and id
  -- go first and whatever followed the name (--patience N) follows them.
  local passed = { args[1], id }
  for index = 2, #args do passed[#passed + 1] = args[index] end
  COMMANDS.await(passed)
end
-- }}}

-- {{{ COMMANDS.reply()
function COMMANDS.reply(args)
  local name = check_name(args[1])
  local id = args[2]
  local heard = DIR .. "/" .. name .. "/heard/" .. tostring(id)
  if not id or not exists(heard) then
    fail("no question " .. tostring(id) .. " has been heard by '" .. name .. "'")
  end
  write_whole(DIR .. "/" .. name .. "/replies", id, read_stdin("the answer"))
  print("answered " .. id)
end
-- }}}

-- {{{ COMMANDS.who()
function COMMANDS.who()
  local any = false
  for _, name in ipairs(list_folder(DIR)) do
    local home = DIR .. "/" .. name
    local permitted = exists(home .. "/permit")
    local waiting = #list_folder(home .. "/inbox")
    print(string.format("%-24s %-14s %d waiting", name,
                        permitted and "permitted" or "de-permitted", waiting))
    any = true
  end
  if not any then print("no listeners have ever been permitted under " .. DIR) end
end
-- }}}

-- {{{ local function main()
local function main(argv)
  local args = {}
  local index = 1
  while index <= #argv do
    if argv[index] == "--dir" then
      DIR = argv[index + 1] or fail("--dir takes a folder")
      index = index + 2
    else
      args[#args + 1] = argv[index]
      index = index + 1
    end
  end
  math.randomseed(os.time())
  local command = table.remove(args, 1)
  local run = COMMANDS[command or ""]
  if not run then
    fail("commands: permit, listen, ask, send, await, reply, stop, who")
  end
  make_folder(DIR)
  run(args)
end
-- }}}

main(arg)
