#!/usr/bin/env bash
# repair-transcript-timezone - Put the existing archive of conversation
# transcripts back onto the calendar days the conversations actually happened
# on.
#
# In plain terms: every conversation Claude holds is saved as a markdown file
# named after the date it took place, and those names were being computed in
# the wrong timezone. Anything held after about five in the evening was filed
# under the following day, and every file's "last modified" stamp was off by
# the same several hours. The exporter that writes new transcripts has been
# corrected; this tool goes back and corrects the ones already written.
#
# Most of the original session logs have been deleted, so it cannot simply
# recompute them. It works instead from whatever evidence each transcript
# still has, strongest first, and where every witness fails it says so rather
# than inventing a date:
#
#   rebuild      the session log survives. Left alone here entirely - the
#                exporter rebuilds these from source, which is better than
#                patching them. Run `rederive-transcripts --write` AFTER this.
#   history      the log is gone, but the session is in the prompt history,
#                which timestamps each prompt as a Unix epoch in milliseconds
#                - an absolute instant, carrying no timezone and so immune to
#                the fault being repaired. BOTH ends come from it, and the
#                file's own stamp is ignored, which makes these files safe to
#                reconsider any number of times. The end is the last prompt
#                rather than the assistant's closing reply; measured over the
#                archive that moves the day for one file in sixty-eight.
#   stamp        no history, but a sound stamp. The fault is inverted back out
#                of it, which is exact - but cannot be done twice, and this is
#                the group the repair note exists for.
#   no-evidence  the stamp was disproved and there is no history. Reported and
#                left untouched.
#
# On disproving a stamp: a bulk copy or a restore rewrites every file's
# modification time to the moment of that operation, and this archive contains
# folders where hundreds of files share one identical second. Such a stamp
# says nothing about the conversation inside the file. It is caught by
# comparing it against the prompt history of the files that share it - a stamp
# sitting a day or more past a session's last prompt is recording something
# that happened TO the file, not IN it.
#
# The planning is done by libs/transcript-repair-plan.lua and this script
# carries the plan out; working out the answer and acting on it are kept apart
# so a wrong answer can be read before it becomes a wrong rename. Nothing is
# changed unless asked. See issues/018-date-range-transcript-naming.md.
#
# Usage:
#   repair-transcript-timezone                 report what would change
#   repair-transcript-timezone --write         perform the renames and stamps
#   repair-transcript-timezone --recover       undo an interrupted run
#   repair-transcript-timezone --commit        ...and commit, one per repo
#   repair-transcript-timezone --only <path>   restrict to one subtree
#   repair-transcript-timezone --dir <path>    where the scripts live
#   repair-transcript-timezone --verbose       list every rename

set -euo pipefail

# -- {{{ Paths and settings
# Hard-coded default root, overridable by environment or --dir, so the script
# runs from any directory (house convention). Everything else derives from it.
DIR="${DIR:-/home/ritz/programming/ai-stuff/scripts}"

CLAUDE_SESSIONS_ROOT="${CLAUDE_SESSIONS_ROOT:-$HOME/.claude/projects}"
PROMPT_HISTORY="${PROMPT_HISTORY:-$HOME/.claude/history.jsonl}"

# Where projects live. A project is anything holding an llm-transcripts folder.
#
# Worktrees are skipped. They are second views of a repository whose real copy
# is already in this list, so repairing both would stage the same rename twice.
# Measured rather than assumed: of the 442 conversations held inside worktree
# transcript folders, all 442 also exist outside one. Nothing is only there.
# Overridable as a space-separated list so the tests can point the whole tool
# at a fixture tree instead of the real archive. Without that the renaming
# half could only ever be exercised against live data, which is why it went
# untested and why a fault in it reached a real run.
read -ra SEARCH_ROOTS <<< "${TRANSCRIPT_SEARCH_ROOTS:-/mnt/mtwo /mnt/cmdo /mnt/kaun}"
SEARCH_DEPTH=8

# Projects left exactly as they are, examined by nothing below.
#
# world-edit-to-execute holds the output of an older exporter that was run
# by hand every so often, and its session logs are long gone, so nothing can
# regenerate it. Its dates are not merely wrong, they are absent: all 297 of
# its transcripts were written in one batch on the evening of 2025-12-30 (the
# "Generated on" line says so, identically, in every one of them) and then
# copied on 2026-01-07, which is the second every file's modification time
# now carries. Neither figure has anything to do with when the conversations
# happened.
#
# The prompt history could date 26 of them. That is not a good enough reason
# to disturb the set: renaming a quarter of a folder to real dates while the
# rest keep a copy's date would leave a listing that looks sorted and is not,
# which is worse than one that is plainly undated. Preserved whole instead.
PRESERVE_PATHS=(
   /mnt/mtwo/programming/ai-stuff/world-edit-to-execute
)

# Dropped into a folder once its transcripts have been repaired, and checked
# for before repairing one.
#
# This is not tidiness, it is correctness. Undoing the fault means converting
# a timestamp twice, and that operation has no idea whether it has been done
# before: applied to an already-corrected time it simply subtracts the offset
# again. Run three times, an evening conversation walks from 19:49 back to
# 12:49 to 05:49 and eventually across midnight into the wrong day, renaming
# itself as it goes. Nothing in the file distinguishes a corrected timestamp
# from an uncorrected one, so the fact has to be written down.
#
# The marker lives beside the transcripts rather than in one central ledger
# on purpose: restoring a folder from a snapshot taken before the repair also
# removes its marker, which is exactly right, because that folder does need
# repairing again.
REPAIR_MARKER=".timezone-repaired"

# The pathspec every commit is limited to. Several of these repositories have
# unrelated work sitting in them, so the commit names what it is taking.
TRANSCRIPT_PATHSPEC='*llm-transcripts/*'

# The tooling that performs the repair, named relative to DIR. It rides along
# in whichever repository holds it, so the change and its consequences land in
# one commit: the renames are a line or two each, and reading them beside the
# code that produced them is the whole point of keeping them together.
TOOLING_PATHS=(
   "repair-transcript-timezone"
   "backup-transcript-corpus"
   "rederive-transcripts"
   "backup-transcript-corpus.info.md"
   "repair-transcript-timezone.info.md"
   "libs/transcript-repair-plan.lua"
   "libs/transcript-repair-plan.info.md"
   "libs/conversation-parser.lua"
   "tests/test_conversation-parser-timezone.lua"
   "tests/test-transcript-repair-plan.sh"
   "issues/018-date-range-transcript-naming.md"
   "README-backup-conversations.md"
)

# RAM-backed scratch, per house convention: ephemeral artifacts never touch a
# spinning disk, and the directory is ensured before anything writes to it.
WORK="${WORK:-/dev/shm/transcript-timezone-repair}"

WRITE=false
RECOVER=false
COMMIT=false
VERBOSE=false
ONLY=""
# }}}

# -- {{{ parse_arguments()
parse_arguments() {
   while [ $# -gt 0 ]; do
      case "$1" in
         --write)   WRITE=true ;;
         --recover) RECOVER=true ;;
         --commit)  COMMIT=true ; WRITE=true ;;
         --verbose) VERBOSE=true ;;
         --only)    shift ; ONLY="${1:-}" ;;
         --dir)     shift ; DIR="${1:-$DIR}" ;;
         --help|-h) sed -n '2,51p' "$0" ; exit 0 ;;
         *) echo "unknown argument: $1" >&2 ; exit 1 ;;
      esac
      shift
   done
}
# }}}

# -- {{{ ensure_work_area()
# The scratch directory is created before use rather than assumed, because a
# reboot empties /dev/shm and the first run after one would otherwise fail on
# its very first redirect.
ensure_work_area() {
   mkdir -p "$WORK"
   : > "$WORK/plan.tsv"
}
# }}}

# -- {{{ load_surviving_logs()
# One line per conversation id whose session log is still on disk. These are
# the transcripts the planner will hand back to the exporter untouched.
load_surviving_logs() {
   { find "$CLAUDE_SESSIONS_ROOT" -name '*.jsonl' -type f -printf '%f\n' || true; } \
      | sed 's/\.jsonl$//' \
      | sort -u > "$WORK/surviving-logs.txt"
}
# }}}

# -- {{{ load_prompt_history()
# Reduce the prompt-history file to one line per session: the session id, its
# earliest prompt and its latest, both as Unix epoch SECONDS.
#
# The timestamps there are epoch milliseconds. An epoch count names an instant
# outright rather than describing a clock reading, so no timezone was ever
# applied to it and none can have been applied wrongly - which is the whole
# reason this file can be trusted to correct the others. The two fields wanted
# are read by pattern rather than by decoding the JSON, because that is all
# this shape of line needs and it keeps the dependency list at zero.
load_prompt_history() {
   if [ ! -f "$PROMPT_HISTORY" ]; then
      echo "note: no prompt history at $PROMPT_HISTORY; that tier will be empty" >&2
      : > "$WORK/prompt-history.tsv"
      return 0
   fi
   lua - "$PROMPT_HISTORY" "$WORK/prompt-history.tsv" <<'LUA'
local source_path, destination_path = arg[1], arg[2]
local first_prompt, last_prompt, order = {}, {}, {}
for line in io.lines(source_path) do
    local session = line:match('"sessionId"%s*:%s*"([^"]+)"')
    local stamp = tonumber(line:match('"timestamp"%s*:%s*(%d+)'))
    if session and stamp then
        local seconds = math.floor(stamp / 1000)
        if not first_prompt[session] then
            first_prompt[session] = seconds
            last_prompt[session] = seconds
            order[#order + 1] = session
        else
            if seconds < first_prompt[session] then first_prompt[session] = seconds end
            if seconds > last_prompt[session] then last_prompt[session] = seconds end
        end
    end
end
local out = assert(io.open(destination_path, "w"))
for _, session in ipairs(order) do
    out:write(string.format("%s\t%d\t%d\n",
        session, first_prompt[session], last_prompt[session]))
end
out:close()
LUA
}
# }}}

# -- {{{ find_transcript_dirs()
find_all_transcript_dirs() {
   local root
   for root in "${SEARCH_ROOTS[@]}"; do
      [ -d "$root" ] || continue
      # Unreadable directories are pruned rather than walked into.
      #
      # A search this wide crosses other people's property - database
      # directories, lost+found - and used to announce every one of them.
      # Those complaints were noise of the least useful kind: a directory
      # that cannot be opened cannot be searched either way, so refusing to
      # descend loses nothing that was ever available and removes twenty
      # lines of alarm from a run where nothing is wrong. Checked against
      # the unpruned search: the same folders are found, exactly.
      #
      # What it does NOT do is hide a genuine problem. Anything find still
      # has to say now is something new, and is left on stderr to be read.
      find "$root" -maxdepth "$SEARCH_DEPTH" \
         \( -type d ! -readable -prune \) -o \
         \( -type d -name llm-transcripts \
            -not -path '*/ai-worktrees/*' -not -path '*backup*' -print \) || true
   done | sort -u
}
# }}}

# -- {{{ find_transcript_dirs()
# The folders this run is actually to consider: everything found, less those
# preserved by request, less those already repaired, less anything outside a
# --only restriction.
find_transcript_dirs() {
   local d
   while read -r d; do
      is_preserved "$d" && continue
      [ -e "$d/$REPAIR_MARKER" ] && continue
      if [ -n "$ONLY" ]; then
         case "$d" in "$ONLY"*) printf '%s\n' "$d" ;; esac
      else
         printf '%s\n' "$d"
      fi
   done < <(find_all_transcript_dirs)
}
# }}}

# -- {{{ is_preserved()
# True when a folder belongs to a project that is to be left alone entirely -
# not renamed, not restamped, not even read.
is_preserved() {
   local dir="$1" kept
   for kept in ${PRESERVE_PATHS[@]+"${PRESERVE_PATHS[@]}"}; do
      case "$dir" in "$kept"/*|"$kept") return 0 ;; esac
   done
   return 1
}
# }}}

# -- {{{ count_preserved_files()
# How many transcripts the preserve list is holding back, so the report can
# account for them rather than have them silently missing from the totals.
count_preserved_files() {
   local kept folder total=0
   for kept in ${PRESERVE_PATHS[@]+"${PRESERVE_PATHS[@]}"}; do
      [ -d "$kept" ] || continue
      while read -r folder; do
         total=$((total + $(find "$folder" -maxdepth 1 -name '*.md' -type f | wc -l)))
      done < <(find "$kept" -type d -name llm-transcripts || true)
   done
   printf '%s\n' "$total"
}
# }}}

# -- {{{ build_plan()
# Hand the planner every candidate file with its stored stamp, and keep what
# it decides. The stamp is read here rather than there because Lua has no way
# to ask the filesystem for one.
build_plan() {
   find_transcript_dirs \
      | while read -r d; do
           find "$d" -maxdepth 1 -name '*.md' -type f -printf '%T@\t%p\n' || true
        done \
      | sed 's/\.[0-9]*\t/\t/' \
      | REPAIR_DIR="$DIR" lua "${DIR}/libs/transcript-repair-plan.lua" \
           --logs "$WORK/surviving-logs.txt" \
           --history "$WORK/prompt-history.tsv" \
      > "$WORK/plan.tsv"
}
# }}}

# -- {{{ move_into_place()
# Move a parked file to the name it should have.
#
# A plain move, not "git mv", and the reason is worth writing down because
# the first version of this tried to be clever and silently was not. By the
# time this runs the file is sitting under a temporary name that git has
# never heard of, so asking git to move it fails the is-this-tracked test and
# falls through to a plain move regardless - the cleverness was dead code.
#
# Nothing is lost by dropping it. Git does not record renames at all; it
# stores contents and works out renames when reading a diff. Since a rename
# here leaves the bytes untouched, the pairing is exact, and staging the
# whole folder at commit time presents the same rename either way.
move_into_place() {
   local dir="$1" from="$2" to="$3"
   mv -f "$dir/$from" "$dir/$to"
}
# }}}

# -- {{{ apply_directory()
# Carry out one folder's share of the plan.
#
# Renames happen in two passes through a temporary name. A bulk rename can
# form a cycle - one file wanting the name another currently holds - and a
# single pass would either refuse or clobber. Parking everything that moves
# under a temporary name first breaks every cycle by construction.
apply_directory() {
   local dir="$1"
   local plan="$2"

   local d file tier dest true_epoch action i
   local -a moved_from=() moved_to=()

   while IFS=$'\t' read -r d file tier dest true_epoch action; do
      [ "$action" = rename ] || continue
      mv -f "$dir/$file" "$dir/.repair-tmp-$file"
      moved_from+=(".repair-tmp-$file")
      moved_to+=("$dest")
   done < "$plan"

   # Counted rather than iterated over the array's indices. The guarded form
   # ${!array[@]+...} that protects an empty array elsewhere does NOT work
   # here: a "!" immediately after the brace means indirect expansion - look
   # up the variable NAMED by this value - so bash read the whole list of
   # filenames as one variable name and refused it. That aborted the run
   # after the files had been parked under temporary names and before they
   # were moved to their real ones. An arithmetic loop asks for a count,
   # which an empty array answers with zero, and never names anything.
   local moved_count="${#moved_from[@]}"
   for (( i = 0; i < moved_count; i++ )); do
      move_into_place "$dir" "${moved_from[$i]}" "${moved_to[$i]}"
   done

   # Every transcript the planner dated gets its stamp corrected, renamed or
   # not - the stamp was wrong on all of them, git does not record it, so this
   # costs nothing in the history and repairs what a listing shows. Files the
   # planner declined to date are skipped here too, stamp included.
   while IFS=$'\t' read -r d file tier dest true_epoch action; do
      [ "$action" = skip ] && continue
      touch -d "@${true_epoch}" "$dir/$dest"
   done < "$plan"
}
# }}}

# -- {{{ refuse_if_parked()
# Stop before planning anything if a previous run was interrupted between
# parking a folder's files and moving them into place. Planning on top of
# that state would read half a folder and quietly decide the other half had
# never existed.
refuse_if_parked() {
   local parked
   parked=$(while read -r d; do
      find "$d" -maxdepth 1 -name '.repair-tmp-*' -type f || true
   done < <(find_all_transcript_dirs) | wc -l)

   [ "$parked" -eq 0 ] && return 0

   echo "Refusing to run: $parked file(s) are parked under temporary names" >&2
   echo "from a previous run that did not finish. Nothing is lost - their" >&2
   echo "contents and timestamps are intact - but they must be put back" >&2
   echo "before anything can be planned on top of them:" >&2
   echo "" >&2
   echo "    $0 --recover" >&2
   exit 1
}
# }}}

# -- {{{ mark_repaired()
# Record that a folder has been through the repair, so a second run leaves it
# alone. Written only after its files are all in place.
mark_repaired() {
   local dir="$1"
   cat > "$dir/$REPAIR_MARKER" <<MARKER
Repaired $(date '+%Y-%m-%d %H:%M:%S %Z') by repair-transcript-timezone.

The transcripts here were named and stamped from a UTC clock reading treated
as local time, which filed every evening conversation a day late and left
every timestamp one offset ahead of itself. Both have been corrected.

This file stops the repair running twice. Correcting the fault means
converting a timestamp twice over, and that cannot tell whether it has
already been done - applied again it would subtract the offset a second
time and eventually walk a conversation into the wrong day.

Delete this only if these transcripts have been restored from a snapshot
taken before the repair.
MARKER
}
# }}}

# -- {{{ recover_parked_files()
# Undo a run that stopped between parking a folder's files under temporary
# names and moving them to their real ones.
#
# The two-pass rename is what makes a cycle of files swapping names safe, but
# it means an interruption leaves the archive mid-step: the contents are all
# present and unharmed, and the names are all wrong. Reversing it is exact,
# because the temporary name carries the original inside it and the move
# preserved every modification time.
recover_parked_files() {
   local folder parked original recovered=0
   while read -r folder; do
      while read -r parked; do
         original="$folder/$(basename "$parked" | sed 's/^\.repair-tmp-//')"
         if [ -e "$original" ]; then
            echo "  refusing: $original already exists, leaving $(basename "$parked")" >&2
            continue
         fi
         mv -f "$parked" "$original"
         recovered=$((recovered + 1))
      done < <(find "$folder" -maxdepth 1 -name '.repair-tmp-*' -type f || true)
   done < <(find_all_transcript_dirs)
   echo "Recovered $recovered parked file(s) to their original names."
}
# }}}

# -- {{{ apply_plan()
apply_plan() {
   local dir
   while read -r dir; do
      awk -F'\t' -v d="$dir" '$1==d' "$WORK/plan.tsv" > "$WORK/dir-plan.tsv"
      [ -s "$WORK/dir-plan.tsv" ] || continue
      apply_directory "$dir" "$WORK/dir-plan.tsv"
      mark_repaired "$dir"
   done < <(cut -f1 "$WORK/plan.tsv" | sort -u)
}
# }}}

# -- {{{ write_commit_message()
# Written out once rather than inlined, so every repository gets identical
# wording and whoever finds one of these commits in an unfamiliar project
# still learns what happened to it.
write_commit_message() {
   cat > "$WORK/commit-message.txt" <<'MSG'
Put the conversation archive back on the days it happened

The transcripts were named and stamped from a clock reading taken in
the wrong zone. The log records each message in UTC, and both the name
and the modification time copied those figures across as though they
were local, so every conversation held after the early evening was
filed under the following morning and every file sat several hours
ahead of itself. The two agreed with each other, which is why nothing
downstream ever contradicted them. The names now follow the local
calendar.

Each file was dated from the strongest evidence still standing for it.
Where the session log survived it was left for the exporter, which
rebuilds from source. Where the log was gone the start came from the
record of prompts sent, which counts from an absolute instant and so
was never affected by any of this. Where neither survived, the fault
was inverted back out of the file's own timestamp, which is exact
because the same offset had been applied going in.

Some timestamps could not be believed. A bulk copy rewrites every
file's modification time to the moment of the copy, and one folder
here holds hundreds sharing a single second. Counting files per
timestamp does not reveal this, because a conversation and the agents
it spawned honestly do share a last message; what reveals it is a
second witness disagreeing by more than a day. Those files were dated
from the record of prompts where it reached them, and otherwise left
alone. An archive with acknowledged gaps is worth more than one that
quietly invents dates.

One project is preserved untouched. Its transcripts came from an
earlier exporter, run by hand and now unregenerable, and their dates
are not wrong so much as absent: written in one batch one evening and
copied weeks later, with neither figure describing the conversations
inside them.

Carried alongside, where this repository holds them: the correction
itself, the planner that decides what each file deserves, the tool
that carries those decisions out, and tests for both. The planner
changes nothing, so a wrong judgement can be read in a report before
it becomes a wrong rename.
MSG
}
# }}}

# -- {{{ stage_tooling()
# Stage the repair tooling in the repository that holds it, as paths relative
# to that repository's root. Returns 1 when the scripts are not in a
# repository at all, so the caller can carry on without them.
stage_tooling() {
   local repo="$1"
   local tooling_repo prefix path
   tooling_repo=$(git -C "$DIR" rev-parse --show-toplevel 2>/dev/null) || return 1
   [ "$tooling_repo" = "$repo" ] || return 1

   prefix="${DIR#"$tooling_repo"/}"
   for path in "${TOOLING_PATHS[@]}"; do
      git -C "$repo" add -A -- "${prefix}/${path}" || true
   done
   return 0
}
# }}}

# -- {{{ commit_repositories()
# One commit per repository, naming the paths it takes.
#
# Several of these repositories have unrelated work sitting in them. Both the
# staging and the commit are limited to the transcript pathspec, so that work
# is neither committed nor otherwise disturbed - it stays exactly as modified
# as it was.
commit_repositories() {
   local repos repo
   repos=$(cut -f1 "$WORK/plan.tsv" | sort -u | while read -r d; do
      git -C "$d" rev-parse --show-toplevel 2>/dev/null || true
   done | sort -u)

   # The repository holding the tooling may have no transcripts of its own,
   # so it is added to the list rather than waited for.
   local tooling_repo
   tooling_repo=$(git -C "$DIR" rev-parse --show-toplevel 2>/dev/null || true)
   if [ -n "$tooling_repo" ]; then
      repos=$(printf '%s\n%s\n' "$repos" "$tooling_repo" | sort -u)
   fi

   local -a pathspec
   for repo in $repos; do
      [ -n "$repo" ] || continue

      pathspec=("$TRANSCRIPT_PATHSPEC")
      # -A so that the vanished names are staged as deletions alongside the
      # new ones. Without it the commit would carry the arrivals and not the
      # departures, and every renamed transcript would appear twice.
      git -C "$repo" add -A -- "$TRANSCRIPT_PATHSPEC" || true
      if stage_tooling "$repo"; then
         pathspec+=("${TOOLING_PATHS[@]/#/${DIR#"$repo"/}/}")
      fi

      if git -C "$repo" diff --cached --quiet -- "${pathspec[@]}"; then
         echo "  nothing to commit in $repo"
         continue
      fi
      git -C "$repo" commit -q -F "$WORK/commit-message.txt" -- "${pathspec[@]}"
      echo "  committed $repo"
   done
}
# }}}

# -- {{{ count_tier()
count_tier() {
   awk -F'\t' -v tier="$1" '$3==tier' "$WORK/plan.tsv" | wc -l
}
# }}}

# -- {{{ report()
report() {
   local total renames stamps adopted
   total=$(wc -l < "$WORK/plan.tsv")
   renames=$(awk -F'\t' '$6=="rename"' "$WORK/plan.tsv" | wc -l)
   stamps=$(awk -F'\t' '$6=="stamp-only"' "$WORK/plan.tsv" | wc -l)
   adopted=$(awk -F'\t' '$6=="rename"' "$WORK/plan.tsv" | grep -c '_summary\.md' || true)

   echo ""
   echo "Transcripts examined:                            $total"
   echo "  left to the exporter, session log survives:    $(count_tier rebuild)"
   echo "  dated from prompt history, repeatable:         $(count_tier history)"
   echo "  dated by inverting the stamp, one-way:         $(count_tier stamp)"
   echo "  no surviving evidence, left untouched:         $(count_tier no-evidence)"
   echo ""
   echo "Files to rename:                                 $renames"
   echo "  of those, still uuid-named from before:        $adopted"
   echo "Files needing only a corrected stamp:            $stamps"
   echo ""
   local preserved already
   preserved=$(count_preserved_files)
   # An "if" rather than a "&&": under pipefail the loop hands its pipeline
   # the status of the last thing its body ran, and a bare test that comes
   # out false would make counting zero repaired folders look like a failed
   # command and abort the report.
   already=$(while read -r d; do
      if [ -e "$d/$REPAIR_MARKER" ]; then printf 'x\n'; fi
   done < <(find_all_transcript_dirs) | wc -l)
   echo "Transcripts preserved untouched by request:      $preserved"
   echo "Folders already repaired, skipped:               $already"
   echo ""
   echo "Repositories touched:"
   cut -f1 "$WORK/plan.tsv" | sort -u | while read -r d; do
      git -C "$d" rev-parse --show-toplevel 2>/dev/null || echo "(not a repository) $d"
   done | sort | uniq -c | sort -rn

   if [ "$VERBOSE" = true ]; then
      echo ""
      echo "Every rename:"
      awk -F'\t' '$6=="rename" {printf "  %s\n    %s -> %s   [%s]\n", $1, $2, $4, $3}' \
         "$WORK/plan.tsv"
      echo ""
      echo "Left untouched for want of evidence:"
      awk -F'\t' '$3=="no-evidence" {printf "  %s/%s\n", $1, $2}' "$WORK/plan.tsv" | head -40
   fi

   if [ "$WRITE" = false ]; then
      echo ""
      echo "Nothing written. Re-run with --write to apply."
      echo "Afterwards run: rederive-transcripts --write   (rebuilds the first group)"
   fi
}
# }}}

# -- {{{ main()
main() {
   parse_arguments "$@"

   if [ "$RECOVER" = true ]; then
      echo "Undoing any interrupted run:"
      recover_parked_files
      exit 0
   fi

   # Resolve the scripts directory to where it physically lives before
   # anything compares it against a path. /home/ritz/programming is a symlink
   # onto /mnt/mtwo/programming, git reports the physical path, and a
   # comparison between the two spellings quietly fails to match - which
   # would leave every tooling pathspec pointing outside its own repository.
   # Issue 024 records the same symlink counting this corpus twice.
   DIR=$(realpath "$DIR")

   refuse_if_parked
   ensure_work_area
   load_surviving_logs
   load_prompt_history
   build_plan

   if [ "$WRITE" = true ]; then
      apply_plan
   fi

   report

   if [ "$COMMIT" = true ]; then
      write_commit_message
      echo ""
      echo "Committing, transcripts only:"
      commit_repositories
   fi
}
# }}}

main "$@"
