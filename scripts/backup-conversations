#!/bin/bash
set -euo pipefail

function start-claude(){
   claude
}

# see issues in the project directory (scripts) too

function write-transcripts-to-project-directory(){ # {{{
   DIR="${1:-$(pwd)}"
   
   # Resolve to absolute path
   DIR=$(realpath "$DIR")
   
   if [ ! -d "$DIR" ]; then
      echo "Error: '$DIR' is not a directory"
      echo ""
      echo "Usage: write-transcripts-to-project-directory [project-directory]"
      echo ""
      echo "Extracts Claude conversation transcripts and writes summaries to the specified"
      echo "project directory. If no directory is provided, uses current directory."
      echo "Output files are placed in '<project-directory>/llm-transcripts/'"
      echo "and contain every user prompt plus every block of assistant prose between"
      echo "user turns. Tool calls and tool results are dropped, but in-progress"
      echo "narration the model wrote for the user to read is preserved."
      return 1
   fi
   
   # Create output directory - special handling for /home/ritz/ and llm-transcripts
   if [ "$DIR" = "/home/ritz" ] || [ "$DIR" = "/mnt/mtwo" ]; then
      TRANSCRIPT_DIR="/home/ritz/ai/llm-transcripts"
   elif [ "$DIR" = "/mnt/mtwo/scripts/llm-transcripts" ]; then
      TRANSCRIPT_DIR="/mnt/mtwo/scripts/llm-transcripts/transcripts"
   else
      TRANSCRIPT_DIR="${DIR}/llm-transcripts"
   fi
   mkdir -p "$TRANSCRIPT_DIR"
   
   # Find the corresponding Claude project directory
   PROJECT_NAME=$(basename "$DIR")
   CLAUDE_PROJECT_DIR="$HOME/.claude/projects/-$(echo "$DIR" | sed 's|^/||' | tr '/' '-')"
   
   if [ ! -d "$CLAUDE_PROJECT_DIR" ]; then
      echo "Could not find Claude project directory: $CLAUDE_PROJECT_DIR"
      return 1
   fi
   
   echo "Extracting transcripts from $CLAUDE_PROJECT_DIR to $TRANSCRIPT_DIR"
   
   # Naming, identity, and collision rules all live in one shared library so the
   # producer, the migrator, and the analytics consumers can never disagree.
   SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
   source "${SCRIPT_DIR}/libs/transcript-discovery.sh"
   PARSER="${SCRIPT_DIR}/libs/conversation-parser.lua"

   # Order matters. The main conversation should claim the bare date name and
   # its agent sidechains should fall into the "_agent-N" collision slots, so we
   # feed the main "<uuid>.jsonl" files first and the "agent-*.jsonl" ones last.
   local ordered_jsonl=()
   for jsonl_file in "$CLAUDE_PROJECT_DIR"/*.jsonl; do
      [ -f "$jsonl_file" ] || continue
      case "$(basename "$jsonl_file")" in
         agent-*) : ;;                       # held back for the second pass
         *) ordered_jsonl+=("$jsonl_file") ;;
      esac
   done
   for jsonl_file in "$CLAUDE_PROJECT_DIR"/agent-*.jsonl; do
      [ -f "$jsonl_file" ] || continue
      ordered_jsonl+=("$jsonl_file")
   done

   for jsonl_file in "${ordered_jsonl[@]}"; do
      conversation_id=$(basename "$jsonl_file" .jsonl)
      echo "Processing conversation: $conversation_id"

      # Parse into a temp file first: the final name depends on the start/end
      # dates that only the parser can report. The temp name is hidden and lacks
      # a .md suffix, so the discovery library never mistakes it for a claimant.
      local temp_file="$TRANSCRIPT_DIR/.transcript-${conversation_id}.tmp"
      local parser_signals
      parser_signals=$(lua "$PARSER" "$jsonl_file" "$temp_file" 2>&1 >/dev/null)

      if [ ! -f "$temp_file" ]; then
         echo "  (parser produced no output for $conversation_id)"
         continue
      fi

      local final_timestamp start_date final_date
      final_timestamp=$(echo "$parser_signals" | grep "FINAL_TIMESTAMP:" | cut -d: -f2 || true)
      start_date=$(echo "$parser_signals" | grep "START_DATE:" | cut -d: -f2 || true)
      final_date=$(echo "$parser_signals" | grep "FINAL_DATE:" | cut -d: -f2 || true)

      # Build the date-span basename. If the parser found no dates at all, we
      # keep the conversation id so nothing is silently mis-filed (a warning
      # path, per house rule: warnings are errors).
      local base
      if [ -n "$start_date" ] || [ -n "$final_date" ]; then
         base=$(transcript_span_basename "$start_date" "$final_date")
      else
         echo "  WARNING: no timestamps for $conversation_id; keeping id as name"
         base="$conversation_id"
      fi

      # Idempotency: if this conversation already owns a transcript, reuse it,
      # re-placing it only when the span (hence the base) grew - e.g. the
      # conversation continued into a new day.
      local claim dest claim_base
      claim=$(transcript_find_claim "$TRANSCRIPT_DIR" "$conversation_id" || true)
      if [ -n "$claim" ]; then
         claim_base=$(transcript_strip_suffix "$claim")
         if [ "$claim_base" = "$base" ]; then
            dest="$claim"                               # same span: overwrite in place
         else
            dest=$(transcript_pick_free_name "$TRANSCRIPT_DIR" "$base" "$claim")
         fi
      else
         dest=$(transcript_pick_free_name "$TRANSCRIPT_DIR" "$base")
      fi

      # Move content into place, retire any stale prior name, stamp the mtime
      # from the last message so the file's timestamp matches its name's date.
      mv -f "$temp_file" "$dest"
      if [ -n "$claim" ] && [ "$claim" != "$dest" ]; then
         rm -f "$claim"
      fi
      if [ -n "$final_timestamp" ] && [ "$final_timestamp" -gt 0 ]; then
         touch -d "@$final_timestamp" "$dest" 2>/dev/null || true
      fi

      echo "Created: $dest"
   done

   echo "Transcript extraction complete!"
} # }}}


function backup-conversation(){
   DIR="${1:-$(pwd)}" # first argument, or current directory if no argument
    echo "Backing up Claude conversation transcripts..."
    if command -v lua &> /dev/null; then
        write-transcripts-to-project-directory "${DIR}" 2>/dev/null || echo "  (No new transcripts to backup)"
    else
        echo "  (Transcript backup unavailable - missing lua)"
    fi
 }

# Alias for plural form
function backup-conversations(){
    backup-conversation "$@"
}

# Direct-invocation entry point.
# Until now this file only defined functions; running it as a command did
# nothing, which silently broke batch-transcript-backup.sh and made it
# impossible to use as a Stop-hook target. Now: when executed directly
# (rather than sourced), run the backup against the given path, or against
# $CLAUDE_PROJECT_DIR / $(pwd) as fallback. The "no transcripts to back up"
# case is already swallowed inside backup-conversation, so this stays quiet
# when there is nothing to do.
if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    target="${1:-${CLAUDE_PROJECT_DIR:-$(pwd)}}"
    backup-conversation "$target"
    exit 0
fi

function claude-next(){
   DIR=$(pwd)
   CLAUDE_NEXT_DIR="${DIR}/todo/claude-next"
   
   # Create directories if they don't exist
   mkdir -p "${CLAUDE_NEXT_DIR}/completed"
   
   # Find highest number in both current and completed directories
   NEXT=0
   
   # Check current directory
   if [ -d "${CLAUDE_NEXT_DIR}" ]; then
      for file in "${CLAUDE_NEXT_DIR}"/claude-next-*; do
         if [ -f "$file" ]; then
            filename=$(basename "$file")
            if [[ $filename =~ claude-next-([0-9]+) ]]; then
               num=${BASH_REMATCH[1]}
               if [ "$num" -ge "$NEXT" ]; then
                  NEXT=$((num + 1))
               fi
            fi
         fi
      done
   fi
   
   # Check completed directory
   if [ -d "${CLAUDE_NEXT_DIR}/completed" ]; then
      for file in "${CLAUDE_NEXT_DIR}/completed"/claude-next-*; do
         if [ -f "$file" ]; then
            filename=$(basename "$file")
            if [[ $filename =~ claude-next-([0-9]+) ]]; then
               num=${BASH_REMATCH[1]}
               if [ "$num" -ge "$NEXT" ]; then
                  NEXT=$((num + 1))
               fi
            fi
         fi
      done
   fi
   
   nvim "${CLAUDE_NEXT_DIR}/claude-next-${NEXT}"
}
