#!/usr/bin/env luajit
-- see-in-3d - Turns a picture into an object you can walk around: a
-- screenshot, a few lines saying what it is in space, and four views of that
-- object from other sides.
--
-- In plain terms: a language model looking at a screenshot sees one flat
-- picture from one side. With this it can say, in a short scene file, what it
-- thinks the picture is as a solid thing -- these boxes, that ball, here, this
-- colour -- and then look at that thing from the front, the right, above and
-- at an angle, all on one sheet. If the views look wrong, its understanding of
-- the picture was wrong, and it can say so. A person gets the idea turned
-- around for them too.
--
-- Three steps:
--   see-in-3d shot --desktop [OUT.png]       the whole X screen
--   see-in-3d shot PAGE-OR-URL [OUT.png]     a page, opened in headless Firefox
--   see-in-3d brief SHOT.png                 what to write next, and the paintbrush
--   see-in-3d render SCENE.lua [--size=N]    four views, a sheet, and an .obj model
--   see-in-3d gallery EXAMPLES-DIR [--out=DIR]   every example as a web page of
--                                            drawing sheets (picture beside views)
--   see-in-3d imagine SCENE.lua [--view=angle] [--picture=PNG] [--prompt=TEXT]
--                     [--seed=N] [--dry-run]  one view imagined as a picture by
--                                            the local Stable Diffusion server:
--                                            shape from the view's depth, look
--                                            from the picture, meaning from the
--                                            scene's description (issue A09)
--
-- Where things go: ${DIR}/tmp/shared-memory/see-in-3d/ unless a path is given;
-- render writes beside the scene file. The words a scene may use are in
-- see-in-3d-paintbrush.md, next to this file.
--
-- Options: --dir=PATH (where these scripts live), --workers=N (render views
-- across N processes; default one per view).

-- {{{ DIR Configuration
local DIR = "/home/ritz/programming/ai-stuff/scripts"
local SIZE = 480
local WORKERS = nil
local OUT = nil
local VIEW, PICTURE, PROMPT, SEED, DRY_RUN = "angle", nil, nil, 1, false
-- the animate step's ends and middle, frames per segment, and frame delay
-- in hundredths of a second (issue A12)
local FROM, TO, MIDDLE, FRAMES, DELAY, BOUNCE = nil, nil, nil, 8, 12, false
local SIZE_GIVEN = false
-- Where what this run makes is kept (issue A10): the project given, or the
-- nearest folder above the working directory that keeps llm-transcripts/.
-- --no-keep is for the tool's own regenerations (the gallery rebuilding its
-- examples), never for looking at something new.
local PROJECT, KEEP = nil, true
-- settings handed straight to the workflow builder (libs/see-in-3d-imagine.lua
-- M.defaults names each one); only those given on the command line are set
local IMAGINE = {}
local imagine_options = {
    server = "server", checkpoint = "checkpoint", mode = "mode", sampler = "sampler", scheduler = "scheduler",
    denoise = "denoise", steps = "steps", cfg = "cfg",
}
local numeric_options = { denoise = true, steps = true, cfg = true }
local positional = {}
for _, argument in ipairs(arg) do
    local option_name, option_value = argument:match("^%-%-([%a]+)=(.+)$")
    local view_value = argument:match("^%-%-view=(%a+)$")
    local picture_value = argument:match("^%-%-picture=(.+)$")
    local prompt_value = argument:match("^%-%-prompt=(.*)$")
    local seed_value = argument:match("^%-%-seed=(%d+)$")
    local dir_value = argument:match("^%-%-dir=(.+)$")
    local size_value = argument:match("^%-%-size=(%d+)$")
    local workers_value = argument:match("^%-%-workers=(%d+)$")
    local out_value = argument:match("^%-%-out=(.+)$")
    -- each option sets one setting; the rest are the step and its targets
    if option_name and imagine_options[option_name] then
        IMAGINE[imagine_options[option_name]] = numeric_options[option_name] and tonumber(option_value) or option_value
    elseif dir_value then DIR = dir_value
    elseif size_value then SIZE = tonumber(size_value); SIZE_GIVEN = true
    elseif workers_value then WORKERS = tonumber(workers_value)
    elseif out_value then OUT = out_value
    elseif view_value then VIEW = view_value
    elseif picture_value then PICTURE = picture_value
    elseif prompt_value then PROMPT = prompt_value
    elseif seed_value then SEED = tonumber(seed_value)
    elseif argument == "--dry-run" then DRY_RUN = true
    elseif argument == "--no-keep" then KEEP = false
    elseif argument == "--bounce" then BOUNCE = true
    elseif argument:match("^%-%-from=(.+)$") then FROM = argument:match("^%-%-from=(.+)$")
    elseif argument:match("^%-%-to=(.+)$") then TO = argument:match("^%-%-to=(.+)$")
    elseif argument:match("^%-%-middle=(.+)$") then MIDDLE = argument:match("^%-%-middle=(.+)$")
    elseif argument:match("^%-%-frames=(%d+)$") then FRAMES = tonumber(argument:match("^%-%-frames=(%d+)$"))
    elseif argument:match("^%-%-delay=(%d+)$") then DELAY = tonumber(argument:match("^%-%-delay=(%d+)$"))
    elseif argument:match("^%-%-project=(.+)$") then PROJECT = argument:match("^%-%-project=(.+)$")
    else positional[#positional + 1] = argument end
end
local SCRATCH = DIR .. "/tmp/shared-memory/see-in-3d"
-- gif-generator's encoder, used as it is: one GIF writer for every project
local GIF_ENCODER = DIR .. "/../gif-generator/src/004-gif.lua"
local ffi_string = require("ffi").string
local SCRIPT_PATH = arg[0]
-- }}}

-- {{{ local function fail()
local function fail(message)
    io.stderr:write("see-in-3d: ", message, "\n")
    os.exit(1)
end
-- }}}

-- {{{ local function shell_quote()
local function shell_quote(text)
    return "'" .. text:gsub("'", "'\\''") .. "'"
end
-- }}}

-- {{{ local function run()
-- A shell command that must succeed; its failure stops the program with the
-- command named.
local function run(command, what)
    local status = os.execute(command)
    if status ~= 0 and status ~= true then fail(what .. " failed: " .. command) end
end
-- }}}

-- {{{ local function ensure_scratch()
local function ensure_scratch()
    local tiers = dofile(DIR .. "/libs/ensure-ram-tiers.lua")
    tiers.ensure(DIR)
    run("mkdir -p " .. shell_quote(SCRATCH), "making the scratch folder")
end
-- }}}

-- {{{ local function file_exists()
local function file_exists(path)
    local handle = io.open(path, "r")
    if handle then handle:close() return true end
    return false
end
-- }}}

-- {{{ local function shot()
-- A screenshot: the X desktop through ImageMagick's import, or a page through
-- headless Firefox with a throwaway profile in RAM (so it never touches the
-- person's own browser profile, and runs beside an open Firefox).
local function shot(target, out)
    if not target then fail("usage: see-in-3d shot --desktop|PAGE-OR-URL [OUT.png]") end
    ensure_scratch()
    out = out or (SCRATCH .. "/shot-" .. os.date("%Y%m%d-%H%M%S") .. ".png")
    if target == "--desktop" then
        run("import -window root " .. shell_quote(out), "the desktop screenshot")
    else
        local url = target
        -- a plain path becomes a file address; anything with a scheme is used as is
        if not target:match("^%a[%w+.-]*://") then
            local absolute = target:sub(1, 1) == "/" and target or (os.getenv("PWD") .. "/" .. target)
            if not file_exists(absolute) then fail("no such page: " .. absolute) end
            url = "file://" .. absolute
        end
        local profile = SCRATCH .. "/firefox-profile"
        run("mkdir -p " .. shell_quote(profile), "making the browser profile")
        run(string.format("timeout 90 firefox --headless --no-remote --profile %s --window-size %d,%d --screenshot %s %s >/dev/null 2>&1",
            shell_quote(profile), 1280, 900, shell_quote(out), shell_quote(url)), "the page screenshot")
    end
    if not file_exists(out) then fail("no screenshot was written to " .. out) end
    io.write(out, "\n")
end
-- }}}

-- {{{ local function brief()
-- What the looking model needs: the picture's path, where to write the scene,
-- and every word it may use (the paintbrush document, printed whole).
local function brief(picture)
    if not picture or not file_exists(picture) then fail("usage: see-in-3d brief SHOT.png (the picture must exist)") end
    ensure_scratch()
    local stem = picture:match("([^/]+)%.%w+$") or "scene"
    local scene_path = SCRATCH .. "/" .. stem .. "-scene.lua"
    io.write("Look at: ", picture, "\n\n")
    io.write("Decide what the picture is as an object in space -- its parts, where they sit,\n")
    io.write("their sizes and colours -- and write it, using only the words below, to:\n  ", scene_path, "\n")
    io.write("Then run:\n  ", SCRIPT_PATH, " render ", scene_path, "\n")
    io.write("and look at the sheet it names. If the views do not match the picture, the\n")
    io.write("scene (your reading of the picture) is what is wrong: change it and render again.\n\n")
    local handle = io.open(DIR .. "/see-in-3d-paintbrush.md", "r")
    if not handle then fail("the paintbrush document is missing: " .. DIR .. "/see-in-3d-paintbrush.md") end
    io.write(handle:read("*a"))
    handle:close()
end
-- }}}

-- {{{ local function render_one_view()
-- Worker: one view of a scene, written as raw RGB bytes. Each worker reads and
-- compiles the scene itself; that is cheap, and it keeps workers from sharing
-- anything but the scene file.
local function render_one_view(scene_path, view_index, size, out)
    local paintbrush = dofile(DIR .. "/libs/see-in-3d-paintbrush.lua")
    local renderer = dofile(DIR .. "/libs/see-in-3d-render.lua")
    local scene, problems = paintbrush.read(scene_path)
    if not scene then fail(table.concat(problems, "\n")) end
    -- the raw file is the colour bytes followed by the depth bytes
    local rgb, depth = renderer.render(paintbrush.compile(scene), renderer.views[tonumber(view_index)], tonumber(size))
    local handle = io.open(out, "wb")
    handle:write(rgb, depth)
    handle:close()
end
-- }}}

-- {{{ local function find_project()
local function find_project()
    -- the project given, or the nearest folder at or above the working
    -- directory holding llm-transcripts/ -- that is what makes a folder a
    -- project whose story the picture joins
    if PROJECT then
        if not file_exists(PROJECT .. "/llm-transcripts/.") then
            fail("--project=" .. PROJECT .. " has no llm-transcripts/ folder, so it is not a project whose story a picture can join")
        end
        return PROJECT
    end
    local folder = os.getenv("PWD") or ""
    while folder ~= "" do
        if file_exists(folder .. "/llm-transcripts/.") then return folder end
        folder = folder:match("^(.*)/[^/]*$") or ""
    end
    fail("no project above " .. (os.getenv("PWD") or "?") .. " keeps llm-transcripts/; run from inside the project, or name it with --project=DIR")
end
-- }}}

-- {{{ local function keep_visual()
-- What a render or an imagining made, kept in the project's
-- mind/imagination-portraits/<date-time>-<name>/: the scene, the picture(s) as
-- JPEG copies (the PNGs are uncompressed), and visual.info saying what made
-- it, in which conversation, and when. Then one line per picture,
-- "see-in-3d: kept PATH", which the conversation exporter reads to put the
-- picture into the transcript at the moment it was made (issue A10).
local function keep_visual(scene_path, kind, pictures)
    if not KEEP then return end
    local project = find_project()
    -- named after the scene, or, for a moving picture made from pictures
    -- rather than a scene, after the picture it starts from
    local name = (scene_path:match("([^/]+)%.%w+$") or "scene"):gsub("[^%w%-]", "-")
    local folder = string.format("%s/mind/imagination-portraits/%s-%s-%s", project, os.date("%Y-%m-%d-%H%M%S"), name, kind)
    run("mkdir -p " .. shell_quote(folder), "making the portrait folder")
    -- a scene is kept beside its pictures; a moving picture made from
    -- pictures has its workflow and its ends kept instead, by the caller
    if scene_path:match("%.lua$") then
        run("cp " .. shell_quote(scene_path) .. " " .. shell_quote(folder .. "/scene.lua"), "keeping the scene")
    end
    local kept = {}
    for _, picture in ipairs(pictures) do
        -- a still is kept as a JPEG copy (its PNG is uncompressed); a moving
        -- picture is kept as it is, since a JPEG cannot move
        local target
        if picture.as_is then
            target = folder .. "/" .. picture.name .. "." .. (picture.path:match("%.(%w+)$") or "bin")
            run("cp " .. shell_quote(picture.path) .. " " .. shell_quote(target), "keeping " .. picture.name)
        else
            target = folder .. "/" .. picture.name .. ".jpg"
            run(string.format("magick %s -quality 88 %s", shell_quote(picture.path), shell_quote(target)), "keeping " .. picture.name)
        end
        kept[#kept + 1] = { path = target, caption = picture.caption }
    end
    local info = io.open(folder .. "/visual.info", "w")
    info:write("Made by scripts/see-in-3d ", kind, ", ", os.date("%Y-%m-%d %H:%M:%S"),
        ", in conversation ", os.getenv("CLAUDE_CODE_SESSION_ID") or "(not in a Claude Code session)",
        ", so the agent's looking is kept with the project and shown where it happened.\n",
        "scene: ", scene_path, "\n")
    for _, picture in ipairs(kept) do info:write("picture: ", picture.path:match("([^/]+)$"), " -- ", picture.caption, "\n") end
    info:close()
    for _, picture in ipairs(kept) do io.write("see-in-3d: kept ", picture.path, " | ", picture.caption, "\n") end
end
-- }}}

-- {{{ local function render()
-- A scene file to pictures: checked by the wall first (every problem printed,
-- nothing drawn), then the .obj model, then four views in parallel, stitched
-- in a fixed order into the sheet, and the sheet kept in the project.
local function render(scene_path)
    if not scene_path then fail("usage: see-in-3d render SCENE.lua [--size=N]") end
    local paintbrush = dofile(DIR .. "/libs/see-in-3d-paintbrush.lua")
    local renderer = dofile(DIR .. "/libs/see-in-3d-render.lua")
    local png = dofile(DIR .. "/libs/png-writer.lua")
    local scene, problems = paintbrush.read(scene_path)
    if not scene then
        io.stderr:write("see-in-3d: the scene was refused (", #problems, " problem", #problems == 1 and "" or "s", "):\n")
        for _, problem in ipairs(problems) do io.stderr:write("  ", problem, "\n") end
        os.exit(1)
    end
    local model = paintbrush.compile(scene)
    local stem = scene_path:gsub("%.lua$", "")
    paintbrush.write_obj(model, stem .. ".obj")

    -- four views across worker processes, each writing its own raw file;
    -- collected in view order, never in finishing order
    local raws, commands = {}, {}
    local workers = WORKERS or #renderer.views
    for index = 1, #renderer.views do
        raws[index] = stem .. "-" .. renderer.views[index].name .. ".raw"
        commands[#commands + 1] = string.format("luajit %s --dir=%s --view-worker %s %d %d %s",
            shell_quote(SCRIPT_PATH), shell_quote(DIR), shell_quote(scene_path), index, SIZE, shell_quote(raws[index]))
    end
    local batches = {}
    for index, command in ipairs(commands) do
        local batch = (index - 1) % workers + 1
        batches[batch] = (batches[batch] and (batches[batch] .. " && ") or "") .. command
    end
    local script = {}
    for _, batch in ipairs(batches) do script[#script + 1] = "( " .. batch .. " ) &" end
    run("bash -c " .. shell_quote(table.concat(script, "\n") .. "\nwait"), "rendering the views")
    local rendered = {}
    for index, raw in ipairs(raws) do
        local handle = io.open(raw, "rb")
        if not handle then fail("a view was not rendered: " .. raw) end
        local bytes = handle:read("*a")
        handle:close()
        os.remove(raw)
        if #bytes ~= SIZE * SIZE * 4 then fail("a view came back the wrong size: " .. raw) end
        rendered[index] = bytes:sub(1, SIZE * SIZE * 3)
        local grey = bytes:sub(SIZE * SIZE * 3 + 1)
        png.write(stem .. "-" .. renderer.views[index].name .. ".png", SIZE, SIZE, rendered[index])
        png.write(stem .. "-" .. renderer.views[index].name .. "-depth.png", SIZE, SIZE, (grey:gsub(".", function(c) return c .. c .. c end)))
    end
    png.write(stem .. ".png", SIZE * 2, SIZE * 2, renderer.sheet(rendered, SIZE))
    io.write(string.format("%s: %d shapes, %d triangles\n", scene.what, #scene.shapes, #model.cr))
    io.write("  sheet (front, right / top, angle): ", stem, ".png\n")
    io.write("  each view: ", stem, "-{front,right,top,angle}.png\n")
    io.write("  each view's depth (near bright): ", stem, "-{front,right,top,angle}-depth.png\n")
    io.write("  model: ", stem, ".obj\n")
    keep_visual(scene_path, "views", { { name = "views", path = stem .. ".png",
        caption = scene.what .. " -- front, right / top, angle" } })
end
-- }}}

-- {{{ local function imagine()
-- One view of a scene imagined as a picture. The view and its depth are drawn
-- here at the model's size (512); the depth and the look picture are sent to
-- the server; the workflow is queued, waited on, and the picture fetched.
-- Everything lands beside the scene: the depth used, the workflow sent, and
-- the picture, so a result can always be traced to what made it. --dry-run
-- writes the depth and the workflow and stops before the server.
local function imagine(scene_path)
    if not scene_path then fail("usage: see-in-3d imagine SCENE.lua [--view=angle] [--picture=PNG] [--prompt=TEXT] [--seed=N] [--dry-run]") end
    local paintbrush = dofile(DIR .. "/libs/see-in-3d-paintbrush.lua")
    local renderer = dofile(DIR .. "/libs/see-in-3d-render.lua")
    local png = dofile(DIR .. "/libs/png-writer.lua")
    local imagining = dofile(DIR .. "/libs/see-in-3d-imagine.lua")
    local scene, problems = paintbrush.read(scene_path)
    if not scene then fail("the scene was refused:\n  " .. table.concat(problems, "\n  ")) end
    local view = nil
    for _, candidate in ipairs(renderer.views) do if candidate.name == VIEW then view = candidate end end
    if not view then fail("no view called " .. VIEW .. " (front, right, top or angle)") end
    if PICTURE and not file_exists(PICTURE) then fail("no such picture: " .. PICTURE) end

    -- the size the model works at: 512 unless --size says otherwise (SDXL
    -- models compose best at 1024)
    local size = SIZE_GIVEN and SIZE or 512
    local stem = scene_path:gsub("%.lua$", "") .. "-" .. VIEW
    local colour, depth = renderer.render(paintbrush.compile(scene), view, size)
    local depth_path = stem .. "-depth-" .. size .. ".png"
    local render_path = stem .. "-render-" .. size .. ".png"
    png.write(depth_path, size, size, (depth:gsub(".", function(c) return c .. c .. c end)))
    png.write(render_path, size, size, colour)
    local prompt = scene.what .. (PROMPT and PROMPT ~= "" and (", " .. PROMPT) or "")
    local prefix = "see-in-3d-" .. (stem:match("([^/]+)$") or "view")

    local settings = { prompt = prompt, seed = SEED, prefix = prefix, width = size, height = size,
        depth_image = depth_path:match("([^/]+)$"), render_image = render_path:match("([^/]+)$"),
        look_image = PICTURE and PICTURE:match("([^/]+)$") or nil }
    for key, value in pairs(IMAGINE) do settings[key] = value end
    local server = settings.server or imagining.defaults.server
    settings.server = nil
    local mode = settings.mode or imagining.defaults.mode
    -- the render mode starts from the drawn view and has no ControlNet to
    -- carry a look picture; it is refused rather than dropped without a word
    if mode == "render" and PICTURE then
        fail("--picture needs the depth mode's look ControlNet; the render mode cannot use it. Leave --picture out, or use --mode=depth on a server with ControlNets")
    end
    -- a dry run stops before the server: the workflow names the files by the
    -- names they would be uploaded under
    if DRY_RUN then
        local handle = io.open(stem .. "-workflow.json", "w")
        handle:write(imagining.json(imagining.workflow(settings)), "\n")
        handle:close()
        io.write("prompt: ", prompt, "\n  depth: ", depth_path, "\n  workflow: ", stem, "-workflow.json\n  (dry run: the server was not contacted)\n")
        return
    end
    if not imagining.reachable(server) then
        fail("the Stable Diffusion server at " .. server .. " is not answering. Start it with /mnt/kaun/stable-diffusion/run")
    end
    local missing = imagining.missing(server, imagining.workflow(settings))
    if #missing > 0 then
        fail("the server at " .. server .. " lacks what this workflow needs:\n  " .. table.concat(missing, "\n  "))
    end
    -- the image the shape comes from: the depth map, or the drawn view itself
    local uploaded, problem = imagining.upload(server, mode == "render" and render_path or depth_path)
    if not uploaded then fail(problem) end
    if mode == "render" then settings.render_image = uploaded else settings.depth_image = uploaded end
    if PICTURE then
        uploaded, problem = imagining.upload(server, PICTURE)
        if not uploaded then fail(problem) end
        settings.look_image = uploaded
    end
    local graph = imagining.workflow(settings)
    local id
    id, problem = imagining.queue(server, graph, stem .. "-workflow.json")
    if not id then fail(problem) end
    io.write("queued: ", prompt, "\n")
    local result
    result, problem = imagining.wait(server, id, 900)
    if not result then fail(problem) end
    local saved
    saved, problem = imagining.fetch(server, result, stem .. "-imagined.png")
    if not saved then fail(problem) end
    io.write("  imagined: ", saved, "\n  from: ", mode == "render" and render_path or depth_path, "\n  workflow: ", stem, "-workflow.json\n")
    keep_visual(scene_path, "imagined", { { name = "imagined", path = saved,
        caption = scene.what .. " -- imagined from the " .. VIEW .. " view" } })
end
-- }}}

-- {{{ local function animate()
-- A moving picture between two pictures (and through a middle one, if
-- given): every in-between frame made by the image server, the frames turned
-- into a looping GIF by gif-generator's encoder, the GIF kept in the project
-- and so shown in the conversation where it was made. Issue A12.
local function animate()
    if not FROM or not TO then
        fail("usage: see-in-3d animate --from=PICTURE --to=PICTURE [--middle=PICTURE] --prompt=\"the mechanism\" [--frames=8] [--delay=12] [--bounce] [server options]")
    end
    for _, path in ipairs({ FROM, TO, MIDDLE }) do
        if not file_exists(path) then fail("no such picture: " .. path) end
    end
    if not PROMPT or PROMPT == "" then fail("--prompt names the mechanism the movement shows; it guides every frame") end
    local imagining = dofile(DIR .. "/libs/see-in-3d-imagine.lua")
    local animating = dofile(DIR .. "/libs/see-in-3d-animate.lua")
    ensure_scratch()
    local size = SIZE_GIVEN and SIZE or 512
    local name = (FROM:match("([^/]+)%.%w+$") or "from"):gsub("[^%w%-]", "-")
    local work = SCRATCH .. "/animate-" .. os.date("%Y%m%d-%H%M%S") .. "-" .. name
    run("mkdir -p " .. shell_quote(work), "making the work folder")

    -- the ends (and middle) at one size, centred and cropped square
    local ends = { FROM, MIDDLE or TO, MIDDLE and TO or nil }
    local prepared = {}
    for index, path in ipairs(ends) do
        prepared[index] = string.format("%s/end-%d.png", work, index)
        run(string.format("magick %s -resize %dx%d^ -gravity center -extent %dx%d %s",
            shell_quote(path), size, size, size, size, shell_quote(prepared[index])), "sizing " .. path)
    end

    local settings = { prompt = PROMPT, seed = SEED, denoise = 0.45 }
    for key, value in pairs(imagining.defaults) do if settings[key] == nil then settings[key] = value end end
    for key, value in pairs(IMAGINE) do settings[key] = value end
    local server = settings.server
    if not imagining.reachable(server) then fail("the image server at " .. server .. " is not answering") end
    local probe = animating.workflow_between(setmetatable({ from_image = "x", to_image = "x", blend = 1, prefix = "x" }, { __index = settings }))
    local missing = imagining.missing(server, probe)
    if #missing > 0 then fail("the server at " .. server .. " lacks what this needs:\n  " .. table.concat(missing, "\n  ")) end
    local uploaded = {}
    for index, path in ipairs(prepared) do
        local remote, problem = imagining.upload(server, path)
        if not remote then fail(problem) end
        uploaded[index] = remote
    end

    -- every frame queued at once (the server works through them in turn),
    -- then each waited on and fetched in order
    local plan = animating.blends(#prepared - 1, FRAMES)
    local ids = {}
    for index, frame in ipairs(plan) do
        local frame_settings = setmetatable({ from_image = uploaded[frame.segment], to_image = uploaded[frame.segment + 1],
            blend = frame.blend, prefix = "see-in-3d-animate-" .. name }, { __index = settings })
        local id, problem = imagining.queue(server, animating.workflow_between(frame_settings), string.format("%s/frame-%02d-workflow.json", work, index))
        if not id then fail(problem) end
        ids[index] = id
    end
    io.write(string.format("queued %d frames: %s\n", #plan, PROMPT))
    local frames_rgb = {}
    for index, id in ipairs(ids) do
        local result, problem = imagining.wait(server, id, 900)
        if not result then fail("frame " .. index .. ": " .. problem) end
        local png = string.format("%s/frame-%02d.png", work, index)
        local saved
        saved, problem = imagining.fetch(server, result, png)
        if not saved then fail("frame " .. index .. ": " .. problem) end
        local raw = string.format("%s/frame-%02d.rgb", work, index)
        run(string.format("magick %s -resize %dx%d! -depth 8 rgb:%s", shell_quote(png), size, size, shell_quote(raw)), "reading frame " .. index)
        local handle = io.open(raw, "rb")
        frames_rgb[index] = handle:read("*a")
        handle:close()
    end
    -- going and coming back, when asked, so the loop has no jump
    if BOUNCE then
        for index = #frames_rgb - 1, 2, -1 do frames_rgb[#frames_rgb + 1] = frames_rgb[index] end
    end

    -- the palette from the frames, then each frame compressed by its own
    -- worker process (compression is the slow half, and frames are
    -- independent), then gif-generator's encoder puts them together
    local palette = animating.median_cut(frames_rgb, 256)
    local to_indexes = animating.indexer(palette)
    local commands = {}
    for index, rgb in ipairs(frames_rgb) do
        local indexes = to_indexes(rgb, size * size)
        local handle = io.open(string.format("%s/indexes-%02d", work, index), "wb")
        handle:write(ffi_string(indexes, size * size))
        handle:close()
        commands[#commands + 1] = string.format("luajit %s --dir=%s --gif-frame-worker %s %s &", shell_quote(SCRIPT_PATH), shell_quote(DIR),
            shell_quote(string.format("%s/indexes-%02d", work, index)), shell_quote(string.format("%s/compressed-%02d", work, index)))
    end
    run("bash -c " .. shell_quote(table.concat(commands, "\n") .. "\nwait"), "compressing the frames")
    local gif = dofile(GIF_ENCODER)
    local compressed = {}
    for index = 1, #frames_rgb do
        local handle = io.open(string.format("%s/compressed-%02d", work, index), "rb")
        if not handle then fail("frame " .. index .. " was not compressed") end
        compressed[index] = handle:read("*a")
        handle:close()
    end
    local gif_path = work .. "/animation.gif"
    local bytes = gif.assemble({ width = size, height = size, palette_bytes = animating.palette_bytes(palette),
        compressed = compressed, delay_cs = DELAY })
    local handle = io.open(gif_path, "wb")
    handle:write(bytes)
    handle:close()
    io.write(string.format("  moving picture: %s (%d frames, %d colours, %d KB)\n", gif_path, #frames_rgb, #palette, math.floor(#bytes / 1024)))
    keep_visual(FROM, "animated", { { name = "animation", path = gif_path, as_is = true, caption = PROMPT .. " -- in motion" } })
end
-- }}}

-- {{{ local function choose()
-- A page of the project's kept still pictures, each with beginning / middle /
-- end buttons, a box for the mechanism, and the animate command written out
-- to copy. The page only writes text; making stays with the command, so
-- choosing and making never share code (issue A12). Written to the RAM
-- scratch space: it is a view of the kept pictures, remade on demand.
local function choose(project_dir)
    if project_dir then PROJECT = project_dir end
    local project = find_project()
    ensure_scratch()
    local pipe = io.popen("ls -1 " .. shell_quote(project .. "/mind/imagination-portraits") .. " 2>&1")
    local pictures = {}
    for folder in pipe:lines() do
        for _, still in ipairs({ "views.jpg", "imagined.jpg" }) do
            local path = project .. "/mind/imagination-portraits/" .. folder .. "/" .. still
            if file_exists(path) then pictures[#pictures + 1] = path end
        end
    end
    pipe:close()
    if #pictures == 0 then fail("no kept pictures in " .. project .. "/mind/imagination-portraits yet") end
    local escape = function(text) return (text:gsub('[&<>"]', { ["&"] = "&amp;", ["<"] = "&lt;", [">"] = "&gt;", ['"'] = "&quot;" })) end
    local cards = {}
    for index, path in ipairs(pictures) do
        cards[#cards + 1] = string.format(
            '<figure><img src="file://%s" alt="kept picture %d" loading="lazy"><figcaption>%s</figcaption>' ..
            '<div class="pick"><button data-role="from" data-path="%s">beginning</button><button data-role="middle" data-path="%s">middle</button>' ..
            '<button data-role="to" data-path="%s">end</button></div></figure>',
            escape(path), index, escape(path:match("imagination%-portraits/(.*)$")), escape(path), escape(path), escape(path))
    end
    local page = [[<!doctype html>
<!-- Made by scripts/see-in-3d choose, from the project's kept pictures, so the moments of a moving picture can be picked by eye (issue A12). -->
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title>Choose the Moments</title>
<style>
:root { --paper: #eef1ee; --ink: #1f2a2e; --pencil: #5d6b70; --accent: #2c5d86; --chosen: #a3402d; }
@media (prefers-color-scheme: dark) { :root { --paper: #13181a; --ink: #dfe7e4; --pencil: #93a3a6; --accent: #86b3da; --chosen: #e08a76; } }
body { background: var(--paper); color: var(--ink); font: 16px/1.5 Georgia, serif; margin: 0; padding: 16px; }
h1 { font: 600 30px system-ui, sans-serif; margin: 0 0 8px; }
.bar { position: sticky; top: 0; background: var(--paper); padding: 8px 0 12px; border-bottom: 1px solid var(--pencil); }
textarea, pre { width: 100%; box-sizing: border-box; font: 13px ui-monospace, monospace; }
pre { white-space: pre-wrap; background: rgba(0,0,0,.05); padding: 8px; }
.grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 16px; margin-top: 16px; }
figure { margin: 0; } img { width: 100%; height: auto; display: block; }
figcaption { font: 12px system-ui, sans-serif; color: var(--pencil); word-break: break-all; }
button { font: 13px system-ui, sans-serif; margin: 4px 4px 0 0; padding: 4px 8px; border: 1px solid var(--accent); background: transparent; color: var(--accent); cursor: pointer; }
button.on { background: var(--chosen); border-color: var(--chosen); color: #fff; }
button:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
</style></head><body>
<div class="bar"><h1>Choose the moments</h1>
<p>Pick a beginning and an end (a middle if you like), say what mechanism the movement shows, and copy the command.</p>
<label for="mechanism">The mechanism</label>
<textarea id="mechanism" rows="2">the mechanism, in a sentence</textarea>
<pre id="command">pick a beginning and an end</pre><button id="copy">copy the command</button> <span id="copied"></span></div>
<div class="grid">]] .. table.concat(cards) .. [[</div>
<script>
const chosen = { from: null, middle: null, to: null };
const tool = ]] .. string.format("%q", SCRIPT_PATH) .. [[;
const project = ]] .. string.format("%q", project) .. [[;
function quote(s) { return "'" + s.replace(/'/g, "'\\''") + "'"; }
function write() {
  const out = document.getElementById("command");
  if (!chosen.from || !chosen.to) { out.textContent = "pick a beginning and an end"; return; }
  let c = tool + " animate --project=" + quote(project) + " --from=" + quote(chosen.from) + " --to=" + quote(chosen.to);
  if (chosen.middle) c += " --middle=" + quote(chosen.middle);
  c += " --prompt=" + quote(document.getElementById("mechanism").value) + " --frames=8 --bounce";
  out.textContent = c;
}
document.querySelectorAll(".pick button").forEach(b => b.addEventListener("click", () => {
  const role = b.dataset.role;
  chosen[role] = chosen[role] === b.dataset.path ? null : b.dataset.path;
  document.querySelectorAll('.pick button[data-role="' + role + '"]').forEach(x => x.classList.toggle("on", x.dataset.path === chosen[role]));
  write();
}));
document.getElementById("mechanism").addEventListener("input", write);
document.getElementById("copy").addEventListener("click", () => {
  const text = document.getElementById("command").textContent;
  navigator.clipboard.writeText(text).then(() => { document.getElementById("copied").textContent = "copied"; },
    () => { document.getElementById("copied").textContent = "select the text above and copy it"; });
});
</script></body></html>
]]
    local out = OUT or (SCRATCH .. "/choose.html")
    local handle = io.open(out, "w")
    handle:write(page)
    handle:close()
    io.write(string.format("%d kept pictures to choose from\n  %s\n", #pictures, out))
end
-- }}}

-- {{{ local function gif_frame_worker()
-- One frame's palette indexes compressed for the GIF, in a process of its own.
local function gif_frame_worker(indexes_path, out_path)
    local ffi = require("ffi")
    local gif = dofile(GIF_ENCODER)
    local handle = io.open(indexes_path, "rb")
    local raw = handle:read("*a")
    handle:close()
    local pixels = ffi.new("uint8_t[?]", #raw)
    ffi.copy(pixels, raw, #raw)
    local out = io.open(out_path, "wb")
    out:write(gif.compress_frame(pixels, #raw))
    out:close()
end
-- }}}

-- {{{ local function imagine_all()
-- Every gallery example imagined, with the options given on the command line
-- (the server, checkpoint, mode and so on). The result is kept in the example's
-- folder as imagined.jpg, with imagined.info beside it naming what made it --
-- kept rather than remade, because it took a graphics card's time and another
-- card would not draw the same picture. An example that already has one is
-- left alone. Up to four run at once; the server queues them in turn.
local function imagine_all(examples_dir)
    if not examples_dir then fail("usage: see-in-3d imagine-all EXAMPLES-DIR [imagine options]") end
    ensure_scratch()
    local work = SCRATCH .. "/imagine-all"
    run("mkdir -p " .. shell_quote(work), "making the work folder")
    local pipe = io.popen("ls -1 " .. shell_quote(examples_dir))
    local jobs = {}
    local passed = {}
    for key, value in pairs(IMAGINE) do passed[#passed + 1] = shell_quote("--" .. key .. "=" .. tostring(value)) end
    table.sort(passed)
    if SIZE_GIVEN then passed[#passed + 1] = "--size=" .. SIZE end
    if PROMPT then passed[#passed + 1] = shell_quote("--prompt=" .. PROMPT) end
    passed[#passed + 1] = "--view=" .. VIEW
    passed[#passed + 1] = "--seed=" .. SEED
    for name in pipe:lines() do
        local folder = examples_dir .. "/" .. name
        -- an example already imagined is kept as it is; a folder that is not an
        -- example (no scene) is not one to imagine
        if file_exists(folder .. "/scene.lua") and not file_exists(folder .. "/imagined.jpg") then
            local copy = work .. "/" .. name .. ".lua"
            run("cp " .. shell_quote(folder .. "/scene.lua") .. " " .. shell_quote(copy), "copying " .. name)
            local result = work .. "/" .. name .. "-" .. VIEW .. "-imagined.png"
            local info = string.format("Made by scripts/see-in-3d imagine-all from this folder's scene.lua, %s, with: %s -- the scene imagined by a Stable Diffusion server from the %s view, for the gallery.",
                os.date("%Y-%m-%d"), table.concat(passed, " "), VIEW)
            -- --no-keep: the result is kept in the example's own folder
            jobs[#jobs + 1] = string.format("luajit %s --dir=%s imagine --no-keep %s %s > %s 2>&1 && magick %s -quality 88 %s && printf '%%s\\n' %s > %s",
                shell_quote(SCRIPT_PATH), shell_quote(DIR), shell_quote(copy), table.concat(passed, " "),
                shell_quote(work .. "/" .. name .. ".log"), shell_quote(result), shell_quote(folder .. "/imagined.jpg"),
                shell_quote(info), shell_quote(folder .. "/imagined.info"))
        end
    end
    pipe:close()
    if #jobs == 0 then io.write("every example is already imagined\n") return end
    local lanes = {}
    for index, job in ipairs(jobs) do
        local lane = (index - 1) % 4 + 1
        lanes[lane] = (lanes[lane] and (lanes[lane] .. " ; ") or "") .. "( " .. job .. " || echo " .. shell_quote("FAILED: " .. job:match("imagine '([^']+)'")) .. " )"
    end
    local script = {}
    for _, lane in ipairs(lanes) do script[#script + 1] = "( " .. lane .. " ) &" end
    run("bash -c " .. shell_quote(table.concat(script, "\n") .. "\nwait"), "imagining the examples")
    io.write(string.format("imagined %d examples; logs in %s\n", #jobs, work))
end
-- }}}

-- {{{ local function gallery()
-- Every example folder (scene.lua, note.txt, and the picture the note names)
-- made into a page. The work is in three parts kept apart: the views are
-- rendered by this command's own render step, one example per process, all at
-- once; display copies (JPEG, scaled) of the views and pictures are made by
-- ImageMagick, because the page is for looking and the stored PNGs are large;
-- then the page is written from the notes, naming those files.
local function gallery(examples_dir)
    if not examples_dir then fail("usage: see-in-3d gallery EXAMPLES-DIR [--out=DIR]") end
    local paintbrush = dofile(DIR .. "/libs/see-in-3d-paintbrush.lua")
    local layout = dofile(DIR .. "/libs/see-in-3d-gallery.lua")
    ensure_scratch()
    local out = OUT or (SCRATCH .. "/gallery")
    run("mkdir -p " .. shell_quote(out), "making the gallery folder")
    local pipe = io.popen("ls -1 " .. shell_quote(examples_dir))
    local names = {}
    for name in pipe:lines() do
        if file_exists(examples_dir .. "/" .. name .. "/note.txt") then names[#names + 1] = name end
    end
    pipe:close()
    if #names == 0 then fail("no examples (folders holding note.txt) in " .. examples_dir) end

    local examples, renders, copies = {}, {}, {}
    for number, name in ipairs(names) do
        local folder = examples_dir .. "/" .. name
        local note = layout.read_note(folder .. "/note.txt")
        local scene, problems = paintbrush.read(folder .. "/scene.lua")
        if not scene then fail(name .. ": the scene was refused:\n  " .. table.concat(problems, "\n  ")) end
        local handle = io.open(folder .. "/scene.lua", "r")
        local scene_text = handle:read("*a")
        handle:close()
        local stem = string.format("%02d-%s", number, name:gsub("^%d+%-", ""))
        local copy = io.open(out .. "/" .. stem .. ".lua", "w")
        copy:write(scene_text)
        copy:close()
        -- --no-keep: rebuilding the gallery redraws old examples, it is not new looking
        renders[#renders + 1] = string.format("luajit %s --dir=%s render --no-keep %s --size=260 >/dev/null",
            shell_quote(SCRIPT_PATH), shell_quote(DIR), shell_quote(out .. "/" .. stem .. ".lua"))
        copies[#copies + 1] = string.format("magick %s -quality 88 %s",
            shell_quote(out .. "/" .. stem .. ".png"), shell_quote(out .. "/" .. stem .. "-views.jpg"))
        local picture_file = nil
        -- a note names its picture, or says none (the scene was read from an idea)
        if note.picture ~= "none" then
            if not file_exists(note.picture) then fail(name .. ": the picture is missing: " .. note.picture) end
            picture_file = stem .. "-picture.jpg"
            copies[#copies + 1] = string.format("magick %s -resize '640x640>' -quality 85 %s",
                shell_quote(note.picture), shell_quote(out .. "/" .. picture_file))
        end
        -- an imagined picture, made earlier by imagine-all and kept with the
        -- example, is shown as it is; an example without one shows two panels
        local imagined_file = nil
        if file_exists(folder .. "/imagined.jpg") then
            imagined_file = stem .. "-imagined.jpg"
            copies[#copies + 1] = "cp " .. shell_quote(folder .. "/imagined.jpg") .. " " .. shell_quote(out .. "/" .. imagined_file)
        end
        examples[number] = { number = number, note = note, picture_file = picture_file, sheet_file = stem .. "-views.jpg",
            imagined_file = imagined_file, what = scene.what, shape_count = #scene.shapes, scene_text = scene_text }
    end
    local function all_at_once(commands, what)
        local lines = {}
        for _, command in ipairs(commands) do lines[#lines + 1] = "( " .. command .. " ) &" end
        run("bash -c " .. shell_quote(table.concat(lines, "\n") .. "\nwait"), what)
    end
    all_at_once(renders, "rendering the examples")
    all_at_once(copies, "making display copies")
    for _, example in ipairs(examples) do
        if not file_exists(out .. "/" .. example.sheet_file) then fail("a view sheet was not made: " .. example.sheet_file) end
        if example.picture_file and not file_exists(out .. "/" .. example.picture_file) then fail("a picture copy was not made: " .. example.picture_file) end
    end
    local handle = io.open(out .. "/index.html", "w")
    handle:write(layout.page(examples, layout.read_stages(examples_dir .. "/stages.txt")))
    handle:close()
    io.write(string.format("gallery: %d sheets\n  %s/index.html\n", #examples, out))
end
-- }}}

-- {{{ local function main()
local steps = {
    shot = function() shot(positional[2], positional[3]) end,
    brief = function() brief(positional[2]) end,
    render = function() render(positional[2]) end,
    gallery = function() gallery(positional[2]) end,
    imagine = function() imagine(positional[2]) end,
    ["imagine-all"] = function() imagine_all(positional[2]) end,
    animate = function() animate() end,
    choose = function() choose(positional[2]) end,
    ["--gif-frame-worker"] = function() gif_frame_worker(positional[2], positional[3]) end,
    ["--view-worker"] = function() render_one_view(positional[2], positional[3], positional[4], positional[5]) end,
}
local function main()
    local step = steps[positional[1] or ""]
    if not step then fail("usage: see-in-3d shot|brief|render ... (see the top of this file)") end
    step()
end
-- }}}

main()
